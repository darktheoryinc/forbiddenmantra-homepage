# Copy to .env — never commit real keys. These are read only by the server, never shipped to the browser.

# Optional: require this bearer token for all /api routes (enter it under Settings in the app).
APP_ACCESS_TOKEN=

# Optional: speech-to-text. Any OpenAI-compatible /audio/transcriptions endpoint
# (OpenAI, Groq, or a self-hosted whisper.cpp / faster-whisper server — the latter needs no paid service).
TRANSCRIBE_API_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# Optional: AI joke analysis. Any OpenAI-compatible /chat/completions endpoint.
# Free, local option (tested): Ollama — https://ollama.com
#   ollama pull qwen2.5:3b          # ~1.9 GB download, ~3-4 GB RAM, CPU-only is fine (4+ cores)
#   OLLAMA_CONTEXT_LENGTH=8192 ollama serve
#   LLM_API_URL=http://localhost:11434/v1/chat/completions
#   LLM_MODEL=qwen2.5:3b
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# Tuning for slow/small models (all optional):
# LLM_TIMEOUT_MS=300000   per model call
# LLM_CHUNK_WORDS=600     transcript words per extraction call
# LLM_MAX_CHUNKS=8        long transcripts: analyze at most this many sections
