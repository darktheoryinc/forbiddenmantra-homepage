s":["Taylor & Francis Group"],"source_records":["bwb:9780367660390"],"subjects":["Buddhism"],"title":"History of Shaolin","pagination":"294","full_title":"History of Shaolin","works":[{"key":"/works/OL25755066W"}],"key":"/books/OL34681110M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-07T02:40:55.719892"},"last_modified":{"type":"/type/datetime","value":"2021-10-07T02:40:55.719892"}}},"ISBN:9780367204600":{"bib_key":"ISBN:9780367204600","info_url":"http://openlibrary.org/books/OL34663458M/History_of_Shaolin","preview":"noview","preview_url":"http://openlibrary.org/books/OL34663458M/History_of_Shaolin","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7902000A","name":"Lu Zhouxiang"}],"isbn_13":["9780367204600"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BQ6345.C62","BQ6345.T462 L89 2019","BQ6345.T462 S52277 2019"],"publish_date":"2019","publishers":["Taylor & Francis Group"],"source_records":["bwb:9780367204600","marc:marc_columbia/Columbia-extract-20221130-030.mrc:117426371:4264","marc:marc_columbia/Columbia-extract-20221130-029.mrc:61688481:3021","marc:harvard_bibliographic_metadata/20220215_022.bib.mrc:286026989:4322"],"subjects":["Monasteries","Zen buddhism","China, religion"],"title":"History of Shaolin","weight":"0.723","pagination":"294","works":[{"key":"/works/OL25755066W"}],"key":"/books/OL34663458M","lccn":["2019009340","2019008585"],"oclc_numbers":["1088651677","1088602923"],"description":{"type":"/type/text","value":"Shaolin Monastery at Mount Song is considered the epicentre of the Chan school of Buddhism. It is also well known for its martial arts tradition and has long been regarded as a special cultural heritage site and an important symbol of the Chinese nation. This book is the first scholarly work in English to comprehensively examine the full history of Shaolin Monastery from 496 to 2016. More importantly, it offers a clear grasp of the origins and development of Cha