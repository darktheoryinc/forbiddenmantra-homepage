pids, Mich"],"pagination":"xii, 280 p. ;","source_records":["marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:33214043:2290","marc:marc_evangelical_seminary/Evangelical_Seminary_20200728.mrc:39916614:766","marc:marc_loc_2016/BooksAll.2016.part30.utf8:198993163:692","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:33227122:2290","bwb:9780802809940","ia:fallsinwhatwehav0000shus","idb:9780802809940","marc:marc_columbia/Columbia-extract-20221130-010.mrc:355750867:1549","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:385088519:734","marc:harvard_bibliographic_metadata/20220215_032.bib.mrc:249065230:2841"],"title":"The fall and sin","dewey_decimal_class":["233/.14"],"notes":{"type":"/type/text","value":"Includes bibliographical references and indexes."},"identifiers":{"goodreads":["2798392"],"librarything":["775024"]},"languages":[{"key":"/languages/eng"}],"lccn":["2003060240"],"subjects":["Fall of man.","Sin."],"publish_date":"2004","publish_country":"miu","by_statement":"Marguerite Shuster.","works":[{"key":"/works/OL4968251W"}],"type":{"key":"/type/edition"},"covers":[13023660],"ocaid":"fallsinwhatwehav0000shus","oclc_numbers":["52821250"],"description":{"type":"/type/text","value":"The devastating evils of recent history have brought about renewed interest in the Christian doctrine of sin. This volume explores with fresh insight and great seriousness the contemporary plausibility, meaning, and relevance of the biblical understanding of the Fall and its effects.Marguerite Shuster argues that certain aspects of the traditional doctrine of the Fall, including the belief that it took place in time and space, cannot simply be set aside without serious consequences for our doctrine of God and our understanding of human identity, dignity, and responsibility. She explores the nature and extent of sin and examines such problematic issues as \"degrees\" of sin and culpability. Despite the seriousness with which Shuster treats these topics, her discussion is not despairing but instead points to the redemption that God has accomplished in Christ.Filled with contemporary allusions and completed with model sermons on the Fall and sin, this volume is one of the best available studies of this key Christian doctrine--from publisher's wesbite."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-10-20T12:30:08.135770"},"last_modified":{"type":"/type/datetime","value":"2026-03-10T07:51:34.307117"}}},"ISBN:9781467404143":{"bib_key":"ISBN:9781467404143","info_url":"http://openlibrary.org/books/OL48826509M/Fall_and_Sin","preview":"noview","preview_url":"http://openlibrary.org/books/OL48826509M/Fall_and_Sin","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL1072598A","name":"Marguerite Shuster"}],"isbn_13":["9781467404143"],"languages":[{"key":"/languages/eng"}],"pagination":"292","publish_date":"2003","publishers":["Eerdmans Publishing Company, William B."],"source_records":["bwb:9781467404143"],"title":"Fall and Sin","subtitle":"What We Have Become As Sinners","full_title":"Fall and Sin What We Have Become As Sinners","works":[{"key":"/works/OL4968251W"}],"key":"/books/OL48826509M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-07-17T15:40:09.612363"},"last_modified":{"type":"/type/datetime","value":"2023-07-17T15:40:09.612363"}}},"ISBN:9780060653675":{"bib_key":"ISBN:9780060653675","info_url":"http://openlibrary.org/books/OL20945097M/Thinking_about_God","preview":"borrow","preview_url":"https://archive.org/details/thinkingaboutgod00macq","thumbnail_url":"https://covers.openlibrary.org/b/id/8136128-S.jpg","details":{"publishers":["Harper & Row"],"identifiers":{"librarything":["226021"],"goodreads":["193907"]},"isbn_10":["0060653671"],"covers":[8136128],"lc_classifications":["BT102","BT102 .M274 1975"],"key":"/books/OL20945097M","authors":[{"key":"/authors/OL4339696A","name":"John Macquarrie"}],"ocaid":"thinkingaboutgod00ma