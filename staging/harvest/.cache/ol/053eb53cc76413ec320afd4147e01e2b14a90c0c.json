y work in English to comprehensively examine the full history of Shaolin Monastery from 496 to 2016. More importantly, it offers a clear grasp of the origins and development of Chan Buddhism through an examination of Shaolin, and highlights the role of Shaolin and Shaolin kung fu in the construction of a national identity among the Chinese people in the past two centuries."},"number_of_pages":293,"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2021-10-06T23:11:50.329344"},"last_modified":{"type":"/type/datetime","value":"2025-11-24T19:37:22.340819"}}},"ISBN:9780429523748":{"bib_key":"ISBN:9780429523748","info_url":"http://openlibrary.org/books/OL35545083M/History_of_Shaolin","preview":"noview","preview_url":"http://openlibrary.org/books/OL35545083M/History_of_Shaolin","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7902000A","name":"Lu Zhouxiang"}],"isbn_13":["9780429523748"],"languages":[{"key":"/languages/eng"}],"pagination":"294","publish_date":"2019","publishers":["Taylor & Francis Group"],"source_records":["bwb:9780429523748"],"title":"History of Shaolin","subtitle":"Buddhism, Kung Fu and Identity","full_title":"History of Shaolin Buddhism, Kung Fu and Identity","works":[{"key":"/works/OL25755066W"}],"key":"/books/OL35545083M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-11-03T02:10:21.283145"},"last_modified":{"type":"/type/datetime","value":"2021-11-03T02:10:21.283145"}}},"ISBN:9780367788025":{"bib_key":"ISBN:9780367788025","info_url":"http://openlibrary.org/books/OL34704513M/Fourth_Secularisation","preview":"noview","preview_url":"http://openlibrary.org/books/OL34704513M/Fourth_Secularisation","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL318898A","name":"Luigi Berzano"}],"isbn_13":["9780367788025"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BL2747.8.B4813 2021"],"publish_date":"2021","publishers":["Taylor & Francis Group"],"