{"ISBN:9780367786724":{"bib_key":"ISBN:9780367786724","info_url":"http://openlibrary.org/books/OL34703660M/In_Dialogue_with_Classical_Indian_Traditions","preview":"noview","preview_url":"http://openlibrary.org/books/OL34703660M/In_Dialogue_with_Classical_Indian_Traditions","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL745280A","name":"Brian Black"},{"key":"/authors/OL2462963A","name":"Chakravarthi Ram-Prasad"}],"isbn_13":["9780367786724"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BL1111.8"],"publish_date":"2021","publishers":["Taylor & Francis Group"],"source_records":["bwb:9780367786724"],"subjects":["Religion"],"title":"In Dialogue with Classical Indian Traditions","pagination":"282","full_title":"In Dialogue with Classical Indian Traditions","works":[{"key":"/works/OL25745511W"}],"key":"/books/OL34703660M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-07T06:30:16.533472"},"last_modified":{"type":"/type/datetime","value":"2021-10-07T06:30:16.533472"}}},"ISBN:9781138541399":{"bib_key":"ISBN:9781138541399","info_url":"http://openlibrary.org/books/OL34640356M/In_Dialogue_with_Classical_Indian_Traditions","preview":"noview","preview_url":"http://openlibrary.org/books/OL34640356M/In_Dialogue_with_Classical_Indian_Traditions","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL745280A","name":"Brian Black"},{"key":"/authors/OL2462963A","name":"Chakravarthi Ram-Prasad"}],"isbn_13":["9781138541399"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BL2015.D53I5 2019","BL1215.D53","BL1215.D53 D53 2019"],"publish_date":"2019","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781138541399","marc:marc_columbia/Columbia-extract-20221130-030.mrc:117699573:9060","marc:marc_columbia/Columbia-extract-20221130-028.mrc:208931844:2798","marc:harvard_bibliographic_metadata/20220215_036.bib.mrc:86226607:7281"],"subjects":["Dialogue","Religious literature, history and criticism","Philosophy, indic","India, religion"],"title":"In Dialogue with Classical Indian Traditions","pagination":"300","works":[{"key":"/works/OL25745511W"}],"key":"/books/OL34640356M","oclc_numbers":["1089125921","1060582553"],"description":{"type":"/type/text","value":"Dialogue is a recurring and significant component of Indian religious and philosophical literature. Whether it be as a narrative account of a conversation between characters within a text, as an implied response or provocation towards an interlocutor outside the text, or as a hermeneutical lens through which commentators and modern audiences can engage with an ancient text, dialogue features prominently in many of the most foundational sources from classical India. Despite its ubiquity, there are very few studies that explore this important facet of Indian texts. This book redresses this imbalance by undertaking a close textual analysis of a range of religious and philosophical literature to highlight the many uses and functions of dialogue in the sources themselves and in subsequent interpretations. Using the themes of encounter, transformation and interpretation - all of which emerged from face-to-face discussions between the contributors of this volume - each chapter explores dialogue in its own context, thereby demonstrating the variety and pervasiveness of dialogue in different genres of the textual tradition. This is a rich and detailed study that offers a fresh and timely perspective on many of the most well-known and influential sources from classical India. As such, it will be of great use to scholars of religious studies, Asian studies, comparative literature and literary theory."},"number_of_pages":281,"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2021-10-06T18:42:36.110900"},"last_modified":{"type":"/type/datetime","value":"2026-04-15T16:34:15.325708"}}},"ISBN:9780429261626":{"bib_key":"ISBN:9780429261626","info_url":"http://openlibrary.org/