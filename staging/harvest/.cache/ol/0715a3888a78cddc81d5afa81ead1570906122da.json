ision":6,"revision":6,"created":{"type":"/type/datetime","value":"2008-09-27T17:41:32.040533"},"last_modified":{"type":"/type/datetime","value":"2022-11-17T14:56:33.769607"}}},"ISBN:9780877285908":{"bib_key":"ISBN:9780877285908","info_url":"http://openlibrary.org/books/OL3189949M/The_hidden_teaching_beyond_yoga","preview":"noview","preview_url":"http://openlibrary.org/books/OL3189949M/The_hidden_teaching_beyond_yoga","details":{"publishers":["S. Weiser"],"number_of_pages":2,"table_of_contents":[{"level":0,"label":"","title":"1. Beyond Yoga","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"II. The Ultimate Path","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"III. The Religious and Mystic Grades","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"IV. The Hidden Philosophy of India","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"V. The Philosophical Discipline","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"VI. The Worship of Words","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"VII. The Arbitrament of Thinking Power","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"VIII. The Revelation of Relativity","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"IX. From Thing to Thought","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"X. The Secret of Space and Time","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"XI. The Magic of the Mind","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"XII. The Downfall of Materialism","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Epilogue: The Philosophic Life","pagenum":"","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"Everyone has this illusion: that the world is \"out there\" and you are somewhere \"inside\" and somehow knowledge of an external world is reflected in our mind.  Here  Brunton takes us step by step in dismantling the common view of experience, and turns experience inside out.  He shows step by step how there is no outside, there is no basis for the belief in matter, and that all we experiences are contents of mind-- all experience including space and time is in and for and to mind.  This will change your relation to the world.   In the second and companion volume, The Wisdom of the Overself, Brunton explores the nature of the Mind to which the world and ego appear."},"isbn_10":["087728590X"],"coverimage":"/static/images/book.trans.gif","lc_classifications":["BD21 .B75 1984"],"key":"/books/OL3189949M","authors":[{"key":"/authors/OL427469A","name":"Paul Brunton"}],"publish_places":["York Beach, Me"],"languages":[{"key":"/languages/eng"}],"pagination":"365 p. ;","source_records":["marc:marc_records_scriblio_net/part16.dat:124570340:656","marc:marc_loc_updates/v40.i13.records.utf8:19951956:1039","bwb:9780877285908","marc:marc_loc_2016/BooksAll.2016.part14.utf8:193995773:691","marc:harvard_bibliographic_metadata/ab.bib.01.20150123.full.mrc:808110982:752","marc:harvard_bibliographic_metadata/20220215_020.bib.mrc:205127383:1328"],"title":"The hidden teaching beyond yoga","dewey_decimal_class":["181/.45"],"notes":{"type":"/type/text","value":"Includes index."},"identifiers":{"goodreads":["560916"],"librarything":["1737965"]},"edition_name":"2nd rev. ed.","lccn":["83060830"],"subjects":["Metaphysics","Knowledge, Theory of","Yoga","Philosophy, Modern"],"publish_date":"1984","publish_country":"meu","by_statement":"Paul Brunton.","works":[{"key":"/works/OL122942W"}],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"THE more I wander around this turning globe the more I realize that it is not only individual men, parties, governments or peoples who are to blame for the distressful condition of the human race—so mesmerized by popular follies and so deluded by traditional fables!—but also common ignorance concerning three fundamental questions: What is the meaning of the world and experience? What am I?  What is the object of existence?"},"oclc_numbers":["12216389"],"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-10-31T05:55:12.004141"}}},"ISBN:9781428674844":{"bib_key":"ISBN:9781428674844","info_url":"http://openlibrary.org/books/OL11893571M/Tibetan_Yoga","preview":"noview","preview_url":"http://openlibrary.org/books/OL11893571M/Tibetan_Yoga","thumbnail_url":"https://covers.openlibrary.org/b/id/2854754-S.jpg","details":{"publishers":["Kessinger Publishing, LLC"],"identifiers":{"goodreads":["1690378"]},"subtitle":"The Way And Its Power","weight":"4.8 ounces","covers":[2854754],"physical_format":"Paperback","key":"/books/OL11893571M","authors":[{"key":"/authors/OL1744839A","name":"Bernard Bromage"}],"subjects":["Yoga","Health & Fitness / Yoga","Non-Classifiable","Consumer Health","Novelty"],"isbn_13":["9781428674844"],"title":"Tibetan Yoga","number_of_pages":36,"languages":[{"key":"/languages/eng"}],"isbn_10":["1428674845"],"publish_date":"September 15, 2006","works":[{"key":"/works/OL15845511W"}],"type":{"key":"/type/edition"},"physical_dimensions":"11 x 8.5 x 0.5 inches","source_records":["amazon:1428674845"],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-04-30T20:50:18.033121"},"last_modified":{"type":"/type/datetime","value":"2022-11-15T08:17:20.014684"}}},"ISBN:9780850301991":{"bib_key":"ISBN:9780850301991","info_url":"http://openlibrary.org/books/OL29692143M/Tibetan_Yoga","preview":"noview","preview_url":"http://openlibrary.org/books/OL29692143M/Tibetan_Yoga","details":{"publishers":["Red Wheel/Weiser"],"source_records":["bwb:9780850301991","promise:bwb_daily_pallets_2023-12-11:P9-BPA-421"],"title":"Tibetan Yoga"