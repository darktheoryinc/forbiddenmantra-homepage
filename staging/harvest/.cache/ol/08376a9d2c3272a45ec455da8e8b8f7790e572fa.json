g/books/OL44096097M/Buddhism","preview":"noview","preview_url":"http://openlibrary.org/books/OL44096097M/Buddhism","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL716209A","name":"Huston Smith"},{"key":"/authors/OL722024A","name":"Philip Novak"}],"isbn_13":["9780060573164"],"languages":[{"key":"/languages/eng"}],"publish_date":"2003","publishers":["HarperCollins Publishers Limited"],"source_records":["bwb:9780060573164"],"subjects":["Buddhism"],"title":"Buddhism","subtitle":"A Concise Introduction","full_title":"Buddhism A Concise Introduction","works":[{"key":"/works/OL3930637W"}],"key":"/books/OL44096097M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-12-17T03:05:40.575764"},"last_modified":{"type":"/type/datetime","value":"2022-12-17T03:05:40.575764"}}},"ISBN:9780060730673":{"bib_key":"ISBN:9780060730673","info_url":"http://openlibrary.org/books/OL15579205M/Buddhism","preview":"restricted","preview_url":"https://archive.org/details/buddhismconcisei00smit","thumbnail_url":"https://covers.openlibrary.org/b/id/7341984-S.jpg","details":{"publishers":["HarperSanFrancisco"],"identifiers":{"librarything":["119675"],"goodreads":["25886"]},"subtitle":"a concise introduction","description":{"type":"/type/text","value":"\"Smith and Novak respectfully cover the essential teachings, practices, and historical development of Buddhism in all its rich variety. Beginning with the life and legend of the Buddha, Buddhism explores core Buddhist doctrines such as the Four Noble Truths, the Eightfold Path, nirvana, and emptiness. The authors go on to discuss the split between Theravada and Mahayana Buddhism, Vipassana - the Theravadin Way of Insight, the continued divisions of Mahayana into Pure Land, Zen, and the quite distinct Vajrayana/Tantric tradition of Tibetan Buddhism. The second half of the book follows the global migration of Buddhism and its continuing diversification and development in the West, especially in America. This compelling work by two great scholars - a legendary teacher and his long-time student and colleague - is the most insightful, up-to-date, and accessible introduction to this great and immensely appealing religious tradition available today.\"--BOOK JACKET"},"covers":[7341984],"local_id":["urn:sfpl:31223065348949","urn:sfpl:31223065348956","urn:sfpl:31223122313738","urn:sfpl:31223063174032","urn:sfpl:31223065348907","urn:sfpl:31223065348923","urn:cst:10017012869"],"key":"/books/OL15579205M","authors":[{"key":"/authors/OL716209A","name":"Huston Smith"}],"ocaid":"buddhismconcisei00smit","publish_places":["New York, NY"],"contributions":["Novak, Philip."],"subjects":["Buddhism"],"languages":[{"key":"/languages/eng"}],"pagination":"xiii, 242 p. ;","source_records":["marc:marc_western_washington_univ/wwu_bibs.mrc_revrev.mrc:881970000:1812","ia:buddhismconcisei00smit","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run03.mrc:34296302:2659","marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:30888671:3435","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:30900910:3435","bwb:9780060730673","idb:9780060730673"],"title":"Buddhism","notes":{"type":"/type/text","value":"Includes bibliographical references (p. [199]-230) and index."},"number_of_pages":242,"edition_name":"1st HarperCollins pbk. ed.","isbn_10":["0060730676"],"publish_date":"2004","publish_country":"nyu","by_statement":"Huston Smith and Philip Novak.","oclc_numbers":["57307393"],"works":[{"key":"/works/OL3930637W"}],"type":{"key":"/type/edition"},"lccn":["2003544630"],"lc_classifications":["BQ266 .S59 2003","BQ4132"],"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-09-20T15:34:32.115786"},"last_modified":{"type":"/type/datetime","value":"2023-12-19T19:46:23.473576"}}},"ISBN:9780060506964":{"bib_key":"ISBN:9780060506964","info_url":"http://openlibrary.org/books/OL3777976M/Buddhism","preview":"restricted","preview_url":"https://arch