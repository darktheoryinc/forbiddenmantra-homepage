0521547505","info_url":"http://openlibrary.org/books/OL22715062M/FRENCH_WARS_OF_RELIGION_1562-1629.","preview":"noview","preview_url":"http://openlibrary.org/books/OL22715062M/FRENCH_WARS_OF_RELIGION_1562-1629.","thumbnail_url":"https://covers.openlibrary.org/b/id/8651237-S.jpg","details":{"publishers":["CAMBRIDGE UNIV PRESS"],"series":["NEW APPROACHES TO EUROPEAN HISTORY; V. 36"],"covers":[8651237],"lc_classifications":["DC111.3","DC111.3 .H65 2005"],"key":"/books/OL22715062M","authors":[{"key":"/authors/OL6516365A","name":"MACK P. HOLT"}],"publish_places":["CAMBRIDGE"],"edition_name":"2ND ED.","source_records":["ia:frenchwarsreligi00holt_303","ia:frenchwarsreligi00holt","bwb:9780521547505","marc:marc_loc_2016/BooksAll.2016.part33.utf8:165102398:1559","marc:marc_columbia/Columbia-extract-20221130-011.mrc:296279517:1704","idb:9780521547505","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:793419597:1221","marc:harvard_bibliographic_metadata/20220215_043.bib.mrc:313518517:3955"],"title":"FRENCH WARS OF RELIGION, 1562-1629.","identifiers":{"goodreads":["321989"],"librarything":["30779"]},"languages":[{"key":"/languages/und"},{"key":"/languages/eng"}],"isbn_10":["0521547504"],"publish_country":"xx ","works":[{"key":"/works/OL13660592W"}],"type":{"key":"/type/edition"},"lccn":["2006277383"],"oclc_numbers":["61260116"],"number_of_pages":260,"publish_date":"2005","description":{"type":"/type/text","value":"\"This is a new edition of Mack P. Holt's classic study of the French religious wars of the sixteenth and seventeenth centuries. Drawing on the scholarship of social and cultural historians of the Reformation, it shows how religion infused both politics and the socio-economic tensions of the period to produce a long extended civil war. Professor Holt integrates court politics and the political theory of the elites with the religious experiences of the popular classes, offering a fresh perspective on the wars and on why the French were willing to kill their neighbours in the name of religion. The book has been created specifically for undergraduates and general readers with no background knowledge of either French history or the Reformation. This new edition updates the text in the light of new work published in the last decade and the 'Suggestions for further reading' has been completely rewritten.\"--Jacket."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-12-19T06:32:23.656463"},"last_modified":{"type":"/type/datetime","value":"2026-07-16T09:48:06.047866"}}},"ISBN:9780521838726":{"bib_key":"ISBN:9780521838726","info_url":"http://openlibrary.org/books/OL7766037M/The_French_Wars_of_Religion_15621629_(New_Approaches_to_European_History)","preview":"noview","preview_url":"http://openlibrary.org/books/OL7766037M/The_French_Wars_of_Religion_15621629_(New_Approaches_to_European_History)","thumbnail_url":"https://covers.openlibrary.org/b/id/358702-S.jpg","details":{"publishers":["Cambridge University Press"],"number_of_pages":258,"weight":"1.2 pounds","covers":[358702],"physical_format":"Hardcover","key":"/books/OL7766037M","authors":[{"key":"/authors/OL656578A","name":"Mack P. Holt"}],"subjects":["European history: c 1500 to c 1750","History of religion","c 1500 to c 1600","Military - General","History","History - General History","History: World","France","Christianity - History - General","Europe - France","History / Europe / General","Europe - General","17th century","Huguenots","Reformation","Religion and politics"],"edition_name":"2 edition","languages":[{"key":"/languages/eng"}],"first_sentence":{"type":"/type/text","value":"When the Parisian lawyer and historian Etienne Pasquier heard the news of the massacre at Vassy, his reaction was typical of many among the upper classes."},"source_records":["bwb:9780521838726"],"title":"The French Wars of Religion, 15621629 (New Approaches to European History)","identifiers":{"librarything":["30779"],"goodreads":["6644927"]},"isbn_13":["9