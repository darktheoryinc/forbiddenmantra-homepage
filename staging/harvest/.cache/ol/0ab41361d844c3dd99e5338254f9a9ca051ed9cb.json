4:51.721930"}}},"ISBN:9780522850031":{"bib_key":"ISBN:9780522850031","info_url":"http://openlibrary.org/books/OL3648605M/Anglicanism_in_Australia","preview":"noview","preview_url":"http://openlibrary.org/books/OL3648605M/Anglicanism_in_Australia","thumbnail_url":"https://covers.openlibrary.org/b/id/360680-S.jpg","details":{"publishers":["Melbourne University Press","Melbourne University Publishing"],"number_of_pages":408,"table_of_contents":[{"level":0,"label":"","title":"The Anglican ascendancy, 1788-1835 / Brian Fletcher","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"State support for churches, 1836-1860 / Patricia Curthoys","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Secular advance and diocesan response, 1861-1900 / Brian Dickey","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Imperial fervour and Anglican loyalty, 1901-1929 / Ruth Frappell","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Local differences, social and national identity, 1930-1966 / Tom Frame","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Pluralism and new alignments in society and church, 1967 to the present / David Hilliard","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The emergence and character of Australian Anglican identity / Bruce Kaye","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Australian Anglican theology / Bill Lawton","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Australian Anglicanism in a world-wide context / Stuart Piggin","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Anglicanism and indigenous peoples / John Harris","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Anglicanism, the visual arts and architecture / Colin Holden","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Anglicanism and gender issues / Anne O'Brien","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Anglicanism and the shaping of Australian society / Brian Fletcher.","pagenum":"","type":{"key":"/type/toc_item"}}],"isbn_10":["0522850030"],"subject_place":["Australia"],"covers":[360680],"lc_classifications":["BX5710 .A54 2002","BX5710.A54 2002"],"key":"/books/OL3648605M","subtitle":"a history","publish_places":["Carlton South, Vic., Australia"],"contributions":["Kaye, Bruce Norman, 1939-","Frame, T. R. 1962-","Holden, Colin.","Treloar, Geoffrey R., 1951-"],"pagination":"xxiii, 408 p. :","source_records":["marc:marc_records_scriblio_net/part14.dat:112398627:1844","bwb:9780522850031","marc:marc_loc_2016/BooksAll.2016.part30.utf8:108794355:1844","amazon:0522850030","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:73287574:1912","marc:harvard_bibliographic_metadata/20220215_001.bib.mrc:147048876:4881"],"title":"Anglicanism in Australia","dewey_decimal_class":["283/.94"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 351-384) and index."},"identifiers":{"librarything":["4274098"],"goodreads":["2894507"]},"languages":[{"key":"/languages/eng"}],"lccn":["2002489574"],"subjects":["Anglican Church of Australia -- History.","Anglican Communion -- Australia -- History."],"publish_date":"2002","publish_country":"at ","by_statement":"general editor, Bruce Kaye ; associate editors, Tom Frame, Colin Holden, Geoff Treloar.","works":[{"key":"/works/OL18838943W"}],"type":{"key":"/type/edition"},"oclc_numbers":["50242322"],"description":{"type":"/type/text","value":"\"This benchmark work is unlike anything previously attempted. It is the first comprehensive national history of Anglicans in Australia. Anglicanism in Australia is an important contribution to our social history. Its authors have moved beyond biography and histories of individual congregations to create a broad, complex, layered history. They assess Anglicanism's contribution to Australian social, political and cultural life. They explore the processes by which a highly centralised English institution has been reshaped by the environment and experience of this country. The book begins with a fascinating and thoroughly researched narrative account--which moves from the arrival with the First Fleet of an Anglican chaplain, right through to the 1990s. Along the way it charts, among many other events, the nineteenth-century church buffeted by the pendulum swings of 'state aid'; the nationalistic fervour of wartime, and the political radicalism of the 1960s. In its second half, Anglicanism in Australia looks at Anglicans dealing with a broad spectrum of issues: the family, questions of gender, Indigenous peoples, the visual arts, the search for a national identity. It acknowledges thewide variety of Anglican views and reveals how regional identity, a powerful force in many other areas of Australian life, has expressed itself both positively and negatively during the past two centuries. Anglicanism in Australia will be an indispensible research tool for Australian social historians, an invaluable general reference work and, above all, a treasury for those close to the Anglican Church or interested in church history.\" -- BOOK JACKET."},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-04-16T22:15:28.435535"}}},"ISBN:9780674013490":{"bib_key":"ISBN:9780674013490","info_url":"http://openlibrary.org/books/OL20024828M/Ephesos_metropolis_of_Asia","preview":"noview","preview_url":"http://openlibrary.org/books/OL20024828M/Ephesos_metropolis_of_Asia","details":{"publishers":["Distributed by Harvard University Press for Harvard Theological Studies/Harvard Divinity School"],"number_of_pages":357,"table_of_contents":[{"level":0,"label":"","title":"Peter Scherrer","pagenum":"","type":{"key":"/type/