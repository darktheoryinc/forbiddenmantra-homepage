oc_updates/v37.i44.records.utf8:4416079:1308","marc:marc_loc_2016/BooksAll.2016.part34.utf8:154501684:1308","ia:buddhismtaoismfa0000moll","marc:marc_columbia/Columbia-extract-20221130-013.mrc:351918342:2810","marc:harvard_bibliographic_metadata/ab.bib.11.20150123.full.mrc:347876341:1174","bwb:9780824831691","marc:harvard_bibliographic_metadata/20220215_004.bib.mrc:232269821:3777"],"subtitle":"scripture, ritual, and iconographic exchange in medieval China","title":"Buddhism and Taoism face to face","dewey_decimal_class":["294.3/35"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [213]-229) and index."},"number_of_pages":241,"languages":[{"key":"/languages/eng"}],"lccn":["2007042577"],"subjects":["Buddhism -- Relations -- Taoism","Taoism -- Relations -- Buddhism","China -- Religion"],"publish_date":"2008","publish_country":"hiu","by_statement":"Christine Mollier.","works":[{"key":"/works/OL4206581W"}],"type":{"key":"/type/edition"},"oclc_numbers":["257475731","174501785"],"description":{"type":"/type/text","value":"\"This book reveals previously unexplored dimensions of the interaction between Buddhism and Taoism in medieval China. While scholars of Chinese religions have long recognized the mutual influences linking the two traditions, Mollier here brings to light their intense contest for hegemony in the domains of scripture and ritual. Drawing on a far-reaching investigation of canonical texts, together with manuscript sources from Dunhuang and the monastic libraries of Japan - many of them studied here for the first time - she demonstrates the competition and complementarity of the two great Chinese religions in their quest to address personal and collective fears of diverse ills, including sorcery, famine, and untimely death.\" \"This book is abundantly illustrated with drawings and diagrams from canonical and manuscript sources, together with art and artifacts photographed by the author in the course of her field research in China. Sophisticated in its analysis, broad in its synthesis of a variety of difficult material, and original in its interpretations, it will be required reading for those interested in East Asian religions and in the history of the medieval Chinese sciences, including astrology, medicine, and divination.\"--BOOK JACKET."},"latest_revision":18,"revision":18,"created":{"type":"/type/datetime","value":"2008-09-24T05:53:19.059901"},"last_modified":{"type":"/type/datetime","value":"2025-06-18T02:32:18.314361"}}},"ISBN:9780824852146":{"bib_key":"ISBN:9780824852146","info_url":"http://openlibrary.org/books/OL35988926M/Buddhism_and_Taoism_Face_to_Face","preview":"noview","preview_url":"http://openlibrary.org/books/OL35988926M/Buddhism_and_Taoism_Face_to_Face","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL801821A","name":"Christine Mollier"}],"isbn_13":["9780824852146"],"languages":[{"key":"/languages/eng"}],"publish_date":"2008","publishers":["University of Hawaii Press"],"source_records":["bwb:9780824852146"],"title":"Buddhism and Taoism Face to Face","subtitle":"Scripture, Ritual, and Iconographic Exchange in Medieval China","full_title":"Buddhism and Taoism Face to Face Scripture, Ritual, and Iconographic Exchange in Medieval China","works":[{"key":"/works/OL4206581W"}],"key":"/books/OL35988926M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-12-27T15:03:41.947852"},"last_modified":{"type":"/type/datetime","value":"2021-12-27T15:03:41.947852"}}}}