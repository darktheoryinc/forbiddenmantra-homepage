17007668"],"publish_date":"February 2003","works":[{"key":"/works/OL8587255W"}],"type":{"key":"/type/edition"},"physical_dimensions":"9 x 5.9 x 1.3 inches","isbn_10":["0881257265"],"isbn_13":["9780881257267"],"lccn":["2002023598"],"classifications":{},"lc_classifications":["BM755.Z32 B75 2002"],"oclc_numbers":["49375165"],"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-29T15:03:11.581851"},"last_modified":{"type":"/type/datetime","value":"2025-09-19T01:26:27.010608"}}},"ISBN:9780300108323":{"bib_key":"ISBN:9780300108323","info_url":"http://openlibrary.org/books/OL3391691M/Kabbalah_and_eros","preview":"restricted","preview_url":"https://archive.org/details/kabbalaheros0000idel","thumbnail_url":"https://covers.openlibrary.org/b/id/162625-S.jpg","details":{"publishers":["Yale University Press"],"table_of_contents":[{"level":0,"title":"Kabbalah and some prekabbalistic attitudes to eros","type":{"key":"/type/toc_item"}},{"level":0,"title":"Du-partzufin : interpretations of androgyneity in Jewish mysticism","type":{"key":"/type/toc_item"}},{"level":0,"title":"God's wife and concubine : paths of national myth","type":{"key":"/type/toc_item"}},{"level":0,"title":"Contemplating a female : from platonic eros to Jewish mysticism","type":{"key":"/type/toc_item"}},{"level":0,"title":"Cosmoeroticism in Jewish mysticism","type":{"key":"/type/toc_item"}},{"level":0,"title":"Appendix : on the theurgical role of the woman in sexuality.","type":{"key":"/type/toc_item"}}],"covers":[162625],"local_id":["urn:cst:10017004891","urn:bwbsku:O8-DED-158"],"url":["http://www.loc.gov/catdir/toc/ecip056/2005000196.html"],"key":"/books/OL3391691M","authors":[{"key":"/authors/OL222337A","name":"Moshe Idel"}],"publish_places":["New Haven"],"subjects":["Cabala -- History","Love -- Religious aspects -- Judaism","Sex -- Religious aspects -- Judaism"],"uri_descriptions":["Table of contents"],"languages":[{"key":"/languages/eng"},{"key":"/languages/rum"}],"pagination":"p. cm.","source_records":["marc:marc_records_scriblio_net/part15.dat:109838489:1186","marc:marc_ithaca_college/ic_marc.mrc:209305116:1167","marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:42292440:4711","bwb:9780300108323","marc:marc_loc_2016/BooksAll.2016.part32.utf8:117019947:1452","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:42308514:4711","ia:kabbalaheros0000idel","promise:bwb_daily_pallets_2022-09-12","marc:marc_columbia/Columbia-extract-20221130-011.mrc:243918548:2651","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:692385507:1211","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:801052507:644","marc:harvard_bibliographic_metadata/20220215_004.bib.mrc:234625912:3014","marc:harvard_bibliographic_metadata/20220215_041.bib.mrc:330916789:1223"],"title":"Kabbalah and eros","notes":"Includes bibliographical references and index.","identifiers":{"librarything":["632578"],"goodreads":["252457"]},"edition_name":"1st ed.","publish_date":"2005","publish_country":"ctu","by_statement":"Moshe Idel.","works":[{"key":"/works/OL1857205W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/toc/ecip056/2005000196.html"],"isbn_10":["030010832X"],"lccn":["2005000196"],"classifications":{},"dewey_decimal_class":["296.1/6"],"lc_classifications":["BM526 .I337 2005","BM526.I337 2005"],"ocaid":"kabbalaheros0000idel","oclc_numbers":["57422572","237318457"],"number_of_pages":371,"description":{"type":"/type/text","value":"\"In this book, the world's foremost scholar of Kabbalah explores the understanding of erotic love in Jewish mystical thought. Encompassing Jewish mystical literatures from those of late antiquity to works of Polish Hasidism, Moshe Idel highlights the diversity of Kabbalistic views on eros and distinguishes between the major forms of eroticism.\" \"The author traces the main developments of a religious formula that reflects the union between a masculine divine attribute and a feminine divine attribute, and he asks why such an \"erotic formula\" was incorporated into the Jewish prayer book. Idel shows how Kabbalistic literature was influenced not only by rabbinic literature but also by Greek thought that helped introduce a wider understanding of eros. Addressing topics ranging from cosmic eros and androgyneity to the affinity between C. J. Jung and Kabbalah to feminist thought, Idel's study will be of interest to scholars of religion, Judaism, and feminism.\"--BOOK JACKET."},"latest_revision":20,"revision":20,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-06-30T16:52:37.757585"}}},"ISBN:9798235375758":{"bib_key":"ISBN:9798235375758","info_url":"http://openlibrary.org/books/OL62288366M/The_Philosophy_of_the_Sitra_Achra","preview":"noview","preview_url":"http://openlibrary.org/books/OL62288366M/The_Philosophy_of_the_Sitra_Achra","thumbnail_url":"https://covers.openlibrary.org/b/id/15237737-S.jpg","details":{"works":[{"key":"/works/OL45759550W"}],"title":"The Philosophy of the Sitra Achra","publishers":["Draft2digital"],"publish_date":"2026","key":"/books/OL62288366M","type":{"key":"/type/edition"},"identifiers":{},"covers":[15237737],"isbn_13":["9798235375758"],"series":["Philosophy of the Left-Hand Path, #7"],"languages":[{"key":"/languages/eng"}],"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2026-07-12T12:45:15.837273"},"last_modified":{"type":"/type/datetime","value":"2026-07-12T12:47:16.342916"}}}}