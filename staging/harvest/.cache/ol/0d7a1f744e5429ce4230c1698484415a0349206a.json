35A","name":"Thomas A. Forsthoefel"}],"publish_places":["Alderhot, England","Burlington, VT"],"pagination":"xi, 199 p. ;","title":"Knowing beyond knowledge","dewey_decimal_class":["181/.482"],"notes":{"type":"/type/text","value":"Includes bibliographical references (183-195) and index."},"identifiers":{"goodreads":["2467820"],"librarything":["6526562"]},"languages":[{"key":"/languages/eng"}],"lccn":["2002024890"],"subjects":["Advaita.","Knowledge, Theory of.","Experience (Religion)"],"publish_date":"2002","publish_country":"enk","by_statement":"Thomas A. Forsthoefel.","works":[{"key":"/works/OL5957330W"}],"type":{"key":"/type/edition"},"source_records":["marc:marc_loc_2016/BooksAll.2016.part29.utf8:188132674:848","ia:knowingbeyondkno0000fors","bwb:9780754606253","promise:bwb_daily_pallets_2020-12-17","marc:marc_columbia/Columbia-extract-20221130-007.mrc:424804925:1404","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:45779875:2470"],"ocaid":"knowingbeyondkno0000fors","local_id":["urn:bwbsku:KI-529-796"],"oclc_numbers":["49495147"],"description":{"type":"/type/text","value":"\"This book builds on contemporary discussion of 'mysticism' and religious experience by examining the process and content of 'religious knowing' in classical and modern Advaita. Drawing from the work of William Alston and Alvin Plantinga, Thomas Forsthoefel examines key streams of Advaita with special reference to the conditions, contexts, and scope of epistemic merit in religious experience. Forsthoefel uniquely employs specific analytical categories of contemporary Western epistemologies as heuristics to examine the cognitive dimension of religious experience in Indian Vedanta.\"--Jacket."},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-08-21T13:44:23.485734"}}},"ISBN:9781351760959":{"bib_key":"ISBN:9781351760959","info_url":"http://openlibrary.org/books/OL3473418