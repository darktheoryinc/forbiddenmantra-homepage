g","pagination":"241p.","languages":[{"key":"/languages/eng"}],"covers":[12077329],"local_id":["urn:scms:0188500514644","urn:nuls:31786000092459"],"source_records":["marc:marc_scms/20220805_ADAM_MARC_records.mrc:121391337:1573","marc:marc_nuls/NULS_PHC_180925.mrc:205214562:1027","marc:marc_columbia/Columbia-extract-20221130-007.mrc:397075976:1449","marc:marc_columbia/Columbia-extract-20221130-005.mrc:554117907:1192"],"key":"/books/OL35262933M","number_of_pages":241,"works":[{"key":"/works/OL110959W"}],"classifications":{},"isbn_10":["0811200124"],"isbn_13":["9780811200127"],"lccn":["64025440","68028626"],"oclc_numbers":["87844074","1861","40233705"],"lc_classifications":["PQ7797.B635 L3 1964","HJ1011 .D6 1968"],"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2021-10-12T18:36:16.332270"},"last_modified":{"type":"/type/datetime","value":"2024-07-19T17:47:38.327923"}}},"ISBN:9780811229951":{"bib_key":"ISBN:9780811229951","info_url":"http://openlibrary.org/books/OL47068047M/Labyrinths","preview":"noview","preview_url":"http://openlibrary.org/books/OL47068047M/Labyrinths","thumbnail_url":"https://covers.openlibrary.org/b/id/13379270-S.jpg","details":{"works":[{"key":"/works/OL110959W"}],"title":"Labyrinths","publishers":["New Directions"],"publish_date":"2019","key":"/books/OL47068047M","type":{"key":"/type/edition"},"identifiers":{"goodreads":["90589329"]},"covers":[13379270],"isbn_13":["9780811229951"],"isbn_10":["0811229955"],"classifications":{},"description":{"type":"/type/text","value":"The groundbreaking trans-genre work of Argentinian writer Jorge Luis Borges (1899-1986) has been insinuating itself into the structure, stance, and very breath of world literature for well over half a century. Multi-layered, self-referential, elusive, and allusive writing is now frequently labeled Borgesian. Umberto Eco’s international bestseller, The Name of the Rose, is, on one level, an elaborate improvisation on Borges’ fiction “The Library,” which American readers first encountered in the original 1962 New Directions publication of Labyrinths. This new edition of Labyrinths, the classic representative selection of Borges’ writing edited by Donald A. Yates and James E. Irby (in translations by themselves and others), includes the text of the original edition (as augmented in 1964) as well as Irby’s biographical and critical essay, a poignant tribute by Andre Maurois, and a chronology of the author’s life. Borges enthusiast William Gibson has contributed a new introduction bringing Borges’ influence and importance into the twenty-first century."},"physical_format":"Digital Audio","languages":[{"key":"/languages/eng"}],"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2023-03-05T08:16:10.432720"},"last_modified":{"type":"/type/datetime","value":"2023-03-05T08:17:10.538459"}}},"ISBN:9780877286905":{"bib_key":"ISBN:9780877286905","info_url":"http://openlibrary.org/books/OL16689332M/Sefer_Yetzirah_(The_book_of_Creation)","preview":"noview","preview_url":"http://openlibrary.org/books/OL16689332M/Sefer_Yetzirah_(The_book_of_Creation)","details":{"notes":{"type":"/type/text","value":"English and Hebrew; commentary in English\n\nIncludes bibliographical references"},"identifiers":{"librarything":["132968"],"goodreads":["3833590"]},"title":"Sefer Yetzirah (The book of Creation)","subtitle":"in theory and practice","publish_date":"1990","publishers":["S. Weiser"],"isbn_10":["0877286906"],"lc_classifications":["BM525.A4212 K37 1990","BM525.A412 K37 1990","BM525.A412K37 1990"],"publish_places":["York Beach, Me"],"contributions":["Kaplan, Aryeh"],"pagination":"xxvi, 388 p. :","source_records":["bwb:9780877286905","marc:marc_loc_2016/BooksAll.2016.part19.utf8:104814290:849","marc:marc_columbia/Columbia-extract-20221130-002.mrc:584313849:1314","marc:harvard_bibliographic_metadata/ab.bib.01.20150123.full.mrc:816064606:847","marc:harvard_bibliographic_metadata/20220215_028.bib.mrc:225958099:1374"],"w