:[{"key":"/languages/eng"}],"full_title":"Heavenly Stems and Earthly Branches - TianGan Dizhi The Heart of Chinese Wisdom Traditions","lc_classifications":["B127.C68"],"publish_date":"2016","key":"/books/OL28606715M","authors":[{"key":"/authors/OL7026633A","name":"Zhongxian Wu"},{"key":"/authors/OL8051256A","name":"Karin Taylor Wu"},{"key":"/authors/OL8090527A","name":"Fei BingXun"}],"works":[{"key":"/works/OL17559430W"}],"type":{"key":"/type/edition"},"subjects":["Cosmology","Taoism","Calendar, chinese"],"covers":[12431116],"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2020-08-05T05:56:47.377436"},"last_modified":{"type":"/type/datetime","value":"2021-12-10T04:44:57.914954"}}},"ISBN:9781848191518":{"bib_key":"ISBN:9781848191518","info_url":"http://openlibrary.org/books/OL26149870M/Heavenly_Stems_and_Earthly_Branches_TianGan_DiZhi","preview":"noview","preview_url":"http://openlibrary.org/books/OL26149870M/Heavenly_Stems_and_Earthly_Branches_TianGan_DiZhi","thumbnail_url":"https://covers.openlibrary.org/b/id/7820437-S.jpg","details":{"publishers":["Jessica Kingsley Publishers"],"source_records":["bwb:9781848191518","marc:marc_loc_2016/BooksAll.2016.part40.utf8:241679365:905","marc:harvard_bibliographic_metadata/ab.bib.14.20150123.full.mrc:130019751:1090","marc:harvard_bibliographic_metadata/20220215_039.bib.mrc:78514857:2745"],"title":"Heavenly Stems and Earthly Branches  TianGan DiZhi","lccn":["2013032297"],"identifiers":{},"covers":[7820437],"isbn_13":["9781848191518"],"lc_classifications":["CE37.W86 2014","CE37 .W86 2014"],"publish_date":"2014","key":"/books/OL26149870M","works":[{"key":"/works/OL17559430W"}],"type":{"key":"/type/edition"},"oclc_numbers":["827260871"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"TianGan (Heavenly Stems) and DiZhi (Earthly Branches), commonly abbreviated to GanZhi, originated in the ancient Chinese cosmological sciences and is a complex calendrical system which was created to codify the patterns of life and of the universe itself. The ten symbols of Gan express the Yin or Yang perspective of Five Elements and embody the Way of Heaven. The 12 symbols of Zhi, made manifest in the 12 animals of the Chinese zodiac, hold the root of each Element and embrace the Way of Earth. In this book Master Zhongxian Wu and Dr Karin Taylor Wu provide a detailed explanation of the 22 GanZhi symbols outlining the characteristics. Poetic summaries give the reader a deep understanding of the meaning of each Stem and Branch and their relationship to each other. Offering a rare insight into the subtleties and far-reaching influence of this ancient system, this book will be a useful aid for anyone studying or practicing Chinese medicine, FengShui, Chinese astrology, traditional Chinese cosmology, Qigong, Taiji, and other inner cultivation practices. --Provided by publisher."},"number_of_pages":250,"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2016-10-14T21:30:28.431493"},"last_modified":{"type":"/type/datetime","value":"2026-05-16T19:19:56.681491"}}},"ISBN:9781848191501":{"bib_key":"ISBN:9781848191501","info_url":"http://openlibrary.org/books/OL28500381M/Heavenly_Stems_and_Earthly_Branches_-_TianGan_DiZhi","preview":"noview","preview_url":"http://openlibrary.org/books/OL28500381M/Heavenly_Stems_and_Earthly_Branches_-_TianGan_DiZhi","thumbnail_url":"https://covers.openlibrary.org/b/id/13794980-S.jpg","details":{"publishers":["Kingsley Publishers, Jessica","Singing Dragon"],"subtitle":"The Keys to the Sublime","source_records":["bwb:9781848191501","amazon:1848191502"],"title":"Heavenly Stems and Earthly Branches - TianGan DiZhi","number_of_pages":25,"isbn_13":["9781848191501"],"languages":[{"key":"/languages/eng"}],"full_title":"Heavenly Stems and Earthly Branches - TianGan DiZhi The Keys to the Sublime","lc_classifications":[""],"publish_date":"2013","key":"/books/OL28500381M","authors":[{"key":"/authors/OL7026633A","na