{"ISBN:9781138304949":{"bib_key":"ISBN:9781138304949","info_url":"http://openlibrary.org/books/OL29440571M/Daoism","preview":"noview","preview_url":"http://openlibrary.org/books/OL29440571M/Daoism","thumbnail_url":"https://covers.openlibrary.org/b/id/13484966-S.jpg","details":{"publishers":["Taylor & Francis Group","Routledge"],"subtitle":"A Contemporary Philosophical Investigation","source_records":["bwb:9781138304949","marc:marc_columbia/Columbia-extract-20221130-031.mrc:385203949:5899","marc:marc_columbia/Columbia-extract-20221130-030.mrc:145364823:5591","marc:marc_columbia/Columbia-extract-20221130-029.mrc:108125847:2702","amazon:1138304948","marc:harvard_bibliographic_metadata/20220215_031.bib.mrc:261510622:3749"],"title":"Daoism","number_of_pages":214,"isbn_13":["9781138304949"],"languages":[{"key":"/languages/eng"}],"full_title":"Daoism A Contemporary Philosophical Investigation","lc_classifications":["BL1920.K625 2020","BL1925","BL1920 .K625 2020"],"publish_date":"2019","key":"/books/OL29440571M","authors":[{"key":"/authors/OL234641A","name":"Livia Kohn"}],"works":[{"key":"/works/OL21652302W"}],"type":{"key":"/type/edition"},"subjects":["Religion"],"oclc_numbers":["1120941703","1100611657"],"lccn":["2019036204"],"covers":[13484966],"description":{"type":"/type/text","value":"\"Daoism: A Contemporary Philosophical Investigation explores philosophy of religion from a Daoist perspective. Philosophy of religion is a thriving field today, increasingly expanding from its traditional theistic, Christian roots into more cosmologically oriented Asian religions. This book raises a number of different issues on the three levels of cosmos, individual, and society, and addresses key questions like: What are the distinctive characteristics of Daoist thought and cosmology? How does it approach problems of creation, body, mind, and society? What, ultimately, is Dao? How does it manifest and play a role in the world? What are the key features of Daoist communities and ethics? What role does the body play in Daoism? What do Daoists think is the relationship between language and reality? What is Daoist immortality? How do Daoists envision the perfect life on earth? The volume delves into philosophical subject matter in a way that is accessible to those approaching the topic for this first time, while also making an original contribution to Daoist philosophy of religion. This volume is suitable for use by undergraduate and graduate students studying Chinese religion and philosophy, as well as more general introductory courses on Daoism\"--"},"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2020-08-25T21:38:00.053511"},"last_modified":{"type":"/type/datetime","value":"2026-02-22T13:24:46.663503"}}},"ISBN:9780804764940":{"bib_key":"ISBN:9780804764940","info_url":"http://openlibrary.org/books/OL51659723M/Taoism","preview":"noview","preview_url":"http://openlibrary.org/books/OL51659723M/Taoism","details":{"type":{"key":"/type/edition"},"isbn_13":["9780804764940"],"identifiers":{"open_alex":["W4205897607"]},"publish_date":"1997","title":"Taoism","authors":[{"key":"/authors/OL303298A","name":"Isabelle Robinet"}],"isbn_10":["0804764948"],"source_records":["openalex:W4205897607"],"full_title":"Taoism","works":[{"key":"/works/OL2299936W"}],"key":"/books/OL51659723M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-04-24T20:14:27.751847"},"last_modified":{"type":"/type/datetime","value":"2024-04-24T20:14:27.751847"}}},"ISBN:9780804728386":{"bib_key":"ISBN:9780804728386","info_url":"http://openlibrary.org/books/OL7929002M/Taoism","preview":"noview","preview_url":"http://openlibrary.org/books/OL7929002M/Taoism","thumbnail_url":"https://covers.openlibrary.org/b/id/1518059-S.jpg","details":{"publishers":["Stanford University Press"],"identifiers":{"goodreads":["4812685"],"librarything":["485343"]},"subtitle":"Growth of a Religion","weight":"1.2 pounds","isbn_10":["0804728380"],"covers":[15180