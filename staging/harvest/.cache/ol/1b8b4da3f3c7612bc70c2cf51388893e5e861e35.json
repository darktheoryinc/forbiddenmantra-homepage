{"ISBN:9781845116255":{"bib_key":"ISBN:9781845116255","info_url":"http://openlibrary.org/books/OL11911404M/Jainism","preview":"noview","preview_url":"http://openlibrary.org/books/OL11911404M/Jainism","thumbnail_url":"https://covers.openlibrary.org/b/id/14598366-S.jpg","details":{"publishers":["I. B. Tauris"],"subtitle":"An Introduction","isbn_10":["1845116259"],"physical_format":"Hardcover","lc_classifications":["BL1351.3 .L66 2009"],"key":"/books/OL11911404M","authors":[{"key":"/authors/OL3149285A","name":"Jeffery D. Long"}],"subjects":["History","Jainism","Religion / Jainism","Religion","Religion - World Religions"],"isbn_13":["9781845116255"],"source_records":["marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:69787306:4003","marc:marc_loc_2016/BooksAll.2016.part37.utf8:180834008:1145","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:69821717:4003","marc:marc_columbia/Columbia-extract-20221130-015.mrc:115052793:1269","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:62599684:902","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:30027532:2066","marc:harvard_bibliographic_metadata/20220215_042.bib.mrc:199634154:2876"],"title":"Jainism","lccn":["2010277148"],"number_of_pages":272,"languages":[{"key":"/languages/eng"}],"local_id":["urn:cst:10017026756"],"publish_date":"January 6, 2009","works":[{"key":"/works/OL9030183W"}],"type":{"key":"/type/edition"},"oclc_numbers":["276331912","608555139"],"covers":[14598366],"identifiers":{"doi":["10.5040/9780755624966"]},"description":{"type":"/type/text","value":"\"Jainism evokes images of monks wearing face-masks to protect insects and mico-organisms from being inhaled. Or of Jains sweeping the ground in front of them to ensure that living creatures are not inadvertently crushed: a practice of non-violence so radical as to defy easy comprehension. Yet for all its apparent exoticism, Jainism is still little understood in the West ... Plunging back more than two and a half millennia, to the plains of northern India and the life of a prince who - much like the Buddha - gave up a life of luxury to pursue enlightenment, Long traces the history of the Jain community from founding sage Mahavira to the present day. He explores asceticism, worship, the life of the Jain layperson, relations between Jainism and other Indic traditions, the Jain philosophy of relativity, and the implications of Jain ideals for the contemporary world.\"--Provided by publisher."},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-30T20:50:18.033121"},"last_modified":{"type":"/type/datetime","value":"2026-07-11T22:16:54.971722"}}},"ISBN:9780906180020":{"bib_key":"ISBN:9780906180020","info_url":"http://openlibrary.org/books/OL15609554M/No_destination.","preview":"noview","preview_url":"http://openlibrary.org/books/OL15609554M/No_destination.","details":{"title":"No destination.","authors":[{"key":"/authors/OL2742703A","name":"Satish Kumar"}],"publish_date":"1978","publishers":["Black Pig Press"],"pagination":"158p.","languages":[{"key":"/languages/eng"}],"isbn_10":["0906180023"],"publish_country":"wlk","publish_places":["Pant Mawr"],"type":{"key":"/type/edition"},"oclc_numbers":["40128126"],"source_records":["marc:talis_openlibrary_contribution/talis-openlibrary-contribution.mrc:988079317:401"],"key":"/books/OL15609554M","number_of_pages":158,"works":[{"key":"/works/OL8241645W"}],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2008-09-20T17:45:06.505676"},"last_modified":{"type":"/type/datetime","value":"2025-12-03T10:24:22.603594"}}},"ISBN:9781870098465":{"bib_key":"ISBN:9781870098465","info_url":"http://openlibrary.org/books/OL9494988M/No_Destination","preview":"restricted","preview_url":"https://archive.org/details/nodestinationaut0000sati","thumbnail_url":"https://covers.openlibrary.org/b/id/2071949-S.jpg","details":{"publishers":["Green Books"],"number_of_pages":288,"subtitle":"An Autobiography","weight":"14.4 ounces","