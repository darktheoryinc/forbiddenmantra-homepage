, Seyyed Hossein Nasr seeks to \"open a spiritual and intellectual space for mutual understanding.\" Exploring Islamic values in scripture, traditional sources, and history, he also shows their clear counterparts in the Jewish and Christian traditions, revealing the common ground of the Abrahamic faiths.\".\n\n\"The Heart of Islam is a landmark presentation of enduring value that offers hope to humanity, and a compelling portrait of the beauty and appeal of the faith of 1.2 billion people.\"--BOOK JACKET."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2023-11-15T13:40:12.367944"}}},"ISBN:9780060516659":{"bib_key":"ISBN:9780060516659","info_url":"http://openlibrary.org/books/OL24256653M/The_Heart_of_Islam","preview":"noview","preview_url":"http://openlibrary.org/books/OL24256653M/The_Heart_of_Islam","thumbnail_url":"https://covers.openlibrary.org/b/id/6404402-S.jpg","details":{"publishers":["HarperCollins"],"covers":[6404402],"physical_format":"Electronic resource","key":"/books/OL24256653M","authors":[{"key":"/authors/OL4379441A","name":"Seyyed Hossein Nasr"}],"publish_places":["New York"],"isbn_13":["9780060516659","9780061746604","9780060771126"],"source_records":["marc_overdrive/InternetArchiveCrMarc-2010-06-11g.mrc:6343101:1938","bwb:9780061746604","bwb:9780060516659","marc:marc_columbia/Columbia-extract-20221130-025.mrc:11445747:1718"],"title":"The Heart of Islam","identifiers":{"overdrive":["5C3F1C4B-26E9-4763-9BA6-5B0E05793BE9"]},"languages":[{"key":"/languages/eng"}],"publish_date":"2002","publish_country":"nyu","works":[{"key":"/works/OL582354W"}],"type":{"key":"/type/edition"},"lc_classifications":["BP170.8.N37 2002","BP170.8 .N37 2002eb"],"oclc_numbers":["52697968"],"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2010-06-17T17:12:34.037949"},"last_modified":{"type":"/type/datetime","value":"2025-03-28T16:56:59.94629