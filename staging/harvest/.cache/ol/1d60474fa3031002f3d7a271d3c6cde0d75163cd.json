[327411],"lc_classifications":["BL1283.84 U73 2003","2002073270","BL 1283.84 .U73 2003","BL1283.84 .U73 2003"],"url":["http://www.loc.gov/catdir/bios/ucal052/2002073270.html","http://www.loc.gov/catdir/description/ucal042/2002073270.html","http://www.loc.gov/catdir/toc/fy042/2002073270.html"],"key":"/books/OL3570135M","authors":[{"key":"/authors/OL1479861A","name":"Hugh B. Urban"}],"publish_places":["Berkeley"],"uri_descriptions":["Contributor biographical information","Publisher description","Table of contents"],"pagination":"xvi, 372 p. :","source_records":["bwb:9780520236561","bwb:9780520230620","marc:marc_loc_2016/BooksAll.2016.part29.utf8:209527684:1050","marc:marc_scms/20220805_ADAM_MARC_records.mrc:38692830:1634","marc:marc_columbia/Columbia-extract-20221130-009.mrc:192365594:1958","amazon:0520230620","promise:bwb_daily_pallets_2023-09-06:O9-AWU-711","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:215930037:2915"],"title":"Tantra","dewey_decimal_class":["294.5/514"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 337-366) and index."},"identifiers":{"librarything":["687556"],"goodreads":["4609874","1849854"]},"languages":[{"key":"/languages/eng"}],"lccn":["2002073270"],"subjects":["Tantrism.","Tantric Buddhism."],"publish_date":"2003","publish_country":"cau","by_statement":"Hugh B. Urban.","works":[{"key":"/works/OL5962859W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/bios/ucal052/2002073270.html","http://www.loc.gov/catdir/description/ucal042/2002073270.html","http://www.loc.gov/catdir/toc/fy042/2002073270.html"],"local_id":["urn:scms:0188600267705","urn:bwbsku:O9-AWU-711"],"oclc_numbers":["50693530"],"description":{"type":"/type/text","value":"\"A complex body of religious practices that spread throughout the Hindu, Buddhist, and Jain traditions a form of spirituality that seemingly combines sexuality, sensual pleasure, and the full range of physical experience with the religious life--Tantra has held a central yet conflicted role within the Western imagination ever since the first 'discovery' of Indian religions by European scholars. Always radical, always extremely Other, Tantra has proven a key factor in the imagining of India. This book offers a critical account of how the phenomenon has come to be. Tracing the complex genealogy of Tantra as a category within the history of religions, Hugh B. Urban reveals how it has been formed through the interplay of popular and scholarly imaginations. Tantra emerges as a product of mirroring and misrepresentation at work between East and West--a dialectical category born out of the ongoing play between Western and Indian minds. Combining historical detail, textual analysis, popular cultural phenomena, and critical theory, this book shows Tantra as a shifting amalgam of fantasies, fears, and wish-fulfillment, at once native and Other, that strikes at the very heart of our constructions of the exotic Orient and the contemporary West\"--Publisher's description."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-09-13T17:11:48.343035"}}},"ISBN:9780520230620":{"bib_key":"ISBN:9780520230620","info_url":"http://openlibrary.org/books/OL3570135M/Tantra","preview":"noview","preview_url":"http://openlibrary.org/books/OL3570135M/Tantra","thumbnail_url":"https://covers.openlibrary.org/b/id/327411-S.jpg","details":{"publishers":["University of California Press"],"number_of_pages":372,"subtitle":"sex, secrecy politics, and power in the study of religions","isbn_10":["0520230620","0520236564"],"covers":[327411],"lc_classifications":["BL1283.84 U73 2003","2002073270","BL 1283.84 .U73 2003","BL1283.84 .U73 2003"],"url":["http://www.loc.gov/catdir/bios/ucal052/2002073270.html","http://www.loc.gov/catdir/description/ucal042/2002073270.html","http://www.loc.gov/catdir/toc/fy042/2002073270.html"],"key":"/books/OL3570