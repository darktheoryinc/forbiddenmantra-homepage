itle":"Judas' place in the 'handing over' of the Son","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Judas' repentance and death","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Judas and Christ's descent into hell","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"A Christology facing the tension between providence and tragedy.","pagenum":"","type":{"key":"/type/toc_item"}}],"isbn_10":["075465284X"],"covers":[1411640],"lc_classifications":["BS2460.J8 C28 2004","BS2460.J8C28 2004","BS2460.J8 C28 2005","BS2460.J8 C36 2017"],"url":["http://www.loc.gov/catdir/toc/ecip0512/2005011002.html"],"key":"/books/OL3397859M","authors":[{"key":"/authors/OL1426312A","name":"Anthony Cane"}],"publish_places":["Aldershot, Hants, England","Burlington, Vt"],"subjects":["Judas Iscariot."],"uri_descriptions":["Table of contents"],"pagination":"p. cm.","source_records":["marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:44838469:2939","bwb:9780754652847","marc:marc_loc_2016/BooksAll.2016.part32.utf8:129985496:1129","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:44855299:2939","marc:marc_columbia/Columbia-extract-20221130-030.mrc:158203608:3122","marc:marc_columbia/Columbia-extract-20221130-012.mrc:35378470:1472","amazon:075465284X","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:883330662:1146","promise:bwb_daily_pallets_2024-11-19:S0-BYM-053","marc:harvard_bibliographic_metadata/20220215_042.bib.mrc:171686390:2414"],"title":"The place of Judas Iscariot in Christology","dewey_decimal_class":["226/.092"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"identifiers":{"librarything":["6513576"],"goodreads":["5154001"]},"languages":[{"key":"/languages/eng"}],"lccn":["2005011002"],"local_id":["urn:cst:10017005691","urn:bwbsku:S0-BYM-053"],"publish_date":"2004","publish_country":"enk","by_statement":"Anthony Cane.","works":[{"key":"/works/OL5821042W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/toc/ecip0512/2005011002.html"],"oclc_numbers":["993638495","60341280"],"number_of_pages":220,"description":{"type":"/type/text","value":"\"Exploring the significance of Judas Iscariot for Christian theology and the difficult issues surrounding Judas, Anthony Cane shows that focusing on the tension between providential and tragic interpretations of Judas in the New Testament and in subsequent writing about Judas, is the key to understanding his significance. Building on the work of Karl Barth and Donald MacKinnon, Cane's argument sheds light not simply on the way Judas is understood, but on the way Jesus and the whole economy of salvation are understood. This book also highlights implications for the way in which issues relating to anti-Semitism and evil and suffering are most effectively explored.\"--BOOK JACKET."},"latest_revision":17,"revision":17,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-07-10T22:28:52.150060"}}},"ISBN:9783525569108":{"bib_key":"ISBN:9783525569108","info_url":"http://openlibrary.org/books/OL26098150M/Accepted_And_Renewed_In_Christ_The_Twofold_Grace_Of_God_And_The_Interpretation_Of_Calvins_Theology","preview":"noview","preview_url":"http://openlibrary.org/books/OL26098150M/Accepted_And_Renewed_In_Christ_The_Twofold_Grace_Of_God_And_The_Interpretation_Of_Calvins_Theology","thumbnail_url":"https://covers.openlibrary.org/b/id/7721400-S.jpg","details":{"publishers":["Vandehoeck & Ruprecht","Vandenhoeck & Ruprecht","Vandenhoeck and Ruprecht"],"source_records":["marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:61425273:4978","bwb:9783525569108","marc:marc_loc_2016/BooksAll.2016.part37.utf8:25732960:2026","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:61452630:4978","amazon:3525569106","marc:harvard_bibliographic_metadata/ab.bib.11.20150123.full.mrc:735090700:1