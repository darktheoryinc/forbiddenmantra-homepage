.2016.part11.utf8:95690787:758","marc:marc_columbia/Columbia-extract-20221130-001.mrc:16077745:1213","marc:marc_columbia/Columbia-extract-20221130-009.mrc:431295766:1039"],"lccn":["78303495"],"translation_of":"Les gnostiques","languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["273/.1"],"subjects":["Gnosticism"],"publish_country":"enk","by_statement":"Jacques Lacarrière ; foreword by Lawrence Durrell ; translated from the French by Nina Rootes.","oclc_numbers":["3915035"],"type":{"key":"/type/edition"},"key":"/books/OL4277734M","number_of_pages":136,"works":[{"key":"/works/OL2163954W"}],"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-09-03T08:53:36.250640"}}},"ISBN:9780567030504":{"bib_key":"ISBN:9780567030504","info_url":"http://openlibrary.org/books/OL3426662M/Women_and_marriage_in_Paul_and_his_early_interpreters","preview":"noview","preview_url":"http://openlibrary.org/books/OL3426662M/Women_and_marriage_in_Paul_and_his_early_interpreters","thumbnail_url":"https://covers.openlibrary.org/b/id/375939-S.jpg","details":{"publishers":["T & T Clark International"],"isbn_10":["0567030504"],"series":["Journal for the study of the New Testament.","296"],"covers":[375939],"local_id":["urn:cst:10017005762","urn:bwbsku:P9-CNQ-003"],"lc_classifications":["BS2655.W5 B43 2005","BS2655.W5B43 2005"],"key":"/books/OL3426662M","authors":[{"key":"/authors/OL1435324A","name":"Gillian Beattie"}],"publish_places":["New York"],"pagination":"p. cm.","source_records":["marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:45409260:6629","marc:marc_loc_2016/BooksAll.2016.part32.utf8:173402733:1173","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:45426229:6629","bwb:9780567030504","amazon:0567030504","marc:marc_columbia/Columbia-extract-20221130-012.mrc:45602455:1786","promise:bwb_daily_pallets_2024-02-20:P9-CNQ-003","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:816451899:3678","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:40640860:3592"],"title":"Women and marriage in Paul and his early interpreters","dewey_decimal_class":["227/.083054"],"notes":{"type":"/type/text","value":"Includes bibliographical references."},"identifiers":{"goodreads":["1882341"],"librarything":["2010506"],"doi":["10.5040/9781474214001"]},"languages":[{"key":"/languages/eng"}],"lccn":["2005050555"],"subjects":["Bible. N.T. Epistles of Paul -- Theology.","Nag Hammadi codices.","Women -- Biblical teaching.","Marriage -- Biblical teaching.","Women -- Religious aspects -- Gnosticism -- History of doctrines.","Marriage -- Religious aspects -- Gnosticism -- History of doctrines."],"publish_date":"2005","publish_country":"nyu","by_statement":"Gillian Beattie.","works":[{"key":"/works/OL5848758W"}],"type":{"key":"/type/edition"},"oclc_numbers":["60590201","741690058"],"number_of_pages":181,"description":{"type":"/type/text","value":"\"Beattie undertakes a comparative survey of the treatment of women and marriage in three different kinds of text: an authentic Pauline letter (namely 1 Corinthians); the deutero-Pauline literature (Colossians, Ephesians and the Pastoral Epistles); and some tractates from the Nag Hammadi library (giving particular attention to the Gospel of Philip, the Exegesis on the Soul, the Hypostasis of the Archons and the Gospel of Thomas). The theoretical position she takes is based upon the neo-pragmatist thought of Richard Rorty and Stanley Fish, the former's notions of 'contingency' and 'redescription' being of particular importance. The aim of this book is twofold: to draw attention to the contingency (that is to say, the situatedness and vested interests) attendant on all acts of interpretation; and to engage in a redescription of the category of 'gnosticism' to which the Nag Hammadi texts have traditionally been assigned, and thus also of the canonical texts as seen in relation to them. It is not the intention to suggest in a simplistic fashion that the Nag Hammadi texts should somehow displace the canonical documents as the 'correct' reading of Paul, but rather to show that texts can be read in ways as diverse and numerous as the goals of their interpreters. JSNTS 296\"--Bloomsbury Publishing."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-04-30T13:01:28.874729"}}},"ISBN:9781441175335":{"bib_key":"ISBN:9781441175335","info_url":"http://openlibrary.org/books/OL48646995M/Women_and_Marriage_in_Paul_and_His_Early_Interpreters","preview":"noview","preview_url":"http://openlibrary.org/books/OL48646995M/Women_and_Marriage_in_Paul_and_His_Early_Interpreters","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL1435324A","name":"Gillian Beattie"}],"isbn_13":["9781441175335"],"languages":[{"key":"/languages/eng"}],"pagination":"194","publish_date":"2005","publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781441175335"],"subjects":["Bible, commentaries, n. t. epistles of paul","Marriage, biblical teaching","Women, religious aspects","Marriage, religious aspects","Bible, theology, n. t."],"title":"Women and Marriage in Paul and His Early Interpreters","full_title":"Women and Marriage in Paul and His Early Interpreters","works":[{"key":"/works/OL5848758W"}],"key":"/books/OL48646995M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-07-17T06:40:58.277754"},"last_modified":{"type":"/type/datetime","value":"2023-07-17T06:40:58.277754"}}},"ISBN:9781283206563":{"bib_key":"ISBN:9781283206563","info_url":"http://openlibrary.org/books/OL48650987M/Women_and_Marriage_in_Paul_and_His_Early_Interpreters","preview":"noview","preview_url":"http://openlibrary.org/books/OL48650987M/Women_and_Marriage_in_Paul_and_His_Early_Interpreters","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL14