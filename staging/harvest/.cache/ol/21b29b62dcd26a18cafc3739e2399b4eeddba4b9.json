oks/OL34026317M/Creating_a_Buddhist_Community","preview":"noview","preview_url":"http://openlibrary.org/books/OL34026317M/Creating_a_Buddhist_Community","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2880927A","name":"Jiemin Bao"}],"isbn_13":["9781439909560"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BQ6377"],"number_of_pages":204,"publish_date":"2015","publishers":["Temple University Press"],"source_records":["bwb:9781439909560"],"subjects":["Buddhism, united states"],"title":"Creating a Buddhist Community","subtitle":"A Thai Temple in Silicon Valley","full_title":"Creating a Buddhist Community A Thai Temple in Silicon Valley","works":[{"key":"/works/OL21562349W"}],"key":"/books/OL34026317M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-09-29T17:18:35.099005"},"last_modified":{"type":"/type/datetime","value":"2021-09-29T17:18:35.099005"}}},"ISBN:9781439909546":{"bib_key":"ISBN:9781439909546","info_url":"http://openlibrary.org/books/OL29257265M/Creating_a_Buddhist_Community","preview":"noview","preview_url":"http://openlibrary.org/books/OL29257265M/Creating_a_Buddhist_Community","details":{"publishers":["Temple University Press"],"subtitle":"A Thai Temple in Silicon Valley","last_modified":{"type":"/type/datetime","value":"2020-08-23T22:58:02.698497"},"source_records":["bwb:9781439909546"],"title":"Creating a Buddhist Community","number_of_pages":204,"isbn_13":["9781439909546"],"created":{"type":"/type/datetime","value":"2020-08-23T22:58:02.698497"},"languages":[{"key":"/languages/eng"}],"full_title":"Creating a Buddhist Community A Thai Temple in Silicon Valley","lc_classifications":["BQ6377.S382W383 2015"],"publish_date":"2015","key":"/books/OL29257265M","authors":[{"key":"/authors/OL2880927A","name":"Jiemin Bao"}],"latest_revision":1,"works":[{"key":"/works/OL21562349W"}],"type":{"key":"/type/edition"},"subjects":["Buddhism, united states"],"revision":1}},"ISBN:9781439909553":{"bib_key":"ISBN:9781439909553","info_url":"http://openlibrary.org/books/OL29257250M/Creating_a_Buddhist_Community","preview":"noview","preview_url":"http://openlibrary.org/books/OL29257250M/Creating_a_Buddhist_Community","details":{"publishers":["Temple University Press"],"languages":[{"key":"/languages/eng"}],"subtitle":"A Thai Temple in Silicon Valley","source_records":["bwb:9781439909553","marc:marc_loc_2016/BooksAll.2016.part41.utf8:201114717:2403","marc:harvard_bibliographic_metadata/20220215_016.bib.mrc:64383684:3704","promise:bwb_daily_pallets_2024-12-31:Y0-BSD-168"],"title":"Creating a Buddhist Community","lccn":["2014040345"],"number_of_pages":204,"isbn_13":["9781439909553"],"lc_classifications":["BQ6377.S382W383 2015","BQ6377.S382 W383 2015"],"publish_date":"2015","key":"/books/OL29257250M","authors":[{"key":"/authors/OL2880927A","name":"Jiemin Bao"}],"works":[{"key":"/works/OL21562349W"}],"type":{"key":"/type/edition"},"subjects":["Buddhism, united states"],"oclc_numbers":["893896028"],"description":{"type":"/type/text","value":"\"The Wat Thai Buddhist Temple in Silicon Valley was founded in 1983 by a group of predominantly middle-class men and women with different ethnic and racial identities. The temple, which functions as a religious, social, economic, educational, and cultural hub, has become a place for the community members to engage in spiritual and cultural practices. In Creating a Buddhist Community, Jiemin Bao shows how the Wat Thai participants practice Buddhism and rework gender relationships in the course of organizing temple space, teaching meditation, schooling children in Thai language and culture, merit making, fundraising, and celebrating festivals. Bao's detailed account of the process of creating an inclusive temple community with Thai immigrants as the majority helps to deconstruct the exoticized view of Buddhism in American culture. Creating a Buddhist Community also explores Wat Thai's identification with both the United States and Thailand and how this transnational perspective reimagines and reterritorializes what is called American Buddhism.\"--"},"local_id":["urn:bwbsku:Y0-BSD-168"],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-08-23T22:57:47.798765"},"last_modified":{"type":"/type/datetime","value":"2025-10-01T02:18:23.040825"}}},"ISBN:9780861713110":{"bib_key":"ISBN:9780861713110","info_url":"http://openlibrary.org/books/OL3951827M/In_this_very_life","preview":"noview","preview_url":"http://openlibrary.org/books/OL3951827M/In_this_very_life","thumbnail_url":"https://covers.openlibrary.org/b/id/652670-S.jpg","details":{"publishers":["Wisdom"],"number_of_pages":303,"subtitle":"the liberation teachings of the Buddha","isbn_10":["0861713117"],"covers":[652670],"lc_classifications":["BQ5395 .P355 2001","BQ5395 .S29 2001","BQ5395.P355 2001b"],"key":"/books/OL3951827M","authors":[{"key":"/authors/OL839322A","name":"Pandita Bivamsa Ūʺ"}],"publish_places":["Boston"],"contributions":["Aggacitta, Ū.","Wheeler, Kate, 1955-"],"pagination":"xv, 303 p. ;","classifications":{},"source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:351090172:2200","marc:marc_loc_2016/BooksAll.2016.part28.utf8:223815359:975","bwb:9780861713110"],"title":"In this very life","dewey_decimal_class":["294.3/444"],"notes":"Includes index.","identifiers":{"goodreads":["750063"],"librarything":["1407547"]},"languages":[{"key":"/languages/eng"}],"lccn":["2001046878"],"local_id":["urn:sfpl:31223100662254"],"publish_date":"2001","publish_country":"mau","by_statement":"Sayadaw U Pandita ; translated by Venrable U Aggacitta ; edited by Kate Wheeler ; foreword by Joseph Goldstein.","works":[{"key":"/works/OL4314845W"}],"type":{"key":"/type/edition"},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2021-10-04T03:47:23.703027"}}}}