],"contributions":["Pollock, Sheldon I"],"subjects":["Epic poetry, Sanskrit -- Translations into English"],"genres":["Translations into English"],"source_records":["marc:marc_miami_univ_ohio/allbibs0192.out:2523863:1394","marc:marc_loc_updates/v36.i03.records.utf8:6095533:1393","marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:49817142:3477","marc:marc_loc_2016/BooksAll.2016.part33.utf8:97616111:1393","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:49836099:3477","bwb:9780814767221","promise:bwb_daily_pallets_2022-09-14","ia:rmyaabookthreefo0000vlmk","marc:harvard_bibliographic_metadata/ab.bib.10.20150123.full.mrc:519644462:1442","marc:harvard_bibliographic_metadata/20220215_001.bib.mrc:101978709:3139"],"title":"Rāmāyaṇa.","work_titles":["Rāmāyaṇa. Āraṇyakāṇḍa."],"notes":{"type":"/type/text","value":"Epic poetry\n\nIncludes bibliographical references and index\n\nIn English and Sanskrit (romanized) on facing pages; translated from Sanskrit"},"identifiers":{"librarything":["5365576"],"goodreads":["359934"]},"languages":[{"key":"/languages/eng"},{"key":"/languages/san"}],"lccn":["2006005694"],"local_id":["urn:cst:10017038623","urn:bwbsku:O8-CVC-192"],"publish_date":"2006","publish_country":"nyu","by_statement":"by Vālmī́ki ; translated by Sheldon I. Pollock","works":[{"key":"/works/OL10361597W"}],"type":{"key":"/type/edition"},"covers":[13146880],"ocaid":"rmyaabookthreefo0000vlmk","oclc_numbers":["64098556"],"description":{"type":"/type/text","value":"\"The skies darken for the exiles, who have taken figure in forest hermitages. First one demon, then another, attempts to harm or corrupt them. When these efforts fail, an army of demons is sent, and then a bigger one, but each time Rama defeats them. Finally Ravana, the supreme lord of the demons, decides to cripple Rama by capturing Sita; he traps her, and carriers her off under heavy guard to the island fortress of Lanka. Rama is distraught with grief, and searches everywhere, without success.\" \"'The Forest' contains the narrative center of the epic, the abduction of Sita by the demon king Ravana. It provides a profound meditation on the paradox of the hero as both human and divine.\"--BOOK JACKET."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-10-12T00:20:08.840363"},"last_modified":{"type":"/type/datetime","value":"2025-04-15T14:23:48.589214"}}}}