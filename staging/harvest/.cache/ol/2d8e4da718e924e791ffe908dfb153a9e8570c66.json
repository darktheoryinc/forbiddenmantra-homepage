hism -- Doctrines"],"edition_name":"Modern Library pbk. ed","pagination":"xlvi, 181 p. :","source_records":["ia:basicteachingsof00wall","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run03.mrc:239534095:2491","bwb:9780812975239","marc:marc_loc_2016/BooksAll.2016.part33.utf8:139486454:1455","marc:harvard_bibliographic_metadata/ab.bib.11.20150123.full.mrc:84805506:1897","marc:harvard_bibliographic_metadata/20220215_031.bib.mrc:174874539:3148"],"title":"Basic teachings of the Buddha","lccn":["2006038051"],"notes":{"type":"/type/text","value":"Includes translated selections from the Tipiṭaka\n\nIncludes bibliographical references and index"},"identifiers":{"librarything":["4443453"],"goodreads":["398167"]},"isbn_13":["9780812975239"],"languages":[{"key":"/languages/eng"}],"isbn_10":["0812975235"],"publish_date":"2007","publish_country":"nyu","by_statement":"Glenn Wallis","oclc_numbers":["76183810"],"works":[{"key":"/works/OL6214511W"}],"type":{"key":"/type/edition"},"description":{"type":"/type/text","value":"\"In Basic Teachings of the Buddha, Glenn Wallis selects sixteen essential dialogues drawn from more than five thousand Pali-dialect suttas of the Buddhist canon. The result is a vibrant introductory guide to studying Buddhist thought, applying its principles to everyday life, and gaining a deeper understanding of Buddhist themes in modern literature. Focusing on the most crucial topics for today's readers, Wallis presents writings that address modern psychological, religious, ethical, and philosophical concerns. This volume provides an overview of the history of Buddhism and an illuminating analysis of the core writings that personalizes the suttas for each reader.\"--BOOK JACKET."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-09-28T02:25:53.266166"},"last_modified":{"type":"/type/datetime","value":"2026-02-18T07:51:03.711798"}}}}