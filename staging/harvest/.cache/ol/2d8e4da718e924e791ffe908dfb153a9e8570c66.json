":[{"key":"/authors/OL1430571A","name":"Sachiko Kaneki Morrell"}],"publish_places":["Albany"],"contributions":["Morrell, Robert E."],"uri_descriptions":["Table of contents"],"pagination":"p. cm.","title":"Zen sanctuary of purple robes","lccn":["2005027280"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"identifiers":{"goodreads":["3262732","2271449"],"librarything":["4085310"]},"languages":[{"key":"/languages/eng"}],"url":["http://www.loc.gov/catdir/toc/ecip0519/2005027280.html"],"subjects":["Tōkeiji (Kamakura-shi, Japan) -- History.","Women's shelters -- Japan -- History.","Divorce -- Japan -- History."],"publish_date":"2006","publish_country":"nyu","by_statement":"Sachiko Kaneki Morrell, Robert E. Morrell.","works":[{"key":"/works/OL5835290W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/toc/ecip0519/2005027280.html"],"source_records":["marc:marc_loc_2016/BooksAll.2016.part32.utf8:150126168:1118","bwb:9780791468289","bwb:9780791468272","marc:marc_columbia/Columbia-extract-20221130-012.mrc:157134007:2104","promise:bwb_daily_pallets_2024-07-23:W9-AJK-039","marc:harvard_bibliographic_metadata/ab.bib.10.20150123.full.mrc:62023306:1134","marc:harvard_bibliographic_metadata/20220215_040.bib.mrc:312983473:3144"],"oclc_numbers":["61684184"],"local_id":["urn:bwbsku:W9-AJK-039"],"number_of_pages":246,"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-05-27T22:06:59.224241"}}},"ISBN:9780691114460":{"bib_key":"ISBN:9780691114460","info_url":"http://openlibrary.org/books/OL3303936M/Dance_of_Divine_Love","preview":"noview","preview_url":"http://openlibrary.org/books/OL3303936M/Dance_of_Divine_Love","thumbnail_url":"https://covers.openlibrary.org/b/id/443236-S.jpg","details":{"publishers":["Princeton University Press"],"subtitle":"The Rasa Lila of Krishna from the Bhagavata Purana, India's classic sacred love story","isbn_10":["0691114463"],"covers":[443236],"lc_classifications":["BL1140.4.B436 P87 2005","BL1140.4.B436P87"],"key":"/books/OL3303936M","publish_places":["Princeton, NJ"],"contributions":["Schweig, Graham M., 1953-"],"pagination":"p. cm.","source_records":["marc:marc_records_scriblio_net/part15.dat:24768601:1006","marc:marc_university_of_toronto/uoft.marc:4846098871:689","bwb:9780691114460","marc:marc_loc_2016/BooksAll.2016.part31.utf8:177762394:1509","marc:marc_columbia/Columbia-extract-20221130-011.mrc:113037198:3127","amazon:0691114463","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:590545569:1131","marc:harvard_bibliographic_metadata/20220215_029.bib.mrc:86374462:5434"],"title":"Dance of Divine Love","dewey_decimal_class":["294.5/925"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"identifiers":{"librarything":["211680"],"goodreads":["238287"]},"languages":[{"key":"/languages/eng"},{"key":"/languages/san"}],"lccn":["2004045788"],"subjects":["Puranas. Bhāgavatapurāṇa -- Criticism, interpretation, etc.","Rādhā (Hindu deity)","Krishna (Hindu deity)","Rāsa līlā (Dance)"],"publish_date":"2005","publish_country":"nju","by_statement":"introduced, translated and illuminated [by] Graham M. Schweig.","work_title":["Puranas. Bhāgavatapurāṇa. Selections."],"works":[{"key":"/works/OL19170827W"}],"type":{"key":"/type/edition"},"oclc_numbers":["54852893"],"number_of_pages":424,"description":{"type":"/type/text","value":"\"The heart of this book is a dramatic love poem, the Rasa Lila, which is the ultimate focal point of one of the most treasured Sanskrit texts of India, the Bhagavata Purana. Judged a literary masterpiece by Indian and Western scholars alike, this work of poetic genius and religious vision is one of the world's greatest sacred love stories and, as Graham Schweig demonstrates, should be regarded as India's Song of Songs. The story presents the supreme deity as the youthful and amorous cowherd, Krishna, who joins his beloved maidens in an enchanting and celebratory \"dance of divine love.\"\" \"Schweig introduces this work of poetry and theology to the Western world in the form of a translation and scholarly treatment. His book explores the historical context and literary genre of the work and elucidates the aesthetic and emotional richness of the composition, highlighting poignant details of this drama of divine love. Schweig illuminates the religious dimensions and ethical nuances of the drama, drawing widely from the commentaries and esoteric vision of masters of the Caitanya school of Vaishnavism, a prominent devotional Hindu tradition.\" \"Themes such as transcendence of death through love, the yoga of devotion, the contrast between worldly love and passionate love for God, and the dialectical tension between ethical boundaries and boundless love are presented. The final event of the Rasa dance, the author concludes, presents a dynamic symbol of supreme love that provides the basis for theological vision of genuine religious pluralism.\"--BOOK JACKET."},"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-01-30T11:36:57.739664"}}},"ISBN:9788120831407":{"bib_key":"ISBN:9788120831407","info_url":"http://openlibrary.org/books/OL44961402M/Dance_of_Divine_Love","preview":"noview","preview_url":"http://openlibrary.org/books/OL44961402M/Dance_of_Divine_Love","details":{"type":{"key":"/type/edition"},"publish_date":"2007","copyright_date":"2007","publish_country":"ii","languages":[{"key":"/languages/eng"}],"oclc_numbers":["235927505"],"lc_classifications":["BL1140.4.B436 P87 2007"],"work_titles":["Puranas. Bhāgavatapurāṇa. Selections"],"edition_name":"1st Indian ed.","notes":{"type":"/type/text","value":"Includes bibliographical references (p. [355]-365) and index."},"authors":[{"key":"/authors/OL7062503A","name":"Graham M. Schweig"}],"sub