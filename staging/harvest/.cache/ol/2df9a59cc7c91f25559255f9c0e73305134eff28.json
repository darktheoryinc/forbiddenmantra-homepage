rs":{"goodreads":["1328129"],"librarything":["22549"]},"lccn":["97037659"],"isbn_10":["0385490372"],"publish_date":"1998","work_title":["Book of Margery Kempe."],"works":[{"key":"/works/OL461742W"}],"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-10-27T19:26:07.425069"}}},"ISBN:9780393976397":{"bib_key":"ISBN:9780393976397","info_url":"http://openlibrary.org/books/OL6791650M/The_book_of_Margery_Kempe","preview":"noview","preview_url":"http://openlibrary.org/books/OL6791650M/The_book_of_Margery_Kempe","thumbnail_url":"https://covers.openlibrary.org/b/id/253034-S.jpg","details":{"publishers":["Norton"],"number_of_pages":305,"subtitle":"a new translation, contexts, criticism","isbn_10":["0393976394"],"series":["A Norton critical edition"],"pagination":"xxii, 305 p. :","covers":[253034],"lc_classifications":["PR2007.K4 A199 2001","PR2007.K4A199 2001"],"key":"/books/OL6791650M","authors":[{"key":"/authors/OL26989A","name":"Margery Kempe"}],"publish_places":["New York"],"contributions":["Staley, Lynn, 1947-"],"subject_time":["Middle English, 1100-1500","To 1500."],"languages":[{"key":"/languages/eng"}],"genres":["Biography.","Early works to 1800."],"source_records":["marc:marc_records_scriblio_net/part01.dat:16274394:1284","marc:marc_ithaca_college/ic_marc.mrc:200532207:2173","amazon:0393976394","marc:marc_loc_2016/BooksAll.2016.part01.utf8:37893568:1305","bwb:9780393976397","marc:marc_nuls/NULS_PHC_180925.mrc:85938822:1534","idb:9780393976397","marc:marc_columbia/Columbia-extract-20221130-006.mrc:405454625:3202"],"title":"The book of Margery Kempe","dewey_decimal_class":["248.2/2/092","B"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 303-305)."},"identifiers":{"goodreads":["305200"],"librarything":["22549"]},"edition_name":"1st ed.","lccn":["00055455"],"subjects":["Kempe, Margery, b. ca. 1373","Kempe, Margery, b. ca. 1373","Authors, English -- Middle English, 1100-1500 -- Biography","Christian pilgrims and pilgrimages -- Early works to 1800","Women and literature -- England -- History -- To 1500","Christian women -- Religious life -- England","Mysticism -- England -- Early works to 1800"],"publish_date":"2001","publish_country":"nyu","subject_place":["England","England."],"by_statement":"translated and edited by Lynn Staley.","work_title":["Book of Margery Kempe."],"works":[{"key":"/works/OL461742W"}],"type":{"key":"/type/edition"},"local_id":["urn:nuls:31786101468814"],"oclc_numbers":["44426807"],"description":{"type":"/type/text","value":"\"Margery Kempe's autobiography engages the modern reader with its richly textured images of late-medieval England - its town life, customs, means of travel, dress, food, and, most notably, its observations of the religious rituals that prevailed in the author's lifetime (ca. 1373-ca. 1440). Lynn Staley's new translation does not modernize; rather, it stays as close to the original Middle English as possible without sounding archaic. The text is accompanied by explanatory annotations, a map of medieval England, and a Kempe lexicon.\" \"\"Contexts\" collects primary readings chosen to inform readers about late-medieval religious authority, mysticism, and expressions of worship. Included are excerpts from The Constitutions of Thomas Arundel, Meditations on the Life of Christ, The Shewings of Julian of Norwich, The Book of Saint Bride, and The Life of Marie d'Oignies by Jacques de Vitry.\" \"\"Criticism\" includes nine important interpretations of The Book of Margery Kempe, chosen to engage student readers and stimulate classroom discussion. Clarissa W. Atkinson, Lynn Staley, Karma Lochrie, David Aers, Kathleen Ashley, Gail McMurray Gibson, Sarah Beckwith, Caroline Walker Bynum, and Nicholas Watson provide their varied assessments.\" \"A Selected Bibliography is also included.\"--BOOK JACKET."},"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-07-16T15:58:58.324497"}}},"ISBN:9781879288720":{"bib_key":"ISBN:9781879288720","info_url":"http://openlibrary.org/books/OL22638862M/The_book_of_Margery_Kempe","preview":"noview","preview_url":"http://openlibrary.org/books/OL22638862M/The_book_of_Margery_Kempe","thumbnail_url":"https://covers.openlibrary.org/b/id/3853232-S.jpg","details":{"publishers":["TEAMS, Medieval Institute Publications, Western Michigan University"],"number_of_pages":262,"isbn_10":["1879288729"],"series":["Middle English texts"],"covers":[3853232],"lc_classifications":["PR2007.K4","PR2007.K4 A199 1996","PR2007.K4A199 1996"],"key":"/books/OL22638862M","authors":[{"key":"/authors/OL6216644A","name":"Margery Kempe"}],"publish_places":["Kalamazoo, Mich"],"contributions":["Johnson, Lynn Staley, 1947-","Consortium for the Teaching of the Middle Ages.","Western Michigan University. Medieval Institute."],"pagination":"viii, 262 p. ;","source_records":["marc:marc_loc_2016/BooksAll.2016.part25.utf8:93869425:1389","idb:9781879288720","marc:marc_columbia/Columbia-extract-20221130-005.mrc:218610048:1921","marc:harvard_bibliographic_metadata/20220215_006.bib.mrc:24353361:3637","bwb:9781879288720"],"title":"The book of Margery Kempe","dewey_decimal_class":["248/.2/092"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 10-16)."},"identifiers":{"librarything":["8135685"],"goodreads":["1429407"],"doi":["10.1604/9781879288720"]},"languages":[{"key":"/languages/enm"},{"key":"/languages/eng"}],"lccn":["96027254"],"subjects":["Kempe, Margery.","Authors, English -- Middle English, 1100-1500 -- Biography.","Christian pilgrims and pilgrimages -- Early works to 1800.","Mysticism -- England -- History -- Middle Ages, 600-1500.","Christian women -- Religious life -- England.","Mysticism -- England -- Early works to 1800."],"publish_date":"1996","publish_country":"xxu","by_statement":"edited 