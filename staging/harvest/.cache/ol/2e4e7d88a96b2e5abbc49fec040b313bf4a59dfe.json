n"},"authors":[{"key":"/authors/OL3496386A","name":"Jörg Rüpke"},{"key":"/authors/OL8541553A","name":"Valentino Gasparini"},{"key":"/authors/OL9619049A","name":"Maik Patzelt"},{"key":"/authors/OL7317473A","name":"Rubina Raja"},{"key":"/authors/OL5739063A","name":"Anna-Katharina Rieger"}],"isbn_13":["9783110557572"],"languages":[{"key":"/languages/eng"}],"pagination":"605","publish_date":"2020","publishers":["de Gruyter GmbH, Walter"],"source_records":["bwb:9783110557572"],"subjects":["Religion, history","Religions"],"title":"Lived Religion in the Ancient Mediterranean World","weight":"0.988","subtitle":"Approaching Religious Transformations from Archaeology, History and Classics","full_title":"Lived Religion in the Ancient Mediterranean World Approaching Religious Transformations from Archaeology, History and Classics","works":[{"key":"/works/OL23498732W"}],"key":"/books/OL35823913M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-12-25T22:33:57.852710"},"last_modified":{"type":"/type/datetime","value":"2021-12-25T22:33:57.852710"}}},"ISBN:9783110557947":{"bib_key":"ISBN:9783110557947","info_url":"http://openlibrary.org/books/OL31368972M/Lived_Religion_in_the_Ancient_Mediterranean_World","preview":"noview","preview_url":"http://openlibrary.org/books/OL31368972M/Lived_Religion_in_the_Ancient_Mediterranean_World","details":{"publishers":["De Gruyter"],"description":{"type":"/type/text","value":"The Lived Ancient Religion project has radically changed perspectives on ancient religions and their supposedly personal or public character. This volume applies and further develops these methodological tools, new perspectives and new questions. The religious transformations of the Roman Imperial period appear in new light and more nuances by comparative confrontation and the integration of many disciplines. The contributions are written by specialists from a variety of disciplinary contexts (Jewish Studies, Theology, Classics, Early Christian Studies) dealing with the history of religion of the Mediterranean, West-Asian, and European area from the (late) Hellenistic period to the (early) Middle Ages and shaped by their intensive exchange. From the point of view of their respective fields of research, the contributors engage with discourses on agency, embodiment, appropriation and experience. They present innovative research in four fields also of theoretical debate, which are “Experiencing the Religious”, “Switching the Code”, „A Thing Called Body“ and “Commemorating the Moment”."},"links":[{"url":"https://library.oapen.org/bitstream/id/d5753072-716a-4a42-96f4-598b4efbc3ba/9783110557596.pdf","title":"OAPEN Library: download the publication"},{"url":"http://library.oapen.org/handle/20.500.12657/37602","title":"OAPEN Library: description of the publication"}],"key":"/books/OL31368972M","authors":[{"key":"/authors/OL3496386A","name":"Jörg Rüpke"}],"publish_places":["Berlin/Boston"],"contributions":["Gasparini, Valentino","Patzelt, Maik","Raja, Rubina","Rieger, Anna-Katharina","Urciuoli, Emiliano","Rüpke, Jörg","Gasparini, Valentino","Patzelt, Maik","Raja, Rubina","Rieger, Anna-Katharina","Urciuoli, Emiliano"],"pagination":"1 electronic resource (597 p.)","source_records":["marc:marc_oapen/convert_oapen_20201117.mrc:7171322:2877","bwb:9783110557947"],"title":"Lived Religion in the Ancient Mediterranean World","notes":{"type":"/type/text","value":"Open Access Unrestricted online access\n\nFP7 Ideas: European Research Council\n\nCreative Commons https://creativecommons.org/licenses/by-nc-nd/4.0/\n\nEnglish"},"number_of_pages":597,"isbn_13":["9783110557947"],"subjects":["Regional studies","Ancient religions & mythologies","History of religion"],"publish_date":"2020","works":[{"key":"/works/OL23498732W"}],"type":{"key":"/type/edition"},"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2020-11-16T22:08:27.993042"},"last_modified":{"type":"/type/datetime","value":"2022-01-27T10:06:37.02