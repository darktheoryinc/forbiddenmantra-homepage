{"ISBN:9781624668555":{"bib_key":"ISBN:9781624668555","info_url":"http://openlibrary.org/books/OL29489747M/Zhuangzi","preview":"noview","preview_url":"http://openlibrary.org/books/OL29489747M/Zhuangzi","details":{"publishers":["Hackett Publishing Company, Incorporated"],"subtitle":"the Complete Writings","source_records":["bwb:9781624668555","marc:marc_columbia/Columbia-extract-20221130-031.mrc:321297542:2961","marc:harvard_bibliographic_metadata/20220215_013.bib.mrc:266236246:5815","promise:bwb_daily_pallets_2024-10-29:S0-AFP-894"],"title":"Zhuangzi","number_of_pages":336,"isbn_13":["9781624668555"],"languages":[{"key":"/languages/eng"}],"full_title":"Zhuangzi the Complete Writings","lc_classifications":["","BL1900.C46E5 2020","BL1900.C576 E5 2020"],"publish_date":"2020","key":"/books/OL29489747M","authors":[{"key":"/authors/OL333978A","name":"Zhuangzi"},{"key":"/authors/OL8293444A","name":"Brook Ziporyn"}],"works":[{"key":"/works/OL21678836W"}],"type":{"key":"/type/edition"},"oclc_numbers":["1178778870"],"lccn":["2019952373"],"description":{"type":"/type/text","value":"\"This volume includes a complete translation of the 33 chapters of the Chinese text, Zhuangzi, a substantial portion of which I had previously translated and published in 2009 as the main text of a volume entitled, Zhuangzi: The Essential Writings with Selections from Traditional Commentaries (Hackett, 2009). Ziporyn has had many opportunities to further study and teach the Zhuangzi, reading through and discussing his translation and interpretation of this work of Zhuangzi with a great many very intelligent and attentive students and scholars. In these same ten years since the publication of the abridged Zhuangzi the digital tools available for research into classical Chinese texts, which played little to no role in his translation process previously, have become exponentially more powerful, allowing for instant comparison of huge quantities of texts and contexts that would have taken months and years only a short time ago. The selections from traditional commentaries in the earlier volume have been omitted in this one; the reader is invited to consult them there if interested. Amplified considerably are the explanatory material included in the footnotes, which provide important information to aid the real-time reading of the text, and endnotes have been added where a technical philological matter must be addressed or a more extended conceptual discussion is warranted than could be accommodated on the page without interrupting the reading process\"--"},"local_id":["urn:bwbsku:S0-AFP-894"],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2020-08-26T09:10:43.170990"},"last_modified":{"type":"/type/datetime","value":"2025-10-04T04:05:48.197010"}}},"ISBN:9787101067842":{"bib_key":"ISBN:9787101067842","info_url":"http://openlibrary.org/books/OL45229268M/Zhuangzi","preview":"noview","preview_url":"http://openlibrary.org/books/OL45229268M/Zhuangzi","details":{"notes":{"type":"/type/text","value":"Chinese and French."},"title":"Zhuangzi","authors":[{"key":"/authors/OL333978A","name":"Zhuangzi"}],"publish_date":"2009","type":{"key":"/type/edition"},"publish_country":"cc","languages":[{"key":"/languages/chi"}],"oclc_numbers":["740357799"],"lc_classifications":["BL1900.C46 F7 2009"],"work_titles":["Nanhua jing"],"edition_name":"Di 1 ban","series":["Da Zhonghua wen ku = -- Bibliothèque des classiques Chinois","Bibliothèque des classiques Chinois","Da Zhonghua wen ku"],"contributions":["Sun, Tonghai","Liou, Kia-hway"],"subjects":["Taoist philosophy","Early works to 1800","Taoism"],"by_statement":"Sun Tonghai jin yi ; Liu Jiahuai Fa yi = Zhuangzi / traduit en chinois moderne par Sun Tonghai ; traduit en français par Liou Kia-hway","publishers":["Zhonghua shu ju"],"publish_places":["Beijing"],"isbn_13":["9787101067842"],"isbn_10":["7101067840"],"pagination":"507 p.","source_records":["marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mr