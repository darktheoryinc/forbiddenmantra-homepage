ision":8,"revision":8,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2020-12-11T11:24:10.673641"}}},"ISBN:9780195139020":{"bib_key":"ISBN:9780195139020","info_url":"http://openlibrary.org/books/OL6792944M/The_economics_of_ecstasy","preview":"noview","preview_url":"http://openlibrary.org/books/OL6792944M/The_economics_of_ecstasy","thumbnail_url":"https://covers.openlibrary.org/b/id/125149-S.jpg","details":{"publishers":["Oxford University Press"],"number_of_pages":286,"subtitle":"tantra, secrecy, and power in colonial Bengal","isbn_10":["019513902X"],"subject_place":["India","Bengal."],"covers":[125149],"lc_classifications":["BL1276.84 .U63 2001","BL1276.84.U63 2001"],"key":"/books/OL6792944M","authors":[{"key":"/authors/OL1479861A","name":"Hugh B. Urban"}],"publish_places":["New York"],"pagination":"xvii, 286 p. ;","source_records":["ia:economicsecstasy00urba","ia:economicsecstasy00urba_456","ia:economicsecstasy00urba_577","ia:economicsecstasy00urba_045","marc:marc_loc_2016/BooksAll.2016.part01.utf8:40899938:973","bwb:9780195139020","marc:marc_columbia/Columbia-extract-20221130-007.mrc:199114333:2199","marc:harvard_bibliographic_metadata/20220215_040.bib.mrc:17408246:2062"],"title":"The economics of ecstasy","dewey_decimal_class":["294.5/514"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 269-280) and index."},"identifiers":{"librarything":["1103577"],"goodreads":["1849856"]},"languages":[{"key":"/languages/eng"}],"lccn":["00058911"],"subjects":["Kartābhajā.","Hindu sects -- India -- Bengal.","Tantrism -- India -- Bengal."],"publish_date":"2001","publish_country":"nyu","by_statement":"Hugh B. Urban.","works":[{"key":"/works/OL5962856W"}],"type":{"key":"/type/edition"},"oclc_numbers":["44632997"],"description":{"type":"/type/text","value":"\"This volume explores the Bengali Kartabhaja sect and its place in the broader movement of Tantra, an Indian religious movement notorious for its alleged use of shocking sexual language and rituals. Hugh B. Urban looks closely at the relationship between the rise of the Kartabhajas, who flourished at the turn of the nineteenth century, and the changing economic context of colonial Bengal.\".\n\n\"Urban shows that the case of the Kartabhajas opens many new insights not merely into the specific case of one minor Bengali cult, but also into much larger cross-cultural and theoretical issues, including the changing role of the lower class, marginalized groups under the changing conditions of colonialism, the changing role of Tantric traditions during the period of British rule, and the topic of secrecy as a cross-cultural category in the study of religion.\n\nUrban's reflections on the ethical and epistemological dilemmas involved in studying traditions that wish to remain secret will set a new standard for discussion of this controversial issue.\"--BOOK JACKET."},"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-05-14T15:52:08.311081"}}},"ISBN:9780198031826":{"bib_key":"ISBN:9780198031826","info_url":"http://openlibrary.org/books/OL36295476M/Economics_of_Ecstasy","preview":"noview","preview_url":"http://openlibrary.org/books/OL36295476M/Economics_of_Ecstasy","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL1479861A","name":"Hugh B. Urban"},{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"isbn_13":["9780198031826"],"languages":[{"key":"/languages/eng"}],"publish_date":"2001","publishers":["Oxford University Press, Incorporated"],"source_records":["bwb:9780198031826"],"subjects":["Religion"],"title":"Economics of Ecstasy","subtitle":"Tantra, Secrecy and Power in Colonial Bengal","full_title":"Economics of Ecstasy Tantra, Secrecy and Power in Colonial Bengal","works":[{"key":"/works/OL5962856W"}],"key":"/books/OL36295476M","latest_revision":1,"revision"