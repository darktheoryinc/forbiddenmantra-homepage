0062512222","marc:marc_columbia/Columbia-extract-20221130-004.mrc:250038137:1941","marc:harvard_bibliographic_metadata/20220215_037.bib.mrc:15901829:3081"],"title":"Boychiks in the hood","lccn":["95009838"],"identifiers":{"librarything":["221942"],"goodreads":["282486","282484"]},"languages":[{"key":"/languages/eng"}],"url":["http://www.loc.gov/catdir/description/hc043/95009838.html"],"local_id":["urn:sfpl:31223045663037"],"publish_date":"1995","publish_country":"cau","by_statement":"Robert Eisenberg.","works":[{"key":"/works/OL3751266W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/description/hc043/95009838.html"],"oclc_numbers":["32132028","233981223"],"description":{"type":"/type/text","value":"Boychiks in the Hood is your passport to the Hasidic \"underworld\" - a destination far different from popular expectations. When Robert Eisenberg, a secular Jew from Omaha, Nebraska, decided to investigate his family's distant Satmar connections, he unknowingly embarked on a journey that would carry him around the world and into the hearts and lives of the Hasidim.\n\nArmed with a loving curiosity and the Yiddish his grandmother taught him as a child, Eisenberg found himself intimately drawn into the sometimes nutty, often inspiring, lives of these most traditional of Jews. Join Eisenberg as he hangs out with an ex-Deadhead in Antwerp, makes a pilgrimage to the grave of the revered Rebbe Nachman in the Ukraine, munches mini-bagels with Roller-blading kosher butchers in Minnesota, talks about sex with a karate champion turned rabbi in Israel, and more."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-04-28T18:31:02.170571"}}},"ISBN:9780704380318":{"bib_key":"ISBN:9780704380318","info_url":"http://openlibrary.org/books/OL22308518M/Boychiks_in_the_hood","preview":"noview","preview_url":"http://openlibrary.org/books/OL22308518M/Boychiks_in