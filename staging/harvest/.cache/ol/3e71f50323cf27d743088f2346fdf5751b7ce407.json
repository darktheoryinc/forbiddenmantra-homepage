et."},"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-09-07T13:44:39.704682"}}},"ISBN:9780710308382":{"bib_key":"ISBN:9780710308382","info_url":"http://openlibrary.org/books/OL7780642M/Tibetan_Yoga_and_its_Secret_Doctrines","preview":"noview","preview_url":"http://openlibrary.org/books/OL7780642M/Tibetan_Yoga_and_its_Secret_Doctrines","thumbnail_url":"https://covers.openlibrary.org/b/id/4664111-S.jpg","details":{"publishers":["Kegan Paul"],"number_of_pages":414,"weight":"850 grams","series":["Kegan Paul Library of Religion and Mysticism"],"covers":[4664111],"physical_format":"Hardcover","key":"/books/OL7780642M","authors":[{"key":"/authors/OL914415A","name":"W. Y. Evans-Wentz"}],"subjects":["Tibetan Buddhism","Religion - World Religions","Religion","Buddhism - General","Yoga","Religion / Buddhism","Eastern - General"],"edition_name":"New Ed edition","languages":[{"key":"/languages/eng"}],"classifications":{},"title":"Tibetan Yoga and its Secret Doctrines","identifiers":{"goodreads":["2279122"]},"isbn_13":["9780710308382"],"isbn_10":["0710308388"],"publish_date":"June 15, 2003","oclc_numbers":["51738495","823735050"],"works":[{"key":"/works/OL4538661W"}],"type":{"key":"/type/edition"},"physical_dimensions":"23 x  x  centimeters","lc_classifications":["B132","BQ7805 .T53 2003eb"],"source_records":["bwb:9780710308382","marc:marc_columbia/Columbia-extract-20221130-031.mrc:108322508:1915","marc:marc_columbia/Columbia-extract-20221130-009.mrc:386273719:942","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:132048401:1083"],"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2008-04-29T15:03:11.581851"},"last_modified":{"type":"/type/datetime","value":"2024-09-02T04:50:11.181415"}}},"ISBN:9788178222509":{"bib_key":"ISBN:9788178222509","info_url":"http://openlibrary.org/books/OL13172833M/Tibetan_Yoga_and_Secret_Doctrine