{"ISBN:9781848726659":{"bib_key":"ISBN:9781848726659","info_url":"http://openlibrary.org/books/OL28499652M/Religion_Personality_and_Social_Behavior","preview":"noview","preview_url":"http://openlibrary.org/books/OL28499652M/Religion_Personality_and_Social_Behavior","details":{"publishers":["Taylor & Francis Group"],"last_modified":{"type":"/type/datetime","value":"2020-08-03T09:11:59.226841"},"source_records":["bwb:9781848726659"],"title":"Religion, Personality, and Social Behavior","number_of_pages":440,"isbn_13":["9781848726659"],"created":{"type":"/type/datetime","value":"2020-08-03T09:11:59.226841"},"languages":[{"key":"/languages/eng"}],"full_title":"Religion, Personality, and Social Behavior","lc_classifications":["BF51"],"publish_date":"2013","key":"/books/OL28499652M","authors":[{"key":"/authors/OL298167A","name":"Vassilis Saroglou"}],"latest_revision":1,"works":[{"key":"/works/OL21035625W"}],"type":{"key":"/type/edition"},"subjects":["Psychology and religion","Social psychology"],"revision":1}},"ISBN:9781848729841":{"bib_key":"ISBN:9781848729841","info_url":"http://openlibrary.org/books/OL28474262M/Religion_Personality_and_Social_Behavior","preview":"restricted","preview_url":"https://archive.org/details/isbn_9781848729841","thumbnail_url":"https://covers.openlibrary.org/b/id/14391919-S.jpg","details":{"publishers":["Taylor & Francis Group","Psychology Press, Taylor & Francis Group"],"languages":[{"key":"/languages/eng"}],"source_records":["bwb:9781848729841","marc:marc_loc_2016/BooksAll.2016.part41.utf8:295280880:3521","marc:marc_columbia/Columbia-extract-20221130-030.mrc:61701230:5848","marc:marc_columbia/Columbia-extract-20221130-022.mrc:155608086:5841","marc:marc_nuls/NULS_PHC_180925.mrc:267841172:4096","ia:isbn_9781848729841","marc:harvard_bibliographic_metadata/ab.bib.13.20150123.full.mrc:885324074:3750","marc:harvard_bibliographic_metadata/20220215_011.bib.mrc:82764500:4571"],"title":"Religion, Personality, and Social Behavior","lccn":["2014412245"],"number_of_pages":440,"isbn_13":["9781848729841"],"lc_classifications":["BF51","BL53 .R4356 2014","BF39.9 .R45 2014"],"publish_date":"2013","key":"/books/OL28474262M","authors":[{"key":"/authors/OL298167A","name":"Vassilis Saroglou"}],"works":[{"key":"/works/OL21035625W"}],"type":{"key":"/type/edition"},"subjects":["Psychology and religion","Social psychology"],"oclc_numbers":["854977048","785869195"],"covers":[14391919],"ocaid":"isbn_9781848729841","description":{"type":"/type/text","value":"Religion has always been a major study in psychology, but recent events, including terrorism, have sharpened attention on the relationship between personality and religion. This collection is remarkably even-handed, concentrating on reproducible results and logic, rather than unproved theories and instant reactions. Contributors of these fifteen essays review the accumulated research and theories on the major aspects of personality and social psychology as applied to religion. They concentrate on personality, cognition, and emotion (personality and religiousness, religion and the self, religious cognition, religion and negative emotions as they relate to regulation, positive emotions and self-transcendence), social behavior, morality, and intergroup relations (personal and cognitive factors as they relate to social factors, religion and prejudice in intergroup relations, values as religiosity, religion and sexuality within family, religion and domestic political attitudes around the world, social aspects of religion and mental health), and age, gender and culture (religion and development, gender difference in religion, religion and the national culture, understanding religion and irreligion). Psychology Press is an imprint of the Taylor & Francis Group. Annotation ©2013 Book News, Inc., Portland, OR (booknews.com)"},"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2020-08-02T21:49:11.251781"},"last_modified":{"type":"/type/datetime","value":"2025-07