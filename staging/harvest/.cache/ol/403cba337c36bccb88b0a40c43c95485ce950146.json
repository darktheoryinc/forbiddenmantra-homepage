mber_of_pages":272,"key":"/books/OL20935005M","authors":[{"key":"/authors/OL116592A","name":"Albert Schweitzer"}],"publish_places":["Gloucester, MA"],"subjects":["India -- Religion."],"pagination":"272p.","title":"Indian thought and its development","notes":{"type":"/type/text","value":"100,056"},"identifiers":{"librarything":["1536051"]},"languages":[{"key":"/languages/eng"}],"isbn_10":["084462893X"],"publish_date":"1977","publish_country":"mau","by_statement":"translated by Mrs. Charles E. B. Russell.","works":[{"key":"/works/OL1148756W"}],"type":{"key":"/type/edition"},"covers":[12680871],"ocaid":"indianthoughtits0000schw","lc_classifications":["BL2003 .S413 1977"],"source_records":["ia:indianthoughtits0000schw","promise:bwb_daily_pallets_2022-03-17","amazon:084462893X"],"local_id":["urn:bwbsku:P7-CNN-004"],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-10-31T00:43:46.977303"},"last_modified":{"type":"/type/datetime","value":"2023-02-12T13:54:53.008105"}}},"ISBN:9780429750359":{"bib_key":"ISBN:9780429750359","info_url":"http://openlibrary.org/books/OL33684176M/Goddesses_of_Kathmandu_Valley","preview":"noview","preview_url":"http://openlibrary.org/books/OL33684176M/Goddesses_of_Kathmandu_Valley","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7062939A","name":"Arun Gupto"}],"isbn_13":["9780429750359"],"languages":[{"key":"/languages/eng"}],"number_of_pages":224,"publish_date":"2018","publishers":["Taylor & Francis Group"],"source_records":["bwb:9780429750359"],"title":"Goddesses of Kathmandu Valley","subtitle":"Grace, Rage, Knowledge","full_title":"Goddesses of Kathmandu Valley Grace, Rage, Knowledge","works":[{"key":"/works/OL21113447W"}],"key":"/books/OL33684176M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-09-20T19:31:48.609236"},"last_modified":{"type":"/type/datetime","value":"2021-09-20T19:31:48.609236"}}},"ISBN:9781138589889":{"bib_key":"ISBN:9781138589889","info_url":"http://openlibrary.org/books/OL34636491M/Goddesses_of_Kathmandu_Valley","preview":"noview","preview_url":"http://openlibrary.org/books/OL34636491M/Goddesses_of_Kathmandu_Valley","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7062939A","name":"Arun Gupto"}],"isbn_13":["9781138589889"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BL1216.6","BL473.5 .G87 2018"],"publish_date":"2018","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781138589889","marc:harvard_bibliographic_metadata/20220215_045.bib.mrc:79326277:3632"],"subjects":["Hindu goddesses","Kathmandu (nepal)"],"title":"Goddesses of Kathmandu Valley","weight":"0.609","pagination":"224","full_title":"Goddesses of Kathmandu Valley","works":[{"key":"/works/OL21113447W"}],"key":"/books/OL34636491M","oclc_numbers":["1021295066"],"description":{"type":"/type/text","value":"\"In South Asia goddesses are conceptualized and worshipped in a fascinating range of forms from cosmic beings to bacterial manifestations, from human-like appearances to creatures with animal and insect semblances. This book maps the diverse identities of goddesses through metaphors of grace, rage and knowledge, and offers an in-depth insight into femininity, sexual politics, ritual worships, religion, ecology, and gender. The volume explores how these deity attributes are expressed and embedded through anthropomorphic as well as inorganic forms of nature, beautiful women, multi-legged and many-armed animals, epistemic selves, demonic beings, glamorous personifications, as also grotesque sub-humans. The second edition contains an Epilogue which further explores how the discourses on Goddesses are moulded by the myth and folklore. It opens discussions on how the dynamism of Goddess cultures have been appropriated into contemporary variations of those archetypes over time. This book will be useful to scholars and researchers of religious studies, cultural studies, folklore, art, literature, sociology and gender studies, especially those interested in Nepal and Hinduism.\"--Provided by publisher."},"number_of_pages":223,"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2021-10-06T17:56:19.143844"},"last_modified":{"type":"/type/datetime","value":"2026-07-26T04:52:55.300867"}}},"ISBN:9781138945852":{"bib_key":"ISBN:9781138945852","info_url":"http://openlibrary.org/books/OL28579734M/Goddesses_of_Kathmandu_Valley","preview":"restricted","preview_url":"https://archive.org/details/goddessesofkathm0000gupt","thumbnail_url":"https://covers.openlibrary.org/b/id/12716509-S.jpg","details":{"publishers":["Taylor & Francis Group"],"subtitle":"Grace, Rage, Knowledge","source_records":["bwb:9781138945852","ia:goddessesofkathm0000gupt","amazon:1138945854","marc:marc_columbia/Columbia-extract-20221130-025.mrc:171696465:1540"],"title":"Goddesses of Kathmandu Valley","number_of_pages":220,"isbn_13":["9781138945852"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BL1216.6","BL473.5 .G87 2014","BL2034.3.K38 G87 2016"],"publish_date":"2015","key":"/books/OL28579734M","authors":[{"key":"/authors/OL7062939A","name":"Arun Gupto"}],"works":[{"key":"/works/OL21113447W"}],"type":{"key":"/type/edition"},"subjects":["Hindu goddesses"],"covers":[12716509],"ocaid":"goddessesofkathm0000gupt","lccn":["2016330819"],"oclc_numbers":["912379211"],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-08-04T20:45:01.704962"},"last_modified":{"type":"/type/datetime","value":"2022-12-20T08:38:06.950170"}}},"ISBN:9781138666764":{"bib_key":"ISBN:9781138666764","info_url":"http://openlibrary.org/books/OL43015706M/Goddesses_of_Kathmandu_Valley","preview":"noview","preview_url":"http://openlibrary.org/books/OL43015706M/Goddesses_of_Kathmandu_Valley","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7062939A","name":"Arun Gupto"}],"isbn_10":["1138666769"],"isbn_13":["9781138666764"],"local_id":["urn:bwbsk