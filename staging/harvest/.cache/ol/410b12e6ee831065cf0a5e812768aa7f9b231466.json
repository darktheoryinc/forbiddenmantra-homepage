1A","name":"Richard Mann"}],"isbn_13":["9781135013714"],"languages":[{"key":"/languages/eng"}],"number_of_pages":298,"publish_date":"2014","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781135013714"],"title":"Material Culture and Asian Religions","subtitle":"Text, Image, Object","full_title":"Material Culture and Asian Religions Text, Image, Object","works":[{"key":"/works/OL21247230W"}],"key":"/books/OL33715603M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-09-21T01:36:58.835640"},"last_modified":{"type":"/type/datetime","value":"2021-09-21T01:36:58.835640"}}},"ISBN:9781135013738":{"bib_key":"ISBN:9781135013738","info_url":"http://openlibrary.org/books/OL34622456M/Material_Culture_and_Asian_Religions","preview":"noview","preview_url":"http://openlibrary.org/books/OL34622456M/Material_Culture_and_Asian_Religions","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8136596A","name":"Benjamin Fleming"},{"key":"/authors/OL1239911A","name":"Richard Mann"}],"isbn_13":["9781135013738"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BL1033 .M38 2014"],"publish_date":"2014","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781135013738"],"subjects":["Material culture","Asia, religion"],"title":"Material Culture and Asian Religions","pagination":"298","subtitle":"Text, Image, Object","full_title":"Material Culture and Asian Religions Text, Image, Object","works":[{"key":"/works/OL21247230W"}],"key":"/books/OL34622456M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-06T15:03:18.341614"},"last_modified":{"type":"/type/datetime","value":"2021-10-06T15:03:18.341614"}}},"ISBN:9780415843782":{"bib_key":"ISBN:9780415843782","info_url":"http://openlibrary.org/books/OL28765154M/Material_Culture_and_Asian_Religions","preview":"restricted","preview_url":"https://archive.org/details/materialculturea0000unse","thumbnail_url":"https://covers.openlibrary.org/b/id/12955924-S.jpg","details":{"publishers":["Taylor & Francis Group"],"languages":[{"key":"/languages/eng"}],"subtitle":"Text, Image, Object","source_records":["bwb:9780415843782","marc:marc_loc_2016/BooksAll.2016.part40.utf8:256586296:1059","ia:materialculturea0000unse","marc:harvard_bibliographic_metadata/ab.bib.14.20150123.full.mrc:227887104:3611","marc:marc_columbia/Columbia-extract-20221130-030.mrc:65910341:6823","marc:marc_columbia/Columbia-extract-20221130-022.mrc:157051089:1392","promise:bwb_daily_pallets_2022-08-13","marc:harvard_bibliographic_metadata/20220215_036.bib.mrc:171602624:7244"],"title":"Material Culture and Asian Religions","lccn":["2013041860"],"number_of_pages":308,"isbn_13":["9780415843782"],"lc_classifications":["BL1033","BL1033 .M38 2014","BL1033 .M38 2014eb"],"publish_date":"2014","key":"/books/OL28765154M","authors":[{"key":"/authors/OL8136596A","name":"Benjamin Fleming"},{"key":"/authors/OL1239911A","name":"Richard Mann"}],"works":[{"key":"/works/OL21247230W"}],"type":{"key":"/type/edition"},"subjects":["Material culture","Asia, religion"],"covers":[12955924],"ocaid":"materialculturea0000unse","oclc_numbers":["869458151","875098983"],"local_id":["urn:bwbsku:W3-ARQ-521"],"description":{"type":"/type/text","value":"\"Traditionally, research on the history of Asian religions has been marked by a bias for literary evidence, privileging canonical texts penned in ‘classical’ languages. Not only has a focus on literary evidence shaped the dominant narratives about the religious histories of Asia, in both scholarship and popular culture, but it has contributed to the tendency to study different religious traditions in relative isolation from one another. Today, moreover, historical work is often based on modern textual editions and, increasingly, on electronic databases. What may be lost, in the process, is the visceral sense of the text as artifact – as a material object that formed part of a broader material culture, in which the boundaries between religious traditions were sometimes more fluid than canonical literature might suggest.\n\nThis volume brings together specialists in a variety of Asian cultures to discuss the methodological challenges involved in integrating material evidence for the reconstruction of the religious histories of South, Southeast, Central, and East Asia. By means of specific ‘test cases,’ the volume explores the importance of considering material and literary evidence in concert. What untold stories do these sources help us to recover? How might they push us to reevaluate historical narratives traditionally told from literary sources? By addressing these questions from the perspectives of different subfields and religious traditions, contributors map out the challenges involved in interpreting different types of data, assessing the problems of interpretation distinct to specific types of material evidence (e.g., coins, temple art, manuscripts, donative inscriptions) and considering the issues raised by the different patterns in the preservation of such evidence in different locales. Special attention is paid to newly-discovered and neglected sources; to our evidence for trade, migration, and inter-regional cultural exchange; and to geographical locales that served as \"contact zones\" connecting cultures. In addition, the chapters in this volume represent the rich range of religious traditions across Asia – including Hinduism, Buddhism, Taoism, Shinto, and Chinese religions, as well as Islam and eastern Christianities.\"--"},"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2020-08-15T11:05:10.179858"},"last_modified":{"type":"/type/datetime","value":"2026-04-19T06:56:14.853250"}}},"ISBN:9781135013721":{"bib_key":"ISBN:9781135013721","info_url":"http://openlibrary.org/books/OL33629196M/Material_Culture_and_Asian_Religions","preview":"noview","preview_url":"http://openlibrary.org/books/OL33629196M/Material_Culture_and_Asian_Religions","deta