"}],"key":"/books/OL53243296M","latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2024-08-17T08:30:32.943234"},"last_modified":{"type":"/type/datetime","value":"2024-08-18T18:46:02.479570"}}},"ISBN:9781501122248":{"bib_key":"ISBN:9781501122248","info_url":"http://openlibrary.org/books/OL32042475M/Cell","preview":"restricted","preview_url":"https://archive.org/details/cellnovel0000king","thumbnail_url":"https://covers.openlibrary.org/b/id/14652547-S.jpg","details":{"works":[{"key":"/works/OL81597W"}],"title":"Cell","publishers":["Pocket Books"],"publish_date":"2016-07","key":"/books/OL32042475M","type":{"key":"/type/edition"},"identifiers":{"goodreads":["57425266"],"amazon":["150112224X"],"google":["5ShiDAAAQBAJ"]},"covers":[14652547,10708824],"ocaid":"cellnovel0000king","isbn_10":["150112224X"],"isbn_13":["9781501122248"],"oclc_numbers":["965589290"],"classifications":{},"notes":{"type":"/type/text","value":"US/CAN"},"pagination":"449p.","number_of_pages":465,"languages":[{"key":"/languages/eng"}],"publish_places":["New York"],"copyright_date":"2006","description":{"type":"/type/text","value":"On October 1, God is in His heaven, the stock market stands at 10,140, most of the planes are on time, and graphic artist Clayton Riddell is visiting Boston, having just landed a deal that might finally enable him to make art instead of teaching it. But all those good feelings about the future change in a hurry thanks to a devastating phenomenon that will come to be known as The Pulse. The delivery method is a cell phone—everyone's cell phone. Now Clay and the few desperate survivors who join him suddenly find themselves in the pitch-black night of civilization's dark- est age, surrounded by chaos, carnage, and a relentless human horde that has been reduced to its basest nature . .. and then begins to evolve. There's really no escaping this nightmare. But for Clay, an arrow points the way home to his family in Maine, and as he and his fellow refugees 