es/eng"}],"subjects":["Qi gong."],"publish_country":"nyu","by_statement":"Kenneth S. Cohen ; with a foreword by Larry Dossey.","type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/description/random0412/96050407.html"],"other_titles":["Ch'i kung chi tao"],"publishers":["Ballantine Books"],"ia_box_id":["IA184201"],"key":"/books/OL1010336M","authors":[{"key":"/authors/OL544844A","name":"Ken Cohen"}],"publish_places":["New York"],"lccn":["96050407"],"pagination":"xix, 427 p. :","dewey_decimal_class":["613.7/1"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 397-409) and index.\nParallel title in Chinese."},"identifiers":{"goodreads":["1826638"],"librarything":["307167"]},"url":["http://www.loc.gov/catdir/description/random0412/96050407.html"],"local_id":["urn:sfpl:31223048176177","urn:sfpl:31223052179695","urn:sfpl:31223045518900","urn:nuls:31786100934428"],"publish_date":"1997","works":[{"key":"/works/OL3354806W"}],"oclc_numbers":["36001343"],"description":{"type":"/type/text","value":"Qigong, which literally means \"working with the energy of life,\" is an integrated mind-body healing method that has been practiced with remarkable results in China for thousands of years. The Chinese have long treasured qigong for its effectiveness both in healing and in preventing disease, and more recently they have used it in conjunction with modern medicine to cure cancer, immune system disorders, and other life-threatening conditions. Now in this fascinating,\n\nComprehensive volume, renowned qigong master and China scholar Kenneth S. Cohen brings the ancient healing power of qigong to Western readers. Qigong is a gentle yet rigorous program for working with our life energy through breathing and relaxation exercises, massage, visualization, meditation, and other natural methods."},"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"