_modified":{"type":"/type/datetime","value":"2021-10-05T11:41:55.039111"}}},"ISBN:9781317544296":{"bib_key":"ISBN:9781317544296","info_url":"http://openlibrary.org/books/OL34521489M/Religion_of_the_Peacock_Angel","preview":"noview","preview_url":"http://openlibrary.org/books/OL34521489M/Religion_of_the_Peacock_Angel","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8143408A","name":"Garnik S. Asatrian"},{"key":"/authors/OL8143407A","name":"Victoria Arakelova"}],"isbn_13":["9781317544296"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BL1595 .A83 2014"],"number_of_pages":160,"publish_date":"2014","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781317544296"],"title":"Religion of the Peacock Angel","subtitle":"The Yezidis and Their Spirit World","full_title":"Religion of the Peacock Angel The Yezidis and Their Spirit World","works":[{"key":"/works/OL21262335W"}],"key":"/books/OL34521489M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-05T14:58:49.352402"},"last_modified":{"type":"/type/datetime","value":"2021-10-05T14:58:49.352402"}}},"ISBN:9781322102948":{"bib_key":"ISBN:9781322102948","info_url":"http://openlibrary.org/books/OL46045498M/Religion_of_the_Peacock_Angel","preview":"noview","preview_url":"http://openlibrary.org/books/OL46045498M/Religion_of_the_Peacock_Angel","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8143408A","name":"Garnik S. Asatrian"},{"key":"/authors/OL8143407A","name":"Victoria Arakelova"}],"isbn_13":["9781322102948"],"languages":[{"key":"/languages/eng"}],"pagination":"168","publish_date":"2014","publishers":["Routledge"],"source_records":["bwb:9781322102948"],"title":"Religion of the Peacock Angel","subtitle":"The Yezidis and Their Spirit World","full_title":"Religion of the Peacock Angel The Yezidis and Their Spirit World","works":[{"key":"/works/OL21262335W"}],"key":"/books/OL46045498M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-01-17T04:13:01.978482"},"last_modified":{"type":"/type/datetime","value":"2023-01-17T04:13:01.978482"}}},"ISBN:9781844657612":{"bib_key":"ISBN:9781844657612","info_url":"http://openlibrary.org/books/OL28786936M/Religion_of_the_Peacock_Angel","preview":"noview","preview_url":"http://openlibrary.org/books/OL28786936M/Religion_of_the_Peacock_Angel","details":{"publishers":["Taylor & Francis Group"],"languages":[{"key":"/languages/eng"}],"source_records":["bwb:9781844657612","marc:marc_loc_2016/BooksAll.2016.part41.utf8:258991904:1170","marc:harvard_bibliographic_metadata/ab.bib.14.20150123.full.mrc:65334355:1129","marc:marc_columbia/Columbia-extract-20221130-031.mrc:156988198:2300","marc:harvard_bibliographic_metadata/20220215_025.bib.mrc:4875443:3183"],"title":"Religion of the Peacock Angel","lccn":["2014371858"],"number_of_pages":160,"isbn_13":["9781844657612"],"lc_classifications":["","BL1595 .A83 2014","BL1595 .A838 2014eb"],"publish_date":"2014","key":"/books/OL28786936M","authors":[{"key":"/authors/OL8143407A","name":"Victoria Arakelova"},{"key":"/authors/OL8143408A","name":"Garnik S. Asatrian"}],"works":[{"key":"/works/OL21262335W"}],"type":{"key":"/type/edition"},"subjects":["Yezidis","Gnosticism"],"oclc_numbers":["855582572","891382569"],"description":{"type":"/type/text","value":"Based in Iraq, Syria and Turkey, the Yezidi people claim their religion - a unique combination of Christian, Islamic, and historical faiths - to be the oldest in the world. Yezidi identity centres on their religion, Sharfadin, which has evolved into a highly complex pantheon of one God with many incarnations, the chief of whom is Melek Taus, the Peacock Angel. The Yezidi faith can be traced to a range of pre-Islamic belief systems, such as Sufism, some extreme Shi'ite sects, Gnosticism and other traditions surviving from the ancient world. This particular formulation has served to unify Yezidi religious identity and ethnicity. Based on extensive fieldwork, 'The Religion of the Peacock Angel' presents the first detailed examination of the Yezidi pantheon. The idea of one God and his chief incarnations is first analysed, then the various 'deity figures,' saints, holy patrons and divinized personalities in the Yezidi belief system are considered in the context of related religious traditions. The study determines the place of all these characters in the system of the Yezidi faith, defining their main functions, features, and genealogies. --Provided by publisher."},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2020-08-15T22:10:56.349139"},"last_modified":{"type":"/type/datetime","value":"2025-12-15T01:32:04.553574"}}},"ISBN:9781317201830":{"bib_key":"ISBN:9781317201830","info_url":"http://openlibrary.org/books/OL40090149M/Gnostic_World","preview":"noview","preview_url":"http://openlibrary.org/books/OL40090149M/Gnostic_World","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8184822A","name":"Garry W. Trompf"},{"key":"/authors/OL1621825A","name":"Gunner B. Mikkelsen"},{"key":"/authors/OL3779590A","name":"Jay Johnston"}],"isbn_13":["9781317201830"],"languages":[{"key":"/languages/eng"}],"pagination":"716","publish_date":"2018","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781317201830"],"subjects":["Gnosticism","Cults","Religions"],"title":"Gnostic World","full_title":"Gnostic World","works":[{"key":"/works/OL21362447W"}],"key":"/books/OL40090149M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-10-19T11:31:09.679873"},"last_modified":{"type":"/type/datetime","value":"2022-10-19T11:31:09.679873"}}},"ISBN:9780367733124":{"bib_key":"ISBN:9780367733124","info_url":"http://openlibrary.org/books/OL34694783M/Gnostic_World","preview":"noview","preview_url":"http://openlibrary.org/books/OL34694783M/Gnostic_World","thumbnail_url":"https://covers.openlibrary.org/b/id/13201369-S.jpg","details":{"type":{"key":"/typ