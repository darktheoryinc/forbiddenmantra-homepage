ew","preview_url":"http://openlibrary.org/books/OL54262812M/Little_Flower_Yoga_for_Kids","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7594114A","name":"Jennifer Cohen Harper"},{"key":"/authors/OL6952872A","name":"Daniel J. Siegel"}],"dewey_decimal_class":["613.7046083"],"isbn_13":["9781608827930"],"languages":[{"key":"/languages/eng"}],"number_of_pages":192,"publish_date":"2013","publishers":["New Harbinger Publications"],"source_records":["bwb:9781608827930"],"subjects":["Hatha yoga","Emotions in children","Exercise"],"title":"Little Flower Yoga for Kids","subtitle":"A Yoga and Mindfulness Program to Help Your Child Improve Attention and Emotional Balance","full_title":"Little Flower Yoga for Kids A Yoga and Mindfulness Program to Help Your Child Improve Attention and Emotional Balance","works":[{"key":"/works/OL19973958W"}],"key":"/books/OL54262812M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-09-20T01:47:59.100594"},"last_modified":{"type":"/type/datetime","value":"2024-09-20T01:47:59.100594"}}},"ISBN:9781608828197":{"bib_key":"ISBN:9781608828197","info_url":"http://openlibrary.org/books/OL49758273M/Yoga_for_Grief_Relief","preview":"noview","preview_url":"http://openlibrary.org/books/OL49758273M/Yoga_for_Grief_Relief","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7595648A","name":"Antonio Sausys"},{"key":"/authors/OL13236072A","name":"Lyn Prashant"}],"isbn_13":["9781608828197"],"languages":[{"key":"/languages/eng"}],"pagination":"216","publish_date":"2014","publishers":["New Harbinger Publications"],"source_records":["bwb:9781608828197"],"subjects":["Hatha yoga","Psychotherapy"],"title":"Yoga for Grief Relief","subtitle":"Simple Practices for Transforming Your Grieving Mind and Body","full_title":"Yoga for Grief Relief Simple Practices for Transforming Your Grieving Mind and Body","works":[{"key":"/works/OL19980229W"}],"key":"/books/OL49758273M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-10-17T08:33:22.994344"},"last_modified":{"type":"/type/datetime","value":"2023-10-17T08:33:22.994344"}}},"ISBN:9781608828180":{"bib_key":"ISBN:9781608828180","info_url":"http://openlibrary.org/books/OL27160377M/Yoga_for_grief_relief","preview":"borrow","preview_url":"https://archive.org/details/yogaforgriefreli0000saus","thumbnail_url":"https://covers.openlibrary.org/b/id/13058917-S.jpg","details":{"description":{"type":"/type/text","value":"\"If you've experienced loss, you may feel intense emotional or even physical pain. In fact, it's not uncommon for grieving people to experience depression, anxiety, fatigue, and a variety of other physical, mental, and spiritual symptoms. If you've tried other ways to move beyond your loss but have yet to find relief, you may be surprised to discover the transformative effects of yoga. Yoga for Grief Relief combines over 100 illustrations of gentle yogic poses and the power of psychophysiology and neuroscience to help you recapture a true sense of well-being. You'll also find breathing exercises, cleansing techniques, and self-relaxation tips to help you work through your loss and begin on the journey to self-knowledge and re-identification. At its core, yoga is about accepting change. If you are open to viewing your loss as an opportunity for growth, this book will help transform your grief with gentle clarity and awareness. To find out more, visit yogaforgriefrelief.com\"--\n\n\"When people grieve, they experience profound pain in both body and mind. Some may experience depression, fatigue, anxiety, or even chronic pain. For readers who've experienced loss (and have lost their way) Yoga for Grief Relief combines over 100 illustrations of gentle yogic poses and the latest research in psychophysiology and neuroscience to help them get back on the path to wellness. Written by the founder of Yoga for Health, the step-by-step exercises in this book can be tailored to the reader's personal needs, and are designed to help them work through their loss and begin on the journey to self-knowledge and enlightenment\"--"},"notes":{"type":"/type/text","value":"Includes bibliographical references (pages 159-162)."},"title":"Yoga for grief relief","subtitle":"simple practices for transforming your grieving mind & body","authors":[{"key":"/authors/OL7595648A","name":"Antonio Sausys"}],"publish_date":"2014","local_id":["urn:sfpl:31223100892745","urn:sfpl:31223100892752","urn:sfpl:31223100892760","urn:sfpl:31223100892877","urn:sfpl:31223100892729","urn:sfpl:31223100892737","urn:bwbsku:W7-BBV-789"],"lc_classifications":["BF575.G7 S287 2014","RM727.Y64"],"subjects":["Grief","Yoga","Bereavement"],"isbn_13":["9781608828180"],"pagination":"xiii, 162 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:53291722:4493","bwb:9781608828180","marc:marc_loc_2016/BooksAll.2016.part41.utf8:150602918:2904","ia:yogaforgriefreli0000saus","promise:bwb_daily_pallets_2022-03-17"],"dewey_decimal_class":["204/.36"],"languages":[{"key":"/languages/eng"}],"lccn":["2014009369"],"isbn_10":["1608828182"],"publish_country":"cau","by_statement":"Antonio Sausys, MA, CMT, RYT ; foreword by Lyn Prashant","oclc_numbers":["819383587"],"type":{"key":"/type/edition"},"ocaid":"yogaforgriefreli0000saus","key":"/books/OL27160377M","number_of_pages":162,"works":[{"key":"/works/OL19980229W"}],"covers":[13058917],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2019-07-18T12:42:09.453493"},"last_modified":{"type":"/type/datetime","value":"2022-12-13T09:40:09.224466"}}},"ISBN:9781608828203":{"bib_key":"ISBN:9781608828203","info_url":"http://openlibrary.org/books/OL49757183M/Yoga_for_Grief_Relief","preview":"noview","preview_url":"http://openlibrary.org/books/OL49757183M/Yoga_for_Grief_Relief","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7595648A","name":"Antonio Sausys"},{"key":"/authors/