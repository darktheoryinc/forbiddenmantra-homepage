17.424.N38 2007"],"key":"/books/OL22765225M","authors":[{"key":"/authors/OL6531126A","name":"Kamala E. Nayar"}],"publish_places":["Albany, NY"],"isbn_13":["9780791472132"],"pagination":"xvi, 181 p. 24 cm.","source_records":["marc:marc_loc_updates/v37.i31.records.utf8:6305620:1532","marc:marc_loc_2016/BooksAll.2016.part33.utf8:138720109:1532","bwb:9780791472132","marc:harvard_bibliographic_metadata/ab.bib.11.20150123.full.mrc:234777930:1531","promise:bwb_daily_pallets_2023-09-12:KS-645-980","marc:harvard_bibliographic_metadata/20220215_016.bib.mrc:19737690:4402"],"title":"The socially involved renunciate","number_of_pages":181,"languages":[{"key":"/languages/eng"}],"publish_date":"2008","publish_country":"us ","by_statement":"Kamala Elizabeth Nayar, Jaswinder Singh Sandhu.","works":[{"key":"/works/OL13675773W"}],"type":{"key":"/type/edition"},"lccn":["2006037453"],"oclc_numbers":["76183405"],"local_id":["urn:bwbsku:KS-645-980"],"description":{"type":"/type/text","value":"\"The Socially Involved Renunciate is an in-depth analysis and an original English translation of the Siddh Gost, a fundamental philosophical text of the Sikh tradition. The work reflects the distinctive worldview of Sikhism, the only major Indian religion that does not regard asceticism as a legitimate path to liberation.\" \"Composed by Guru Nanak, a medieval, north Indian saint-poet and venerated founder of the Sikh tradition, the Siddh Gost is a dialogue between Guru Nanak and several Nath yogis who had been pursuing a rigorous path of hath-yoga as renunciates of the material world. Through their dialogue, Guru Nanak teaches the Nath yogis a spiritual path that also includes involvement in the social world and offers a practical way to achieve liberation. In The Socially Involved Renunciate, Kamala Elizabeth Nayar and Jaswinder Singh Sandhu provide background on Sikhism., highlight the ethical teachings expounded in the Siddh Gost, and demonstrate how Guru Nanak reconciles the polarities of the ascetic and householder ideals.\"--Jacket."},"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-12-21T02:45:17.367623"},"last_modified":{"type":"/type/datetime","value":"2025-08-26T17:03:13.428305"}}},"ISBN:9788129109057":{"bib_key":"ISBN:9788129109057","info_url":"http://openlibrary.org/books/OL23144247M/The_philosophy_of_religion","preview":"noview","preview_url":"http://openlibrary.org/books/OL23144247M/The_philosophy_of_religion","thumbnail_url":"https://covers.openlibrary.org/b/id/13218421-S.jpg","details":{"publishers":["Rupa & Co."],"subtitle":"a Sikh perspective","description":{"type":"/type/text","value":"On the philosophical aspects and concept of God in Sikhism."},"local_id":["urn:cst:10017028905"],"lc_classifications":["B162.65 .S33 2007","B162.65 .S53 2007"],"key":"/books/OL23144247M","authors":[{"key":"/authors/OL112695A","name":"Arvind Sharma"}],"publish_places":["New Delhi"],"subjects":["Philosophy, Sikh","God (Sikhism)","Sikh ethics"],"pagination":"x, 301 p. ;","source_records":["marc:marc_loc_updates/v36.i06.records.utf8:11446203:905","marc:marc_loc_updates/v36.i08.records.utf8:10730293:905","marc:marc_loc_updates/v38.i16.records.utf8:5098568:909","marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:60706832:1691","marc:marc_loc_2016/BooksAll.2016.part34.utf8:251736396:909","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:60733965:1691","marc:marc_columbia/Columbia-extract-20221130-016.mrc:177172056:1514","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:131374685:1032","amazon:8129109050"],"title":"The philosophy of religion","lccn":["2007392390"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"number_of_pages":301,"languages":[{"key":"/languages/eng"}],"isbn_10":["8129109050"],"publish_date":"2007","publish_country":"ii ","by_statement":"Arvind Sharma.","works":[{"key":"/works/OL1084026W"}],"type":{"key":"/type/edition"},"oclc_numbers":["167579955"],"covers":[13218421],"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2009-04-27T07:37:38.758410"},"last_modified":{"type":"/type/datetime","value":"2023-02-02T19:25:53.058518"}}},"ISBN:9780195633467":{"bib_key":"ISBN:9780195633467","info_url":"http://openlibrary.org/books/OL7394285M/The_Philosophy_of_Religion","preview":"noview","preview_url":"http://openlibrary.org/books/OL7394285M/The_Philosophy_of_Religion","thumbnail_url":"https://covers.openlibrary.org/b/id/4603426-S.jpg","details":{"publishers":["Oxford University Press, USA"],"number_of_pages":224,"subtitle":"A Buddhist Perspective","covers":[4603426,3842490],"lc_classifications":["BQ282.S5 1995","BQ282 .S5 1995"],"key":"/books/OL7394285M","authors":[{"key":"/authors/OL112695A","name":"Arvind Sharma"}],"languages":[{"key":"/languages/eng"}],"source_records":["bwb:9780195633467","marc:marc_loc_2016/BooksAll.2016.part25.utf8:57867034:805","marc:marc_gtu/KLF IA Export 5-5-22.mrc:55186168:977","marc:marc_columbia/Columbia-extract-20221130-005.mrc:6875558:2550"],"title":"The Philosophy of Religion","lccn":["95910484"],"identifiers":{"goodreads":["1441885"]},"isbn_13":["9780195633467"],"isbn_10":["0195633466"],"publish_date":"February 29, 1996","works":[{"key":"/works/OL1084026W"}],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"The Judaic-Christian concept of God is monotheistic."},"local_id":["urn:gtu:32400003729211"],"oclc_numbers":["33971089"],"description":{"type":"/type/text","value":"This important work does much to extend and redefine the ground of the philosophy of religion. Much of the development in the philosophy of religion, from William James to Paul Tillich, has been conducted in a purely Western context. The discussion, whether it be the soteriological nature of religion, the grounds for belief in God, the problem of evil or the question of verifiability, takes on quite a different complexion in the context of Eastern religions.\n\nArvind Sharma seeks to place this debate with particular reference to the work of such writers as William James, F.R. Tennant, Paul Tillich, J.H. Randall, R.B. Braithwaite, D.Z. Phillips, R.M. Harre, Basil Mitchell, John Hick, W.A. Christian, and W.C. Smith, in the Buddhist context.\n\nAt the same time he clarifies some of the possible misapprehensions which result from a commonality of religious language shared between Buddhism and Hinduism as regards the nature of religious revelation, immortality, karma and reincarnation."},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2024-07-11T08:30:32.142116"}}},"ISBN:9780195642728":{"bib_key":"ISBN:9780195642728","info_url":"http://openlibrary.org/books/OL7394426M/The_Philosophy_of_Religion","preview":"borrow","preview_url":"https://archive.org/details/philosophyofreli0000shar","thumbnail_url":"https://covers.openlibrary.org/b/id/128159-S.jpg","details":{"publishers":["Oxford University Press, USA"],"number_of_pages":224,"subtitle":"A Buddhist Perspective (Oxford India Paperbacks)","covers":[128159],"lc_classifications":["","BQ282 .S5 1997"],"key":"/books/OL7394426M","authors":[{"key":"/authors/OL112695A","name":"Arvind Sharma"}],"languages":[{"key":"/languages/eng"}],"source_records":["bwb:9780195642728","ia:philosophyofreli0000shar","promise:bwb_daily_pallets_2022-05-25"],"title":"The Philosophy of Religion","identifiers":{"librarything":["847670"]},"isbn_13":["9780195642728"],"isbn_10":["0195642724"],"publish_date":"November 13, 1997","works":[{"key":"/works/OL1084026W"}],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"The Judaic-Christian concept of God is monotheistic."},"ocaid":"philosophyofreli0000shar","oclc_numbers":["39383745"],"local_id":["urn:bwbsku:O8-BAI-948"],"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2022-12-05T05:51:39.780184"}}},"ISBN:9781283089227":{"bib_key":"ISBN:9781283089227","info_url":"http://openlibrary.org/books/OL48644583M/Sikhism_Today","preview":"noview","preview_url":"http://openlibrary.org/books/OL48644583M/Sikhism_Today","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL6986227A","name":"Jagbir Jhutti-Johal"}],"isbn_13":["9781283089227"],"languages":[{"key":"/languages/eng"}],"pagination":"176","publish_date":"2011","publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781283089227"],"title":"Sikhism Today","full_title":"Sikhism Today","works":[{"key":"/works/OL16121228W"}],"key":"/books/OL48644583M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-07-17T06:32:07.169983"},"last_modified":{"type":"/type/datetime","value":"2023-07-17T06:32:07.169983"}}},"ISBN:9781847062710":{"bib_key":"ISBN:9781847062710","info_url":"http://openlibrary.org/books/OL25008293M/Sikhism_today","preview":"restricted","preview_url":"https://archive.org/details/sikhismtoday0000jhut","thumbnail_url":"https://covers.openlibrary.org/b/id/10661019-S.jpg","details":{"publishers":["Continuum"],"series":["Continuum religion today","Religion today (London, England)"],"local_id":["urn:cst:10017041436","urn:bwbsku:KJ-644-909"],"full_title":"Sikhism today","lc_classifications":["BL2017.45 .J48 2011","BL2018"],"key":"/books/OL25008293M","authors":[{"key":"/authors/OL6986227A","name":"Jagbir Jhutti-Johal"}],"publish_places":["London","New York"],"subjects":["Sikhism"],"isbn_13":["9781847062710","9781847062727"],"pagination":"xiii, 147 p. ;","source_records":["marc:marc_loc_updates/v39.i35.records.utf8:5382846:870","marc:marc_loc_updates/v39.i41.records.utf8:7529759:1092","marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:79267768:2253","bwb:9781847062727","marc:marc_loc_2016/BooksAll.2016.part37.utf8:166962086:1195","ia:sikhismtoday0000jhut","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:79309319:2253","ia:sikhismtoday0000jhut_y1y4","bwb:9781847062710","amazon:1847062717","marc:marc_columbia/Columbia-extract-20221130-018.mrc:87212422:925","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:676429930:1205","promise:bwb_daily_pallets_2020-12-23","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:48049696:3327","marc:harvard_bibliographic_metadata/20220215_026.bib.mrc:340094523:2208"],"title":"Sikhism today","lccn":["2010045169"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [135]-144) and index."},"number_of_pages":147,"languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["294.6"],"isbn_10":["1847062717","1847062725"],"publish_date":"2011","publish_country":"enk","by_statement":"Jagbir Jhutti-Johal","oclc_numbers":["606768176","721194810"],"works":[{"key":"/works/OL16121228W"}],"type":{"key":"/type/edition"},"covers":[10661019],"ocaid":"sikhismtoday0000jhut","description":{"type":"/type/text","value":"\"This new introduction to Sikhism aims to introduce this increasingly studied religion through the lens of contemporary issues. Illustrated throughout with examples and case studies taken from lived religion, each chapter attempts to interpret the teachings of Sikhism in a modern context and apply them to modern day scenarios. After an initial chapter providing an overview of the Sikh religion, its history and basic theological tenets, Jagbir Jhutti-Johal moves through key contemporary themes, often overlooked in other introductions: Sikhism and women, science and bioethics, and ethics and morality. She concludes with a final section looking at the future for Sikhism, and whether modern issues that are confronting the Sikhs, such as gender inequality, advances in science and technology, family life and homosexuality can be addressed and understood through a critical engagement with the Guru Granth Sahib. She will also consider whether the process of interpretation and reinterpretation has lead to an abandonment, changing or impoverishment of the religious teachings from their original form.\"--Bloomsbury Publishing."},"identifiers":{"doi":["10.5040/9781472549358"]},"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2011-10-20T11:56:47.070652"},"last_modified":{"type":"/type/datetime","value":"2026-01-07T00:37:30.874405"}}},"ISBN:9781847062727":{"bib_key":"ISBN:9781847062727","info_url":"http://openlibrary.org/books/OL25008293M/Sikhism_today","preview":"restricted","preview_url":"https://archive.org/details/sikhismtoday0000jhut","thumbnail_url":"https://covers.openlibrary.org/b/id/10661019-S.jpg","details":{"publishers":["Continuum"],"series":["Continuum religion today","Religion today (London, England)"],"local_id":["urn:cst:10017041436","urn:bwbsku:KJ-644-909"],"full_title":"Sikhism today","lc_classifications":["BL2017.45 .J48 2011","BL2018"],"key":"/books/OL25008293M","authors":[{"key":"/authors/OL6986227A","name":"Jagbir Jhutti-Johal"}],"publish_places":["London","New York"],"subjects":["Sikhism"],"isbn_13":["9781847062710","9781847062727"],"pagination":"xiii, 147 p. ;","source_records":["marc:marc_loc_updates/v39.i35.records.utf8:5382846:870","marc:marc_loc_updates/v39.i41.records.utf8:7529759:1092","marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:79267768:2253","bwb:9781847062727","marc:marc_loc_2016/BooksAll.2016.part37.utf8:166962086:1195","ia:sikhismtoday0000jhut","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:79309319:2253","ia:sikhismtoday0000jhut_y1y4","bwb:9781847062710","amazon:1847062717","marc:marc_columbia/Columbia-extract-20221130-018.mrc:87212422:925","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:676429930:1205","promise:bwb_daily_pallets_2020-12-23","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:48049696:3327","marc:harvard_bibliographic_metadata/20220215_026.bib.mrc:340094523:2208"],"title":"Sikhism today","lccn":["2010045169"],"notes":{"type":"/