languages/eng"}],"publish_date":"2021","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781000476521"],"title":"Reimagining Chan Buddhism","pagination":"192","subtitle":"Sheng Yen and the Creation of the Dharma Drum Lineage of Chan","full_title":"Reimagining Chan Buddhism Sheng Yen and the Creation of the Dharma Drum Lineage of Chan","works":[{"key":"/works/OL25332701W"}],"key":"/books/OL34783068M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-08T01:09:06.947742"},"last_modified":{"type":"/type/datetime","value":"2021-10-08T01:09:06.947742"}}},"ISBN:9781003196372":{"bib_key":"ISBN:9781003196372","info_url":"http://openlibrary.org/books/OL36265455M/Reimagining_Chan_Buddhism","preview":"noview","preview_url":"http://openlibrary.org/books/OL36265455M/Reimagining_Chan_Buddhism","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8124954A","name":"Jimmy Yu"}],"isbn_13":["9781003196372"],"languages":[{"key":"/languages/eng"}],"pagination":"216","publish_date":"2021","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781003196372"],"title":"Reimagining Chan Buddhism","subtitle":"Sheng Yen and the Creation of the Dharma Drum Lineage of Chan","full_title":"Reimagining Chan Buddhism Sheng Yen and the Creation of the Dharma Drum Lineage of Chan","works":[{"key":"/works/OL25332701W"}],"key":"/books/OL36265455M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-12-29T21:29:43.088699"},"last_modified":{"type":"/type/datetime","value":"2021-12-29T21:29:43.088699"}}},"ISBN:9781032048444":{"bib_key":"ISBN:9781032048444","info_url":"http://openlibrary.org/books/OL33935684M/Reimagining_Chan_Buddhism","preview":"noview","preview_url":"http://openlibrary.org/books/OL33935684M/Reimagining_Chan_Buddhism","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8124954A","name":"Jimmy Yu"}],"isbn_13":["9781032048444"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BQ9265.4.Y824 2021","BQ9265.4 .Y824 2022"],"publish_date":"2021","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781032048444","marc:marc_columbia/Columbia-extract-20221130-032.mrc:115997774:5256","marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:214533796:5781"],"subjects":["Buddhism"],"title":"Reimagining Chan Buddhism","works":[{"key":"/works/OL25332701W"}],"key":"/books/OL33935684M","lccn":["2021023632","2021023631"],"oclc_numbers":["1252738811","1252738695"],"description":{"type":"/type/text","value":"\"This book is the first socio-intellectual history of the Dharma Drum Lineage of Chan (Zen), a new form of Buddhism founded by the late Chinese Buddhist cleric, Sheng Yen (1931-2009)-arguably one of the most influential Chan masters in contemporary times. The received academic and popular image of Chan Buddhism is that it is a meditation school that bypasses scriptural learning to direct awakening. Sheng Yen's Chan teachings complicates this image. The heart of the book centers on his doctrinal classification (Chn. panjiao) chart written in 1998 in preparation for a dialogue with the Dalai Lama. This chart synthesizes both major strands of Madhyamaka and Yoga ca ra Indian Buddhism as well as premodern Chinese Tiantai and Huayan Buddhism. It also and presents Chan as the summum bonum of Han Chinese Buddhism. The author presents a historical and culturally embodied approach to the formation of Buddhist doctrine and practice, showing how Sheng Yen's understanding of Chan was intimately related to the volatile social and political realities of his life-the Communist takeover of China and the subsequent industrial boom that impacted Taiwanese society. Drawing on the works of postcolonial theories that integrate the role of the researcher into the research, the book also offers a more integrated approach between emic and etic, insider and outsider perspectives to research. Advancing the field of Buddhist studies, the book will be of interest to scholars of Buddhism in the modern period, twentieth-century religious history of China and Taiwan, Chan/Zen studies, World Religions, Asian civilizations, and Modern Biographies\"--"},"number_of_pages":216,"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2021-09-28T12:42:20.558564"},"last_modified":{"type":"/type/datetime","value":"2025-05-20T20:58:49.325569"}}},"ISBN:9781306013574":{"bib_key":"ISBN:9781306013574","info_url":"http://openlibrary.org/books/OL53927738M/Zen_Dust","preview":"noview","preview_url":"http://openlibrary.org/books/OL53927738M/Zen_Dust","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL6620172A","name":"Antony Osler"}],"isbn_13":["9781306013574"],"languages":[{"key":"/languages/eng"}],"number_of_pages":210,"publish_date":"2012","publishers":["Jacana Media"],"source_records":["bwb:9781306013574"],"title":"Zen Dust","subtitle":"a Journey Home Through the Back Roads of South Africa","full_title":"Zen Dust a Journey Home Through the Back Roads of South Africa","works":[{"key":"/works/OL26310754W"}],"key":"/books/OL53927738M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-09-17T12:33:08.782172"},"last_modified":{"type":"/type/datetime","value":"2024-09-17T12:33:08.782172"}}},"ISBN:9781431406173":{"bib_key":"ISBN:9781431406173","info_url":"http://openlibrary.org/books/OL35484869M/Zen_Dust","preview":"noview","preview_url":"http://openlibrary.org/books/OL35484869M/Zen_Dust","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL6620172A","name":"Antony Osler"}],"isbn_13":["9781431406173"],"languages":[{"key":"/languages/eng"}],"pagination":"184","publish_date":"2013","publishers":["Jacana Education"],"source_records":["bwb:9781431406173"],"subjects":["Spiritual life, zen buddhism","South africa, social life and customs"],"title":"Zen Dust","weight":"0.718","subtitle":"A Journey Home Through the Back Roads of South Africa","full