92"],"key":"/books/OL1709258M","authors":[{"key":"/authors/OL116100A","name":"Francis de Sales"}],"publish_places":["New York"],"contributions":["Dollen, Charles."],"work_title":["Introduction à la vie dévote."],"pagination":"xx, 185 p. ;","source_records":["marc:marc_records_scriblio_net/part22.dat:153469582:875","marc:marc_loc_updates/v36.i39.records.utf8:1950252:848","marc:marc_loc_2016/BooksAll.2016.part21.utf8:189276316:848","marc:harvard_bibliographic_metadata/ab.bib.02.20150123.full.mrc:548507202:981","marc:harvard_bibliographic_metadata/20220215_007.bib.mrc:125561053:2324"],"title":"Introduction to the devout life","dewey_decimal_class":["248.4/82"],"notes":{"type":"/type/text","value":"Includes bibliographical references  (p. 181) and index.\nTranslation of: Introduction à la vie dévote."},"number_of_pages":185,"languages":[{"key":"/languages/eng"}],"lccn":["92010914"],"subjects":["Meditations -- Early works to 1800"],"publish_date":"1992","publish_country":"nyu","by_statement":"St. Francis de Sales ; edited and abridged by Charles Dollen.","oclc_numbers":["25713061"],"works":[{"key":"/works/OL1140014W"}],"type":{"key":"/type/edition"},"description":{"type":"/type/text","value":"Unlike so many of the other spiritual books of his time which were written for persons who had withdrawn from the world or were preparing to do so, this work was addressed to those who lived in cities, who had jobs and families to think about on top of trying to live a life which was both sanctifying and fulfilling. The book begins by detailing the need for a firm resolve to lead a life of union with the Lord and then it discusses the means: sacraments, prayer, the practice of virtue, things to be avoided and finally exercises to help one to continue to grow spiritually."},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-06-30T16:05:34.550379"}}},"ISBN:9780486471686"