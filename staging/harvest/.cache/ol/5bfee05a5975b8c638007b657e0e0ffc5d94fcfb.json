ical_format":"paperback","full_title":"Respira La nueva ciencia de un arte olvidado","subtitle":"La nueva ciencia de un arte olvidado","notes":{"type":"/type/text","value":"Source title: Respira: La nueva ciencia de un arte olvidado (No Ficción) (Spanish Edition)"},"covers":[10828592],"works":[{"key":"/works/OL20799952W"}],"key":"/books/OL32161704M","latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2021-03-30T14:47:31.947363"},"last_modified":{"type":"/type/datetime","value":"2022-12-12T19:38:55.974692"}}},"ISBN:9780241289082":{"bib_key":"ISBN:9780241289082","info_url":"http://openlibrary.org/books/OL28401508M/Breath","preview":"noview","preview_url":"http://openlibrary.org/books/OL28401508M/Breath","thumbnail_url":"https://covers.openlibrary.org/b/id/10313754-S.jpg","details":{"publishers":["Penguin Life"],"subtitle":"The Lost Art and Science of Our Most Misunderstood Function","covers":[10313754],"physical_format":"paperback","full_title":"Breath The Lost Art and Science of Our Most Misunderstood Function","key":"/books/OL28401508M","authors":[{"key":"/authors/OL6704799A","name":"James Nestor"}],"source_records":["amazon:0241289084","marc:harvard_bibliographic_metadata/20220215_015.bib.mrc:208797968:3653"],"title":"Breath","notes":{"type":"/type/text","value":"Source title: Breath: The Lost Art and Science of Our Most Misunderstood Function"},"number_of_pages":336,"isbn_13":["9780241289082"],"isbn_10":["0241289084"],"publish_date":"Jun 18, 2020","works":[{"key":"/works/OL20799952W"}],"type":{"key":"/type/edition"},"lc_classifications":["RA782 .N47 2021"],"oclc_numbers":["1263626450"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"300,000 years ago, Homo sapiens had bigger skulls. Cooked food meant our heads shrunk; alongside a growing brain, our airways got narrower. Urbanisation then led us to breathe less deeply and less healthily. And so today more than 90% of us breathe incorrectly. So we might have been breathing all our life, but we need to learn how to breathe properly! In Breath, James Nestor meets cutting-edge scientists at Harvard and experiments on himself in labs at Stanford to see the impact of bad breathing. He revives the lost, and recently scientifically proven, wisdom of swim coaches, Indian mystics, stern-faced Russian cardiologists, Czechoslovakian Olympians and New Jersey choral conductors, the world's foremost 'pulmonauts' to show how breathing in specific patterns can trigger our bodies to absorb more oxygen, and he explains the benefits for everyone that result, from staying healthy and warding off anxiety to improving focus and losing weight. Breath is a fascinating ride through evolution, medicine and physiology and extreme sports."},"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2020-07-27T18:57:54.252902"},"last_modified":{"type":"/type/datetime","value":"2025-09-03T03:31:43.184392"}}},"ISBN:9780735213616":{"bib_key":"ISBN:9780735213616","info_url":"http://openlibrary.org/books/OL29844566M/Breath","preview":"noview","preview_url":"http://openlibrary.org/books/OL29844566M/Breath","thumbnail_url":"https://covers.openlibrary.org/b/id/11696666-S.jpg","details":{"publishers":["Riverhead Books"],"subtitle":"The New Science of a Lost Art","source_records":["bwb:9780735213630","bwb:9780735213616"],"title":"Breath","number_of_pages":304,"languages":[{"key":"/languages/eng"}],"full_title":"Breath The New Science of a Lost Art","publish_date":"2020","key":"/books/OL29844566M","authors":[{"key":"/authors/OL6704799A","name":"James Nestor"}],"works":[{"key":"/works/OL20799952W"}],"type":{"key":"/type/edition"},"subjects":["Respiration","Breathing exercises"],"identifiers":{"amazon":["0735213615"]},"covers":[11696666],"physical_dimensions":"9.28 x 6.16 x 1.04 inches","weight":"1.1 pounds","physical_format":"Hardcover","edition_name":"hardcover","copyright_date":"26-May-2020","publish_places":["New York"],"pagination":"278