436"],"title":"Handbook of Religions in Ancient Europe","lccn":["2013496837"],"number_of_pages":512,"isbn_13":["9781844657094"],"lc_classifications":["","BL690 .H35 2013","BL690","BL690 .H36 2013","BL690 H36 2013"],"publish_date":"2014","key":"/books/OL28773334M","authors":[{"key":"/authors/OL8139230A","name":"Lisbeth  Bredholt Christensen"},{"key":"/authors/OL3191136A","name":"Olav Hammer"},{"key":"/authors/OL422565A","name":"David Warburton"}],"works":[{"key":"/works/OL21252807W"}],"type":{"key":"/type/edition"},"subjects":["Europe, religion","Civilization, ancient"],"oclc_numbers":["890531439","827262011"],"description":{"type":"/type/text","value":"\"The Handbook of Religions in Ancient Europe surveys the major religious currents of Europe before Christianity--the first continental religion with hegemonic ambition--wiped out most local religions. The evidence--whether archaeological or written--is notoriously difficult to interpret, and the variety of religions documented by the sources and the range of languages used are bewildering. The Handbook brings together leading authorities on pre-Christian religious history to provide a state-of-the-art survey. The first section of the book covers the prehistoric period, from the Paleolithic to the Bronze Age. The second section covers the period since writing systems began. Ranging across the Mediterranean and Northern, Celtic and Slavic Europe, the essays assess the archaeological and textual evidence. Dispersed archaeological remains and biased outside sources constitute our main sources of information, so the complex task of interpreting these traces is explained for each case. The Handbook also aims to highlight the plurality of religions in ancient Europe: the many ways in which it is expressed, notably in discourse, action, organization, and material culture; how it is produced and maintained by different people with different interests; how communities always connect with or disassociate from adjunct communities and how their beliefs and rituals are shaped by these relationships.\"--Publisher's Web site."},"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2020-08-15T15:02:10.924099"},"last_modified":{"type":"/type/datetime","value":"2026-01-14T07:53:50.365919"}}},"ISBN:9781322130385":{"bib_key":"ISBN:9781322130385","info_url":"http://openlibrary.org/books/OL53984558M/Handbook_of_Religions_in_Ancient_Europe","preview":"noview","preview_url":"http://openlibrary.org/books/OL53984558M/Handbook_of_Religions_in_Ancient_Europe","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL10444294A","name":"Lisbeth Bredholt Christensen"},{"key":"/authors/OL3191136A","name":"Olav Hammer"},{"key":"/authors/OL422565A","name":"David Warburton"}],"isbn_13":["9781322130385"],"languages":[{"key":"/languages/eng"}],"number_of_pages":471,"publish_date":"2014","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781322130385"],"title":"Handbook of Religions in Ancient Europe","full_title":"Handbook of Religions in Ancient Europe","works":[{"key":"/works/OL21252807W"}],"key":"/books/OL53984558M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-09-17T22:04:14.688901"},"last_modified":{"type":"/type/datetime","value":"2024-09-17T22:04:14.688901"}}},"ISBN:9781317273790":{"bib_key":"ISBN:9781317273790","info_url":"http://openlibrary.org/books/OL53960920M/Religious_and_Philosophical_Traditions_of_Korea","preview":"noview","preview_url":"http://openlibrary.org/books/OL53960920M/Religious_and_Philosophical_Traditions_of_Korea","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8161532A","name":"Kevin Cawley"}],"dewey_decimal_class":["200.9519"],"isbn_13":["9781317273790"],"languages":[{"key":"/languages/eng"}],"number_of_pages":198,"publish_date":"2019","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781317273790"],"subjects":["Philosophy, korean","Korea, religion"],"title":"Relig