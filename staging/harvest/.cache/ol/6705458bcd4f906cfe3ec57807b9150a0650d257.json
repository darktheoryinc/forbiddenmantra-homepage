005"],"publish_date":"2005","publishers":["State University of New York Press"],"source_records":["bwb:9781423748526"],"subjects":["Sikhism"],"title":"Birth of the Khalsa","subtitle":"A Feminist Re-memory of Sikh Identity","full_title":"Birth of the Khalsa A Feminist Re-memory of Sikh Identity","works":[{"key":"/works/OL4298207W"}],"key":"/books/OL54475072M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-09-21T11:18:49.455917"},"last_modified":{"type":"/type/datetime","value":"2024-09-21T11:18:49.455917"}}},"ISBN:9780791465837":{"bib_key":"ISBN:9780791465837","info_url":"http://openlibrary.org/books/OL7803531M/The_Birth_of_the_Khalsa","preview":"noview","preview_url":"http://openlibrary.org/books/OL7803531M/The_Birth_of_the_Khalsa","thumbnail_url":"https://covers.openlibrary.org/b/id/1493426-S.jpg","details":{"publishers":["State University of New York Press"],"subtitle":"A Feminist Re-memory of Sikh Identity","weight":"15.5 ounces","isbn_10":["0791465837"],"covers":[1493426],"physical_format":"Hardcover","key":"/books/OL7803531M","authors":[{"key":"/authors/OL834777A","name":"Nikky-Guninder Kaur Singh"}],"subjects":["Religion - World Religions","Religion","Women in Sikhism","Sikhism","Eastern - General","Khalsa (Sect)"],"isbn_13":["9780791465837"],"source_records":["marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:41546099:4121","marc:marc_loc_2016/BooksAll.2016.part31.utf8:193342682:839","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:41561978:4121","bwb:9780791465837","marc:marc_columbia/Columbia-extract-20221130-011.mrc:295979268:2917","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:762142361:2403","marc:harvard_bibliographic_metadata/20220215_010.bib.mrc:205272587:3745"],"title":"The Birth of the Khalsa","number_of_pages":224,"languages":[{"key":"/languages/eng"}],"local_id":["urn:cst:10017028733"],"publish_date":"October 6, 2005","works":[{"key":"/works/OL4298207W"}],"type":{"key":"/type/edition"},"physical_dimensions":"9.1 x 6.1 x 0.8 inches","lccn":["2004065340"],"lc_classifications":["BL2018.7.K44 S55 2005","BL2018.7.K44S55 2005"],"oclc_numbers":["57142791"],"description":{"type":"/type/text","value":"\"Sikhs trace the genesis of their religious rites, prayers, dress codes, and names to Guru Gobind Singh's creation of the Khalsa in 1699. The Birth of the Khalsa is the first work to explore this pivotal event in Sikh history from a feminist perspective, questioning the ways in which Sikh memories have constructed a hypermasculine Sikh identity. The book argues that Sikh memory needs to acknowledge the vital female dimension grounded in the universal human condition and present at the birth of the Khalsa.\" \"Inspired by her own father, the eminent Sikh scholar Harbans Singh, Nikky-Guninder Kaur Singh rediscovers the feminine side of the words and actions of the founders of Sikhism. She looks at the basic texts and tenets of Sikh religion and demonstrates the female aspect in the sacred text, daily prayers, dress code, and rituals of the Sikhs. Singh reminds us that Guru Gobind Singh's original vision was an egalitarian one and urges present-day Sikhs to live up to the liberating implications set in motion when he gave birth to the Khalsa.\"--BOOK JACKET."},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-29T15:03:11.581851"},"last_modified":{"type":"/type/datetime","value":"2025-07-20T05:17:18.109889"}}},"ISBN:9780791465844":{"bib_key":"ISBN:9780791465844","info_url":"http://openlibrary.org/books/OL7803532M/The_Birth_of_the_Khalsa","preview":"noview","preview_url":"http://openlibrary.org/books/OL7803532M/The_Birth_of_the_Khalsa","thumbnail_url":"https://covers.openlibrary.org/b/id/556928-S.jpg","details":{"publishers":["State University of New York Press"],"number_of_pages":224,"subtitle":"A Feminist Re-Memory of Sikh Identity (SUNY Series in Religious Studies)","weight":"10.4 ounces","covers":[556928],"phys