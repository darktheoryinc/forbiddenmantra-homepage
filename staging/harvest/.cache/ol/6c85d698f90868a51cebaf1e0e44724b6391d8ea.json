pe/text","value":"The lives of these two saints with similar names could hardly be more contrasting. St. Teresa, reformer of the Carmelites, 'busy woman and great saint', endured the religious mania of sixteenth-century Spain and lived in a state of near perpetual ecstasy. Thérèse, on the other hand, lived the quiet life of a nun in late-nineteenth-century France, was meek, devout and perhaps rather dim. She became a saint of the common people, largely because of the ordinariness of her life (excepting the odd vision)."},"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-04-29T15:03:11.581851"},"last_modified":{"type":"/type/datetime","value":"2025-08-30T11:28:35.842377"}}},"ISBN:9780718106942":{"bib_key":"ISBN:9780718106942","info_url":"http://openlibrary.org/books/OL19644175M/The_eagle_the_dove","preview":"noview","preview_url":"http://openlibrary.org/books/OL19644175M/The_eagle_the_dove","details":{"publishers":["Michael Joseph"],"number_of_pages":182,"subtitle":"a study in contrasts, St. Teresa of Avila, St. Thérèse of Lisieux","isbn_10":["0718106946","0718106946"],"lc_classifications":["BX4700T4 S25 1943","BX4700.T4 S25 1969"],"key":"/books/OL19644175M","authors":[{"key":"/authors/OL137459A","name":"Vita Sackville-West"}],"publish_places":["London"],"pagination":"182 p., [3] leaves of plates :","source_records":["marc:marc_loc_2016/BooksAll.2016.part08.utf8:83983222:900","bwb:9780718106942"],"title":"The eagle & the dove","dewey_decimal_class":["271.9710922","922.246"],"identifiers":{"goodreads":["615770"],"librarything":["178087"]},"languages":[{"key":"/languages/eng"}],"lccn":["73583280"],"subjects":["Teresa, -- of Avila, Saint, -- 1515-1582","Thérèse, -- de Lisieux, Saint, -- 1873-1897"],"publish_date":"1943","publish_country":"enk","by_statement":"V. Sackville-West.","works":[{"key":"/works/OL1347342W"}],"type":{"key":"/type/edition"},"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-10-23T10:37