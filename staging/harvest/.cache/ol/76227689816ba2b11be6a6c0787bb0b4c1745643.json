o_url":"http://openlibrary.org/books/OL29885857M/Realizing_Islam","preview":"noview","preview_url":"http://openlibrary.org/books/OL29885857M/Realizing_Islam","details":{"publishers":["University of North Carolina Press"],"subtitle":"The Tijaniyya in North Africa and the Eighteenth-Century Muslim World","source_records":["bwb:9781469660820","marc:marc_columbia/Columbia-extract-20221130-031.mrc:311951347:2742","marc:harvard_bibliographic_metadata/20220215_009.bib.mrc:262904469:4118"],"title":"Realizing Islam","number_of_pages":320,"isbn_13":["9781469660820"],"languages":[{"key":"/languages/eng"}],"full_title":"Realizing Islam The Tijaniyya in North Africa and the Eighteenth-Century Muslim World","lc_classifications":["","BP189.7.T5W75 2020","BP189.7.T5 W75 2020"],"publish_date":"2020","key":"/books/OL29885857M","authors":[{"key":"/authors/OL3753852A","name":"Zachary Valentine Wright"}],"works":[{"key":"/works/OL21911674W"}],"type":{"key":"/type/edition"},"lccn":["2020010716"],"oclc_numbers":["1145896265"],"description":{"type":"/type/text","value":"\"The Tijaniyya is the largest Sufi order in West and North Africa. In this unprecedented analysis of the Tijaniyya's origins and development in the late eighteenth century, Zachary Valentine Wright situates the order within the broader intellectual history of Islam in the early modern period. While introducing the group's founder, Ahmad al-Tijani (1735-1815), Wright's focus is on the wider network in which the order developed-a veritable global Islamic revival whose scholars commanded large followings, shared key ideas, and produced literature read widely throughout the Muslim world. They were linked, Wright shows, through chains of knowledge transmission in the face of widespread Muslim prejudice against Sufism\"--"},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-09-01T08:45:06.156229"},"last_modified":{"type":"/type/datetime","value":"2025-07-22T23:22:44.828540"}}},"ISBN:9798890860125":{"bib_key":"ISBN:9798890860125","info_url":"http://openlibrary.org/books/OL49782009M/Realizing_Islam","preview":"noview","preview_url":"http://openlibrary.org/books/OL49782009M/Realizing_Islam","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL3753852A","name":"Zachary Valentine Wright"}],"isbn_13":["9798890860125"],"languages":[{"key":"/languages/eng"}],"pagination":"326","publish_date":"2021","publishers":["University of North Carolina Press"],"source_records":["bwb:9798890860125"],"title":"Realizing Islam","subtitle":"The Tijaniyya in North Africa and the Eighteenth-Century Muslim World","full_title":"Realizing Islam The Tijaniyya in North Africa and the Eighteenth-Century Muslim World","works":[{"key":"/works/OL21911674W"}],"key":"/books/OL49782009M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-10-17T12:16:17.947298"},"last_modified":{"type":"/type/datetime","value":"2023-10-17T12:16:17.947298"}}},"ISBN:9781474237604":{"bib_key":"ISBN:9781474237604","info_url":"http://openlibrary.org/books/OL37193718M/Sufism_in_Britain","preview":"noview","preview_url":"http://openlibrary.org/books/OL37193718M/Sufism_in_Britain","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL1426002A","name":"Ron Geaves"},{"key":"/authors/OL2830375A","name":"Theodore Gabriel"}],"isbn_13":["9781474237604"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BP188.8.G7S84 2015"],"pagination":"280","publish_date":"2015","publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781474237604"],"subjects":["Sufism","Great britain, religion"],"title":"Sufism in Britain","weight":"0.400","full_title":"Sufism in Britain","works":[{"key":"/works/OL17580892W"}],"key":"/books/OL37193718M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-02-26T23:42:46.895918"},"last_modified":{"type":"/type/datetime","value":"2022-02-26T23:42:46.895918"}}},"ISBN:9781441112613":{"bib_key":"ISBN:9781441112613","info_url":"http://openlibrary.org/books/OL26184046M/Sufism_In_Britain","preview":"noview","preview_url":"http://openlibrary.org/books/OL26184046M/Sufism_In_Britain","thumbnail_url":"https://covers.openlibrary.org/b/id/7862492-S.jpg","details":{"publishers":["Continuum Publishing Corporation"],"source_records":["marc:marc_loc_2016/BooksAll.2016.part40.utf8:238000787:2135","bwb:9781441112613","marc:marc_columbia/Columbia-extract-20221130-022.mrc:59158564:2435","marc:harvard_bibliographic_metadata/ab.bib.13.20150123.full.mrc:991283525:2523","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:46913024:4017","marc:harvard_bibliographic_metadata/20220215_031.bib.mrc:19713764:3356"],"title":"Sufism In Britain","lccn":["2013029935"],"identifiers":{"doi":["10.5040/9781472552631"]},"covers":[7862492],"isbn_13":["9781441112613"],"lc_classifications":["BP188.8.G7 S84 2013","BP188.8.G7","BP188.8.G7 S84 2014"],"publish_date":"2013","key":"/books/OL26184046M","works":[{"key":"/works/OL17580892W"}],"type":{"key":"/type/edition"},"oclc_numbers":["854848162","1166375994"],"number_of_pages":264,"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"\"This volume provides an objective analysis of current trends and developments in the beliefs and practices of Sufis in Britain. Sufism is a dynamic and substantial presence within British Muslim communities and is influencing both religious and political discourses concerning the formation of Islam in Britain. In the 21st century Sufis have re-positioned themselves to represent the views of a 'Traditional Islam', a non-violent 'other Islam', able to combat the discourses of radical movements. Major transformations have taken place in Sufism that illuminate debates over authenticity, legitimacy, and authority within Islam, and religion more generally. Through examining the theory and history involved, as well as a series of case studies, Sufism in Britain charts the processes of change and offers a significant contribution to the political and religious re-organisation of the Muslim presence in Britain, and the West.\"--Bloomsbury Publishing."},"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2016-10-19T05:31:00.346668"},"last_modified":{"type":"/type/datetime","value":"2026-02-11T15:35:20.477092"}}},"ISBN:9781306726443":{"bib_key":"ISBN:9781306726443","info_url":"http://openlibrary.org/books/OL48652612M/Sufism_in_Britain","preview":"noview","preview_url":"http://openlibrary.org/books/OL48652612M/Sufism_in_Britain","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL1426002A","name":"Ron Geaves"},{"key":"/authors/OL2830375A","name":"Theodore Gabriel"}],"isbn_13":["9781306726443"],"languages":[{"key":"/languages/eng"}],"pagination":"281","publish_date":"2013","publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781306726443"],"subjects":["Sufism","Great britain, religion"],"title":"Sufism in Britain","full_title":"Sufism in Britain","works":[{"key":"/works/OL17580892W"}],"key":"/books/OL48652612M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-07-17T06:56:54.347512"},"last_modified":{"type":"/type/datetime","value":"2023-07-17T06:56:54.347512"}}},"ISBN:9781441114877":{"bib_key":"ISBN:9781441114877","info_url":"http://openlibrary.org/books/OL48650106M/Sufism_in_Britain","preview":"noview","preview_url":"http://openlibrary.org/books/OL48650106M/Sufism_in_Britain","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL1426002A","name":"Ron Geaves"},{"key":"/authors/OL2830375A","name":"Theodore Gabriel"}],"isbn_13":["9781441114877"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BP188.8.G7.S84 2013"],"pagination":"224","publish_date":"2013","publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781441114877"],"subjects":["Sufism","Great britain, religion"],"title":"Sufism in Britain","full_title":"Sufism in Britain","works":[{