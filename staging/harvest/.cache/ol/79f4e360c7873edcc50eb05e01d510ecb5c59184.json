24:KN-703-126"],"isbn_13":["9781782495390"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BF637.M4"],"type":{"key":"/type/edition"},"subjects":["Mantras","Mindfulness (psychology)","Meditations"],"local_id":["urn:bwbsku:KN-703-126"],"ocaid":"isbn_9781782495390","key":"/books/OL28639001M","number_of_pages":144,"works":[{"key":"/works/OL21154911W"}],"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2020-08-05T18:46:08.479443"},"last_modified":{"type":"/type/datetime","value":"2024-03-22T09:47:54.814003"}}},"ISBN:9781844095988":{"bib_key":"ISBN:9781844095988","info_url":"http://openlibrary.org/books/OL28422383M/Modern_magic","preview":"borrow","preview_url":"https://archive.org/details/modernmagicmantr0000ridd","thumbnail_url":"https://covers.openlibrary.org/b/id/10321424-S.jpg","details":{"publishers":["Findhorn Press"],"subtitle":"mantras for daily life","description":{"type":"/type/text","value":"Taking a wholly original approach to self-improvement by harnessing the innate magic within each person, this spiritual survival guide reveals how to utilize everyday routines and surroundings to become a better version of oneself. Offering a modern appeal and quirky sense of fun, newcomers to the practice of magic or those hesitant to commit to a new lifestyle will find the book to be a relaxed, welcoming aid that inspires confidence in the art. The author also takes on existing rituals and magic from different eras and nations and adapts them to the contemporary reader. Enchantment as part of the everyday and the incorporation of common objects, including modern technology, into magic is clearly explained. The book provides instructions on how to manifest what is needed to fulfill desires and needs and guidelines for individuals to fully embrace the creative and contemporary aspects of themselves. -- Publisher description."},"links":[{"url":"http://www.freading.com/ebooks/details/r:download/NTUwNzg2Mjc=","title":"Freading"},{"url