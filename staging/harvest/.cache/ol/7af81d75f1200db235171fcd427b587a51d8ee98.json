n_10":["0198261950"],"publish_date":"1990","publish_country":"enk","by_statement":"Alan C. Clifford.","works":[{"key":"/works/OL2541898W"}],"type":{"key":"/type/edition"},"ocaid":"atonementjustifi0000clif","oclc_numbers":["20522397"],"description":{"type":"/type/text","value":"This title provides an examination and comparison of the theological views of John Owen, the Puritan pastor and theologian, and John Wesley, particularly concerning the doctrine of atonement and justification, in which they represented the Calvinist and Arminian interpretations of the controversy."},"latest_revision":17,"revision":17,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-01-04T16:54:19.216943"}}},"ISBN:9780521464765":{"bib_key":"ISBN:9780521464765","info_url":"http://openlibrary.org/books/OL1437994M/Theology_ideology_and_liberation","preview":"restricted","preview_url":"https://archive.org/details/theologyideology0000scot","thumbnail_url":"https://covers.openlibrary.org/b/id/340935-S.jpg","details":{"publishers":["Cambridge University Press"],"identifiers":{"goodreads":["1551705"],"librarything":["6522512"]},"subtitle":"towards a liberative theology","isbn_10":["0521464765"],"series":["Cambridge studies in ideology and religion ;","6"],"covers":[340935],"lc_classifications":["BT738 .S394 1994"],"key":"/books/OL1437994M","authors":[{"key":"/authors/OL389004A","name":"Scott, Peter"}],"ocaid":"theologyideology0000scot","publish_places":["Cambridge","New York"],"subjects":["Christian sociology.","Idolatry.","Ideology -- Religious aspects -- Christianity.","Liberation theology."],"lccn":["93051059"],"uri_descriptions":["Publisher description","Table of contents"],"pagination":"xiv, 272 p. ;","source_records":["amazon:0521464765","ia:theologyideology0000scot","marc:marc_claremont_school_theology/CSTMARC1_barcode.mrc:207508899:4216","bwb:9780521464765","marc:marc_loc_2016/BooksAll.2016.part22.utf8:188791286:1032","marc:marc_claremont_school_theology/CSTMARC1_multibarcode.mrc:207772418:4216","marc:marc_columbia/Columbia-extract-20221130-014.mrc:170902476:1768","marc:harvard_bibliographic_metadata/20220215_040.bib.mrc:163657508:3263"],"title":"Theology, ideology, and liberation","url":["http://www.loc.gov/catdir/description/cam026/93051059.html","http://www.loc.gov/catdir/toc/cam028/93051059.html"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 261-267) and index."},"number_of_pages":272,"languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["230/.046"],"local_id":["urn:cst:10011348937"],"publish_date":"1994","publish_country":"enk","by_statement":"Peter Scott.","works":[{"key":"/works/OL2666900W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/description/cam026/93051059.html","http://www.loc.gov/catdir/toc/cam028/93051059.html"],"oclc_numbers":["29668973"],"description":{"type":"/type/text","value":"How is theology liberating? In this post-Gorbachev world in which many demand freedom, and which the West seems ill-equipped to deliver, can we even envisage a liberative theology? Taking as his starting point the Marxist complaint that Christianity is ideological, Dr Scott argues that it is not enough for Christian theology to talk about liberation. It must be liberative. Stressing with feminist and liberation theologies the embodied, contextual nature of theology, the constructive proposal made here locates God's liberating abundance towards society in an interpretation of resurrection as social. Only in this way can a trinitarian Christian account of liberation be adequately grounded. This study will be of interest to those who wish to know if theology may speak truthfully about the transformation of society. In a period of crisis and hope, the book offers the shape of a liberative theology that might nerve Christian practice towards social freedom."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetim