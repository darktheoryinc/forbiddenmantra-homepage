g/books/OL28931344M/Studying_Hasidism","details":{"publishers":["Rutgers University Press"],"subtitle":"Sources, Methods, Perspectives","source_records":["bwb:9781978804210"],"title":"Studying Hasidism","number_of_pages":314,"isbn_13":["9781978804210"],"languages":[{"key":"/languages/eng"}],"full_title":"Studying Hasidism Sources, Methods, Perspectives","lc_classifications":["BM198.3.S78 2019"],"publish_date":"2019","key":"/books/OL28931344M","authors":[{"key":"/authors/OL264596A","name":"Marcin Wodziński"},{"key":"/authors/OL7343703A","name":"Levi Cooper"},{"key":"/authors/OL7704749A","name":"Maya Balakirsky Katz"},{"key":"/authors/OL8180364A","name":"Gadi Sagiv"}],"works":[{"key":"/works/OL21350586W"}],"type":{"key":"/type/edition"},"subjects":["Hasidism"],"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2020-08-18T03:26:53.669387"},"last_modified":{"type":"/type/datetime","value":"2024-07-22T18:06:58.782356"}}},"ISBN:9781978804227":{"bib_key":"ISBN:9781978804227","info_url":"http://openlibrary.org/books/OL28918972M/Studying_Hasidism","preview":"noview","preview_url":"http://openlibrary.org/books/OL28918972M/Studying_Hasidism","details":{"publishers":["Rutgers University Press"],"subtitle":"Sources, Methods, Perspectives","source_records":["bwb:9781978804227","marc:marc_columbia/Columbia-extract-20221130-029.mrc:72085256:3294","marc:harvard_bibliographic_metadata/20220215_014.bib.mrc:296944823:3893"],"title":"Studying Hasidism","number_of_pages":314,"isbn_13":["9781978804227"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BM198.3.S78 2019","BM198.3 .S78 2019"],"publish_date":"2019","key":"/books/OL28918972M","authors":[{"key":"/authors/OL264596A","name":"Marcin Wodziński"},{"key":"/authors/OL7343703A","name":"Levi Cooper"},{"key":"/authors/OL7704749A","name":"Maya Balakirsky Katz"},{"key":"/authors/OL8180364A","name":"Gadi Sagiv"}],"works":[{"key":"/works/OL21350586W"}],"type":{"key":"/type/edition"},"subjects":["Hasidism"],"lccn":["2018039640"],"oclc_numbers":["1050143561"],"description":{"type":"/type/text","value":"\"Hasidism is a textbook that introduces sources to the study of the Hasidic movement. Hasidism, an Orthodox Jewish sect that originated in Poland in the 18th century, today counts over 400,000 adherents, primarily in the US, Israel, and the UK. Scholarly interest in this history of Hasidic Judaism and Hasidic Jews is growing, but there is no textbook dedicated to research methods in the field. Hasidism, edited by an internationally recognized historian of Hasidism, aims to remedy this gap in the literature. The work's twelve chapters each of draws upon a set of different source material (such as folklore, music, or material culture) to answer questions in the history of Hasidism. This intervention is necessary because traditionally, historians have limited their research to printed word sources, typically written by rebbes, the leaders in the community. But by doing so, historians have inadvertently erased the ordinary members of the Hasidic community while centralizing its leaders. The contributors to this volume are keenly aware of this limitation, and instead use previously untapped sources to shed new light on the subject. Ultimately, this textbook will present research methods that can decentralize the role community leaders play in the current literature and reclaim the everyday lives of Eastern Europe's Hasidic Jews. As collected whole, Hasidism \"will assemble...knowledge of existing sources for studying the history and culture of Hasidism\" into a comprehensive and unique reference work.\"--"},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-08-17T23:08:46.520387"},"last_modified":{"type":"/type/datetime","value":"2025-08-23T06:18:13.238516"}}},"ISBN:9781978804234":{"bib_key":"ISBN:9781978804234","info_url":"http://openlibrary.org/books/OL60917377M/Studying_Hasidism","preview":"noview","preview_url":"http://openlibrary.org/