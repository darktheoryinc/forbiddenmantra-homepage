ime","value":"2020-08-28T15:18:51.584214"},"languages":[{"key":"/languages/eng"}],"full_title":"Buddhism and Transgression The Appropriation of Buddhism in the Contemporary West","lc_classifications":["BQ704.K66 2009"],"publish_date":"2009","key":"/books/OL29585708M","authors":[{"key":"/authors/OL6708649A","name":"Adrian Konik"}],"latest_revision":1,"works":[{"key":"/works/OL18720169W"}],"type":{"key":"/type/edition"},"subjects":["Buddhist philosophy","Buddhism"],"revision":1}},"ISBN:9789004178755":{"bib_key":"ISBN:9789004178755","info_url":"http://openlibrary.org/books/OL24022499M/Buddhism_and_transgression","preview":"noview","preview_url":"http://openlibrary.org/books/OL24022499M/Buddhism_and_transgression","thumbnail_url":"https://covers.openlibrary.org/b/id/8625344-S.jpg","details":{"publishers":["Brill"],"subtitle":"the appropriation of Buddhism in the contemporary West","series":["Numen book series. Studies in the history of religions -- 125"],"covers":[8625344],"lc_classifications":["BQ704 .K66 2009","BQ704.K66 2009"],"key":"/books/OL24022499M","authors":[{"key":"/authors/OL6708649A","name":"Adrian Konik"}],"publish_places":["Leiden","Boston"],"isbn_13":["9789004178755"],"pagination":"xxi, 191 p. :","source_records":["marc:marc_loc_updates/v38.i04.records.utf8:10083399:847","marc:marc_loc_updates/v38.i05.records.utf8:9289845:847","ia:buddhismtransgre00koni","bwb:9789004178755","marc:marc_loc_2016/BooksAll.2016.part36.utf8:126924516:847","marc:marc_columbia/Columbia-extract-20221130-015.mrc:154473663:1456","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:129820925:1893","marc:harvard_bibliographic_metadata/20220215_045.bib.mrc:159321526:2822"],"title":"Buddhism and transgression","dewey_decimal_class":["294.309182/1"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [179]-183) and index."},"number_of_pages":191,"languages":[{"key":"/languages/eng"}],"lccn":["2009026762"],"subjects":["Buddhism -- Western countries","Buddhist philosophy"],"publish_date":"2009","publish_country":"mau","by_statement":"by Adrian Konik.","works":[{"key":"/works/OL18720169W"}],"type":{"key":"/type/edition"},"oclc_numbers":["401166087"],"description":{"type":"/type/text","value":"\"If Buddhism is to remain relevant to the contemporary era, through providing effective solutions to the proliferating and protean discursive problems encountered by its present-day practitioners, it cannot continue to ignore the role of discourse in the formation of subjectivity. In the interest of problematizing such 'ignorance: this book explores the potential interface between Foucaultian discourse analysis and the development of an indigenous rationale for the practice of contemporary Western Buddhism, along with the growing significance of such a rationale for 'traditional' Buddhism in an era dominated by disciplinary/bio-power. Through doing so, this book radically re-conceptualizes the role of Buddhism in the world today by linking Buddhist practice with acts of discursive transgression.\"--Jacket."},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2010-01-27T07:52:47.008412"},"last_modified":{"type":"/type/datetime","value":"2026-08-09T18:55:37.196446"}}},"ISBN:9780895818454":{"bib_key":"ISBN:9780895818454","info_url":"http://openlibrary.org/books/OL11310051M/Psychology_and_Philosophy_of_Buddhism","preview":"noview","preview_url":"http://openlibrary.org/books/OL11310051M/Psychology_and_Philosophy_of_Buddhism","details":{"publishers":["Asian Humanities Pr"],"physical_format":"Paperback","source_records":["amazon:0895818450"],"title":"Psychology and Philosophy of Buddhism","created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"isbn_13":["9780895818454"],"languages":[{"key":"/languages/eng"}],"authors":[{"key":"/authors/OL13498A","name":"W. F. Jayasuriya"}],"isbn_10":["0895818450"],"publish_date":"September 1984","key":"/books/OL11310051M","last_modified":{"type":"/type