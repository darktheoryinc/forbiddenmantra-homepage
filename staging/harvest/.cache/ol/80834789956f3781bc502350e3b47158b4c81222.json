/edition"},"subjects":["Senegal","Africa, west, religion","Africa, west, social conditions","Sufism"],"oclc_numbers":["992537211","975369948"],"description":{"type":"/type/text","value":"This book explores the historical, religious, cultural and economic contexts of Islam in Senegal through the narrative first-hand accounts of people's everyday lives. Drawing on rich ethnographic fieldwork conducted by the author over a period of seven years, the result is a critical look at Senegal's religious diversity within Islamic beliefs and practices. Containing interviews from men and women, in both rural and urban locations, this book is an important contribution to the literature on Islamic practices, providing a much-needed perspective from ordinary practitioners of the faith. It is essential reading for scholars of the anthropology of religion, Islamic studies, mysticism, African studies and development studies."},"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2020-08-17T01:47:58.800643"},"last_modified":{"type":"/type/datetime","value":"2026-06-18T00:50:26.939821"}}},"ISBN:9781351817967":{"bib_key":"ISBN:9781351817967","info_url":"http://openlibrary.org/books/OL54035437M/Everyday_Faith_in_Sufi_Senegal","preview":"noview","preview_url":"http://openlibrary.org/books/OL54035437M/Everyday_Faith_in_Sufi_Senegal","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7119295A","name":"Laura L. Cochrane"}],"dewey_decimal_class":["297.409663"],"isbn_13":["9781351817967"],"languages":[{"key":"/languages/eng"}],"number_of_pages":148,"publish_date":"2017","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781351817967"],"subjects":["Senegal","Africa, west, religion","Africa, west, social conditions","Sufism"],"title":"Everyday Faith in Sufi Senegal","full_title":"Everyday Faith in Sufi Senegal","works":[{"key":"/works/OL21308912W"}],"key":"/books/OL54035437M","latest_revision":1,"revision":1,"created":{"type":"/type/datet