8"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"identifiers":{"goodreads":["208464"]},"languages":[{"key":"/languages/eng"}],"url":["http://www.loc.gov/catdir/toc/ecip0616/2006021028.html","http://www.loc.gov/catdir/enhancements/fy0724/2006021028-b.html","http://www.loc.gov/catdir/enhancements/fy0724/2006021028-d.html"],"subjects":["Hongzhou (Sect) -- History.","Zen Buddhism -- China -- History."],"publish_date":"2007","publish_country":"nyu","by_statement":"Mario Poceski.","works":[{"key":"/works/OL8005802W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/toc/ecip0616/2006021028.html","http://www.loc.gov/catdir/enhancements/fy0724/2006021028-b.html","http://www.loc.gov/catdir/enhancements/fy0724/2006021028-d.html"],"oclc_numbers":["70199899"],"covers":[13281980],"number_of_pages":304,"local_id":["urn:bwbsku:S0-BCM-146"],"description":{"type":"/type/text","value":"\"Under the leadership of Mazu Daoyi (709-788) and his numerous disciples, the Hongzhou school emerged as the dominant tradition of Chan (Zen) Buddhism in China during the middle part of the Tang dynasty (618-907). Mario Poceski offers a systematic examination of the Hongzhou school's momentous growth and rise to preeminence as the bearer of Chan orthodoxy, analyzing its doctrines against the backdrop of the intellectual and religious milieus of Tang China. Poceski demonstrates that the Hongzhou school represents the first emergence of an empire-wide Chan tradition that had strongholds throughout China and replaced the various fragmented schools of early Chan with an inclusive orthodoxy.\"--Jacket."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-10-07T22:39:07.844076"},"last_modified":{"type":"/type/datetime","value":"2026-05-08T08:44:48.874557"}}},"ISBN:9781281851765":{"bib_key":"ISBN:9781281851765","info_url":"http://openlibrary.org/books/OL40420536M/Ordinary_Mind_As_the_Way","preview":"noview","preview_