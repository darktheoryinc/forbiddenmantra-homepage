. :","source_records":["marc:marc_miami_univ_ohio/allbibs0134.out:12808453:1026","marc:marc_loc_updates/v35.i20.records.utf8:174460:1131","marc:marc_loc_updates/v37.i06.records.utf8:8889:1136","marc:marc_ithaca_college/ic_marc.mrc:180261970:924","marc:marc_loc_updates/v37.i34.records.utf8:21772:1136","marc:marc_loc_2016/BooksAll.2016.part01.utf8:13344565:1136","bwb:9780195136937","ia:hoofprintofoxpri0000zhan","promise:bwb_daily_pallets_2023-08-21:W8-AWR-061","marc:marc_columbia/Columbia-extract-20221130-006.mrc:467270227:2537","marc:harvard_bibliographic_metadata/20220215_032.bib.mrc:10219670:2848"],"title":"Hoofprint of the ox","lccn":["00027699"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [223]-228) and index"},"number_of_pages":236,"languages":[{"key":"/languages/eng"}],"subjects":["Zen Buddhism","Zen meditations"],"publish_date":"2001","publish_country":"nyu","by_statement":"Master Sheng-yen with Dan Stevenson","works":[{"key":"/works/OL5919837W"}],"type":{"key":"/type/edition"},"covers":[12923479],"ocaid":"hoofprintofoxpri0000zhan","oclc_numbers":["436282485","505155787","43561883"],"local_id":["urn:bwbsku:W8-AWR-061"],"description":{"type":"/type/text","value":"\"Master Sheng-yen provides an understanding of Chan, its precepts, and its practice. Beginning with a basic overview of Buddhism and meditation, The Hoofprint of the Ox details the progressive mental exercises traditionally followed by all Buddhists. Known as the Three Disciplines, these procedures develop moral purity, meditative concentration, and enlightening insight through the \"stilling\" of the mind.\n\nMaster Sheng-yen then expounds Chan Buddhism, recounting its centuries-old history in China and illuminating its fundamental tenets. He contemplates the nature of Buddhahood, specifies the physical and mental prerequisites for beginning Chan practice, and considers what it means to be an enlightened Chan master.\".\n\n\"Drawing its title from a famous series of pictures that symbolizes the Chan path as the search of an ox-herd for his wayward ox, The Hoofprint of the Ox is a guide to self-discovery through mental transformation. A contribution to Western understanding of Chan and Zen, this book is intended for practicing Buddhists as well as anyone interested in learning about the Buddhist path.\"--BOOK JACKET."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-09-27T00:58:06.307374"},"last_modified":{"type":"/type/datetime","value":"2026-02-11T06:44:40.295078"}}},"ISBN:9780988904866":{"bib_key":"ISBN:9780988904866","info_url":"http://openlibrary.org/books/OL32120611M/Life_between_the_tigers","preview":"borrow","preview_url":"https://archive.org/details/lifebetweentiger0000unse","thumbnail_url":"https://covers.openlibrary.org/b/id/10781075-S.jpg","details":{"type":{"key":"/type/edition"},"publish_date":"2013","publish_country":"txu","languages":[{"key":"/languages/eng"}],"oclc_numbers":["848163600"],"lc_classifications":["BQ9264 .L54 2013"],"dewey_decimal_class":["294.3/927"],"edition_name":"Second edition.","authors":[{"key":"/authors/OL253166A","name":"Kris Neely"},{"key":"/authors/OL3126108A","name":"Peter Gerardo"}],"subjects":["Zen Buddhism","Zen meditations","Zen literature","Translations into English"],"title":"Life between the tigers","subtitle":"Zen wisdom in everyday English","by_statement":"edited by Kris Neely and Peter Gerardo","publishers":["Emerald Book Company"],"publish_places":["Austin, TX"],"isbn_13":["9780988904866"],"isbn_10":["0988904861"],"pagination":"379 pages","number_of_pages":379,"ocaid":"lifebetweentiger0000unse","source_records":["ia:lifebetweentiger0000unse","bwb:9780988904866","promise:bwb_daily_pallets_2020-10-07"],"covers":[10781075],"works":[{"key":"/works/OL24282174W"}],"key":"/books/OL32120611M","local_id":["urn:bwbsku:O6-EBN-375"],"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2021-03-27T10:33:39.734026"},"last_modified":