["8179922308"],"oclc_numbers":["170873147"],"physical_format":"Paperback","subjects":["Child care & upbringing"],"first_sentence":{"type":"/type/text","value":"THE SADDEST PART OF LIFE lies not in the act of dying, but in failing to truly live while we are alive."},"source_records":["amazon:8179922308"],"key":"/books/OL9082437M","number_of_pages":214,"works":[{"key":"/works/OL1854797W"}],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":{"type":"/type/datetime","value":"2026-05-10T16:10:24.315564"}}},"ISBN:9781443409032":{"bib_key":"ISBN:9781443409032","info_url":"http://openlibrary.org/books/OL26434961M/Family_wisdom_from_the_monk_who_sold_his_Ferrari","preview":"restricted","preview_url":"https://archive.org/details/familywisdomfrom0000shar","thumbnail_url":"https://covers.openlibrary.org/b/id/8147897-S.jpg","details":{"publishers":["HarperCollins"],"table_of_contents":[{"level":0,"label":"","title":"My great awakening","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The best worst experience of my life","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The gift of life","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"A monk comes to visit","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The miraculous journey of the great Julian Mantle","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The first mastery of the family leader","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The second mastery of the family leader","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The third mastery of the family leader","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The fourth mastery of the family leader.","pagenum":"","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"Richard Carlson, author of the worldwide bestseller <Don't Sweat the Small Stuff</ says that <Family Wisdom</ is \"a wonderful book that will help you become a better parent as well as a happier person.\" This is Robin's most profound book yet, rich with truly life-changing ideas on balancing work and family, transforming your family culture and creating a life that fills your heart with joy, fulfillment and peace. This book will show you exactly how to unlock your child's highest abilities, deepen your relationships and leave a lasting legacy.>"},"links":[{"url":"https://www.overdrive.com/search?q=F54D56FF-91C7-46D5-B9AF-AEAF8D87A269","title":"OverDrive"},{"url":"http://rbdigital.oneclickdigital.com"},{"url":"http://overdrive.torontopubliclibrary.ca/ContentDetails.htm?ID=F54D56FF-91C7-46D5-B9AF-AEAF8D87A269"},{"url":"https://samples.overdrive.com/?crid=F54D56FF-91C7-46D5-B9AF-AEAF8D87A269&.epub-sample.overdrive.com","title":"Excerpt"},{"url":"http://images.contentreserve.com/ImageType-100/0293-1/{F54D56FF-91C7-46D5-B9AF-AEAF8D87A269}Img100.jpg","title":"Image"}],"isbn_10":["1443409030","0006385443"],"covers":[8147897],"full_title":"Family wisdom from the monk who sold his Ferrari nurturing the leader within your child","lc_classifications":["HQ769"],"key":"/books/OL26434961M","authors":[{"key":"/authors/OL221968A","name":"Robin S. Sharma"}],"ocaid":"familywisdomfrom0000shar","publish_places":["Toronto"],"isbn_13":["9781443409032","9780006385448"],"pagination":"1 online resource","source_records":["ia:familywisdomfrom0000shar","bwb:9780006385448","bwb:9781443409032","promise:bwb_daily_pallets_2022-09-16"],"subtitle":"nurturing the leader within your child","title":"Family wisdom from the monk who sold his Ferrari","dewey_decimal_class":["649/.7"],"notes":{"type":"/type/text","value":"Print version record."},"languages":[{"key":"/languages/eng"}],"subjects":["Actualisation de soi","Motivational & Inspirational","Leadership in children","Rôle parental","Parenting","Leadership chez l'enfant","SELF-HELP","Self-actualization (Psychology)"],"publish_date":"2001","publish_country":"onc","by_statement":"Robin Sharma","oclc_numbers":["827228340"],"works":[{"key":"/works/OL1854797W"}],"type":{"key":"/type/edition"},"local_id":["urn:bwbsku:T2-DSP-516"],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2018-03-15T04:39:34.152910"},"last_modified":{"type":"/type/datetime","value":"2025-12-23T15:04:19.217857"}}},"ISBN:9788425337543":{"bib_key":"ISBN:9788425337543","info_url":"http://openlibrary.org/books/OL9119200M/Sabiduria_Cotidiana_Del_Monje_Que_Vendio_(Autoayuda)","preview":"noview","preview_url":"http://openlibrary.org/books/OL9119200M/Sabiduria_Cotidiana_Del_Monje_Que_Vendio_(Autoayuda)","thumbnail_url":"https://covers.openlibrary.org/b/id/7881464-S.jpg","details":{"description":{"type":"/type/text","value":"Julian era el monje que decidió vender su Ferrari: abogado de éxito, un buen día lo abandonó todo y se trasladó al Himalaya. Allí inició un proceso de aprendizaje con los sabios de Sivana, que le abrieron las puertas a nuevas formas de abordar la vida y los negocios. En este tercer libro, Julian Mantle va a ayudar a su hermana Catherine, que se recupera de un gravísimo accidente de avión en el que ha perdido a sus dos socios. Ella está pasando por una crisis: no sabe equilibrar las exigencias de su vida profesional como empresaria y su vida familiar, y pide a Julian que le enseñe todo lo que sabe para descubrir su felicidad personal y familiar. Con su estilo ameno y divertido de siempre, Sabiduría cotidiana del monje que vendió su Ferrari nos enseña las lecciones básicas para equilibrar y combinar los aspectos profesionales y personales de nuestra vida, a educar correctamente a nuestros hijos y a tener una familia unida y feliz."},"identifiers":{"depósito_legal":["B51032003"],"goodreads":["7211856"]},"title":"Sabiduria Cotidiana Del Monje Que Vendio (Autoayuda)","authors":[{"key":"/authors/OL221968A","name":"Robin S. Sharma"}],"publish_date":"2003","publishers":["Random House Mondadori, S.A"],"covers":[7881464],"physical_format":"Paperback","publish_places":["Barcelona, España"],"subjects":["Self-Help","Spanish: Adult Nonfiction","Motivational & Inspirational"],"isbn_13":["9788425337543"],"languages":[{"key":"/languages/spa"}],"isbn_10":["8425337542"],"oclc_numbers":["433182378"],"type":{"key":"/type/edition"},"source_records":["amazon:8425337542"],"key":"/books/OL9119200M","number_of_pages":240,"works":[{"key":"/works/OL1854797W"}],"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":{"type":"/type/datetime","value":"2025-12-23T23:16:38.902287"}}},"ISBN:9781401900144":{"bib_key":"ISBN:9781401900144","info_url":"http://openlibrary.org/books/OL8369151M/Family_Wisdom_from_the_Monk_Who_Sold_His_Ferrari","preview":"noview","preview_url":"http://openlibrary.org/books/OL8369151M/Family_Wisdom_from_the_Monk_Who_Sold_His_Ferrari","thumbnail_url":"https://covers.openlibrary.org/b/id/750312-S.jpg","details":{"publishers":["Hay House"],"number_of_pages":224,"weight":"12.6 ounces","covers":[750312],"physical_format":"Paperback","lc_classifications":["HQ769.S4856 2003"],"key":"/books/OL8369151M","authors":[{"key":"/authors/OL221968A","name":"Robin S. Sharma"}],"subjects":["Child care & upbringing","Family & relationships","Popular psychology","New Age (Self Help)","Family","Family / Parenting / Childbirth","Self-Help","Personal Growth - Success","Parenting","Family Relationships","Parenting - General","Conduct of life","Child Development","Child rearing"],"languages":[{"key":"/languages/eng"}],"first_sentence":{"type":"/type/text","value":"THE SADDEST PART OF LIFE lies not in the act of dying, but in failing to truly live while we are alive."},"source_records":["bwb:9781401900144"],"title":"Family Wisdom from the Monk Who Sold His Ferrari","identifiers":{"librarything":["125938"],"goodreads":["289032