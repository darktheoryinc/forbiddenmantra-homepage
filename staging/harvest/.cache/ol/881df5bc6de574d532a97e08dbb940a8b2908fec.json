:[{"key":"/authors/OL575670A","name":"Phil Parshall"},{"key":"/authors/OL3067628A","name":"Julie Parshall"}],"isbn_13":["9780830856961"],"languages":[{"key":"/languages/eng"}],"pagination":"283","publish_date":"2003","publishers":["InterVarsity Press"],"source_records":["bwb:9780830856961"],"title":"Lifting the Veil","weight":"0.341","subtitle":"The World of Muslim Women","full_title":"Lifting the Veil The World of Muslim Women","works":[{"key":"/works/OL3456140W"}],"key":"/books/OL44249527M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-12-17T18:53:15.078047"},"last_modified":{"type":"/type/datetime","value":"2022-12-17T18:53:15.078047"}}},"ISBN:9781884543678":{"bib_key":"ISBN:9781884543678","info_url":"http://openlibrary.org/books/OL3778217M/Lifting_the_veil","preview":"restricted","preview_url":"https://archive.org/details/liftingveilworld0000pars","thumbnail_url":"https://covers.openlibrary.org/b/id/931071-S.jpg","details":{"publishers":["Gabriel Pub."],"number_of_pages":283,"subtitle":"the world of Muslim women","isbn_10":["1884543677"],"covers":[931071],"lc_classifications":["BP173.4 .P37 2002"],"key":"/books/OL3778217M","authors":[{"key":"/authors/OL575670A","name":"Phil Parshall"}],"publish_places":["Waynesboro, GA"],"contributions":["Parshall, Julie."],"pagination":"283 p. ;","title":"Lifting the veil","dewey_decimal_class":["305.486971"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 289-283)."},"identifiers":{"goodreads":["1112620"],"librarything":["1529762"]},"languages":[{"key":"/languages/eng"}],"lccn":["2003544941"],"subjects":["Women in Islam.","Muslim women -- Social conditions.","Muslim women -- Social life and customs."],"publish_date":"2002","publish_country":"gau","by_statement":"Phil & Julie Parshall.","oclc_numbers":["51806943"],"works":[{"key":"/works/OL3456140W"}],"type":{"key":"/type/edition"},"source_records":["marc:marc_loc_2016/BooksAll.2016.part31.utf8:117107489:813","ia:liftingveilworld0000pars","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:153979091:835","marc:harvard_bibliographic_metadata/20220215_002.bib.mrc:91454984:2753"],"ocaid":"liftingveilworld0000pars","description":{"type":"/type/text","value":"The controversy over the veil is symbolic of the issues facing Muslim women today. This piece of cloth embodies the debate over liberation or subjugation. While the Muslim fundamentalists are becoming more vocal and aggressive, a minority voice is courageously being raised in protest against Islamic rites and rituals. It is the Muslim women who are in the eye of the storm, and unfortunately, they seldom get the opportunity to set a direction. Secluded from the eyes of anyone but family members, Muslim women live under a system of tradition, rites, and rituals that favor men above women. \"A man loves first his son, then his camel, and then his wife,\" says an Arab proverb. Phil & Julie Parshall understand the issues, heartaches, and dangers facing Muslim women today, having lived among them for more than four decades. They bring a sensitive perspective to this thoughtful, yet sobering book that examines the controversy of female circumcision and proof of virginity, the heartache of arranged marriages, divorce, polygamy, and the status of women living in a male dominated world. This book will not provide you with easy answers but will prompt you to begin praying for these \"daughters of Ishmael\" and give you sensitive awareness to life behind the veil."},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-04-27T02:27:34.621992"}}},"ISBN:9780830858972":{"bib_key":"ISBN:9780830858972","info_url":"http://openlibrary.org/books/OL44248340M/Lifting_the_Veil","preview":"noview","preview_url":"http://openlibrary.org/books/OL44248340M/Lifting_the_Veil","details":{"type":{"key":"/type/edition"},"authors":[{"key"