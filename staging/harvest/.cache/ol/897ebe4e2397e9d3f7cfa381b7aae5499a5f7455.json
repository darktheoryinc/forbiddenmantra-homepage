,"ISBN:9781003011279":{"bib_key":"ISBN:9781003011279","info_url":"http://openlibrary.org/books/OL29544270M/Multi-Religious_Perspectives_on_a_Global_Ethic","preview":"noview","preview_url":"http://openlibrary.org/books/OL29544270M/Multi-Religious_Perspectives_on_a_Global_Ethic","details":{"publishers":["Taylor & Francis Group"],"subtitle":"In Search of a Common Morality","last_modified":{"type":"/type/datetime","value":"2020-08-26T21:28:37.160382"},"source_records":["bwb:9781003011279"],"title":"Multi-Religious Perspectives on a Global Ethic","number_of_pages":224,"isbn_13":["9781003011279"],"created":{"type":"/type/datetime","value":"2020-08-26T21:28:37.160382"},"languages":[{"key":"/languages/eng"}],"full_title":"Multi-Religious Perspectives on a Global Ethic In Search of a Common Morality","lc_classifications":[""],"publish_date":"2020","key":"/books/OL29544270M","authors":[{"key":"/authors/OL8162597A","name":"Myriam Renaud"},{"key":"/authors/OL233781A","name":"William Schweiker"}],"latest_revision":1,"works":[{"key":"/works/OL21710579W"}],"type":{"key":"/type/edition"},"revision":1}},"ISBN:9781000261356":{"bib_key":"ISBN:9781000261356","info_url":"http://openlibrary.org/books/OL29544173M/Multi-Religious_Perspectives_on_a_Global_Ethic","preview":"noview","preview_url":"http://openlibrary.org/books/OL29544173M/Multi-Religious_Perspectives_on_a_Global_Ethic","details":{"publishers":["Taylor & Francis Group"],"subtitle":"In Search of a Common Morality","source_records":["bwb:9781000261356","marc:marc_columbia/Columbia-extract-20221130-033.mrc:464996961:6234","marc:harvard_bibliographic_metadata/20220215_015.bib.mrc:112435793:5375"],"title":"Multi-Religious Perspectives on a Global Ethic","number_of_pages":224,"isbn_13":["9781000261356"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["","BJ69 .M95 2021"],"publish_date":"2020","key":"/books/OL29544173M","authors":[{"key":"/authors/OL8162597A","name":"Myriam Renaud"},{"key":"/authors/OL233781A","name":"William Schweiker"}],"works":[{"key":"/works/OL21710579W"}],"type":{"key":"/type/edition"},"lccn":["2020034311","2020034310"],"oclc_numbers":["1192304158","1192302814"],"description":{"type":"/type/text","value":"\"Ratified by the Parliament of the World's Religions in 1993 and expanded in 2018, \"Towards a Global Ethic: An Initial Declaration,\" or the Global Ethic, expresses the minimal set of principles shared by people-religious or not. Though it is a secular document, the Global Ethic emerged after months of collaborative, interreligious dialogue dedicated to identifying a common ethical framework. This volume tests and contests the claim that the Global Ethic's ethical directives can be found in the world's religious, spiritual, and cultural traditions. The book features essays by scholars of religion who grapple with the practical implications of the Global Ethic's directives when applied to issues like women's rights, displaced peoples, income and wealth inequality, India's caste system, and more. The scholars explore their respective religious traditions' ethical response to one or more of these issues and compares them to the ethical response elaborated by the Global Ethic. The traditions included are Hinduism, Engaged Buddhism, Shi'i Islam, Sunni Islam, Confucianism, Protestantism, Catholicism, Judaism, Indigenous African Religions, and Human Rights. To highlight the complexities within traditions, each essay is followed by a brief response by an expert in the same tradition. Multi-Religious Perspectives on a Global Ethic is of special interest to advanced students and scholars whose work focuses on the traditions listed above, on comparative religion, religious ethics, comparative ethics, and common morality\"--"},"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2020-08-26T21:27:13.653858"},"last_modified":{"type":"/type/datetime","value":"2025-08-30T06:56:49.646999"}}},"ISBN:9780367640026":{"bib_key":"ISBN:9780367640026","info_u