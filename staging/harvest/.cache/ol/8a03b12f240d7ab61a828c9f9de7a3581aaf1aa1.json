al_id":["urn:bwbsku:W7-ASZ-951"],"number_of_pages":1435,"description":{"type":"/type/text","value":"In 1730 Jonathan Edwards acquired a book-like, leather-bound manuscript containing an interleaved printed edition of the King James version of the Bible. Over the next three decades, Edwards proceeded to write in the manuscript more than five thousand notes and entries relating to biblical texts (although, paradoxically, he called the manuscript his 'blank Bible\"). Only a few of the entries have ever been published. This 2-vol. set presents a complete edition, accompanied by an informative introduction, multiple appendixes and an extensive index. Perhaps the most unusual in Edwards' oeuvre, it brings to light more clearly than before the full scope of his creative investment in Biblical Studies."},"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-08-03T18:42:06.550466"}}},"ISBN:9780334017028":{"bib_key":"ISBN:9780334017028","info_url":"http://openlibrary.org/books/OL5323475M/Twentieth-century_religious_thought","preview":"borrow","preview_url":"https://archive.org/details/twentiethcentury0000macq_w9s3","thumbnail_url":"https://covers.openlibrary.org/b/id/10998329-S.jpg","details":{"publishers":["S.C.M. Press"],"identifiers":{"goodreads":["3758679"],"librarything":["131581"]},"subtitle":"the frontiers of philosophy and theology, 1900-1970.","local_id":["urn:cst:10011426344"],"lc_classifications":["B804 .M25 1971","B804 .M64 1964"],"key":"/books/OL5323475M","authors":[{"key":"/authors/OL235648A","name":"John Macquarrie"}],"publish_places":["London"],"subjects":["Philosophy, Modern -- 20th century.","Religious thought -- 20th century."],"subject_time":["20th century."],"languages":[{"key":"/languages/eng"}],"pagination":"408 p.","source_records":["marc:marc_claremont_school_theology/CSTMARC1_barcode.mrc:57786388:3172","marc:marc_loc_2016/BooksAll.2016.part07.