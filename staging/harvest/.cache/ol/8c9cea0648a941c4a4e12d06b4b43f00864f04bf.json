 5.6 x 0.8 inches","ocaid":"taotechingbookab0000laoz","oclc_numbers":["332863814"],"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2010-03-12T04:57:46.420399"},"last_modified":{"type":"/type/datetime","value":"2023-01-01T04:56:55.088437"}}},"ISBN:9786053161233":{"bib_key":"ISBN:9786053161233","info_url":"http://openlibrary.org/books/OL35377886M/Lao_Tzu","preview":"noview","preview_url":"http://openlibrary.org/books/OL35377886M/Lao_Tzu","thumbnail_url":"https://covers.openlibrary.org/b/id/12220978-S.jpg","details":{"type":{"key":"/type/edition"},"title":"Lao Tzu","authors":[{"key":"/authors/OL31353A","name":"Ursula K. Le Guin"}],"publish_date":"Oct 28, 2018","source_records":["amazon:6053161233"],"number_of_pages":152,"publishers":["Metis Yayinlari"],"physical_format":"paperback","full_title":"Lao Tzu Tao Te Ching","subtitle":"Tao Te Ching","covers":[12220978],"works":[{"key":"/works/OL14988395W"}],"key":"/books/OL35377886M","isbn_10":["6053161233"],"isbn_13":["9786053161233"],"languages":[{"key":"/languages/tur"}],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2021-10-28T16:58:29.480644"},"last_modified":{"type":"/type/datetime","value":"2026-10-14T15:42:55.508980"}}},"ISBN:9781570623950":{"bib_key":"ISBN:9781570623950","info_url":"http://openlibrary.org/books/OL56955637M/Lao_Tzu_Tao_Te_Ching","preview":"noview","preview_url":"http://openlibrary.org/books/OL56955637M/Lao_Tzu_Tao_Te_Ching","details":{"works":[{"key":"/works/OL45499W"}],"title":"Lao Tzu : Tao Te Ching","publishers":["Shambhala"],"publish_date":"1998","key":"/books/OL56955637M","type":{"key":"/type/edition"},"identifiers":{},"classifications":{},"subtitle":"A Book About the Way and the Power of the Way","languages":[{"key":"/languages/eng"}],"contributors":[{"role":"Author name as appears on this edition","name":"Ursula K. Le Guin"}],"isbn_10":["1570623953"],"isbn_13":["9781570623950"],"description":{"type":"/type/text","value":"No other English translation of this greatest of the Chinese classics can match Ursula Le Guin's striking new version. Le Guin, best known for thought-provoking science fiction novels that have helped to transform the genre, has studied the Tao Te Ching for more than forty years. She has consulted the literal translations and worked with Chinese scholars to develop a version that lets the ancient text speak in a fresh way to modern people, while remaining faithful to the poetic beauty of the work. Avoiding scholarly interpretations and esoteric Taoist insights, she has revealed the Tao Te Ching 's immediate relevance and power, its depth and refreshing humor, in a way that shows better than ever before why it has been so much loved for more than 2,500 years. Included are Le Guin's own personal commentary and notes on the text. This new version is sure to be welcomed by the many readers of the Tao Te Ching as well as those coming to the text for the first time."},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2024-11-02T13:34:46.717376"},"last_modified":{"type":"/type/datetime","value":"2025-07-28T15:53:10.367128"}}},"ISBN:9781611807240":{"bib_key":"ISBN:9781611807240","info_url":"http://openlibrary.org/books/OL39037921M/Lao-Tzu_Tao_te_ching","preview":"noview","preview_url":"http://openlibrary.org/books/OL39037921M/Lao-Tzu_Tao_te_ching","thumbnail_url":"https://covers.openlibrary.org/b/id/12824595-S.jpg","details":{"works":[{"key":"/works/OL14988395W"}],"title":"Lao-Tzu: Tao te ching","publishers":["Shambhala Publications, Inc."],"publish_date":"1997","key":"/books/OL39037921M","type":{"key":"/type/edition"},"identifiers":{},"isbn_13":["9781611807240"],"classifications":{},"covers":[12824595],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2022-07-20T20:34:42.013069"},"last_modified":{"type":"/type/datetime","value":"2024-06-28T19:06:23.180938"}}},"ISBN:9780962713101":{"bib_key":"ISBN:9780962713101","info_url":"http://op