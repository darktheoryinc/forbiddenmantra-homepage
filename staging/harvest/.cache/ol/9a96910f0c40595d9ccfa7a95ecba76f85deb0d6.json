. The book also introduces the reader to philosophical discussions of topics in socially engaged Buddhism such as human rights, war and peace, and environmental ethics.\"--Back cover."},"isbn_10":["0415890667","0415890675","1315766078"],"lc_classifications":["BJ1289 .G69 2015","BJ1289","BJ1289 .G693 2015eb"],"key":"/books/OL28392286M","authors":[{"key":"/authors/OL712621A","name":"Christopher W. Gowans"}],"subtitle":"an introduction","publish_places":["London","New York"],"subjects":["Ethik","Buddhistische Philosophie","Buddhist ethics"],"isbn_13":["9780415890663","9780415890670","9781315766072"],"pagination":"ix, 333 pages","source_records":["marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:102775577:3619","bwb:9780415890670","bwb:9780415890663","marc:marc_loc_2016/BooksAll.2016.part42.utf8:29840674:2838","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:102835260:3619","marc:harvard_bibliographic_metadata/ab.bib.14.20150123.full.mrc:225380022:1267","marc:marc_columbia/Columbia-extract-20221130-031.mrc:154854530:2636","marc:marc_columbia/Columbia-extract-20221130-024.mrc:177989052:3175","bwb:9781315766072"],"title":"Buddhist moral philosophy","lccn":["2014942959"],"notes":{"type":"/type/text","value":"Publication date on Routledge web site: July 20th 2014.\n\nIncludes bibliographical references (pages 295-316) and index."},"number_of_pages":333,"languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["294.3/5"],"local_id":["urn:cst:10017037405"],"publish_date":"2015","publish_country":"nyu","copyright_date":"2015","by_statement":"Christopher W. Gowans","oclc_numbers":["866614440","889316056"],"works":[{"key":"/works/OL20957835W"}],"type":{"key":"/type/edition"},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2020-07-27T09:57:37.008380"},"last_modified":{"type":"/type/datetime","value":"2024-09-17T17:24:30.477863"}}},"ISBN:9780415890663":{"bib_key":"ISBN:9780415890663","info_url":"http://openlibrary.org/books/