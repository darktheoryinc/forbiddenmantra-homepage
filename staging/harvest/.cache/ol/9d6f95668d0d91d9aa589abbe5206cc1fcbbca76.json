alue":"Includes bibliographical references (p. 114)."},"identifiers":{"goodreads":["4808903","6773003"],"librarything":["489919"]},"languages":[{"key":"/languages/eng"}],"lccn":["94006763"],"subjects":["Joy -- Religious aspects -- Judaism -- Quotations, maxims, etc.","Hope -- Religious aspects -- Judaism -- Quotations, maxims, etc.","Hasidism -- Quotations, maxims, etc."],"publish_date":"1994","publish_country":"vtu","by_statement":"adapted by Moshe Mykoff and the Breslov Research Institute.","works":[{"key":"/works/OL1990239W"}],"type":{"key":"/type/edition"},"oclc_numbers":["29953457"],"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-07-14T22:51:51.956767"}}},"ISBN:9780520277236":{"bib_key":"ISBN:9780520277236","info_url":"http://openlibrary.org/books/OL26946614M/Who_will_lead_us","preview":"noview","preview_url":"http://openlibrary.org/books/OL26946614M/Who_will_lead_us","details":{"table_of_contents":[{"level":0,"label":"","title":"Succession in contemporary Hasidism : who will lead us?","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Munkács : a Oedipal challenge","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Boyan and Kopyczynitz : running out of rebbes","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Bobov : a clash of families","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Satmar : succession charged with conflict","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"ChaBaD Lubavitch : a rebbe who never dies","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Final thoughts.","pagenum":"","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"\"Hasidism, a movement many believed had passed its golden age, has had an extraordinary revival since its near decimation in the Holocaust and Soviet communism. These Hasidim, now settled primarily in North America and Israel have reversed the losses they suffered and rebuilt their communities. The once unimaginable is today routine. Hasidism is alive and growing. How? \"Who Will Lead Us?\" is the story of five contemporary Hasidic dynasties and how they have handled the delicate issue of leadership and succession. It explores two groups with too few successors, two with too many successors, and one that claims there is no need for a successor, as they claim their leader never died\"--Provided by publisher."},"isbn_10":["0520277236"],"local_id":["urn:sfpl:31223124862914"],"lc_classifications":["BM198.2 .H43 2017","BM198.2.H43 2017"],"key":"/books/OL26946614M","authors":[{"key":"/authors/OL219894A","name":"Samuel C. Heilman"}],"subtitle":"the story of five Hasidic dynasties in America","isbn_13":["9780520277236"],"pagination":"xvii, 318 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run06.mrc:96670837:3003","bwb:9780520277236","marc:marc_columbia/Columbia-extract-20221130-026.mrc:21783344:2473","marc:harvard_bibliographic_metadata/20220215_024.bib.mrc:41870354:3337"],"title":"Who will lead us?","dewey_decimal_class":["296.8/332"],"notes":{"type":"/type/text","value":"Includes bibliographical references (pages 271-309) and index."},"number_of_pages":318,"languages":[{"key":"/languages/eng"}],"lccn":["2016046899"],"subjects":["Hasidism","Leadership","Judaism"],"publish_date":"2017","publish_country":"cau","by_statement":"Samuel C. Heilman","oclc_numbers":["961035092"],"works":[{"key":"/works/OL19733520W"}],"type":{"key":"/type/edition"},"publishers":["University of California Press"],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2019-05-24T04:05:07.362599"},"last_modified":{"type":"/type/datetime","value":"2025-11-29T09:13:38.413606"}}},"ISBN:9780520966482":{"bib_key":"ISBN:9780520966482","info_url":"http