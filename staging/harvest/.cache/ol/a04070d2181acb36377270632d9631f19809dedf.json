bwbsku:KR-373-537"],"oclc_numbers":["38936629"],"description":{"type":"/type/text","value":"\"This study of the history, practices, and thoughts of Soto Zen nuns expands the purview of Zen studies, uncovering aspects of Zen not found in other sources. Arai demonstrates that many women in Japanese Buddhist history were not limited by a male-dominated institutional hierarchy. Their vision of Zen Buddhist teachings enabled them to navigate through oppressive institutional structures and regulations - testimony to their commitment and ingenuity.\n\nAlthough many Buddhists have made concessions to contradictory religious and social expectations during the twentieth century, these Zen nuns spent much of the century advancing their traditional monastic values by fighting for and winning reforms of the sect's misogynist regulations.\"--BOOK JACKET."},"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-04-21T17:29:22.454680"}}},"ISBN:9781280471575":{"bib_key":"ISBN:9781280471575","info_url":"http://openlibrary.org/books/OL40402219M/Women_Living_Zen","preview":"noview","preview_url":"http://openlibrary.org/books/OL40402219M/Women_Living_Zen","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL224332A","name":"Paula Kane Robinson Arai"},{"key":"/authors/OL224332A","name":"Paula Kane Robinson Arai"}],"isbn_13":["9781280471575"],"languages":[{"key":"/languages/eng"}],"pagination":"233","publish_date":"1999","publishers":["Oxford University Press"],"source_records":["bwb:9781280471575"],"title":"Women Living Zen","subtitle":"Japanese Soto Buddhist Nuns","full_title":"Women Living Zen Japanese Soto Buddhist Nuns","works":[{"key":"/works/OL1873668W"}],"key":"/books/OL40402219M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-11-18T12:25:14.772615"},"last_modified":{"type":"/type/datetime","value":"2022-11-18T12:25:14.77