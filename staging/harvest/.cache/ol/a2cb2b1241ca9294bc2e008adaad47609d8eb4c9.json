pe/datetime","value":"2021-09-20T08:00:03.722326"}}},"ISBN:9781134370016":{"bib_key":"ISBN:9781134370016","info_url":"http://openlibrary.org/books/OL53995310M/Muslim_Saints_of_South_Asia","preview":"noview","preview_url":"http://openlibrary.org/books/OL53995310M/Muslim_Saints_of_South_Asia","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7865274A","name":"Anna Suvorova"}],"dewey_decimal_class":["297.4092254"],"isbn_13":["9781134370016"],"languages":[{"key":"/languages/eng"}],"number_of_pages":256,"publish_date":"2004","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781134370016"],"subjects":["Sufism","Muslim saints"],"title":"Muslim Saints of South Asia","subtitle":"The Eleventh to Fifteenth Centuries","full_title":"Muslim Saints of South Asia The Eleventh to Fifteenth Centuries","works":[{"key":"/works/OL21030264W"}],"key":"/books/OL53995310M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-09-17T23:28:40.343765"},"last_modified":{"type":"/type/datetime","value":"2024-09-17T23:28:40.343765"}}},"ISBN:9781138776111":{"bib_key":"ISBN:9781138776111","info_url":"http://openlibrary.org/books/OL28799951M/Sufism_and_Politics_in_Morocco","preview":"noview","preview_url":"http://openlibrary.org/books/OL28799951M/Sufism_and_Politics_in_Morocco","details":{"publishers":["Taylor & Francis Group"],"languages":[{"key":"/languages/eng"}],"subtitle":"Activism and Dissent","source_records":["bwb:9781138776111","marc:marc_loc_2016/BooksAll.2016.part41.utf8:161839088:2291","marc:marc_columbia/Columbia-extract-20221130-031.mrc:166545280:6387","marc:marc_columbia/Columbia-extract-20221130-023.mrc:125744822:2566","marc:harvard_bibliographic_metadata/20220215_007.bib.mrc:204794330:3215"],"title":"Sufism and Politics in Morocco","lccn":["2014016037"],"number_of_pages":246,"isbn_13":["9781138776111"],"lc_classifications":["BP188.8.M6B78 2014","BP188.8.M6 B78 2015","BP188.8.M6","BP188.8.M6 B78 2014"],"publish_date":"2015","key":"/books/OL28799951M","authors":[{"key":"/authors/OL3009707A","name":"Abdelilah Bouasria"}],"works":[{"key":"/works/OL21271837W"}],"type":{"key":"/type/edition"},"subjects":["Sufism","Africa, religion"],"oclc_numbers":["903488807","904854440","1035352503"],"description":{"type":"/type/text","value":"\"Presenting a political history and sociology of Moroccan Sufism from colonialism to the modern day, this book studies the Sufi model of Master and Disciple in relation to social and political life, comparing the different eras of acquiescent versus dissident Sufism. This comparative fieldwork study offers new perspectives on the connection between the monarchy and mystic realms with a specific coverage of the Boutchichi order and Abdessalam Yassine's Al Adl Wal Ihsane, examining the myth of apolitical Sufism throughout the Middle East and North Africa. Drawing on Michel Foucault and James Scott, this book fuses thinking about the political dimension of Sufism, a \"hidden transcript,\" involving power struggles, patronage and justice and its esoteric spiritual ethics of care. Addressing the lacuna in English language literature on the Boutchichi Sufi order in Morocco, this book will be of interest to students and scholars of Islamic Studies, Comparative Politics and the MENA region\"--"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2020-08-16T05:58:12.910021"},"last_modified":{"type":"/type/datetime","value":"2025-07-05T00:46:53.642032"}}},"ISBN:9781317681434":{"bib_key":"ISBN:9781317681434","info_url":"http://openlibrary.org/books/OL36229340M/Sufism_and_Politics_in_Morocco","preview":"noview","preview_url":"http://openlibrary.org/books/OL36229340M/Sufism_and_Politics_in_Morocco","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL3009707A","name":"Abdelilah Bouasria"}],"isbn_13":["9781317681434"],"languages":[{"key":"/languages/eng"}],"pagination":"232","publish_date":"2015","publishers":["Taylor & Francis Gr