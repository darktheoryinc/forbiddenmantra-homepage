library.org/books/OL18631150M/From_Cranmer_to_Sancroft","preview":"noview","preview_url":"http://openlibrary.org/books/OL18631150M/From_Cranmer_to_Sancroft","details":{"publishers":["Hambledon Continuum"],"identifiers":{"librarything":["5386161"],"goodreads":["1207612"],"doi":["10.5040/9781474210034"]},"table_of_contents":[{"level":0,"label":"","title":"Thomas Cranmer and the truth","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Godly preachers and zealous magistrates in Elizabethan East Anglia : the roots of dissent","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Shepherds, sheepdogs, and hirelings : the pastoral ministry in post-Reformation England","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"England and international Calvinism, 1558-1640","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The Puritan character : polemics and polarities in early seventeenth-century English culture","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Sects and the evolution of Puritanism","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The English conventicle","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"William Sancroft , 1617-1693 : a retiring disposition in a revolutionary age.","pagenum":"","type":{"key":"/type/toc_item"}}],"isbn_10":["185285118X"],"lc_classifications":["BR756 .C64 2006","BX4838","BR756 .C655 2006"],"key":"/books/OL18631150M","authors":[{"key":"/authors/OL4461306A","name":"Patrick Collinson"}],"publish_places":["London","New York"],"oclc_number":["67764918"],"isbn_13":["9781852851187"],"pagination":"xv, 276 p. :","title":"From Cranmer to Sancroft","dewey_decimal_class":["280.409"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [201]-252) and index."},"number_of_pages":276,"languages":[{"key":"/languages/eng"}],"lccn":["2007280628"],"subjects":["Church of England -- History.","Protestantism -- History.","Reformation -- England.","Puritans -- England.","England -- Church history -- 16th century.","England -- Church history -- 17th century."],"publish_date":"2006","publish_country":"enk","by_statement":"Patrick Collinson.","works":[{"key":"/works/OL3455432W"}],"type":{"key":"/type/edition"},"source_records":["marc:marc_loc_2016/BooksAll.2016.part34.utf8:179117600:1966","bwb:9781852851187","marc:marc_columbia/Columbia-extract-20221130-012.mrc:114414376:1961","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:13423651:3212","marc:harvard_bibliographic_metadata/20220215_032.bib.mrc:348025840:2544"],"oclc_numbers":["67764918","1154843147"],"description":{"type":"/type/text","value":"Patrick Collinson is the leading historian of English religion in the years after the Reformation. This collection of essays ranges from Thomas Cranmer, who was burnt at the stake after repeated recantations in 1556, to William Sancroft, the only other post-Reformation archbishop of Canterbury to have been deprived of office. Patrick Collinson's work explores the complex interactions between the inclusive and exclusive tendencies in English Protestantism, focusing both on famous figures, such as John Foxe and Richard Hooker, and on the individual reactions of lesser figures to the religious challenges of the time. Two themes throughout are the importance of the Bible and the emergence of Puritanism inside the Church of England"},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2008-10-18T20:08:16.542386"},"last_modified":{"type":"/type/datetime","value":"2026-03-14T14:45:20.119969"}}},"ISBN:9780525474555":{"bib_key":"ISBN:9780525474555","info_url":"http://openlibrary.org/books/OL3298127M/The_wild_little_horse","preview":"borrow","preview_url":"https://archive.org/details/wildlittlehorse0000gray","thumbnail_url":"https://covers.openlibrary.org/b/id/361589-S.jpg","details":{"publishers":["Dutton C