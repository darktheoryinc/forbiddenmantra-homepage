c_metadata/20220215_038.bib.mrc:278777977:1705"],"title":"An introduction to the Advaita Śaiva philosophy of Kashmir","lccn":["2009310037"],"notes":{"type":"/type/text","value":"Includes index.\n\nIncludes bibliographical references (p. 177-180)."},"number_of_pages":180,"languages":[{"key":"/languages/eng"}],"subjects":["Kashmir Śaivism -- Doctrines","Advaita"],"publish_date":"2009","publish_country":"ii ","by_statement":"Debabrata SenSharma.","works":[{"key":"/works/OL18644681W"}],"type":{"key":"/type/edition"},"oclc_numbers":["432588543"],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2010-03-26T23:23:35.897912"},"last_modified":{"type":"/type/datetime","value":"2026-05-09T10:55:20.058492"}}},"ISBN:9781438454559":{"bib_key":"ISBN:9781438454559","info_url":"http://openlibrary.org/books/OL36717530M/Hindu_Theology_of_Liberation","preview":"noview","preview_url":"http://openlibrary.org/books/OL36717530M/Hindu_Theology_of_Liberation","thumbnail_url":"https://covers.openlibrary.org/b/id/14693343-S.jpg","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL6523073A","name":"Anantanand Rambachan"}],"isbn_13":["9781438454559"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["B132.A3R362 2015","B132.A3 R362 2015"],"pagination":"242","publish_date":"2015","publishers":["State University of New York Press"],"source_records":["bwb:9781438454559","marc:harvard_bibliographic_metadata/ab.bib.14.20150123.full.mrc:347368512:1300","marc:harvard_bibliographic_metadata/20220215_040.bib.mrc:345412096:7886"],"subjects":["Advaita","Hinduism","Liberation theology"],"title":"Hindu Theology of Liberation","weight":"0.001","subtitle":"Not-Two Is Not One","full_title":"Hindu Theology of Liberation Not-Two Is Not One","works":[{"key":"/works/OL21559396W"}],"key":"/books/OL36717530M","lccn":["2014007246"],"oclc_numbers":["872139209"],"covers":[14693343],"description":{"type":"/type/text","value":"\"This engaging and accessible work provides an introduction to the Hindu tradition of Advaita Vedānta and brings it into discussion with contemporary concerns. Advaita, the non-dual school of Indian philosophy and spirituality associated with Śaṅkara, is often seen as \"other-worldly,\" regarding the world as an illusion. Anantanand Rambachan has played a central role in presenting a more authentic Advaita, one that reveals how Advaita is positive about the here and now. The first part of the book presents the hermeneutics and spirituality of Advaita, using textual sources, classical commentary, and modern scholarship. The book's second section considers the implications of Advaita for ethical and social challenges: patriarchy, homophobia, ecological crisis, child abuse, and inequality. Rambachan establishes how Advaita's non-dual understanding of reality provides the ground for social activism and the values that advocate for justince, dignity, and the equality of human beings\"--Page [4] of cover."},"number_of_pages":230,"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2022-01-27T07:18:09.113660"},"last_modified":{"type":"/type/datetime","value":"2026-05-29T04:40:40.875712"}}},"ISBN:9781438454573":{"bib_key":"ISBN:9781438454573","info_url":"http://openlibrary.org/books/OL34523655M/Hindu_Theology_of_Liberation","preview":"noview","preview_url":"http://openlibrary.org/books/OL34523655M/Hindu_Theology_of_Liberation","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL6523073A","name":"Anantanand Rambachan"}],"isbn_13":["9781438454573"],"languages":[{"key":"/languages/eng"}],"number_of_pages":242,"publish_date":"2014","publishers":["State University of New York Press"],"source_records":["bwb:9781438454573"],"subjects":["Advaita","Hinduism","Liberation theology"],"title":"Hindu Theology of Liberation","subtitle":"Not-Two Is Not One","full_title":"Hindu Theology of Liberation Not-Two Is Not One","works":[{"key":"/works/OL21559396W"}],"key":"/books/OL34523655M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-05T15:29:29.898809"},"last_modified":{"type":"/type/datetime","value":"2021-10-05T15:29:29.898809"}}},"ISBN:9781438454566":{"bib_key":"ISBN:9781438454566","info_url":"http://openlibrary.org/books/OL29251643M/Hindu_Theology_of_Liberation","preview":"borrow","preview_url":"https://archive.org/details/hindutheologyofl0000ramb","thumbnail_url":"https://covers.openlibrary.org/b/id/12743046-S.jpg","details":{"publishers":["State University of New York Press"],"subtitle":"Not-Two Is Not One","source_records":["bwb:9781438454566","ia:hindutheologyofl0000ramb","amazon:1438454562","promise:bwb_daily_pallets_2022-03-17"],"title":"Hindu Theology of Liberation","number_of_pages":242,"languages":[{"key":"/languages/eng"}],"publish_date":"2015","key":"/books/OL29251643M","authors":[{"key":"/authors/OL6523073A","name":"Anantanand Rambachan"}],"works":[{"key":"/works/OL21559396W"}],"type":{"key":"/type/edition"},"subjects":["Advaita","Hinduism","Liberation theology"],"covers":[12743046],"local_id":["urn:bwbsku:G5-BPP-704"],"identifiers":{},"ocaid":"hindutheologyofl0000ramb","isbn_13":["9781438454566"],"lccn":["2014007246"],"oclc_numbers":["872139209"],"lc_classifications":["B132.A3 R362 2015"],"description":{"type":"/type/text","value":"Discusses Hindu Advaita Vedānta as a philosophy of social justice for the modern world.\r\n\r\nFinalist for the 2016 Book Award for Excellence in the Study of Religion, in the Constructive-Reflective category presented by the American Academy of Religion \r\n\r\nThis engaging and accessible work provides an introduction to the Hindu tradition of Advaita Vedānta and brings it into discussion with contemporary concerns. Advaita, the non-dual school of Indian philosophy and spirituality associated with Śakara, is often seen as \"other-worldly,\" regarding the world as an illusion. Anantanand Rambachan has played a central role in presenting a more authentic Advaita, one that reveals how Advaita is positive about the here and now. The first part of the book presents the hermeneutics and spirituality of Advaita, using textual sources, classical commentary, and modern scholarship. The book's second section considers the implications of Advaita for ethical and social challenges: patriarchy, homophobia, ecological crisis, child abuse, and inequality. Rambachan establishes how Advaita's non-dual understanding of reality provides the ground for social activism and the values that advocate for justice, dignity, and the equality of human beings."},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2020-08-23T21:31:40.687472"},"last_modified":{"type":"/type/datetime","value":"2025-03-16T03:50:57.337546"}}},"ISBN:9780895819574":{"bib_key":"ISBN:9780895819574","info_url":"http://openlibrary.org/books/OL3682236M/The_Paramārthasāra_of_Ādi_Śeṣa","preview":"noview","preview_url":"http://openlibrary.org/books/OL3682236M/The_Paramārthasāra_of_Ādi_Śeṣa","thumbnail_url":"https://covers.openlibrary.org/b/id/1654750-S.jpg","details":{"other_titles":["Paramārthasāra of Ādi Śeṣa, and the Paramāthasāra of Abhinava-gupta","Journal of the Royal Asiatic Society of Great Britain & Ireland.","Paramārthasāra of Abhinava-gupta."],"publishers":["Asian Humanities Press"],"identifiers":{"goodreads":["5109372"]},"isbn_10":["0895819570","0895819589"],"series":["New Indian antiquary ;","extra ser. 4."],"pagination":"xxi, 91 p. ;","covers":[1654750,1654749],"lc_classifications":["BL1213.32 .A3513 2003"],"key":"/books/OL3682236M","authors":[{"key":"/authors/OL204868A","name":"Ādiśeṣa"}],"publish_places":["Fremont, Calif"],"contributions":["Suryanarayana Sastri, Satalur Sundara, 1894-","Barnett, Lionel D. 1871-1960.","Abhinavagupta, Rājānaka."],"genres":["Early works to 1800."],"source_records":["amazon:0895819570","marc:marc_loc_2016/BooksAll.2016.part30.utf8:181767613:1876","marc:marc_columbia/Columbia-extract-2022113