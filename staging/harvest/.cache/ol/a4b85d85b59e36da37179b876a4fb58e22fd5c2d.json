works/OL8727362W"}],"type":{"key":"/type/edition"},"physical_dimensions":"8.3 x 5.3 x 0.6 inches","ocaid":"rumidaylightdayb0000jall","lccn":["99032290"],"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-04-30T08:14:56.482104"},"last_modified":{"type":"/type/datetime","value":"2022-12-07T09:02:08.941153"}}},"ISBN:9780820488592":{"bib_key":"ISBN:9780820488592","info_url":"http://openlibrary.org/books/OL11398306M/Divine_Deviants","preview":"noview","preview_url":"http://openlibrary.org/books/OL11398306M/Divine_Deviants","thumbnail_url":"https://covers.openlibrary.org/b/id/2653569-S.jpg","details":{"publishers":["Peter Lang Publishing"],"number_of_pages":181,"subtitle":"The Dialectics of Devotion in the Poetry of Donne and Rumi","weight":"15.2 ounces","covers":[2653569],"physical_format":"Hardcover","lc_classifications":["PR2248.M27 2007","PR2248 .M27 2007"],"key":"/books/OL11398306M","authors":[{"key":"/authors/OL3619832A","name":"Manijeh Mannani"}],"subjects":["English, Irish, Scottish, Welsh","Middle Eastern","Poetry","Literary Criticism","Christian poetry, English","Early modern, 1500-1700","History and criticism","Islamic poetry, Persian"],"isbn_13":["9780820488592"],"source_records":["bwb:9780820488592","marc:marc_columbia/Columbia-extract-20221130-013.mrc:151091466:2619","marc:harvard_bibliographic_metadata/ab.bib.10.20150123.full.mrc:287696582:1331","marc:harvard_bibliographic_metadata/20220215_036.bib.mrc:141871576:3341"],"title":"Divine Deviants","identifiers":{"goodreads":["1301130"]},"languages":[{"key":"/languages/eng"}],"isbn_10":["0820488593"],"publish_date":"April 2007","works":[{"key":"/works/OL9622706W"}],"type":{"key":"/type/edition"},"physical_dimensions":"9.1 x 6.1 x 0.7 inches","lccn":["2006023772"],"oclc_numbers":["70823076"],"description":{"type":"/type/text","value":"\"Divine Deviants is a comparative study of the Persian Sufi poet, Jalal al-Din Rumi (1212-1273), and the English Metaphysical poet, John Donne (1572-1631). By focusing on the two schools of thought to which these poets belong as well as their individual poetic worldviews and styles, this book elucidates the different dimensions of the shared philosophy governing their poetry.\" \"Bridging linguistic, cultural, religious, and philosophical barriers, Divine Deviants carefully illustrates that in the works of both Rumi and Donne love symbolizes Beatific Vision and Truth. More generally, this book highlights the bonds between religion, mysticism, and literature and thus examines not only the interdependent issues in these disciplines, but also the invisible and yet profound closeness that exists in the representative works of the two literary and religious traditions.\"--Jacket."},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":{"type":"/type/datetime","value":"2026-04-17T23:41:57.295951"}}},"ISBN:9781402745102":{"bib_key":"ISBN:9781402745102","info_url":"http://openlibrary.org/books/OL11637594M/Call_to_Love","preview":"noview","preview_url":"http://openlibrary.org/books/OL11637594M/Call_to_Love","thumbnail_url":"https://covers.openlibrary.org/b/id/2741000-S.jpg","details":{"publishers":["Sterling"],"number_of_pages":112,"subtitle":"In the Rose Garden with Rumi","weight":"11.2 ounces","covers":[2741000],"physical_format":"Hardcover","key":"/books/OL11637594M","authors":[{"key":"/authors/OL2659024A","name":"Rumi (Jalāl ad-Dīn Muḥammad Balkhī)"}],"contributions":["Lekha Singh (Photographer)","Andrew Harvey (Translator)"],"subjects":["Works by individual poets: classical, early & medieval","General","BG-COOKBKS - BG - COOKBOOKS","Poetry / General","Ancient, Classical & Medieval","Poetry","1207-1273","Jalåal al-Dåin Råumåi,","Maulana,","Sufi poetry, Persian","Translations into English"],"isbn_13":["9781402745102"],"title":"Call to Love","identifiers":{"librarything":["4893520"],"goodreads":["265585"]},"languages":[{"key":"/languages/eng"}],"i