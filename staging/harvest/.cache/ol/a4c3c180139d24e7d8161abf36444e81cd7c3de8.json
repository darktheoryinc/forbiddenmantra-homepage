_hundred_thousand_songs_of_Milarepa","preview":"borrow","preview_url":"https://archive.org/details/hundredthousands0002mila","thumbnail_url":"https://covers.openlibrary.org/b/id/4727073-S.jpg","details":{"publishers":["Shambhala Publications"],"isbn_10":["0877730954","0877730962"],"subject_place":["China","Tibet"],"authors":[{"key":"/authors/OL118022A","name":"Mi-la-ras-pa"}],"covers":[4727073,4059138],"lc_classifications":["BQ7950.M557 A3 1989"],"key":"/books/OL2037475M","publish_places":["Boston, Mass"],"pagination":"2 v. :","title":"The hundred thousand songs of Milarepa","dewey_decimal_class":["294.3/923/0924","B"],"notes":{"type":"/type/text","value":"Includes bibliographical references.\nTranslation of: Mgur ʼbum.\nReprint. Originally published: Boston, Mass. : Shambhala Publications, 1977."},"identifiers":{"goodreads":["2068165","2292133"],"librarything":["163103"]},"languages":[{"key":"/languages/eng"}],"lccn":["88013782","76055120"],"subjects":["Mi-la-ras-pa, 1040-1123.","Lamas -- China -- Tibet -- Biography.","Spiritual life -- Buddhism."],"publish_date":"1989","publish_country":"mau","series":["Shambhala dragon editions"],"by_statement":"translated and annotated by Garma C.C. Chang.","work_title":["Songs."],"works":[{"key":"/works/OL1166737W"}],"type":{"key":"/type/edition"},"ocaid":"hundredthousands0002mila","oclc_numbers":["725948121"],"source_records":["ia:hundredthousands0002mila"],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2022-10-07T07:51:35.327098"}}},"ISBN:9781570624766":{"bib_key":"ISBN:9781570624766","info_url":"http://openlibrary.org/books/OL381388M/The_hundred_thousand_songs_of_Milarepa","preview":"noview","preview_url":"http://openlibrary.org/books/OL381388M/The_hundred_thousand_songs_of_Milarepa","thumbnail_url":"https://covers.openlibrary.org/b/id/817351-S.jpg","details":{"other_titles":["Rje-btsun Mi-la-ras-paʼi Mgur ʼbum bźugs so"],"publishers":["Shambhala"],"identifiers":{"librarything":["163103"],"goodreads":["505983"]},"subtitle":"the life-story and teaching of the greatest Poet-Saint ever to appear in the history of Buddhism = Rje-btsun Mi-la-ras-paʼi Mgur ʼbum bźugs so","isbn_10":["1570624763"],"subject_place":["China","Tibet"],"pagination":"xvii, 730 p. ;","covers":[817351],"lc_classifications":["BQ7950 .M557 1999","BQ7950.M557 1999","BQ7950.M557 A3 1999"],"key":"/books/OL381388M","authors":[{"key":"/authors/OL118022A","name":"Mi-la-ras-pa"}],"publish_places":["Boston"],"genres":["Early works to 1800."],"source_records":["marc:marc_records_scriblio_net/part27.dat:91968578:993","marc:marc_loc_updates/v36.i09.records.utf8:4526470:1140","marc:marc_cca/b10621386.out:30242440:1045","bwb:9781570624766","marc:marc_loc_2016/BooksAll.2016.part27.utf8:35166480:1158","marc:harvard_bibliographic_metadata/20220215_045.bib.mrc:13725713:6126"],"title":"The hundred thousand songs of Milarepa","dewey_decimal_class":["294.3/923/092"],"number_of_pages":730,"languages":[{"key":"/languages/eng"}],"lccn":["98043692"],"subjects":["Mi-la-ras-pa, 1040-1123","Lamas -- China -- Tibet -- Biography -- Early works to 1800","Spiritual life -- Buddhism -- Early works to 1800"],"publish_date":"1999","publish_country":"mau","by_statement":"translated and annotated by Garma C.C. Chang.","work_title":["Songs."],"works":[{"key":"/works/OL1166737W"}],"type":{"key":"/type/edition"},"oclc_numbers":["40359306"],"description":{"type":"/type/text","value":"\"Tibetans accord The Hundred Thousand Songs of Milarepa a classic status comparable to that of the Mahabharata and the Bible, and revere its author as probably the best single exemplar of the religious life. Milarepa was an eleventh-century Buddhist poet and saint, a cotton-clad yogi who avoided the scholarly institutions of his time and wandered from village to village, teaching enlightenment and the path to Buddhahood through his spontaneously composed songs. Wherever he went, crowds of people gathered to hear his sweet sounding voice \"singing the Dharma.\" The Hundred Thousand Songs of Milarepa, says the book's translator, \"has been read as the biography of a saint, a guide book for devotions, a manual of Buddhist yoga, a volume of songs and poems, and even a collection of Tibetan folklore, and fairy tales.\" With titles like \"The Salvation of the Dead,\" \"A Woman's Role in the Dharma,\" and \"Challenge from a Wise Demoness,\" Milrepa's poems are filled with fascinating tales of miraculous encounters and colorful imagery, and present a valuable insight into the living quality of Tibetan Buddhism. Central as this book is to Tibetan culture, the arcane dialect and obscurity of many original passages daunted translators for centuries; this was the first complete version of the classic to appear in the West\"--Publisher's description."},"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-07-23T18:49:14.864037"}}},"ISBN:9780877730958":{"bib_key":"ISBN:9780877730958","info_url":"http://openlibrary.org/books/OL18189276M/The_hundred_thousand_songs_of_Milarepa","preview":"borrow","preview_url":"https://archive.org/details/hundredthousands01mila","thumbnail_url":"https://covers.openlibrary.org/b/id/7154238-S.jpg","details":{"notes":{"type":"/type/text","value":"Title also in Tibetan."},"identifiers":{"goodreads":["2068165"],"librarything":["163103"]},"title":"The hundred thousand songs of Milarepa","subtitle":"the life-story and teaching of the greatest poet-saint ever to appear in the history of Buddhism.","authors":[{"key":"/authors/OL118022A","name":"Mi-la-ras-pa"}],"publish_date":"1977","publishers":["Shambhala"],"ia_box_id":["IA145503"],"isbn_10":["0877730954"],"pagination":"2 v. (xvii, 730 p.)","covers":[7154238],"lc_classifications":["BQ7950.M557 A3 1989"],"ocaid":"hundredthousands01mila","publish_places":["Boulder, C