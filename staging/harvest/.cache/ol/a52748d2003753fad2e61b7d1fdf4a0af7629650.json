s/OL46017751M/Refutation_of_the_Self_in_Indian_Buddhism","preview":"noview","preview_url":"http://openlibrary.org/books/OL46017751M/Refutation_of_the_Self_in_Indian_Buddhism","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL1478899A","name":"James Duerlinger"}],"isbn_13":["9781283919845"],"languages":[{"key":"/languages/eng"}],"pagination":"257","publish_date":"2013","publishers":["Routledge"],"source_records":["bwb:9781283919845"],"subjects":["Buddhist philosophy"],"title":"Refutation of the Self in Indian Buddhism","subtitle":"Candrakirti on the Selflessness of Persons","full_title":"Refutation of the Self in Indian Buddhism Candrakirti on the Selflessness of Persons","works":[{"key":"/works/OL16726564W"}],"key":"/books/OL46017751M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-01-17T02:40:43.955268"},"last_modified":{"type":"/type/datetime","value":"2023-01-17T02:40:43.955268"}}},"ISBN:9780203074718":{"bib_key":"ISBN:9780203074718","info_url":"http://openlibrary.org/books/OL25393574M/The_refutation_of_the_self_in_Indian_Buddhism","preview":"noview","preview_url":"http://openlibrary.org/books/OL25393574M/The_refutation_of_the_self_in_Indian_Buddhism","details":{"subtitle":"Candrakīrti on the selflessness of persons","description":{"type":"/type/text","value":"\"Since the Buddha did not fully explain the theory of persons that underlies his teaching, in later centuries a number of different interpretations were developed. This book presents one of these interpretations by the celebrated Indian Buddhist philosopher, Candrakīrti (ca. 570-650 C.E.). Candrakīrti's theory is part of the \"Introduction to the Middle Way\" (\"Madhyamakāvatāra\"), which is the central treatise upon which the Madhyamaka (Middle Way) School of Indian Buddhist philosophy was developed. In this book, the text is translated and provided with an introduction and commentary, which offers a careful analysis and historical context on Candrakīrti's account of the selflessness of persons. A philosophical analysis of an ancient Indian philosophical text that is both philologically precise and analytically sophisticated, this book is of interest to scholars of Buddhism generally and Buddhist philosophy\"--"},"series":["Routledge critical studies in Buddhism"],"lc_classifications":["BQ7479.8.C364 M3333 2012","BQ7479.8.C364M3333","BQ7479.8.C364 M3333 2013eb","BQ7479.8.C364 M3333 2013"],"key":"/books/OL25393574M","authors":[{"key":"/authors/OL1478899A","name":"James Duerlinger"}],"contributions":["Candrakīrti"],"isbn_13":["9780415657495","9780203074718"],"pagination":"pages cm.","source_records":["marc:marc_loc_updates/v40.i31.records.utf8:12795757:2329","bwb:9780415657495","marc:marc_loc_2016/BooksAll.2016.part39.utf8:202990642:2355","bwb:9780203074718","marc:marc_columbia/Columbia-extract-20221130-031.mrc:106253176:4107","marc:harvard_bibliographic_metadata/ab.bib.13.20150123.full.mrc:566730353:2590","marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:106332222:3908"],"title":"The refutation of the self in Indian Buddhism","lccn":["2012026007"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["294.3/422"],"subjects":["PHILOSOPHY / Buddhist","RELIGION / Buddhism / Sacred Writings","RELIGION / Buddhism / General (see also PHILOSOPHY / Buddhist)","Mādhyamika (Buddhism)","Anātman"],"subject_people":["Candrakīrti"],"publish_country":"nyu","publish_date":"2012","by_statement":"James Duerlinger","works":[{"key":"/works/OL16726564W"}],"type":{"key":"/type/edition"},"oclc_numbers":["823169958","828883902","798062136"],"number_of_pages":238,"publishers":["Routledge"],"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2012-08-01T10:16:51.669730"},"last_modified":{"type":"/type/datetime","value":"2025-05-16T22:36:44.123912"}}},"ISBN:9781138086838":{"bib_key":"ISBN:9781138086838","info_url