openlibrary.org/b/id/2393361-S.jpg","details":{"publishers":["SCM Press"],"number_of_pages":320,"weight":"6.4 ounces","covers":[2393361,200762],"edition_name":"New Ed edition","physical_format":"Paperback","key":"/books/OL10560909M","authors":[{"key":"/authors/OL25661A","name":"Dietrich Bonhoeffer"}],"subjects":["Christian spirituality","Christian theology","Christian Theology - Ethics","Religion - Classic Works","Religion"],"isbn_13":["9780334028567"],"first_sentence":{"type":"/type/text","value":"DIETRICH BONHOEFFER was born in Breslau on February 4th, 1906, the son of a university professor and leading authority on psychiatry and neurology."},"title":"The Cost of Discipleship (scm classics)","identifiers":{"goodreads":["174825"],"librarything":["4539332"]},"languages":[{"key":"/languages/eng"},{"key":"/languages/ger"}],"isbn_10":["0334028566"],"publish_date":"November 2001","works":[{"key":"/works/OL15031473W"}],"type":{"key":"/type/edition"},"physical_dimensions":"7.6 x 5 x 0.8 inches","lc_classifications":["BT380 .B66 2001"],"oclc_numbers":["47867785"],"source_records":["marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:173468951:2977"],"description":{"type":"/type/text","value":"The Cost of Discipleship focuses on the most treasured part of Christ's teaching, the Sermon on the Mount with its call to discipleship, and the grace of God and the sacrifice which that demands. Viewed against the background of Nazi German, Bonhoeffer's book is striking enough. At the same time, it shares with many great Christian classics a quality of timelessness, so that it has spoken, and continues to speak powerfully, to the varied concerns of the contemporary world. Bonhoeffer's critique of 'cheap grace' and his insistence on 'costly grace' continue to influence many today who are engaged in the struggle for a more authentic Christian witness in the world . . . Certainly in South Africa, Bonhoeffer's influence in this regard has been considerable, both in the struggle against apartheid and now with the task of building a new and just democratic society. -- ‡c From the preface."},"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":{"type":"/type/datetime","value":"2025-05-19T11:17:34.038897"}}},"ISBN:9781019006108":{"bib_key":"ISBN:9781019006108","info_url":"http://openlibrary.org/books/OL46368649M/First_Lessons_on_Natural_Philosophy_for_Children","preview":"noview","preview_url":"http://openlibrary.org/books/OL46368649M/First_Lessons_on_Natural_Philosophy_for_Children","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2239453A","name":"Mary A. Swift"}],"isbn_13":["9781019006108"],"languages":[{"key":"/languages/eng"}],"pagination":"180","publish_date":"2022","publishers":["Creative Media Partners, LLC"],"source_records":["bwb:9781019006108"],"title":"First Lessons on Natural Philosophy, for Children","weight":"0.432","full_title":"First Lessons on Natural Philosophy, for Children","works":[{"key":"/works/OL18734438W"}],"key":"/books/OL46368649M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-01-18T00:12:59.484118"},"last_modified":{"type":"/type/datetime","value":"2023-01-18T00:12:59.484118"}}},"ISBN:9781376373035":{"bib_key":"ISBN:9781376373035","info_url":"http://openlibrary.org/books/OL39074140M/First_Lessons_on_Natural_Philosophy_for_Children","preview":"noview","preview_url":"http://openlibrary.org/books/OL39074140M/First_Lessons_on_Natural_Philosophy_for_Children","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2239453A","name":"Mary A. Swift"}],"isbn_13":["9781376373035"],"languages":[{"key":"/languages/eng"}],"pagination":"182","publish_date":"2018","publishers":["Creative Media Partners, LLC"],"source_records":["bwb:9781376373035"],"title":"First Lessons on Natural Philosophy, for Children","weight":"0.264","full_title":"First Lessons on Natural Philosophy, for Children","wor