d.","subjects":["Advaita.","Viśiṣṭādvaita."],"publish_date":"1988","publish_country":"ii ","by_statement":"by Vāsudevśāstri Abhyankar ; translated from Sanskrit with a commentary by Michael Comans ; with a foreword by J.W. de Jong.","work_title":["Advaitāmoda."],"works":[{"key":"/works/OL3435413W"}],"type":{"key":"/type/edition"},"oclc_numbers":["21046274"],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-07-25T17:06:01.705168"}}},"ISBN:9781350063235":{"bib_key":"ISBN:9781350063235","info_url":"http://openlibrary.org/books/OL29467992M/Bloomsbury_Research_Handbook_of_Vedanta","preview":"noview","preview_url":"http://openlibrary.org/books/OL29467992M/Bloomsbury_Research_Handbook_of_Vedanta","details":{"publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781350063235","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:42852774:6179"],"title":"Bloomsbury Research Handbook of Vedanta","number_of_pages":492,"isbn_13":["9781350063235"],"languages":[{"key":"/languages/eng"}],"full_title":"Bloomsbury Research Handbook of Vedanta","lc_classifications":["B132.V3B56 2020","B132.V3 B56 2020eb"],"publish_date":"2020","key":"/books/OL29467992M","authors":[{"key":"/authors/OL7348176A","name":"Ayon Maharaj"},{"key":"/authors/OL545574A","name":"Arindam Chakrabarti"},{"key":"/authors/OL2530294A","name":"Stephen Phillips - undifferentiated"},{"key":"/authors/OL2664519A","name":"Francis X. Clooney"},{"key":"/authors/OL3149285A","name":"Jeffery D. Long"}],"works":[{"key":"/works/OL21666484W"}],"type":{"key":"/type/edition"},"subjects":["Philosophy"],"oclc_numbers":["1142899768"],"description":{"type":"/type/text","value":"\"This handbook brings together a distinguished team of scholars from philosophy, theology, and religious studies to provide the first in-depth discussion of Vedanta and the many different systems of thought that make up this tradition of Indian philosophy. Emphasizing the historical development of Vedantic thought, it includes chapters on numerous classical Vedantic philosophies as well as the modern Vedantic views of Sri Ramakrishna, Sri Aurobindo, and Romain Rolland. The volume offers careful hermeneutic analyses of how Vedantic texts have been interpreted, and it addresses key issues and debates in Vedanta, including religious diversity, the nature of God, and the possibility of embodied liberation. Venturing into cross-philosophical and cross-cultural territory, it also brings Vedanta into dialogue with Saiva Nondualism as well as contemporary Western analytic philosophy. Highlighting current scholarly controversies and charting new paths of inquiry, this is an indispensable research guide for anyone interested in the past, present, and future of Vedanta and Indian philosophy\"--"},"identifiers":{"doi":["10.5040/9781350063266"]},"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2020-08-26T04:27:48.847312"},"last_modified":{"type":"/type/datetime","value":"2025-04-30T13:50:06.301023"}}},"ISBN:9781350355804":{"bib_key":"ISBN:9781350355804","info_url":"http://openlibrary.org/books/OL38339358M/Bloomsbury_Research_Handbook_of_Vedanta","preview":"noview","preview_url":"http://openlibrary.org/books/OL38339358M/Bloomsbury_Research_Handbook_of_Vedanta","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7348176A","name":"Ayon Maharaj"},{"key":"/authors/OL545574A","name":"Arindam Chakrabarti"},{"key":"/authors/OL2530294A","name":"Stephen Phillips - undifferentiated"},{"key":"/authors/OL2664519A","name":"Francis X. Clooney"},{"key":"/authors/OL3149285A","name":"Jeffery D. Long"}],"isbn_13":["9781350355804"],"languages":[{"key":"/languages/eng"}],"pagination":"492","publish_date":"2022","publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781350355804"],"title":"Bloomsbury Research Handbook of Vedanta","full_title":"Bloomsbury Research Handbook of Veda