{"ISBN:9780824879365":{"bib_key":"ISBN:9780824879365","info_url":"http://openlibrary.org/books/OL28899080M/Women_and_Buddhist_Philosophy","preview":"noview","preview_url":"http://openlibrary.org/books/OL28899080M/Women_and_Buddhist_Philosophy","details":{"publishers":["University of Hawaii Press"],"subtitle":"Engaging Zen Master Kim Iryop","last_modified":{"type":"/type/datetime","value":"2020-08-17T15:23:17.673443"},"source_records":["bwb:9780824879365"],"title":"Women and Buddhist Philosophy","number_of_pages":274,"isbn_13":["9780824879365"],"created":{"type":"/type/datetime","value":"2020-08-17T15:23:17.673443"},"languages":[{"key":"/languages/eng"}],"full_title":"Women and Buddhist Philosophy Engaging Zen Master Kim Iryop","lc_classifications":[""],"publish_date":"2018","key":"/books/OL28899080M","authors":[{"key":"/authors/OL5090439A","name":"Jin Y. Park"}],"latest_revision":1,"works":[{"key":"/works/OL20209968W"}],"type":{"key":"/type/edition"},"subjects":["Zen buddhism","Women in buddhism","Women, religious aspects","Buddhist nuns","Buddhist philosophy"],"revision":1}},"ISBN:9780824858780":{"bib_key":"ISBN:9780824858780","info_url":"http://openlibrary.org/books/OL27398296M/Women_and_Buddhist_Philosophy","preview":"noview","preview_url":"http://openlibrary.org/books/OL27398296M/Women_and_Buddhist_Philosophy","thumbnail_url":"https://covers.openlibrary.org/b/id/8860704-S.jpg","details":{"publishers":["University of Hawaii Press"],"identifiers":{"amazon":["0824858786"]},"subtitle":"Engaging Zen Master Kim Iryŏp","covers":[8860704],"physical_format":"hardcover","full_title":"Women and Buddhist Philosophy : Engaging Zen Master Kim Iryŏp","key":"/books/OL27398296M","authors":[{"key":"/authors/OL5090439A","name":"Jin Y. Park"}],"source_records":["amazon:0824858786","bwb:9780824858780","marc:marc_columbia/Columbia-extract-20221130-025.mrc:193463367:2490","promise:bwb_daily_pallets_2024-05-17:P9-CCR-481","marc:harvard_bibliographic_metadata/20220215_001.bib.mrc:37268885:6135"],"title":"Women and Buddhist Philosophy","notes":{"type":"/type/text","value":"Source title: Women and Buddhist Philosophy: Engaging Zen Master Kim Iryŏp (Studies of the International Center for Korean Studies, Korea University)"},"number_of_pages":280,"isbn_13":["9780824858780"],"isbn_10":["0824858786"],"publish_date":"Feb 28, 2017","works":[{"key":"/works/OL20209968W"}],"type":{"key":"/type/edition"},"lc_classifications":["BQ968.I45P37 2017","BQ968.I45 P37 2017"],"lccn":["2016034603"],"oclc_numbers":["956502005"],"local_id":["urn:bwbsku:P9-CCR-481"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"\"Why and how do women engage with Buddhism and philosophy? The present volume aims to answer these questions by examining the life and philosophy of a Korean Zen Buddhist nun, Kim Iryŏp (1896–1971). The daughter of a pastor, Iryŏp began questioning Christian doctrine as a teenager. In a few years, she became increasingly involved in women’s movements in Korea, speaking against society’s control of female sexuality and demanding sexual freedom and free divorce for women. While in her late twenties, an existential turn in her thinking led Iryŏp to Buddhism; she eventually joined a monastery and went on to become a leading figure in the female monastic community until her death. After taking the tonsure, Iryŏp followed the advice of her teacher and stopped publishing for more than two decades.^\n\nShe returned to the world of letters in her sixties, using her strong, distinctive voice to address fundamental questions on the scope of identity, the meaning of being human, and the value of existence. In her writing, she frequently adopted an autobiographical style that combined her experiences with Buddhist teachings. Through a close analysis of Iryŏp’s story, Buddhist philosophy and practice in connection with East Asian new women’s movements, and continental philosophy, this volume offers a creative interpretation of Buddhism as both a philosophy and a religion actively engaged with lives as they are lived. It presents a fascinating narrative on how women connect with the world--whether through social issues such as gender inequality, a Buddhist worldview, or existential debates on human existence and provides readers with a new way of philosophizing that is transformative and deeply connected with everyday life.^\n\nWomen and Buddhist Philosophy: Engaging Zen Master Kim Iryŏp will be of primary interest to scholars and students of Buddhism, Buddhist and comparative philosophy, and gender and Korean studies.\" -- Publisher's description"},"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2019-10-09T17:48:23.590415"},"last_modified":{"type":"/type/datetime","value":"2025-04-13T13:25:36.281061"}}},"ISBN:9780824858797":{"bib_key":"ISBN:9780824858797","info_url":"http://openlibrary.org/books/OL35963276M/Women_and_Buddhist_Philosophy","preview":"noview","preview_url":"http://openlibrary.org/books/OL35963276M/Women_and_Buddhist_Philosophy","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL5090439A","name":"Jin Y. Park"}],"isbn_13":["9780824858797"],"languages":[{"key":"/languages/eng"}],"publish_date":"2017","publishers":["University of Hawaii Press"],"source_records":["bwb:9780824858797"],"subjects":["Zen buddhism","Women in buddhism","Women, religious aspects","Buddhist nuns","Buddhist philosophy"],"title":"Women and Buddhist Philosophy","subtitle":"Engaging Zen Master Kim Iryŏp","full_title":"Women and Buddhist Philosophy Engaging Zen Master Kim Iryŏp","works":[{"key":"/works/OL20209968W"}],"key":"/books/OL35963276M","latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2021-12-27T09:11:44.715102"},"last_modified":{"type":"/type/datetime","value":"2026-06-11T00:58:29.817462"}}},"ISBN:9780824858810":{"bib_key":"ISBN:9780824858810","info_url":"http://openlibrary.org/books/OL29340670M/Women_and_Buddhist_Philosophy","preview":"n