e/edition"},"subjects":["Music"],"lccn":["2009035294"],"lc_classifications":["ML3082 .H53 2009","MT860"],"oclc_numbers":["434439420"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"\"What is Gregorian chant, and where does it come from? What purpose does it serve, and how did it take on the form and features which make it instantly recognizable? Guiding students through this key topic in music studies, this introduction describes the church services in which chant is performed, takes the reader through the church year, explains what Latin texts were used, and, taking Worcester Cathedral as an example, describes the buildings in which chant was sung.\"--Jacket."},"number_of_pages":250,"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":{"type":"/type/datetime","value":"2026-06-24T05:19:17.881788"}}},"ISBN:9780521870207":{"bib_key":"ISBN:9780521870207","info_url":"http://openlibrary.org/books/OL10437853M/Gregorian_Chant","preview":"noview","preview_url":"http://openlibrary.org/books/OL10437853M/Gregorian_Chant","details":{"publishers":["Cambridge University Press"],"physical_format":"Hardcover","lc_classifications":["ML3082 .H53 2009"],"source_records":["bwb:9780521870207","marc:marc_columbia/Columbia-extract-20221130-016.mrc:46424092:1559"],"title":"Gregorian Chant","identifiers":{"librarything":["9799363"]},"isbn_13":["9780521870207"],"isbn_10":["0521870208"],"publish_date":"April 1, 2008","key":"/books/OL10437853M","works":[{"key":"/works/OL2915288W"}],"type":{"key":"/type/edition"},"subjects":["Music"],"lccn":["2009035294"],"oclc_numbers":["434439420"],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":{"type":"/type/datetime","value":"2022-12-25T07:34:38.787504"}}},"ISBN:9780933894112":{"bib_key":"ISBN:9780933894112","info_url":"http://openlibrary.org/books/OL3043140M/Libellus_de_rudimentis_musices","preview":"noview","preview_url":"http://openlibrary.org/books/OL3043140M/Libellus_de_rudimentis_musices","details":{"publishers":["Colorado College Music Press"],"identifiers":{"goodreads":["5147765"]},"subtitle":"Verona, 1529","isbn_10":["0933894112"],"series":["Critical texts ;","no. 12"],"pagination":"iv, 94 p. :","lc_classifications":["MT5.5 .R67","MT5.5 .R67 1981"],"key":"/books/OL3043140M","authors":[{"key":"/authors/OL1302092A","name":"Biagio Rossetti"}],"publish_places":["Colorado Springs"],"contributions":["Seay, Albert."],"genres":["Early works to 1800."],"source_records":["marc:marc_loc_2016/BooksAll.2016.part14.utf8:75152824:860","marc:marc_columbia/Columbia-extract-20221130-001.mrc:135669011:1408","marc:harvard_bibliographic_metadata/ab.bib.01.20150123.full.mrc:52712972:911","marc:harvard_bibliographic_metadata/20220215_042.bib.mrc:314256591:1748"],"title":"Libellus de rudimentis musices","dewey_decimal_class":["783/.02/6"],"notes":{"type":"/type/text","value":"Bibliography: p. iv.\nIn Latin ; introd. in English."},"number_of_pages":94,"languages":[{"key":"/languages/lat"},{"key":"/languages/eng"}],"lccn":["82135613"],"subjects":["Church music -- Early works to 1800.","Music theory -- Early works to 1800."],"publish_date":"1981","publish_country":"cou","by_statement":"Biagio Rossetti ; edited by Albert Seay.","works":[{"key":"/works/OL5491498W"}],"type":{"key":"/type/edition"},"oclc_numbers":["8451324"],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-07-22T07:18:14.083253"}}},"ISBN:9780801420092":{"bib_key":"ISBN:9780801420092","info_url":"http://openlibrary.org/books/OL2062763M/Symphonia","preview":"noview","preview_url":"http://openlibrary.org/books/OL2062763M/Symphonia","details":{"publishers":["Cornell University Press"],"number_of_pages":330,"subtitle":"a critical edition of the Symphonia armonie celestium revelationum [Symphony of the harmony of celestial revelations]","isbn_10":["0801420091","0801495148"],"series":["Cornell paperbacks"],"lc_classifications":["BV469.H534 S9513 1988","BV469.H534S9513 1988"],"key":"/books/OL2062763M","authors":[{"key":"/authors/OL137661A","name":"Hildegard Saint"}],"publish_places":["Ithaca"],"contributions":["Newman, Barbara, 1953-"],"subjects":["Hymns, Latin.","Gregorian chants."],"pagination":"xiv, 330 p. ;","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run01.mrc:103346310:2237","bwb:9780801420092","bwb:9780801495144","marc:marc_loc_2016/BooksAll.2016.part18.utf8:181880417:1111","marc:marc_columbia/Columbia-extract-20221130-002.mrc:278117267:1912","marc:harvard_bibliographic_metadata/ab.bib.01.20150123.full.mrc:445322225:1330","marc:harvard_bibliographic_metadata/20220215_031.bib.mrc:293938185:7455"],"title":"Symphonia","dewey_decimal_class":["782.25/0268"],"notes":{"type":"/type/text","value":"Bibliography: p. 321-327.\nDiscography: p.329-330.\nEnglish and Latin."},"identifiers":{"librarything":["587443"],"goodreads":["4640998","2320266"]},"languages":[{"key":"/languages/eng"},{"key":"/languages/lat"}],"lccn":["88047739"],"local_id":["urn:sfpl:31223020444700","urn:sfpl:31223900013633"],"publish_date":"1988","publish_country":"nyu","by_statement":"Saint Hildegard of Bingen ; with introduction, translations, and commentary by Barbara Newman.","work_title":["Symphonia armonie celestium revelationum."],"works":[{"key":"/works/OL1348983W"}],"type":{"key":"/type/edition"},"oclc_numbers":["17983539"],"description":{"type":"/type/text","value":"\"Famous throughout Europe during her lifetime, Hildegard of Bingen (1098-1179) was by any standards a remarkably gifted woman: a composer and poet, she was also a writer on scientific, medical, and theological subjects, an abbess, a visionary prophet, and a saint of the Roman Catholic Church. One of the relatively few female writers and even fewer female composers of the Middle Ages whose work has survived to the present, Hildegard was neglected for centuries after her death. Recently, however, her liturgical song cycle Symphonia armonie celestium revelationum (Symphony of the harmony of celestial revelations) has been rediscovered, and pieces from it have been performed by several early music groups. Barbara Newman here provides both literal prose translations and sensitive verse renditions of the songs in the cycle, along with a new edition of the original Latin texts. Newman's introduction and commentary provide information on Hildegard's life and on such subjects as the dating of the Symphonia, the theology of music and its use in the monastic liturgy in the twelfth century, medieval music performance, and poetic styles of the period. Of special interest is an essay by Marianne Richert Pfau which delineates the connection between music and text in the Symphonia. This edition of the Symphonia will make Hildegard's work readily accessible to all readers interested in medieval poetry, early music, and the lives of medieval women, as well as to scholars concerned with poetry, musicology, religion, and women's history\"--Back cover."},"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-02-24T01:47:22.613190"}}},"ISBN:9780801495144":{"bib_key":"ISBN:9780801495144","info_url":"http://openlibrary.org/books/OL2062763M/Symphonia","preview":"noview","preview_url":"http://openlibrary.org/books/OL2062763M/Symphonia","details":{"publishers":["Cornell University Press"],"number_of_pages":330,"subtitle":"a critical edition of the Symphonia armonie celestium revelationum [Symphony of the harmony of celestial revelations]","isbn_10":["0801420091","0801495148"],"series":["Cornell paperbacks"],"lc_classifications":["BV469.H534 S9513 1988","BV469.H534S9513 1988"],"key":"/books/OL2062763M","authors":[{"key":"/authors/OL137661A","name":"Hildegard Saint"}],"publish_places":["Ithaca"],"contributions":["Newman, Barbara, 1953-"],"subjects":["Hymns, Latin.","Gregorian chants."],"pagination":"xiv, 330 p. ;","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run01.mrc:103346310:2237","bwb:9780801420092","bwb:9780801495144","marc:marc_loc_2016/BooksAll.2016.part18.utf8:181880417:1111","marc:marc_columbia/Columbia-extract-20221130-002.mrc:278117267:1912","marc:harvard_bibliographic_metadata/ab.bib.01.20150123.full.mrc:445322225:1330","marc:harvard_bibliographic_metadata/20220215_031.bib.mrc:293938185:7455"],"title":"Symphonia","dewey_decimal_class":["782.25/0268"],"notes":{"type":"/type/text","value":"Bibliography: p. 321-327.\nDiscography: p.329-330.\nEnglish and Latin."},"identifiers":{"librarything":["587443"],"goodreads":["4640998","2320266"]},"languages":[{"key":"/languages/eng"},{"key":"/languages/lat"}],"lccn":["88047739"],"local_id":["urn:sfpl:31223020444700","urn:sfpl:31223900013633"],"publish_date":"1988","publish_country":"nyu","by_statement":"Saint Hildegard of Bingen ; with introduction, translations, and commentary by Barbara Newman.","work_title":["Symphonia armonie celestium revelationum."],"works":[{"key":"/works/OL1348983W"}],"type":{"key":"/type/edition"},"oclc_numbers":["17983539"],"description":{"type":"/type/text","value":"\"Famous throughout Europe during her lifetime, Hildegard of Bingen (1098-1179) was by any standards a remarkably gifted woman: a composer and poet, she was also a writer on scientific, medical, and theological subjects, an abbess, a visionary prophet, and a saint of the Roman Catholic Church. One of the relatively few female writers and even fewer female composers of the Middle Ages whose work has survived to the present, Hildegard was neglected for centuries after her death. Recently, however, her liturgical song cycle Symphonia armonie celestium revelationum (Symphony of the harmony of celestial revelations) has been rediscovered, and pieces from it have been performed by several early music groups. Barbara Newman here provides both literal prose translations and sensitive verse renditions of the songs in the cycle, along with a new edition of the original Latin texts. Newman's introduction and commentary provide information on Hildegard's life and on such subjects as the dating of the Symphonia, the theology of music and its use in the monastic liturgy in the twelfth century, medieval music performance, and poetic styles of the period. Of special interest is an essay by Marianne Richert Pfau which delineates the connection between music and text in the Symphonia. This edition of the Symphonia will make Hildegard's work readily accessible to all readers interested in medieval poetry, early music, and the lives of medieval women, as well as to scholars concerned with poetry, musicology, religion, and women's history\"--Back cover."},"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-02-24T01:47:22.613190"}}},"ISBN:9780801485473":{"bib_key":"ISBN:9780801485473","info_url":"http://openlibrary.org/books/OL350263M/Symphonia","preview":"restricted","preview_url":"https://archive.org/details/symphoniacritica00hild_0","thumbnail_url":"https://covers.openlibrary.org/b/id/565096-S.jpg","details":{"publishers":["Cornell University Press"],"identifiers":{"goodreads":["1772717"],"librarything":["587443"]},"subtitle":"a critical edition of the Symphonia armonie celestium revelationum [Symphony of the harmony of celestial revelations]","ia_box_id":["IA152701"],"isbn_10":["0801485479"],"covers":[565096],"ia_loaded_id":["symphoniacritica00hild"],"lc_classifications":["BV469.H534 S9513 1998","BV469.H534S9513 1998"],"key":"/books/OL350263M","authors":[{"key":"/authors/OL137661A","name":"Hildegard Saint"}],"ocaid":"symphoniacritica00hild_0","publish_places":["Ithaca, N.Y"],"contributions":["Newman, Barb