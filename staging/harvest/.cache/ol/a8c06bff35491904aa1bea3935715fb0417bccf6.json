:4,"created":{"type":"/type/datetime","value":"2019-10-06T13:16:10.795398"},"last_modified":{"type":"/type/datetime","value":"2024-01-18T02:15:09.984625"}}},"ISBN:9780143116691":{"bib_key":"ISBN:9780143116691","info_url":"http://openlibrary.org/books/OL30099676M/The_Hindus","preview":"noview","preview_url":"http://openlibrary.org/books/OL30099676M/The_Hindus","thumbnail_url":"https://covers.openlibrary.org/b/id/10426890-S.jpg","details":{"publishers":["Penguin (Non-Classics)","Penguin Group"],"subtitle":"An Alternative History","covers":[10426890],"physical_format":"paperback","full_title":"The Hindus An Alternative History","key":"/books/OL30099676M","authors":[{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"source_records":["amazon:014311669X","bwb:9780143116691","marc:marc_columbia/Columbia-extract-20221130-022.mrc:89891979:3799","marc:harvard_bibliographic_metadata/ab.bib.13.20150123.full.mrc:1087408368:3744"],"title":"The Hindus","notes":{"type":"/type/text","value":"Source title: The Hindus: An Alternative History"},"number_of_pages":800,"isbn_13":["9780143116691"],"isbn_10":["014311669X"],"publish_date":"Nov 30, 2010","works":[{"key":"/works/OL15178611W"}],"type":{"key":"/type/edition"},"oclc_numbers":["1019524862","695063012"],"description":{"type":"/type/text","value":"A narrative account of history and myth that offers a new way of understanding one of the world's oldest major religions, this book elucidates the relationship between recorded history and imaginary worlds. Hinduism does not lend itself easily to a strictly chronological account: many of its central texts cannot be reliably dated; its central tenets--karma, dharma, to name just two--arise at particular moments in Indian history and differ in each era, between genders, and caste to caste; and what is shared among Hindus is overwhelmingly outnumbered by the things that are unique to one group or another. Yet the greatness of Hinduism--its vitality, its earthiness, its vividness--lies precisely in many of those idiosyncratic qualities that continue to inspire debate today. Wendy Doniger, one of the world's foremost scholars of Hinduism, illuminates those moments within the tradition that resist forces that would standardize or establish a canon.--From publisher description."},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2020-09-07T18:03:43.809535"},"last_modified":{"type":"/type/datetime","value":"2024-10-09T01:59:13.573264"}}},"ISBN:9780199593347":{"bib_key":"ISBN:9780199593347","info_url":"http://openlibrary.org/books/OL27690909M/The_Hindus","preview":"noview","preview_url":"http://openlibrary.org/books/OL27690909M/The_Hindus","thumbnail_url":"https://covers.openlibrary.org/b/id/9129740-S.jpg","details":{"publishers":["Oxford University Press, USA"],"number_of_pages":779,"subtitle":"An Alternative History","covers":[9129740],"physical_format":"paperback","full_title":"The Hindus An Alternative History","key":"/books/OL27690909M","authors":[{"key":"/authors/OL7755241A","name":"Mircea Eliade"},{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"source_records":["amazon:0199593345","bwb:9780199593347","marc:marc_columbia/Columbia-extract-20221130-022.mrc:82479496:802"],"title":"The Hindus","notes":"Source title: The Hindus: An Alternative History","identifiers":{"amazon":["0199593345"]},"publish_date":"Sep 01, 2010","works":[{"key":"/works/OL15178611W"}],"type":{"key":"/type/edition"},"isbn_10":["0199593345"],"isbn_13":["9780199593347"],"classifications":{},"lc_classifications":["BL1150","BL1151.3"],"oclc_numbers":["615842469"],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2019-11-14T18:10:46.908177"},"last_modified":{"type":"/type/datetime","value":"2026-06-18T10:35:22.948145"}}},"ISBN:9780143415343":{"bib_key":"ISBN:9780143415343","info_url":"http://openlibrary.org/books/OL62121175M/The_Hindus","preview":"restricted","preview_url":"https://archive.org/details/isbn_9780143415343","thumbna