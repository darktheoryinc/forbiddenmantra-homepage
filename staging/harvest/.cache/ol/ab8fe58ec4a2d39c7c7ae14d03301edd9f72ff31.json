],"oclc_numbers":["150334962"],"type":{"key":"/type/edition"},"physical_dimensions":"12 x 9.2 x 0.8 inches","source_records":["amazon:8425339499"],"key":"/books/OL9119222M","number_of_pages":128,"works":[{"key":"/works/OL8478961W"}],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":{"type":"/type/datetime","value":"2026-01-16T20:40:20.245885"}}},"ISBN:9780754825449":{"bib_key":"ISBN:9780754825449","info_url":"http://openlibrary.org/books/OL27880729M/Yoga-Pilates","preview":"restricted","preview_url":"https://archive.org/details/yogapilatesultim0000monk","thumbnail_url":"https://covers.openlibrary.org/b/id/13427138-S.jpg","details":{"table_of_contents":[{"level":0,"label":"","title":"Core strength","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Standing postures","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Twisted postures","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Balanced postures","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Sequences.","pagenum":"","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"This is a distinctive style of exercise that combines the benefits of yoga and Pilates. You can rediscover the strength and flexibility of your body, and improve your stamina and balance, to achieve an optimum level of fitness. You can transform the shape of your body by strengthening your core muscles to create your own 'body beautiful'. Dynamic Pilates sequences are graded to suit your energy levels at different times of the day. Yoga postures show easy and more advanced variations, to suit your level of flexibility. It is fully illustrated with over 325 practical photographs that clearly demonstrate the postures. This book fuses the stretching and balancing of yoga, and the muscle control demanded by the technique of Pilates, to create a new style of practice that begins with the core strength of the body. The main part of the book is devoted to the individual yoga-Pilates postures, supplemented with advice on extending or moderating them. The postures are then brought together in a series of sequences devised by the author for warming-up, to aid relaxation, help energize, and increase strength and body awareness. Fully illustrated, with step-by-step sequences, this book is an expert guide to an exciting fusion of two influential health disciplines, and is for anyone interested in increasing their fitness levels, and enhancing an overall sense of wellbeing."},"isbn_10":["0754825442"],"covers":[13427138],"full_title":"Yoga-Pilates the ultimate fusion for health and fitness","lc_classifications":["RA781.7"],"key":"/books/OL27880729M","authors":[{"key":"/authors/OL2830578A","name":"Jonathan Monks"}],"ocaid":"yogapilatesultim0000monk","subtitle":"the ultimate fusion for health and fitness","isbn_13":["9780754825449"],"pagination":"127 pages","source_records":["ia:yogapilatesultim0000monk","bwb:9780754825449"],"title":"Yoga-Pilates","dewey_decimal_class":["613.7046"],"notes":{"type":"/type/text","value":"Includes index."},"number_of_pages":127,"languages":[{"key":"/languages/eng"}],"subjects":["Hatha yoga","Pilates method","Health Promotion"],"publish_date":"2012","publish_country":"enk","copyright_date":"2012","by_statement":"Jonathan Monks","oclc_numbers":["795850588"],"works":[{"key":"/works/OL8478961W"}],"type":{"key":"/type/edition"},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-01-08T20:38:51.187871"},"last_modified":{"type":"/type/datetime","value":"2023-03-07T21:43:49.446137"}}},"ISBN:9781844767571":{"bib_key":"ISBN:9781844767571","info_url":"http://openlibrary.org/books/OL28757643M/Yoga-Pilates","preview":"restricted","preview_url":"https://archive.org/details/yogapilatesuniqu0000monk","thumbnail_url":"https://covers.openlibrary.org/b/id/11748318-S.jpg","details"