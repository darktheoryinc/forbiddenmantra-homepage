131","marc:marc_columbia/Columbia-extract-20221130-006.mrc:158678954:2484","marc:harvard_bibliographic_metadata/20220215_009.bib.mrc:8569054:3183"],"title":"Pluralism Comes of Age","lccn":["99088431"],"number_of_pages":250,"languages":[{"key":"/languages/eng"}],"subjects":["American history: from c 1900 -","Comparative Religion","Interfaith relations","20th century","Religion - Church Life & Growth","Religion","USA","Religious pluralism","Institutions & Organizations","Christianity - Catholic","History of doctrines","United States"],"publish_date":"July 2000","works":[{"key":"/works/OL2974913W"}],"type":{"key":"/type/edition"},"physical_dimensions":"9.3 x 6.4 x 1 inches","local_id":["urn:scms:0188600192804"],"oclc_numbers":["43032758"],"description":{"type":"/type/text","value":"\"Beginning with the Victorian age and the end of the nineteenth century, Lippy's narrative moves through the shifting power of Protestantism and American Catholicism and into the period of immigration and pluralism that has characterized our country's religious experience.\n\nHis later chapters include coverage of the Jewish experience, African-American religion, Native American traditions, the ecstatic personal expressions of conversion that mark the evangelical movements, the politics of religion, the proliferation of sects and cults, and the many strands of religious thought in this century.\"--BOOK JACKET."},"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2008-04-29T15:03:11.581851"},"last_modified":{"type":"/type/datetime","value":"2025-06-09T07:07:07.296031"}}},"ISBN:9781315701738":{"bib_key":"ISBN:9781315701738","info_url":"http://openlibrary.org/books/OL39525765M/Pluralism_Comes_of_Age","preview":"noview","preview_url":"http://openlibrary.org/books/OL39525765M/Pluralism_Comes_of_Age","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL455023A","name":"Charles H. Lippy"}],"isbn_13":["9781315701738"],"languages":[{"key":"/languages/en