974913W"}],"type":{"key":"/type/edition"},"oclc_numbers":["49415102"],"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2008-11-07T07:17:06.649356"},"last_modified":{"type":"/type/datetime","value":"2022-12-14T22:10:46.128055"}}},"ISBN:9780872862869":{"bib_key":"ISBN:9780872862869","info_url":"http://openlibrary.org/books/OL1077109M/Macumba","preview":"borrow","preview_url":"https://archive.org/details/macumbateachings0000bram","thumbnail_url":"https://covers.openlibrary.org/b/id/662881-S.jpg","details":{"publishers":["City Lights Books"],"number_of_pages":231,"subtitle":"the teachings of Maria-José, mother of the gods","isbn_10":["0872862860"],"subject_place":["Brazil"],"covers":[662881],"lc_classifications":["BL2592.M23 B73 1994","BL2592.M23B73 1994"],"key":"/books/OL1077109M","authors":[{"key":"/authors/OL21405A","name":"Serge Bramly"}],"ocaid":"macumbateachings0000bram","publish_places":["San Francisco"],"contributions":["Maria-José, mãe."],"subjects":["Maria-José, mãe -- Interviews","Macumba (Cult)","Brazil -- Religion -- 20th century"],"subject_time":["20th century."],"languages":[{"key":"/languages/eng"}],"pagination":"v, 231 p. :","source_records":["marc:marc_records_scriblio_net/part24.dat:40054803:842","marc:marc_ithaca_college/ic_marc.mrc:190872741:851","marc:OpenLibraries-Trent-MARCs/tier5.mrc:38795765:1030","marc:marc_marygrove/marygrovecollegelibrary.full.D20191108.T213022.internetarchive2nd_REPACK.mrc:117616921:1916","ia:macumbateachings0000bram","marc:marc_loc_2016/BooksAll.2016.part23.utf8:114631086:848","bwb:9780872862869","marc:marc_columbia/Columbia-extract-20221130-004.mrc:568159362:2689"],"title":"Macumba","dewey_decimal_class":["299/.67"],"notes":{"type":"/type/text","value":"Interviews with Maria-José, mother of the gods."},"identifiers":{"goodreads":["942152"],"librarything":["532124"]},"edition_name":"1st City Lights ed.","lccn":["94000290"],"local_id":["urn:trent:0116404172599","urn:mgc:31927000898731"],"publish_date":"1994","publish_country":"cau","by_statement":"by Serge Bramly.","works":[{"key":"/works/OL57449W"}],"type":{"key":"/type/edition"},"oclc_numbers":["29752891"],"description":{"type":"/type/text","value":"Every January millions of people crowd the seashore to receive the blessings of Iemanja, goddess of the sea. All year long in terreiros in Brazil and around the world, Orixa worshipers revel in the divine presence of the Living Gods, directly experiencing the sacred energy of the universe.\n\nMacumba is a way of life and belief that is followed by 15 million Brazilians, as well as millions more across the western hemisphere. Yet it - along with its sister-religions of Vodun, Santeria and Ifa - remains a little-known and largely misunderstood spiritual path. This book is a welcome introduction to a rich and profound tradition whose roots lie in ancient Africa.\n\nIn a series of interviews, Maria Jose, a Mae de Santo (Mother of the Gods), explains the philosophy and practice of Macumba. She introduces the Orixas, a pantheon of deities who survived the Middle Passage to Brazil along with the African slaves. With humor and grace she describes the essence of Macumba, the divine interaction between humans and living Gods, and the spiritual regeneration of its followers.\n\nMeet a fascinating Mother of the Gods and discover another path to wisdom. Learn to listen to the drumbeat-heartbeat of the mystical universe as it continues to deepen and expand. Sarava Umbada!"},"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-08-06T04:49:53.427853"}}},"ISBN:9780312503383":{"bib_key":"ISBN:9780312503383","info_url":"http://openlibrary.org/books/OL4563239M/Macumba","preview":"borrow","preview_url":"https://archive.org/details/macumbateachings0000bram_h1t3","thumbnail_url":"https://covers.openlibrary.org/b/id/10652580-S.jpg","details":{"publishers":["St. Martin's