key":"ISBN:9781134519163","info_url":"http://openlibrary.org/books/OL36239595M/Nine_Worlds_of_Seid-Magic","preview":"noview","preview_url":"http://openlibrary.org/books/OL36239595M/Nine_Worlds_of_Seid-Magic","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2651917A","name":"Jenny Blain"}],"isbn_13":["9781134519163"],"languages":[{"key":"/languages/eng"}],"pagination":"208","publish_date":"2003","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781134519163"],"title":"Nine Worlds of Seid-Magic","subtitle":"Ecstasy and Neo-Shamanism in North European Paganism","full_title":"Nine Worlds of Seid-Magic Ecstasy and Neo-Shamanism in North European Paganism","works":[{"key":"/works/OL7949607W"}],"key":"/books/OL36239595M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-12-29T15:39:45.939347"},"last_modified":{"type":"/type/datetime","value":"2021-12-29T15:39:45.939347"}}},"ISBN:9780415256506":{"bib_key":"ISBN:9780415256506","info_url":"http://openlibrary.org/books/OL7488699M/Nine_Worlds_of_Seid-Magic","preview":"noview","preview_url":"http://openlibrary.org/books/OL7488699M/Nine_Worlds_of_Seid-Magic","thumbnail_url":"https://covers.openlibrary.org/b/id/4624500-S.jpg","details":{"publishers":["Routledge"],"number_of_pages":208,"subtitle":"Ecstasy and Neo-Shamanism in North European Paganism","covers":[4624500],"key":"/books/OL7488699M","authors":[{"key":"/authors/OL2651917A","name":"Jenny Blain"}],"isbn_13":["9780415256506"],"source_records":["ia:nineworldsseidma00blai","bwb:9780415256506","marc:marc_loc_2016/BooksAll.2016.part28.utf8:218958036:857","marc:marc_columbia/Columbia-extract-20221130-031.mrc:19916691:2874","marc:harvard_bibliographic_metadata/20220215_026.bib.mrc:110847551:2600"],"title":"Nine Worlds of Seid-Magic","identifiers":{"librarything":["348021"],"goodreads":["1185806"]},"languages":[{"key":"/languages/eng"}],"isbn_10":["041525650X"],"publish_date":"December 14, 2001","works":[{"key":"/works/OL7949607W"}],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"On a day at the end of April 1999, I journeyed by plane from Nova Scotia to Boston, Massachusetts, on my way further west to Illinois."},"lccn":["2001041828"],"lc_classifications":["BF1622.S34 B57 2002","BF1622.S34B57 2001","BF1622.S34 B57 2001"],"oclc_numbers":["54671072","47625348"],"description":{"type":"/type/text","value":"\"Shamanistic practices known as seidr, often involving interactions with the spirit world and states of altered consciousness, lie at the heart of the pagan religions of Northern Europe. This accessible study explores the ways in which seidr, a key element of ancient Scandinavian belief systems described in the Icelandic Sagas and Eddas, is now being rediscovered and redeveloped by people around the world. The book draws on a wealth of research and experience to analyse the phenomenon and place it in context.\" \"Written by someone who is a practitioner as well as a scholar, this is a unique exploration of what Northern 'shamans' do, and how they speak of the spirits they meet. It is set within discussions of shamanism, identity, insider ethnography and new directions in the anthropology of religion. It will fascinate all those with an interest in the possibilities for alternative spirituality in today's world.\"--BOOK JACKET."},"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2025-12-19T16:44:18.886244"}}},"ISBN:9781134519132":{"bib_key":"ISBN:9781134519132","info_url":"http://openlibrary.org/books/OL33576863M/Nine_Worlds_of_Seid-Magic","preview":"noview","preview_url":"http://openlibrary.org/books/OL33576863M/Nine_Worlds_of_Seid-Magic","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2651917A","name":"Jenny Blain"}],"isbn_13":["9781134519132"],"languages":[{"key":"/languages/eng"}],"number_of_pages":208,"publish_