20993864"],"works":[{"key":"/works/OL19492853W"}],"type":{"key":"/type/edition"},"ocaid":"inpraiseofrumi0000unse","local_id":["urn:bwbsku:W2-CSD-020","urn:bwbsku:P2-FBF-442"],"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-03-19T05:23:38.020490"}}},"ISBN:9780061999147":{"bib_key":"ISBN:9780061999147","info_url":"http://openlibrary.org/books/OL27225885M/Rumi's_secret","preview":"noview","preview_url":"http://openlibrary.org/books/OL27225885M/Rumi's_secret","thumbnail_url":"https://covers.openlibrary.org/b/id/12380262-S.jpg","details":{"subtitle":"the life of the Sufi poet of love","local_id":["urn:sfpl:31223121861752","urn:sfpl:31223121180468","urn:sfpl:31223121180435","urn:sfpl:31223121180443","urn:sfpl:31223121180450","urn:bwbsku:P7-EWA-322"],"subject_times":["747-1500"],"lc_classifications":["PK6482 .G66 2017","PK6482.G66 2017"],"key":"/books/OL27225885M","authors":[{"key":"/authors/OL240782A","name":"Brad Gooch"}],"subjects":["Sufis","Persian Poets","Biography","Mevleviyeh members"],"edition_name":"First edition.","pagination":"x, 377 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:402042926:2934","bwb:9780061999147","promise:bwb_daily_pallets_2022-03-17","marc:marc_columbia/Columbia-extract-20221130-025.mrc:157608112:1783","marc:marc_nuls/NULS_PHC_180925.mrc:200979100:3165","marc:harvard_bibliographic_metadata/20220215_013.bib.mrc:347491294:4768"],"title":"Rumi's secret","dewey_decimal_class":["891/.5511"],"notes":{"type":"/type/text","value":"Includes bibliographical references (pages 339-366) and index."},"number_of_pages":377,"isbn_13":["9780061999147"],"languages":[{"key":"/languages/eng"}],"lccn":["2016023342"],"isbn_10":["0061999148"],"subject_people":["Jalāl al-Dīn Rūmī Maulana (1207-1273)"],"publish_country":"nyu","publish_date":"2017","by_statement":"Brad Gooch","oclc_numbers":["948560140"],"works":[{"key":"/works/OL20045858W"}],"type":{"key":"/type/edition"},"covers":[12380262],"identifiers":{"amazon":["B01ER451N0"]},"publishers":["Harper"],"description":{"type":"/type/text","value":"The ecstatic love poems of Rumi, a Persian poet and Sufi mystic born over eight centuries ago, are beloved by millions of readers in America as well as around the world. He has been compared to Shakespeare for his outpouring of creativity and to Saint Francis of Assisi for his spiritual wisdom. Yet his life has long remained the stuff of legend rather than intimate knowledge. In this biography, Brad Gooch brings to life the man and puts a face to the name Rumi, coloring in his time and place--a world as rife with conflict as our own. Gooch traces this epic journey from Central Asia, where Rumi was born in 1207, traveling with his family, displaced by Mongol terror, to settle in Konya, Turkey. Pivotal was the disruptive appearance of Shams of Tabriz, who taught him to whirl and transformed him from a respectable Muslim preacher into a poet and mystic. Their vital connection as teacher and pupil, friend and beloved, is one of the world's greatest spiritual love stories. When Shams disappeared, Rumi coped with the pain of separation by composing joyous poems of reunion, both human and divine. Rumi's Secret reveals the unfolding of Rumi's devotion to a \"religion of love.\"--From publisher description."},"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2019-07-19T19:44:21.440826"},"last_modified":{"type":"/type/datetime","value":"2025-08-18T02:21:08.803527"}}},"ISBN:9789068310948":{"bib_key":"ISBN:9789068310948","info_url":"http://openlibrary.org/books/OL1913755M/A_Green_leaf","preview":"noview","preview_url":"http://openlibrary.org/books/OL1913755M/A_Green_leaf","thumbnail_url":"https://covers.openlibrary.org/b/id/5531628-S.jpg","details":{"other_titles":["Barg-i sabz."],"publishers":["E.J. Brill"],"identifiers":{"goodreads":["761296"]},"s