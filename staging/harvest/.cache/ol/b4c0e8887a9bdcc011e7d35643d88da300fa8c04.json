_place":["India."],"lc_classifications":["BL1171 .B69 1990"],"key":"/books/OL2207295M","authors":[{"key":"/authors/OL31072A","name":"Doug Boyd"}],"publish_places":["New York"],"languages":[{"key":"/languages/eng"}],"pagination":"xxii, 330 p. ;","source_records":["marc:marc_records_scriblio_net/part20.dat:150679318:873","marc:marc_loc_updates/v37.i39.records.utf8:4795918:872","marc:marc_loc_2016/BooksAll.2016.part19.utf8:108595521:872","promise:bwb_daily_pallets_2024-01-catchup:P8-AEO-634","marc:harvard_bibliographic_metadata/ab.bib.01.20150123.full.mrc:841302124:933","marc:harvard_bibliographic_metadata/20220215_013.bib.mrc:356784079:1796"],"title":"Swami","dewey_decimal_class":["294.5/61"],"notes":{"type":"/type/text","value":"Reprint, with new introd. Originally published: New York : Random House, 1976."},"number_of_pages":330,"edition_name":"1st Paragon House ed.","lccn":["89029504"],"subjects":["Rama, Swami, 1925-","Boyd, Doug","Priests, Hindu -- India","Sadhus -- India","Hinduism -- India"],"publish_date":"1990","publish_country":"nyu","series":["An Omega book","Omega book (New York, N.Y.)"],"by_statement":"Doug Boyd.","works":[{"key":"/works/OL50341W"}],"type":{"key":"/type/edition"},"local_id":["urn:bwbsku:P8-AEO-634"],"oclc_numbers":["20691186"],"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-08-18T10:39:05.922041"}}},"ISBN:9781407024004":{"bib_key":"ISBN:9781407024004","info_url":"http://openlibrary.org/books/OL24300083M/Life_After_Death","preview":"noview","preview_url":"http://openlibrary.org/books/OL24300083M/Life_After_Death","details":{"publishers":["Random House Publishing Group"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"Deepak Chopra's new bestseller provides answers to the perennial question - what happens when we die?In this dazzling new book, Dr Deepak Chopra addresses on of the fundamental questions of existence. It is hard to think about death, but death is as much a part of life as birth and it affects every one of us. Drawing upon his personal experience, the wisdom of ancient Vedic philosophy and state-of-the-art particle physics, Chopra helps us to overcome our fears and to consider all the remarkable possibilities that may await us in the afterlife.With warmth, logic and understanding, Dr Chopra explores the theory that death is an illusion of the senses and that the soul survives in an ongoing spiral of refinement that ends in enlightenment. Thought-provoking exercises offer a first-hand experience of these and other ideas, encouraging spiritual growth and readiness without requiring anyone to abandon their beliefs.Life After Death is the book that Dr Chopra has been preparing to write his entire life. It will help you make sense of your own spirituality, whatever path you choose to follow, offering you your very own practical map of eternity."},"source_records":["marc_overdrive/InternetArchiveCrMarc-2010-06-11s.mrc:7898536:2490","bwb:9781407024004","bwb:9781407024011"],"title":"Life After Death","identifiers":{"overdrive":["C80A498F-342B-4B04-AD75-FED4293C5E69"]},"original_isbn":"9781846040573","physical_format":"eBook","publish_date":"2008","publish_country":"nyu","key":"/books/OL24300083M","isbn_13":["9781407024011","9781407024004"],"publish_places":["London"],"works":[{"key":"/works/OL548752W"}],"type":{"key":"/type/edition"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2010-06-24T00:06:26.265149"},"last_modified":{"type":"/type/datetime","value":"2022-11-18T06:26:05.687839"}}},"ISBN:9780307352279":{"bib_key":"ISBN:9780307352279","info_url":"http://openlibrary.org/books/OL24288603M/Life_After_Death","preview":"noview","preview_url":"http://openlibrary.org/books/OL24288603M/Life_After_Death","details":{"publishers":["Crown Publishing Group"],"physical_format":"E-book","source_records":["marc_overdrive/InternetArch