":{"key":"/type/edition"},"authors":[{"key":"/authors/OL9516401A","name":"Karina Jakubowicz"},{"key":"/authors/OL3257989A","name":"Robert Dickins"}],"isbn_13":["9781003090649"],"languages":[{"key":"/languages/eng"}],"pagination":"210","publish_date":"2021","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781003090649"],"title":"Heresy and Borders in the Twentieth Century","full_title":"Heresy and Borders in the Twentieth Century","works":[{"key":"/works/OL25774242W"}],"key":"/books/OL39543184M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-09-17T14:57:14.971719"},"last_modified":{"type":"/type/datetime","value":"2022-09-17T14:57:14.971719"}}},"ISBN:9780367545031":{"bib_key":"ISBN:9780367545031","info_url":"http://openlibrary.org/books/OL34707926M/Heresy_and_Borders_in_the_Twentieth_Century","preview":"noview","preview_url":"http://openlibrary.org/books/OL34707926M/Heresy_and_Borders_in_the_Twentieth_Century","thumbnail_url":"https://covers.openlibrary.org/b/id/13643273-S.jpg","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL9516401A","name":"Karina Jakubowicz"},{"key":"/authors/OL3257989A","name":"Robert Dickins"}],"isbn_13":["9780367545031"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BT1476.H465 2021","BT1476 .H465 2021"],"publish_date":"2021","publishers":["Taylor & Francis Group","Routledge"],"source_records":["bwb:9780367545031","marc:marc_columbia/Columbia-extract-20221130-031.mrc:455413830:6501","amazon:0367545039","marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:197899149:6025"],"subjects":["Theology, doctrinal"],"title":"Heresy and Borders in the Twentieth Century","pagination":"210","works":[{"key":"/works/OL25774242W"}],"key":"/books/OL34707926M","oclc_numbers":["1246805220","1224584452"],"covers":[13643273],"number_of_pages":210,"lccn":["2020046168"],"description":{"type":"/type/text","value":"\"This book explores the shifting and negotiated boundaries of religion, spirituality, and secular thinking in Britain and North America during the Twentieth Century. It contributes to a growing scholarship that problematizes secularization theory, arguing that religion and spirituality increasingly took diverse new forms and identities, rather than simply being replaced by a monolithic secularity. The volume examines the way that thinkers, writers, and artists manipulated and reimagined orthodox belief systems in their work, using the notion of heresy to delineate the borders of what was considered socially and ethically acceptable. It includes topics such as psychospiritual approaches in medicine, countercultures and religious experience, and the function of blasphemy within supposedly secular politics. The book argues that heresy and heretical identities established fluid borderlands. These borderlands not only blur simple demarcations of the religious and secular in the Twentieth Century, but also infer new forms of heterodoxy through an exchange of ideas. This collection of essays offers a nuanced take on a topic that pervades the study of religion. It will be of great use to scholars of Heresy Studies, Religious Studies and Comparative Religion, Social Anthropology, History, Literature, Philosophy, and Cultural Studies\"--"},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2021-10-07T07:12:57.484208"},"last_modified":{"type":"/type/datetime","value":"2025-05-20T03:58:27.161868"}}},"ISBN:9781000359169":{"bib_key":"ISBN:9781000359169","info_url":"http://openlibrary.org/books/OL38788568M/Heresy_and_Borders_in_the_Twentieth_Century","preview":"noview","preview_url":"http://openlibrary.org/books/OL38788568M/Heresy_and_Borders_in_the_Twentieth_Century","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL9516401A","name":"Karina Jakubowicz"},{"key":"/authors/OL3257989A","name":"Robert Dickins"}],"isbn_13":["9781000359169"],"languages":[{"key":"/languages/eng"}],"pagination":"210",