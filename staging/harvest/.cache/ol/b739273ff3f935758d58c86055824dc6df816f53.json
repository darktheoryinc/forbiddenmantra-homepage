840648"],"subjects":["Christianity and other religions"],"title":"Ramanuja and Schleiermacher","weight":"0.286","subtitle":"Toward a Constructive Comparative Theology","full_title":"Ramanuja and Schleiermacher Toward a Constructive Comparative Theology","works":[{"key":"/works/OL17440855W"}],"key":"/books/OL48211657M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-06-17T09:02:07.255022"},"last_modified":{"type":"/type/datetime","value":"2023-06-17T09:02:07.255022"}}},"ISBN:9780227900352":{"bib_key":"ISBN:9780227900352","info_url":"http://openlibrary.org/books/OL34471661M/Ramanuja_and_Schleiermacher","preview":"noview","preview_url":"http://openlibrary.org/books/OL34471661M/Ramanuja_and_Schleiermacher","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7314765A","name":"Jon Paul Sydnor"}],"isbn_13":["9780227900352"],"languages":[{"key":"/languages/eng"}],"number_of_pages":238,"publish_date":"2012","publishers":["Clarke Company, Limited, James"],"source_records":["bwb:9780227900352"],"subjects":["Ramanuja, 1017-1137","Schleiermacher, friedrich, 1768-1834","Hinduism, relations","Christianity and other religions, hinduism"],"title":"Ramanuja and Schleiermacher","weight":"0.341","subtitle":"Toward a Constructive Comparative Theology","full_title":"Ramanuja and Schleiermacher Toward a Constructive Comparative Theology","works":[{"key":"/works/OL17440855W"}],"key":"/books/OL34471661M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-05T01:43:35.451974"},"last_modified":{"type":"/type/datetime","value":"2021-10-05T01:43:35.451974"}}},"ISBN:9781608993086":{"bib_key":"ISBN:9781608993086","info_url":"http://openlibrary.org/books/OL30721146M/Ramanuja_and_Schleiermacher","preview":"noview","preview_url":"http://openlibrary.org/books/OL30721146M/Ramanuja_and_Schleiermacher","details":{"publishers":["Pickwick Publications"],"table_of_contents":[{"level":0,"label":"","title":"Ramanuja and Schleiermacher","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"\"Absolute dependence\"","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"That upon which we are dependent","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"That which is dependent : cosmology","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"That which is dependent : anthropology","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Toward a constructive comparative theology.","pagenum":"","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"\"Can the comparison of two theologians vastly separated in space and time help contemporary theologians to think better? This book argues that it can. Specifically, this book argues that the novel and burgeoning discipline of comparative theology is a powerful method for gaining critical insight into our inherited worldviews. More important, it argues that the critical insights gained through comparison can produce constructive theology or, in other words, revised and renewed worldviews. New comparisons produce new questions, and new questions produce new answers. In order to demonstrate the power of this process, the book compares two preeminent theologians, Sri Ramanuja of the Hindu tradition and Friedrich Schleiermacher of the Christian tradition. Each argues that God sustains the universe at every moment of its existence, but they work out the divine sustenance in very different ways. By comparing their description of God's continual preservation of the universe, this book asks original, unfamiliar questions of each. Then, it speculatively suggests possible answers to those questions, inviting Ramanuja and Schleiermacher to respond to the challenges raised. This method demonstrates the incisive power of comparative theology to generate critical tension, as well as the creative power of comparative theology to resolve that very tension.\"--Publisher's website."},"isbn_10":["1608993086"],"series":["Princeton theological monograph series -- 159","Princeton theological monograph series -- 159."],"full_title":"Ramanuja and Schleiermacher toward a constructive comparative theology","lc_classifications":["BR128.H5 S94 2011","BR128.H5S94 2011","BR1 .P756 no.159","BR128.H5 S99 2011"],"key":"/books/OL30721146M","authors":[{"key":"/authors/OL7314765A","name":"Jon Paul Sydnor"}],"subtitle":"toward a constructive comparative theology","publish_places":["Eugene, Or"],"isbn_13":["9781608993086"],"pagination":"xii, 226 pages","source_records":["marc:marc_loc_2016/BooksAll.2016.part40.utf8:78127059:3521","bwb:9781608993086","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:770428739:2723","marc:harvard_bibliographic_metadata/20220215_018.bib.mrc:25573505:3535"],"title":"Ramanuja and Schleiermacher","lccn":["2012454120"],"notes":{"type":"/type/text","value":"Includes bibliographical references (pages 219-223) and index."},"number_of_pages":226,"languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["230.092"],"subjects":["Religionsvergleich","Christianity and other religions","Hinduism","Religionstheologie","Interfaith relations","Relations","Christianity"],"subject_people":["Rāmānuja (1017-1137)","Friedrich Schleiermacher (1768-1834)","Ramanuja","Friedrich Schleiermacher"],"publish_country":"oru","publish_date":"2011","by_statement":"Jon Paul Sydnor ; with a foreword by Francis X. Clooney","oclc_numbers":["733230339"],"works":[{"key":"/works/OL17440855W"}],"type":{"key":"/type/edition"},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-10-28T05:39:22.585501"},"last_modified":{"type":"/type/datetime","value":"2025-10-03T21:41:15.981957"}}},"ISBN:9780227900369":{"bib_key":"ISBN:9780227900369","info_url":"http://openlibrary.org/books/OL34471662M/Ramanuja_and_Schleiermacher","preview":"noview","preview_url":"http://openlibrary.org/b