.","oclc_numbers":["731660"],"works":[{"key":"/works/OL3284978W"}],"type":{"key":"/type/edition"},"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-08-09T19:48:04.821141"}}},"ISBN:9781299560925":{"bib_key":"ISBN:9781299560925","info_url":"http://openlibrary.org/books/OL38273677M/Kiss_of_the_Yogini","preview":"noview","preview_url":"http://openlibrary.org/books/OL38273677M/Kiss_of_the_Yogini","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL532559A","name":"David Gordon White"}],"isbn_13":["9781299560925"],"languages":[{"key":"/languages/eng"}],"pagination":"393","publish_date":"2006","publishers":["University of Chicago Press"],"source_records":["bwb:9781299560925"],"title":"Kiss of the Yogini","subtitle":"Tantric Sex in Its South Asian Contexts","full_title":"Kiss of the Yogini Tantric Sex in Its South Asian Contexts","works":[{"key":"/works/OL3266065W"}],"key":"/books/OL38273677M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-06-17T12:20:30.570035"},"last_modified":{"type":"/type/datetime","value":"2022-06-17T12:20:30.570035"}}},"ISBN:9780226894836":{"bib_key":"ISBN:9780226894836","info_url":"http://openlibrary.org/books/OL3562306M/Kiss_of_the_yoginī","preview":"noview","preview_url":"http://openlibrary.org/books/OL3562306M/Kiss_of_the_yoginī","thumbnail_url":"https://covers.openlibrary.org/b/id/143522-S.jpg","details":{"publishers":["University of Chicago Press"],"number_of_pages":372,"subtitle":"\"Tantric sex\" in its South Asian contexts","isbn_10":["0226894835"],"subject_place":["South Asia."],"dewey_decimal_class":["294.5/514/0954"],"covers":[143522],"lc_classifications":["BL1283.842 .W45 2003","BL1283.842.W45 2003"],"key":"/books/OL3562306M","authors":[{"key":"/authors/OL532559A","name":"David Gordon White"}],"publish_places":["Chicago","London"],"uri_descriptions":["Publisher description","Contributor biographical information","Table of contents"],"pagination":"xix, 372 p. :","source_records":["ia:kissyoginitantri00whit","bwb:9780226894836","marc:marc_loc_2016/BooksAll.2016.part29.utf8:191938790:1077","marc:marc_columbia/Columbia-extract-20221130-007.mrc:444127826:3091","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:88678603:823","marc:harvard_bibliographic_metadata/20220215_010.bib.mrc:239545260:3409"],"title":"Kiss of the yoginī","lccn":["2002029031"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 335-356) and index."},"identifiers":{"librarything":["1780146"],"goodreads":["271507"]},"languages":[{"key":"/languages/eng"}],"url":["http://www.loc.gov/catdir/description/uchi052/2002029031.html","http://www.loc.gov/catdir/bios/uchi051/2002029031.html","http://www.loc.gov/catdir/toc/uchi051/2002029031.html"],"subjects":["Tantrism -- South Asia.","Sex -- Religious aspects -- Tantrism."],"publish_date":"2003","publish_country":"ilu","by_statement":"David Gordon White.","works":[{"key":"/works/OL3266058W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/description/uchi052/2002029031.html","http://www.loc.gov/catdir/bios/uchi051/2002029031.html","http://www.loc.gov/catdir/toc/uchi051/2002029031.html"],"oclc_numbers":["50339317"],"description":{"type":"/type/text","value":"\"Kiss of the Yogini focuses on what White identifies as the sole truly distinctive feature of South Asian Tantra: sexualized ritual practices, especially as expressed in the medieval Kaula rites. Such practices centered on the exchange of powerful, transformative sexual fluids between male practitioners and wild female bird and animal spirits known as Yoginis.\n\nIt was only by \"drinking\" the sexual fluids of the Yoginis that men could enter the family of the supreme godhead and thereby obtain supernatural powers and transform themselves into gods.\n\nBy focusing on sexual rituals, White resituates South Asian Tantra in its precolonial form, at the center of religious, social, and political life, arguing that Tantra was the mainstream, and that in many ways it continues to influence contemporary Hinduism, even if reformist misunderstandings relegate it to a marginal position.\".\n\n\"Kiss of the Yogini contains White's own translations from over a dozen Tantras that have never before been translated into any European language. It will prove to be the definitive work for persons seeking to understand Tantra and the crucial role it has played in South Asian history, society, culture, and religion.\"--BOOK JACKET."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-07-21T04:00:34.805765"}}},"ISBN:9780226027838":{"bib_key":"ISBN:9780226027838","info_url":"http://openlibrary.org/books/OL36793595M/Kiss_of_the_Yogini","preview":"noview","preview_url":"http://openlibrary.org/books/OL36793595M/Kiss_of_the_Yogini","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL532559A","name":"David Gordon White"}],"isbn_13":["9780226027838"],"languages":[{"key":"/languages/eng"}],"pagination":"391","publish_date":"2003","publishers":["University of Chicago Press"],"source_records":["bwb:9780226027838"],"title":"Kiss of the Yogini","subtitle":"Tantric Sex in Its South Asian Contexts","full_title":"Kiss of the Yogini Tantric Sex in Its South Asian Contexts","works":[{"key":"/works/OL3266065W"}],"key":"/books/OL36793595M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-01-28T01:51:22.212186"},"last_modified":{"type":"/type/datetime","value":"2022-01-28T01:51:22.212186"}}},"ISBN:9780226894843":{"bib_key":"ISBN:9780226894843","info_url":"http://openlibrary.org/books/OL28239012M/Kiss_of_the_Yogini","preview":"noview","preview_url":"http://openlibrary.org/books/OL28239012M/Kiss_of_the_Yogini","thumbnail_url":"https://covers.openlibrary.org/b