:9780429860140":{"bib_key":"ISBN:9780429860140","info_url":"http://openlibrary.org/books/OL39607016M/When_the_Soul_Remembers_Itself","preview":"noview","preview_url":"http://openlibrary.org/books/OL39607016M/When_the_Soul_Remembers_Itself","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7901108A","name":"Thomas Singer"},{"key":"/authors/OL717303A","name":"Jules Cashford"},{"key":"/authors/OL9734799A","name":"Craig San Roque"}],"isbn_13":["9780429860140"],"languages":[{"key":"/languages/eng"}],"pagination":"224","publish_date":"2019","publishers":["Taylor & Francis Group"],"source_records":["bwb:9780429860140"],"subjects":["Civilization, modern","Greece, history","Social psychology"],"title":"When the Soul Remembers Itself","subtitle":"Ancient Greece, Modern Psyche","full_title":"When the Soul Remembers Itself Ancient Greece, Modern Psyche","works":[{"key":"/works/OL25750281W"}],"key":"/books/OL39607016M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-09-18T06:12:33.175821"},"last_modified":{"type":"/type/datetime","value":"2022-09-18T06:12:33.175821"}}},"ISBN:9781138310759":{"bib_key":"ISBN:9781138310759","info_url":"http://openlibrary.org/books/OL34650766M/When_the_Soul_Remembers_Itself","preview":"noview","preview_url":"http://openlibrary.org/books/OL34650766M/When_the_Soul_Remembers_Itself","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7901108A","name":"Thomas Singer"},{"key":"/authors/OL717303A","name":"Jules Cashford"},{"key":"/authors/OL9734799A","name":"Craig San Roque"}],"isbn_13":["9781138310759"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["HM1027","HM1027.G8","HM1027.G8 S56 2019","HM1027.G8 W44 2019"],"publish_date":"2019","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781138310759","marc:marc_columbia/Columbia-extract-20221130-030.mrc:122473022:5437","marc:marc_columbia/Columbia-extract-20221130-029.mrc:45165070:4318","marc:harvard_bibliographic_metadata/20220215_017.bib.mrc:352180333:5330"],"subjects":["Civilization, modern","Greece, history","Social psychology"],"title":"When the Soul Remembers Itself","weight":"0.364","pagination":"224","subtitle":"Ancient Greece, Modern Psyche","works":[{"key":"/works/OL25750281W"}],"key":"/books/OL34650766M","lccn":["2019981300","2018056323"],"oclc_numbers":["1098275289","1076458027"],"description":{"type":"/type/text","value":"Do the ancient Greek poets, playwrights, philosophers and mythologies have anything to say to modern human beings? Is their time finished, or do their insights have as much relevance to the human condition as they did 2,500 years ago? When the Soul Remembers Itself continues the exploration of the connections between ancient and modern psyche with a resounding affirmation of its ongoing relevance. Uniquely combining poetry, drama and storytelling in a pioneering collection, an international selection of contributors each explore a character, myth or theme from ancient Greece in the context of its relevance to the modern psyche. Each author enters an imaginative dialogue that pieces and bridges together fragments of the past with the present, exploring themes such as initiation, war, love, paranoia, tragedy and the soul's journey through the vicissitudes of life on earth, through characters such as Ajax, Persephone, Orpheus, Electra, the Apostle Paul, Perpetua and Jocasta. Understanding myth is crucial in Jungian analysis, and by connecting the modern person with the age-old questions of life and death, the contributors bring truly archetypal narratives to life and speak to the human condition throughout the ages. When the Soul Remembers Itself will be of great interest to academics and students of Jungian and post-Jungian studies, classics, ancient religion, archetypal studies and mythology. As the contributors' conclusions apply to both contemporary theory and clinical practice, it will also appeal to Jungian analysts and psychotherapists in practice and training."},"number_of_pages":223,"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2021-10-06T20:47:44.199192"},"last_modified":{"type":"/type/datetime","value":"2025-10-01T05:16:18.777922"}}},"ISBN:9780429860164":{"bib_key":"ISBN:9780429860164","info_url":"http://openlibrary.org/books/OL34738665M/When_the_Soul_Remembers_Itself","preview":"noview","preview_url":"http://openlibrary.org/books/OL34738665M/When_the_Soul_Remembers_Itself","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7901108A","name":"Thomas Singer"},{"key":"/authors/OL717303A","name":"Jules Cashford"},{"key":"/authors/OL9734799A","name":"Craig San Roque"}],"isbn_13":["9780429860164"],"languages":[{"key":"/languages/eng"}],"publish_date":"2019","publishers":["Taylor & Francis Group"],"source_records":["bwb:9780429860164"],"subjects":["Civilization, modern","Greece, history","Social psychology"],"title":"When the Soul Remembers Itself","pagination":"224","subtitle":"Ancient Greece, Modern Psyche","full_title":"When the Soul Remembers Itself Ancient Greece, Modern Psyche","works":[{"key":"/works/OL25750281W"}],"key":"/books/OL34738665M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-07T15:37:57.829346"},"last_modified":{"type":"/type/datetime","value":"2021-10-07T15:37:57.829346"}}},"ISBN:9781138310728":{"bib_key":"ISBN:9781138310728","info_url":"http://openlibrary.org/books/OL34660258M/When_the_Soul_Remembers_Itself","preview":"noview","preview_url":"http://openlibrary.org/books/OL34660258M/When_the_Soul_Remembers_Itself","thumbnail_url":"https://covers.openlibrary.org/b/id/13827578-S.jpg","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7901108A","name":"Thomas Singer"},{"key":"/authors/OL717303A","name":"Jules Cashford"},{"key":"/authors/OL9734799A","name":"Craig San Roque"}],"isbn_13":["9781138310728"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["HM1027