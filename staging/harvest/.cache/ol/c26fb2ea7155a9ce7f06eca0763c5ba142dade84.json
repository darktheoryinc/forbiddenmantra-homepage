n_Yoga","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2882861A","name":"Elizabeth De Michelis"}],"isbn_13":["9781623568078"],"languages":[{"key":"/languages/eng"}],"publish_date":"2010","publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781623568078"],"title":"History of Modern Yoga","subtitle":"Patanjali and Western Esotericism","full_title":"History of Modern Yoga Patanjali and Western Esotericism","works":[{"key":"/works/OL8585313W"}],"key":"/books/OL48637933M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-07-17T06:12:51.889900"},"last_modified":{"type":"/type/datetime","value":"2023-07-17T06:12:51.889900"}}},"ISBN:9780826487728":{"bib_key":"ISBN:9780826487728","info_url":"http://openlibrary.org/books/OL8169379M/A_History_of_Modern_Yoga","preview":"noview","preview_url":"http://openlibrary.org/books/OL8169379M/A_History_of_Modern_Yoga","thumbnail_url":"https://covers.openlibrary.org/b/id/1573330-S.jpg","details":{"publishers":["Continuum International Publishing Group"],"identifiers":{"goodreads":["1264892"],"librarything":["3011768"],"doi":["10.5040/9781472548436"]},"subtitle":"Patanjali and Western Esotericism","weight":"1.1 pounds","covers":[1573330],"physical_format":"Paperback","lc_classifications":["B132.Y6D37 2005","B132.Y6 D37 2004"],"key":"/books/OL8169379M","authors":[{"key":"/authors/OL2882861A","name":"Elizabeth De Michelis"}],"subjects":["Oriental & Indian philosophy","Yoga for exercise","20th century","c 1700 to c 1800","c 1800 to c 1900","Yoga","Health/Fitness","Health & Fitness","Religion - World Religions","India","Eastern - General","Religion - Socialissues"],"edition_name":"New Ed edition","languages":[{"key":"/languages/eng"}],"source_records":["bwb:9780826487728","promise:bwb_daily_pallets_2021-07-26","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:47773289:3361"],"title":"A History of Modern Yoga","number_of_pages":256,"isbn_13":["9780826487728"],"isbn_10":["0826487726"],"publish_date":"November 2005","works":[{"key":"/works/OL8585313W"}],"type":{"key":"/type/edition"},"physical_dimensions":"9.1 x 6.1 x 0.9 inches","local_id":["urn:bwbsku:P7-CEK-050"],"oclc_numbers":["1057398490"],"description":{"type":"/type/text","value":"\"A History of Modern Yoga traces the roots of Modern Yoga back to the spread of western esoteric ideas in 18th century Bengal's intellectual circles. In due course Raja Yoga, published by Vivekananda in 1896, became the seminal text of Modern Yoga largely because, the author shows, it reconfigured the Yoga Sutras of Patanjali along the lines of a then emerging New Age occultistic style of secularised and individualistically oriented religiosity. With regard to 20th century developments, this book proposes a four-fold typology of Modern Yoga comprising Modern Psychosomatic, Modern Meditational, Modern Postural and Modern Denominational forms. Iyengar Yoga, one of the most influential schools of Modern Postural Yoga, is then analyzed in the light of this framework, while the conclusion shows how a typical Modern Postural Yoga session may be interpreted to reveal the forms and contents of a healing ritual of secular religion.\"--Bloomsbury Publishing."},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-29T15:03:11.581851"},"last_modified":{"type":"/type/datetime","value":"2025-04-30T15:27:39.873921"}}}}