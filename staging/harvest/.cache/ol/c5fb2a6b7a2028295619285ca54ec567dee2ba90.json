 Introduction that sets Rumi in his context and an Afterword musing on poetry of the mysterious and the sacred. Join Coleman Barks and Rumi for a year-long journey into the mystical and sacred within and without. Join them in recognizing and embracing the divine in the sublime, in the ordinary, and in us all."},"latest_revision":18,"revision":18,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-07-09T08:38:36.635071"}}},"ISBN:9780061210501":{"bib_key":"ISBN:9780061210501","info_url":"http://openlibrary.org/books/OL24255709M/A_Year_with_Rumi","preview":"noview","preview_url":"http://openlibrary.org/books/OL24255709M/A_Year_with_Rumi","thumbnail_url":"https://covers.openlibrary.org/b/id/6403664-S.jpg","details":{"publishers":["HarperCollins"],"languages":[{"key":"/languages/eng"}],"source_records":["marc_overdrive/InternetArchiveCrMarc-2010-06-11g.mrc:2611529:2042","bwb:9780061757662","bwb:9780061210518"],"title":"A Year with Rumi","identifiers":{"overdrive":["DB774482-2D30-47EA-83C4-55621B867444"]},"isbn_13":["9780061210501","9780061757662","9780061210518"],"covers":[6403664],"physical_format":"Electronic resource","publish_date":"2006","publish_country":"nyu","key":"/books/OL24255709M","authors":[{"key":"/authors/OL618326A","name":"Coleman Barks"}],"publish_places":["New York"],"works":[{"key":"/works/OL3627261W"}],"type":{"key":"/type/edition"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2010-06-17T05:38:12.850349"},"last_modified":{"type":"/type/datetime","value":"2022-02-28T21:48:33.509093"}}},"ISBN:9780061210532":{"bib_key":"ISBN:9780061210532","info_url":"http://openlibrary.org/books/OL37368364M/Year_with_Rumi","preview":"noview","preview_url":"http://openlibrary.org/books/OL37368364M/Year_with_Rumi","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL618326A","name":"Coleman Barks"}],"isbn_13":["9780061210532"],"languages":[{"key":