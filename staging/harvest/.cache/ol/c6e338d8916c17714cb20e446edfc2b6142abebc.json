ed":{"type":"/type/datetime","value":"2021-12-27T04:46:16.892073"}}},"ISBN:9781510723948":{"bib_key":"ISBN:9781510723948","info_url":"http://openlibrary.org/books/OL34087522M/Joy_of_Yoga","preview":"noview","preview_url":"http://openlibrary.org/books/OL34087522M/Joy_of_Yoga","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7521108A","name":"Emma Silverman"}],"isbn_13":["9781510723948"],"languages":[{"key":"/languages/eng"}],"number_of_pages":208,"publish_date":"2018","publishers":["Skyhorse Publishing Company, Incorporated"],"source_records":["bwb:9781510723948"],"subjects":["Yoga"],"title":"Joy of Yoga","subtitle":"Fifty Sequences for Your Home and Studio Practice","full_title":"Joy of Yoga Fifty Sequences for Your Home and Studio Practice","works":[{"key":"/works/OL19983195W"}],"key":"/books/OL34087522M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-09-30T04:39:04.035622"},"last_modified":{"type":"/type/datetime","value":"2021-09-30T04:39:04.035622"}}},"ISBN:9781628737769":{"bib_key":"ISBN:9781628737769","info_url":"http://openlibrary.org/books/OL27163329M/The_joy_of_yoga","preview":"noview","preview_url":"http://openlibrary.org/books/OL27163329M/The_joy_of_yoga","details":{"subtitle":"fifty sequences for your home and studio practice","description":{"type":"/type/text","value":"\"Thousands of people take time out of their busy schedules every day to attend yoga classes where they learn postures and breathing techniques that make them feel more energized and balanced. Thousands of other people, however, have yet to find the time in their day to do anything but work, study, or chase after their children. In The Joy of Yoga, author and expert Emma Silverman teaches readers how to take advantage of the health benefits yoga offers even when they can't make it to regularly scheduled classes. The Joy of Yoga offers short sequences that readers can perform while seated on airplanes, in taxi cabs, standing at the bus stop, or even while waiting for water to boil. In addition, it also includes sequences to help with daily aches, pains, and annoyances, such as tired feet, sensitive wrists, neck and shoulder tension, lower back pain, anxiety, and even heartbreak. Weekend gardeners, cyclists, runners, musicians, and waiters/waitresses will also find exercises that will help ease the tension in their muscles after long hours of work or play. The Joy of Yoga will also: Provide step-by-step instructions on asana (postures) and pranayama (breathing techniques) for fifty sequences List the benefits of each sequence and include helpful information about modifications for poses Encourage readers to create sequences on their own, using the sequences in the book as starting points\"--"},"isbn_10":["162873776X"],"local_id":["urn:sfpl:31223111605169","urn:sfpl:31223111605177","urn:sfpl:31223111605045","urn:sfpl:31223111605052","urn:bwbsku:P9-DWS-550"],"full_title":"The joy of yoga fifty sequences for your home and studio practice","lc_classifications":["RA781.7 .S546 2014","RA781.7.S546 2014"],"key":"/books/OL27163329M","authors":[{"key":"/authors/OL7521108A","name":"Emma Silverman"}],"contributions":["Frail, Kerri, illustrator"],"isbn_13":["9781628737769"],"pagination":"x, 198 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:71046950:3823","marc:marc_loc_2016/BooksAll.2016.part41.utf8:144935942:2468","bwb:9781628737769","promise:bwb_daily_pallets_2024-05-06:P9-DWS-550"],"title":"The joy of yoga","dewey_decimal_class":["613.7/046"],"number_of_pages":198,"languages":[{"key":"/languages/eng"}],"lccn":["2014005912"],"subjects":["Hatha yoga","Health","Exercise"],"publish_date":"2014","publish_country":"nyu","by_statement":"Emma  Silverman ; illustrated by Kerri Frail","oclc_numbers":["858365191"],"works":[{"key":"/works/OL19983195W"}],"type":{"key":"/type/edition"},"publishers":["Skyhorse Publishing Company, Incorporated"],"latest_revisi