ision":1,"created":{"type":"/type/datetime","value":"2021-12-29T21:19:36.715030"},"last_modified":{"type":"/type/datetime","value":"2021-12-29T21:19:36.715030"}}},"ISBN:9780367748487":{"bib_key":"ISBN:9780367748487","info_url":"http://openlibrary.org/books/OL34709336M/Everyday_Musical_Life_among_the_Indigenous_Bunun_Taiwan","preview":"noview","preview_url":"http://openlibrary.org/books/OL34709336M/Everyday_Musical_Life_among_the_Indigenous_Bunun_Taiwan","thumbnail_url":"https://covers.openlibrary.org/b/id/13217212-S.jpg","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL9576964A","name":"Jonathan P. J. Stock"}],"isbn_13":["9780367748487"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["ML3747.7","ML3747 .S76 2021"],"publish_date":"2021","publishers":["Taylor & Francis Group"],"source_records":["bwb:9780367748487","amazon:0367748487","marc:harvard_bibliographic_metadata/20220215_036.bib.mrc:194986340:3824"],"subjects":["Music, history and criticism"],"title":"Everyday Musical Life among the Indigenous Bunun Taiwan","pagination":"150","full_title":"Everyday Musical Life among the Indigenous Bunun Taiwan","works":[{"key":"/works/OL25326956W"}],"key":"/books/OL34709336M","covers":[13217212],"oclc_numbers":["1235469227"],"description":{"type":"/type/text","value":"\"Everyday Musical Life among the Indigenous Bunun, Taiwan contributes to multidisciplinary research on music in everyday human life by pushing beyond the urbanized Western populations routinely featured in such writing. Based on ethnographic study in Buklavu, a village in southern Taiwan mostly inhabited by the indigenous Bunun, the book explores villagers’ contemporaneous musical engagements and pathways, paying heed both to imported music—such as TV theme tunes, karaoke singing, church hymns—and to the transformation of Bunun traditions through school and community interventions and folkloric festivals. The case study underpins a new, widely applicable, theoretical model for the study of music in everyday life in global society which is historically engaged, sensitive to individual and group diversity, cognizant of the interplay of the mundane and the exceptional, and primed to support applied research\"--"},"number_of_pages":149,"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2021-10-07T07:26:58.025878"},"last_modified":{"type":"/type/datetime","value":"2026-04-20T09:57:58.549133"}}},"ISBN:9780367748494":{"bib_key":"ISBN:9780367748494","info_url":"http://openlibrary.org/books/OL49627200M/Everyday_Musical_Life_among_the_Indigenous_Bunun_Taiwan","preview":"noview","preview_url":"http://openlibrary.org/books/OL49627200M/Everyday_Musical_Life_among_the_Indigenous_Bunun_Taiwan","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL9576964A","name":"Jonathan P. J. Stock"},{"key":"/authors/OL9576965A","name":"Chou Chiener"}],"isbn_13":["9780367748494"],"languages":[{"key":"/languages/eng"}],"pagination":"150","publish_date":"2023","publishers":["Routledge, Chapman & Hall, Incorporated"],"source_records":["bwb:9780367748494"],"title":"Everyday Musical Life among the Indigenous Bunun, Taiwan","full_title":"Everyday Musical Life among the Indigenous Bunun, Taiwan","works":[{"key":"/works/OL25326956W"}],"key":"/books/OL49627200M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-09-17T23:27:50.758299"},"last_modified":{"type":"/type/datetime","value":"2023-09-17T23:27:50.758299"}}}}