g/details/zensandbookofcap0000hori","thumbnail_url":"https://covers.openlibrary.org/b/id/12956901-S.jpg","details":{"publishers":["University of Hawai'i"],"identifiers":{"librarything":["2345939"],"goodreads":["2039162"]},"subtitle":"the book of capping phrases for kōan practice","isbn_10":["0824822846"],"series":["Nanzan library of Asian religion and culture"],"lc_classifications":["BQ9289.5 .H67 2003","BQ9289.5.H67 2003"],"key":"/books/OL15536270M","authors":[{"key":"/authors/OL2880789A","name":"Victor Sōgen Hori"}],"publish_places":["Honolulu"],"pagination":"xiv, 764 p. :","source_records":["marc:marc_western_washington_univ/wwu_bibs.mrc_revrev.mrc:792986293:982","bwb:9780824822842","marc:marc_loc_2016/BooksAll.2016.part29.utf8:195047174:832","ia:zensandbookofcap0000hori","promise:bwb_daily_pallets_2022-08-13","marc:marc_columbia/Columbia-extract-20221130-007.mrc:443792595:3114","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:17414693:956","marc:harvard_bibliographic_metadata/20220215_006.bib.mrc:158932408:3737"],"title":"Zen sand","lccn":["2002032477"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 731-748) and index."},"number_of_pages":764,"languages":[{"key":"/languages/eng"}],"subjects":["Koan","Spiritual life -- Rinzai (Sect)"],"publish_date":"2003","publish_country":"hiu","by_statement":"compiled, translated, and annotated by Victor Sōgen Hori.","oclc_numbers":["50590697"],"works":[{"key":"/works/OL8581123W"}],"type":{"key":"/type/edition"},"covers":[12956901],"ocaid":"zensandbookofcap0000hori","local_id":["urn:bwbsku:O8-CSH-036"],"description":{"type":"/type/text","value":"\"Zen Sand is a classic collection of verses aimed at aiding practitioners of koan meditation in negotiating the difficult relationship between insight and language. As such it represents a major contribution to both Western Zen practice and English-language Zen scholarship.\".\n\n\"In Japan the traditional Rinzai Zen koan curriculum includes the use of jakugo, or \"capping phrases.\" Once a monk has successfully replied to a koan, the Zen master orders the search for a classical verse to express the monk's insight into the koan. Special collections of these jakugo were compiled as handbooks to aid in that search. Until now, Zen students in the West, lacking this important resource, have been severely limited in carrying out this practice.\n\nZen Sand combines and translates two standard jakugo handbooks and opens the way for incorporating this important tradition fully into Western Zen practice.\" \"This impressive compendium of texts central to Zen practice offers a wealth of information not only to students of Zen or Buddhism in general, but to anyone interested in the history and culture of East Asia.\"--BOOK JACKET."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-09-20T09:57:01.685395"},"last_modified":{"type":"/type/datetime","value":"2025-06-27T03:27:19.591001"}}},"ISBN:9780824835071":{"bib_key":"ISBN:9780824835071","info_url":"http://openlibrary.org/books/OL28749181M/Zen_Sand","preview":"noview","preview_url":"http://openlibrary.org/books/OL28749181M/Zen_Sand","details":{"publishers":["University of Hawaii Press"],"subtitle":"The Book of Pa","source_records":["bwb:9780824835071","promise:bwb_daily_pallets_2024-02-20:P9-AAS-517"],"title":"Zen Sand","number_of_pages":784,"isbn_13":["9780824835071"],"languages":[{"key":"/languages/eng"}],"full_title":"Zen Sand The Book of Pa","lc_classifications":[""],"publish_date":"2010","key":"/books/OL28749181M","authors":[{"key":"/authors/OL2880789A","name":"Victor Sōgen Hori"},{"key":"/authors/OL2880789A","name":"Victor Sōgen Hori"},{"key":"/authors/OL2880789A","name":"Victor Sōgen Hori"}],"works":[{"key":"/works/OL8581123W"}],"type":{"key":"/type/edition"},"subjects":["Koan","Spiritual life, buddhism"],"local_id":["urn:bwbsku:P9-AAS-517"],"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":