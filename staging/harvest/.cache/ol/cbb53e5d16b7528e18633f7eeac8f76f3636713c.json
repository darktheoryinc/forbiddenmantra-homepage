{"ISBN:9782290019443":{"bib_key":"ISBN:9782290019443","info_url":"http://openlibrary.org/books/OL27011600M/Le_Trône_de_fer","preview":"restricted","preview_url":"https://archive.org/details/letronedeferlint0002mart_t8e1","thumbnail_url":"https://covers.openlibrary.org/b/id/15123801-S.jpg","details":{"publishers":["J'ai Lu"],"source_records":["amazon:2290019445","ia:letronedeferlint0002mart_t8e1","promise:bwb_daily_pallets_2022-04-01"],"title":"Le Trône de fer","number_of_pages":960,"covers":[15123801],"publish_date":"2013","key":"/books/OL27011600M","authors":[{"key":"/authors/OL234664A","name":"George R. R. Martin"}],"works":[{"key":"/works/OL257939W"}],"type":{"key":"/type/edition"},"local_id":["urn:bwbsku:T2-CNQ-333"],"identifiers":{},"ocaid":"letronedeferlint0002mart_t8e1","isbn_10":["2290019445"],"isbn_13":["9782290019443"],"oclc_numbers":["742945051"],"subtitle":"L'intégrale 2","languages":[{"key":"/languages/fre"}],"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2019-06-23T20:51:49.196768"},"last_modified":{"type":"/type/datetime","value":"2025-10-03T17:01:02.992769"}}},"ISBN:9788652142873":{"bib_key":"ISBN:9788652142873","info_url":"http://openlibrary.org/books/OL57727739M/Sudar_kraljeva","preview":"noview","preview_url":"http://openlibrary.org/books/OL57727739M/Sudar_kraljeva","thumbnail_url":"https://covers.openlibrary.org/b/id/14844141-S.jpg","details":{"works":[{"key":"/works/OL257939W"}],"title":"Sudar kraljeva","publishers":["Laguna"],"publish_date":"2021","key":"/books/OL57727739M","type":{"key":"/type/edition"},"identifiers":{},"covers":[14844141],"isbn_13":["9788652142873"],"subtitle":"Ilustrovano izdanje","publish_places":["Belgrade, Serbia"],"contributors":[{"role":"Translator","name":"Nikola Pajvančić"}],"languages":[{"key":"/languages/srp"}],"translation_of":"A Clash of Kings","translated_from":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"Kao da se samo vreme iščašilo. Leto spokoja i obilja, dugo deset godina, bliži se kraju, a surova, ledena zima prikrada se kao gladna zver. Dva velika čoveka – lord Edard Stark i kralj Robert Barateon – koji su vladali tokom dugog doba mira, sada su mrtvi, žrtve izdajstva u kraljevskom domu. Od drevne citadele Zmajkamen do surovog severa oko Zimovrela, vlada metež, pošto pretendenti na gvozdeni presto Sedam kraljevstava pokušavaju da ga zauzmu ratom, prevarom ili magijom.\r\n\r\nDok nebo preseca kometa boje krvi i plamena – kometa koja najavljuje propast – šest strana se bore za prevlast u zavađenoj zemlji. Edardov sin Rob proglasio se za kralja na Severu. Na jugu, prestolonaslednik Džofri je vladar samo po imenu, okružen spletkama dvorana u Kraljevoj luci. Dva Robertova brata takođe žele vlast, ali i oni bez prava na tron spremaju se u osvajački pohod. A na dalekom kontinentu, prognana kraljica, majka zmajeva, stavlja sve na kocku i vodi svoje dragocene štićenike preko nemilosrdne pustinje da osvoji krunu koja joj po pravu pripada.\r\n\r\nU svetu kojim vladaju bratoubistvo i rodoskvrnuće, alhemija i izdajstvo, cena slave meri se krvlju, a pobednički plen će završiti u rukama ljudi sa najhladnijim čelikom i najhladnijim srcem. Jer kada se kraljevi sudare, čitavo kraljevstvo se ruši."},"physical_format":"Hardcover","number_of_pages":749,"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2025-02-15T21:17:59.250495"},"last_modified":{"type":"/type/datetime","value":"2025-02-15T21:20:20.558043"}}},"ISBN:9780008115418":{"bib_key":"ISBN:9780008115418","info_url":"http://openlibrary.org/books/OL28622322M/Clash_of_Kings","preview":"noview","preview_url":"http://openlibrary.org/books/OL28622322M/Clash_of_Kings","thumbnail_url":"https://covers.openlibrary.org/b/id/14818018-S.jpg","details":{"publishers":["HarperCollins Publishers Limited"],"source_records":["bwb:9780008115418"],"title":"Clash of Kings","number_of_pages":928,"isbn_13":["9780008115418"],"languages":[{"key":"/languages/eng"}],"full_title"