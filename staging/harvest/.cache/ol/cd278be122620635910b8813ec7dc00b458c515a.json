utions":["Holstein, Alexander"],"languages":[{"key":"/languages/eng"}],"pagination":"202 p. :","source_records":["marc:marc_miami_univ_ohio/allbibs0075.out:6291863:875","bwb:9780804819244","marc:marc_columbia/Columbia-extract-20221130-003.mrc:388290782:1795","marc:harvard_bibliographic_metadata/20220215_033.bib.mrc:195430359:1522"],"title":"Pointing at the moon","lccn":["93061302"],"number_of_pages":202,"edition_name":"1st ed","subjects":["Koan","Zen meditations","Zen Buddhism"],"publish_date":"1993","publish_country":"vtu","by_statement":"translated & illustrated by Alexander Holstein","works":[{"key":"/works/OL19026757W"}],"type":{"key":"/type/edition"},"oclc_numbers":["29969768"],"description":{"type":"/type/text","value":"People around the world value the mind-cleansing, spiritually uplifting benefits to be gained through the practice of Ch'an (Zen) Buddhism. Central to Ch'an Buddhism is the enigmatic koan (kung-an), a kind of riddle used by masters to shock their students into greater awareness. In this timeless collection from Chinese masters, translations of 100 of these question-and-answer riddles are presented.\n\nEach koan is followed by the author's commentary, which provides fascinating insight into the background and deeper meanings of the koans. Enhanced by 85 beautifully sketched Chinese brush paintings, Pointing at the Moon is a text certain to stimulate and challenge anyone interested in learning more about Zen and its tradition of spiritual enlightenment."},"lc_classifications":["BQ9289 .P65 1993"],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-09-26T00:02:05.766857"},"last_modified":{"type":"/type/datetime","value":"2026-03-25T12:16:06.684797"}}},"ISBN:9781281606983":{"bib_key":"ISBN:9781281606983","info_url":"http://openlibrary.org/books/OL33449508M/Pointing_at_the_Moon","preview":"noview","preview_url":"http://openlibrary.org/books/OL33449508M/Pointing_at_the_Moon","details":{"type":{"key":"/type/edition"},"aut