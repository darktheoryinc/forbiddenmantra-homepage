{"ISBN:9780791443620":{"bib_key":"ISBN:9780791443620","info_url":"http://openlibrary.org/books/OL35642M/Freedom_through_inner_renunciation","preview":"borrow","preview_url":"https://archive.org/details/freedomthroughin0000marc","thumbnail_url":"https://covers.openlibrary.org/b/id/1491713-S.jpg","details":{"publishers":["State University of New York Press"],"identifiers":{"goodreads":["5867124","2957951"]},"subtitle":"Śaṅkara's philosophy in a new light","isbn_10":["0791443612","0791443620"],"series":["McGill studies in the history of religions"],"covers":[1491713,1491711],"lc_classifications":["B133.S5 M35 2000","B133.S5M35 2000"],"key":"/books/OL35642M","authors":[{"key":"/authors/OL22785A","name":"Roger Marcaurelle"}],"publish_places":["Albany"],"pagination":"xvii, 269 p. ;","source_records":["marc:marc_records_scriblio_net/part28.dat:4828577:884","marc:marc_loc_2016/BooksAll.2016.part27.utf8:229682317:890","bwb:9780791443613","bwb:9780791443620","ia:freedomthroughin0000marc","promise:bwb_daily_pallets_2022-03-17","marc:marc_columbia/Columbia-extract-20221130-005.mrc:493907828:3208","marc:harvard_bibliographic_metadata/20220215_039.bib.mrc:269328939:3780"],"title":"Freedom through inner renunciation","dewey_decimal_class":["181/.482"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 255-260) and index."},"number_of_pages":269,"languages":[{"key":"/languages/eng"}],"lccn":["99020738"],"subjects":["Śaṅkarācārya","Renunciation (Philosophy)","Advaita","Vedanta"],"publish_date":"2000","publish_country":"nyu","by_statement":"Roger Marcaurelle.","works":[{"key":"/works/OL13391W"}],"type":{"key":"/type/edition"},"ocaid":"freedomthroughin0000marc","local_id":["urn:bwbsku:690-BAA-289"],"oclc_numbers":["40943415"],"description":{"type":"/type/text","value":"\"This book is the first full-length study of renunciation in Sankara's Advaita Vedanta. It shows that a major misinterpretation occurred concerning Sankara's position on renunciation early within his own tradition, and has persisted amongst modern Indologists. Most interpreters of Sankara understand that he saw the monastic way of living as a sine qua non for full knowledge of the Self and spiritual freedom.\n\nBut this study brings Sankara's real position to light and shows that, for him, inner renunciation of ego and doership was the only indispensable form of renunciation. Monasticism was quite useful, but not mandatory. Using Sankara's own hermeneutical principles as well as the modern philological approach, Marcaurelle shows the basic processes of interpretation and misinterpretation that can shape fundamental aspects of a spiritual tradition.\"--BOOK JACKET."},"latest_revision":23,"revision":23,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-05-24T07:43:13.685847"}}},"ISBN:9788185122045":{"bib_key":"ISBN:9788185122045","info_url":"http://openlibrary.org/books/OL2513216M/Siddhāntatattvabinduḥ","preview":"noview","preview_url":"http://openlibrary.org/books/OL2513216M/Siddhāntatattvabinduḥ","thumbnail_url":"https://covers.openlibrary.org/b/id/13831280-S.jpg","details":{"other_titles":["Siddhanta-tattva-bindu."],"publishers":["Bhāratīya Buka Kārporeśana","Anya prāpti sthāna Bhāratīya Vidyā Prakāśana"],"identifiers":{"goodreads":["6294674"]},"description":{"type":"/type/text","value":"Commentary, with supercommentaries on Śaṅkarācārya's Daśaślokī, verse work propounding fundamentals of Advaita philosophy."},"isbn_10":["8185122040"],"lc_classifications":["B133.S47 D3737 1986"],"key":"/books/OL2513216M","authors":[{"key":"/authors/OL3523A","name":"Madhusūdana Sarasvatī."}],"publish_places":["Dillī, Bhārata","Vārāṇasī"],"contributions":["Nārāyaṇatīrtha, 18th cent.","Puruṣottamasarasvatī.","Bākre, Mahādevaśarmā."],"pagination":"7, 146 p. ;","source_records":["marc:marc_records_scriblio_net/part19.dat:195044550:1354","marc:marc_loc_2