{"ISBN:9780195633467":{"bib_key":"ISBN:9780195633467","info_url":"http://openlibrary.org/books/OL7394285M/The_Philosophy_of_Religion","preview":"noview","preview_url":"http://openlibrary.org/books/OL7394285M/The_Philosophy_of_Religion","thumbnail_url":"https://covers.openlibrary.org/b/id/4603426-S.jpg","details":{"publishers":["Oxford University Press, USA"],"number_of_pages":224,"subtitle":"A Buddhist Perspective","covers":[4603426,3842490],"lc_classifications":["BQ282.S5 1995","BQ282 .S5 1995"],"key":"/books/OL7394285M","authors":[{"key":"/authors/OL112695A","name":"Arvind Sharma"}],"languages":[{"key":"/languages/eng"}],"source_records":["bwb:9780195633467","marc:marc_loc_2016/BooksAll.2016.part25.utf8:57867034:805","marc:marc_gtu/KLF IA Export 5-5-22.mrc:55186168:977","marc:marc_columbia/Columbia-extract-20221130-005.mrc:6875558:2550"],"title":"The Philosophy of Religion","lccn":["95910484"],"identifiers":{"goodreads":["1441885"]},"isbn_13":["9780195633467"],"isbn_10":["0195633466"],"publish_date":"February 29, 1996","works":[{"key":"/works/OL1084026W"}],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"The Judaic-Christian concept of God is monotheistic."},"local_id":["urn:gtu:32400003729211"],"oclc_numbers":["33971089"],"description":{"type":"/type/text","value":"This important work does much to extend and redefine the ground of the philosophy of religion. Much of the development in the philosophy of religion, from William James to Paul Tillich, has been conducted in a purely Western context. The discussion, whether it be the soteriological nature of religion, the grounds for belief in God, the problem of evil or the question of verifiability, takes on quite a different complexion in the context of Eastern religions.\n\nArvind Sharma seeks to place this debate with particular reference to the work of such writers as William James, F.R. Tennant, Paul Tillich, J.H. Randall, R.B. Braithwaite, D.Z. Phillips, R.M. Harre, Basil Mitchell, John Hick, W.A. Christian, and W.C. Smith, in the Buddhist context.\n\nAt the same time he clarifies some of the possible misapprehensions which result from a commonality of religious language shared between Buddhism and Hinduism as regards the nature of religious revelation, immortality, karma and reincarnation."},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2024-07-11T08:30:32.142116"}}},"ISBN:9780195642728":{"bib_key":"ISBN:9780195642728","info_url":"http://openlibrary.org/books/OL7394426M/The_Philosophy_of_Religion","preview":"borrow","preview_url":"https://archive.org/details/philosophyofreli0000shar","thumbnail_url":"https://covers.openlibrary.org/b/id/128159-S.jpg","details":{"publishers":["Oxford University Press, USA"],"number_of_pages":224,"subtitle":"A Buddhist Perspective (Oxford India Paperbacks)","covers":[128159],"lc_classifications":["","BQ282 .S5 1997"],"key":"/books/OL7394426M","authors":[{"key":"/authors/OL112695A","name":"Arvind Sharma"}],"languages":[{"key":"/languages/eng"}],"source_records":["bwb:9780195642728","ia:philosophyofreli0000shar","promise:bwb_daily_pallets_2022-05-25"],"title":"The Philosophy of Religion","identifiers":{"librarything":["847670"]},"isbn_13":["9780195642728"],"isbn_10":["0195642724"],"publish_date":"November 13, 1997","works":[{"key":"/works/OL1084026W"}],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"The Judaic-Christian concept of God is monotheistic."},"ocaid":"philosophyofreli0000shar","oclc_numbers":["39383745"],"local_id":["urn:bwbsku:O8-BAI-948"],"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2022-12-05T05:51:39.780184"}}},"ISBN:9780190253110":{"bib_key":"ISBN:9780190253110","info_url":"http://openlibrary.org/books/OL28571185M/Perceiving_Reality","preview":"novie