type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-08-11T08:29:33.445449"}}},"ISBN:9780755643417":{"bib_key":"ISBN:9780755643417","info_url":"http://openlibrary.org/books/OL42777064M/Sufi_Warrior_Saints","preview":"noview","preview_url":"http://openlibrary.org/books/OL42777064M/Sufi_Warrior_Saints","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL9827664A","name":"Harry S. Neale"}],"isbn_13":["9780755643417"],"languages":[{"key":"/languages/eng"}],"pagination":"200","publish_date":"2023","publishers":["I. B. Tauris & Company, Limited"],"source_records":["bwb:9780755643417","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:39365193:3556"],"title":"Sufi Warrior Saints","weight":"0.455","subtitle":"Stories of Sufi Jihad from Muslim Hagiography","full_title":"Sufi Warrior Saints Stories of Sufi Jihad from Muslim Hagiography","works":[{"key":"/works/OL26003592W"}],"key":"/books/OL42777064M","lc_classifications":["BP189.4 .N47 2022eb"],"oclc_numbers":["1295018185"],"description":{"type":"/type/text","value":"\"This book presents a thematic collection of hagiographical stories of Sufi saints, often referred to as friends of Gods. Despite the diverse wealth of Sufi works, much of the rich, global and centuries old literature of Sufi warrior-saints, has yet to be translated into English. Examining hagiographical depictions of Sufi mujahids , Neale corrects frequent misunderstandings of the term jihad in relation to Sufi thought and practice. Using Sufi hagiography, treatises, travel narratives and Muslim histories, each chapter comprises the lives of Sufi saints during significant historical events, from the Crusades to the Mongol Invasion and in regions ranging from Islamic Spain to North Africa and India. Using Persian and Arabic sources, this compendium of translated hagiographies gives us a sense of the range, themes and global dissemination of the Sufi literature on war and heroism\"--"},"number_of_pages":224,"identifiers":{"doi":["10.5040/9780755643400"]},"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2022-12-03T13:41:16.461991"},"last_modified":{"type":"/type/datetime","value":"2025-04-30T12:35:33.239606"}}},"ISBN:9780755643370":{"bib_key":"ISBN:9780755643370","info_url":"http://openlibrary.org/books/OL35097606M/Sufi_Warrior_Saints","preview":"noview","preview_url":"http://openlibrary.org/books/OL35097606M/Sufi_Warrior_Saints","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL9827664A","name":"Harry S. Neale"}],"isbn_13":["9780755643370"],"languages":[{"key":"/languages/eng"}],"publish_date":"2022","publishers":["I. B. Tauris & Company, Limited"],"source_records":["bwb:9780755643370"],"title":"Sufi Warrior Saints","pagination":"224","subtitle":"Translated Stories of Sufi Jihad from Muslim Hagiography","works":[{"key":"/works/OL26003592W"}],"key":"/books/OL35097606M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-10T10:36:16.143500"},"last_modified":{"type":"/type/datetime","value":"2021-10-10T10:36:16.143500"}}},"ISBN:9781350177895":{"bib_key":"ISBN:9781350177895","info_url":"http://openlibrary.org/books/OL37312617M/Anarchist_Artist_Sufi","preview":"noview","preview_url":"http://openlibrary.org/books/OL37312617M/Anarchist_Artist_Sufi","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2664276A","name":"Mark Sedgwick"}],"isbn_13":["9781350177895"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["ND793"],"pagination":"320","publish_date":"2021","publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781350177895"],"subjects":["Painting"],"title":"Anarchist, Artist, Sufi","weight":"0.622","subtitle":"The Politics, Painting, and Esotericism of Ivan Aguéli","full_title":"Anarchist, Artist, Sufi The Politics, Painting, and Esotericism of Ivan Aguéli","works":[{"key":"/works/OL26725050W"}],"key":"/books/OL37312617M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-02-28T05:08:56.440818"},"last_modified":{"type":"/type/datetime","value":"2022-02-28T05:08:56.440818"}}},"ISBN:9781350229563":{"bib_key":"ISBN:9781350229563","info_url":"http://openlibrary.org/books/OL36181671M/Anarchist_Artist_Sufi","preview":"noview","preview_url":"http://openlibrary.org/books/OL36181671M/Anarchist_Artist_Sufi","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2664276A","name":"Mark Sedgwick"},{"key":"/authors/OL7311828A","name":"Frank Peter"},{"key":"/authors/OL537350A","name":"Kambiz GhaneaBassiri"}],"isbn_13":["9781350229563"],"languages":[{"key":"/languages/eng"}],"pagination":"320","publish_date":"2022","publishers":["Bloomsbury Academic & Professional"],"source_records":["bwb:9781350229563","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:47739499:5150"],"title":"Anarchist, Artist, Sufi","subtitle":"The Politics, Painting, and Esotericism of Ivan Aguéli","works":[{"key":"/works/OL26725050W"}],"key":"/books/OL36181671M","lc_classifications":["ND793.A45 A53 2021eb"],"oclc_numbers":["1237400198"],"description":{"type":"/type/text","value":"\"This book follows the life of Ivan Aguľi, the artist, anarchist, and esotericist, notable as one of the earliest Western intellectuals to convert to Islam and to explore Sufism. This book explores different aspects of his life and activities, revealing each facet of Aguľi's complex personality in its own right. It then shows how esotericism, art, and anarchism finally found their fulfillment in Sufi Islam. The authors analyze how Aguľi's life and conversion show that Islam occupied a more central place in modern European intellectual history than is generally realized. His life reflects several major modern intellectual, political, and cultural trends. This book is an important contribution to understanding how he came to Islam, the values and influences that informed his life, and-ultimately-the role he played in the mod