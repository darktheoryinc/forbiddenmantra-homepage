uages/eng"}],"full_title":"Daoism in Japan Chinese Traditions and Their Influence on Japanese Religious Culture","lc_classifications":["BL1913.D36 2018"],"publish_date":"2018","key":"/books/OL28899033M","authors":[{"key":"/authors/OL3376207A","name":"Jeffrey L. Richey"}],"latest_revision":1,"works":[{"key":"/works/OL21279910W"}],"type":{"key":"/type/edition"},"subjects":["Taoism","Japan, civilization"],"revision":1}},"ISBN:9781315767246":{"bib_key":"ISBN:9781315767246","info_url":"http://openlibrary.org/books/OL53972974M/Daoism_in_Japan","preview":"noview","preview_url":"http://openlibrary.org/books/OL53972974M/Daoism_in_Japan","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL3376207A","name":"Jeffrey L. Richey"}],"dewey_decimal_class":["299.5/140952"],"isbn_13":["9781315767246"],"languages":[{"key":"/languages/eng"}],"number_of_pages":268,"publish_date":"2015","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781315767246"],"subjects":["Taoism","Japan, civilization"],"title":"Daoism in Japan","subtitle":"Chinese Traditions and Their Influence on Japanese Religious Culture","full_title":"Daoism in Japan Chinese Traditions and Their Influence on Japanese Religious Culture","works":[{"key":"/works/OL21279910W"}],"key":"/books/OL53972974M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-09-17T20:47:09.291646"},"last_modified":{"type":"/type/datetime","value":"2024-09-17T20:47:09.291646"}}},"ISBN:9781138786493":{"bib_key":"ISBN:9781138786493","info_url":"http://openlibrary.org/books/OL28811003M/Daoism_in_Japan","preview":"noview","preview_url":"http://openlibrary.org/books/OL28811003M/Daoism_in_Japan","details":{"publishers":["Taylor & Francis Group"],"languages":[{"key":"/languages/eng"}],"subtitle":"Chinese Traditions and Their Influence on Japanese Religious Culture","source_records":["bwb:9781138786493","marc:marc_loc_2016/BooksAll.2016.part41.utf8:202033097:2658","marc:marc_columbia/Columbia-extract-20221130-031.mrc:171111689:4390","marc:harvard_bibliographic_metadata/20220215_032.bib.mrc:175781623:3951"],"title":"Daoism in Japan","lccn":["2014040959"],"number_of_pages":282,"isbn_13":["9781138786493"],"lc_classifications":["BL1913.D36 2015","BL1913 .D36 2015","BL1913"],"publish_date":"2015","key":"/books/OL28811003M","authors":[{"key":"/authors/OL3376207A","name":"Jeffrey L. Richey"}],"works":[{"key":"/works/OL21279910W"}],"type":{"key":"/type/edition"},"subjects":["Taoism","Japan, civilization"],"oclc_numbers":["908389503","893895727"],"description":{"type":"/type/text","value":"\"Daoist traditions introduced from China once flowed powerfully through the Japanese religious landscape, forever altering its topography and ecology. Daoism's presence in Japan still may be discerned in its abiding influence on astrology, divination, festivals, literature, politics, and popular culture, not to mention Buddhism and Shintō, yet few English-language studies of Daoism's influence on Japanese religious culture have been published. Daoism in Japan provides an exploration of the particular pathways by which Daoist traditions entered Japan from continental East Asia. After addressing the basic issues in both Daoism Studies and the study of Japanese religions, including the problems of defining 'Daoism' and 'Japanese', the book looks at the influence of Daoism on ancient, medieval and modern Japan in turn. To do so, the volume is arranged both chronologically and topically, according to the following three broad divisions: \"Arrivals\" (c. 5th-8th centuries CE), \"Assimilations\" (794-1868), and \"Apparitions\" ( 1600s-present). The book demonstrates how Chinese influence on Japanese religious culture ironically proved to be crucial in establishing traditions that usually are seen as authentically, even quintessentially, Japanese. Touching on multiple facets of Japanese cultural history and religious traditions, this book is a fascinating contribution for students and scholars of Japanese Culture, History and Religions, as well as Daoism Studies\"--"},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-08-16T09:39:13.982138"},"last_modified":{"type":"/type/datetime","value":"2026-02-18T11:11:08.654590"}}},"ISBN:9781317540106":{"bib_key":"ISBN:9781317540106","info_url":"http://openlibrary.org/books/OL54020423M/Education_Between_Speech_and_Writing","preview":"noview","preview_url":"http://openlibrary.org/books/OL54020423M/Education_Between_Speech_and_Writing","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL6776606A","name":"Ruyu Hung"}],"isbn_13":["9781317540106"],"languages":[{"key":"/languages/eng"}],"number_of_pages":164,"publish_date":"2017","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781317540106"],"title":"Education Between Speech and Writing","subtitle":"Crossing the Boundaries of Dao and Deconstruction","full_title":"Education Between Speech and Writing Crossing the Boundaries of Dao and Deconstruction","works":[{"key":"/works/OL21288461W"}],"key":"/books/OL54020423M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-09-18T03:32:14.390176"},"last_modified":{"type":"/type/datetime","value":"2024-09-18T03:32:14.390176"}}},"ISBN:9781315727509":{"bib_key":"ISBN:9781315727509","info_url":"http://openlibrary.org/books/OL53987159M/Education_Between_Speech_and_Writing","preview":"noview","preview_url":"http://openlibrary.org/books/OL53987159M/Education_Between_Speech_and_Writing","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL6776606A","name":"Ruyu Hung"}],"isbn_13":["9781315727509"],"languages":[{"key":"/languages/eng"}],"number_of_pages":164,"publish_date":"2017","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781315727509"],"subjects":["Education, china","Chinese language","Communication in education"],"title":"Education Between Speech and Writing","subtitle":"Crossing the Boundaries of