pe":"/type/datetime","value":"2021-10-05T22:23:15.948156"}}},"ISBN:9783110542349":{"bib_key":"ISBN:9783110542349","info_url":"http://openlibrary.org/books/OL34554020M/Gospels_and_Gospel_Traditions_in_the_Second_Century","preview":"noview","preview_url":"http://openlibrary.org/books/OL34554020M/Gospels_and_Gospel_Traditions_in_the_Second_Century","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL4143991A","name":"Jens Schröter"},{"key":"/authors/OL3166247A","name":"Tobias Nicklas"},{"key":"/authors/OL7808455A","name":"Joseph Verheyden"},{"key":"/authors/OL9717401A","name":"Katharina Simunovic"}],"isbn_13":["9783110542349"],"languages":[{"key":"/languages/eng"}],"number_of_pages":382,"publish_date":"2018","publishers":["de Gruyter GmbH, Walter"],"source_records":["bwb:9783110542349"],"subjects":["Bible, commentaries, n. t. gospels"],"title":"Gospels and Gospel Traditions in the Second Century","subtitle":"Experiments in Reception","full_title":"Gospels and Gospel Traditions in the Second Century Experiments in Reception","works":[{"key":"/works/OL25711934W"}],"key":"/books/OL34554020M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-05T22:23:10.275666"},"last_modified":{"type":"/type/datetime","value":"2021-10-05T22:23:10.275666"}}},"ISBN:9783110540819":{"bib_key":"ISBN:9783110540819","info_url":"http://openlibrary.org/books/OL34554002M/Gospels_and_Gospel_Traditions_in_the_Second_Century","preview":"noview","preview_url":"http://openlibrary.org/books/OL34554002M/Gospels_and_Gospel_Traditions_in_the_Second_Century","thumbnail_url":"https://covers.openlibrary.org/b/id/14668156-S.jpg","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL4143991A","name":"Jens Schröter"},{"key":"/authors/OL3166247A","name":"Tobias Nicklas"},{"key":"/authors/OL7808455A","name":"Joseph Verheyden"},{"key":"/authors/OL9717401A","name":"Katharina Simunovic"}],"isbn_13":["9783110540819"],"languages":[{"key":"/languages/eng"},{"key":"/languages/ger"}],"lc_classifications":["BS2555.52.L48 2019","BS410 .Z7 Heft 235","BS2555.52 .L48 2019"],"number_of_pages":382,"publish_date":"2018","publishers":["De Gruyter, Inc."],"source_records":["bwb:9783110540819","marc:marc_columbia/Columbia-extract-20221130-028.mrc:136040069:5474","marc:harvard_bibliographic_metadata/20220215_031.bib.mrc:202446069:7080"],"subjects":["Bible, commentaries, n. t. gospels"],"title":"Gospels and Gospel Traditions in the Second Century","weight":"0.677","subtitle":"Experiments in Reception","works":[{"key":"/works/OL25711934W"}],"key":"/books/OL34554002M","lccn":["2018954517"],"oclc_numbers":["1019604896"],"identifiers":{"dnb":["1154614506"]},"covers":[14668156],"description":{"type":"/type/text","value":"\"The second century CE has often been described as a kind of dark period with regard to our knowledge of how the earliest Christian writings (the gospels and Paul's letters) were transmitted and gradually came to be accepted as authoritative and then, later on, as \"canonical\". At the same time a number of other Christian texts, of various genres, saw the light. Some of these seem to be familiar with the gospels, or perhaps rather with gospel traditions identical or similar to those that found their way into the NT gospels. The volume focuses on representative texts and authors of the time in order to see how they have struggled to find a way to work with the NT gospels and/or the traditions behind these, while at the same time giving a place also to other extra-canonical traditions. It studies in a comparative way the reception of identifiably \"canonical\" and of extra-canonical traditions in the second century. It aims at discovering patterns or strategies of reception within the at first sight often rather chaotic way some of these ancient authors have cited or used these traditions. And it will look for explanations of why it took such a while before authors got used to cite gospel texts (more or less) accurately.\"--"},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2021-10-05T22:22:57.934963"},"last_modified":{"type":"/type/datetime","value":"2026-02-19T16:31:02.629460"}}},"ISBN:9783110736618":{"bib_key":"ISBN:9783110736618","info_url":"http://openlibrary.org/books/OL35856054M/Gospels_and_Gospel_Traditions_in_the_Second_Century","preview":"noview","preview_url":"http://openlibrary.org/books/OL35856054M/Gospels_and_Gospel_Traditions_in_the_Second_Century","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL4143991A","name":"Jens Schröter"}],"isbn_13":["9783110736618"],"languages":[{"key":"/languages/eng"}],"pagination":"382","publish_date":"2020","publishers":["de Gruyter GmbH, Walter"],"source_records":["bwb:9783110736618"],"subjects":["Bible, commentaries, n. t.","Bible, criticism, interpretation, etc., n. t.","Bible, hermeneutics","Bible, study and teaching, n. t."],"title":"Gospels and Gospel Traditions in the Second Century","weight":"0.721","subtitle":"Experiments in Reception","full_title":"Gospels and Gospel Traditions in the Second Century Experiments in Reception","works":[{"key":"/works/OL25711934W"}],"key":"/books/OL35856054M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-12-26T06:48:37.095913"},"last_modified":{"type":"/type/datetime","value":"2021-12-26T06:48:37.095913"}}},"ISBN:9780974275505":{"bib_key":"ISBN:9780974275505","info_url":"http://openlibrary.org/books/OL8581787M/The_Perfect_Matrimony","preview":"borrow","preview_url":"https://archive.org/details/perfectmatrimony0000weor","thumbnail_url":"https://covers.openlibrary.org/b/id/739773-S.jpg","details":{"publishers":["Thelema Pr"],"identifiers":{"librarything":["1771315"]},"subtitle":"Tantra - the Door to Enter into Initiation","weight":"14.4 ounces","covers":[739773],"physical_format":"Paperback","key":"/books/OL8581787M","authors":[{"key":"/authors/OL669580A","name":"Samael Aun Weor."}],"subjects":["Religion"