B797E1"]},"isbn_13":["9780061541278","9780061750656","9780061541285"],"covers":[6417535],"physical_format":"Electronic resource","publish_date":"2007","publish_country":"nyu","key":"/books/OL24268459M","authors":[{"key":"/authors/OL2629619A","name":"Warren Kozak"}],"publish_places":["New York"],"works":[{"key":"/works/OL274238W"}],"type":{"key":"/type/edition"},"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2010-06-17T23:32:09.139570"},"last_modified":{"type":"/type/datetime","value":"2022-03-01T01:04:32.576864"}}},"ISBN:9780060511012":{"bib_key":"ISBN:9780060511012","info_url":"http://openlibrary.org/books/OL7277435M/The_Rabbi_of_84th_Street","preview":"borrow","preview_url":"https://archive.org/details/rabbiof84thstree0000koza","thumbnail_url":"https://covers.openlibrary.org/b/id/26354-S.jpg","details":{"publishers":["HarperCollins"],"identifiers":{"librarything":["7832751"],"goodreads":["1631996"]},"subtitle":"The Extraordinary Life of Haskel Besser","covers":[26354],"key":"/books/OL7277435M","authors":[{"key":"/authors/OL2629619A","name":"Warren Kozak"}],"ocaid":"rabbiof84thstree0000koza","languages":[{"key":"/languages/eng"}],"source_records":["amazon:006051101X:o-2:3798462456:227864","amazon:006051101X:3:3463758762:229346","ia:rabbiof84thstree0000koza","marc:marc_loc_2016/BooksAll.2016.part30.utf8:196434870:1006","bwb:9780060511012","amazon:006051101X","promise:bwb_daily_pallets_2022-09-12","marc:marc_columbia/Columbia-extract-20221130-010.mrc:353479690:2949","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:375840776:960"],"title":"The Rabbi of 84th Street","number_of_pages":224,"isbn_13":["9780060511012"],"isbn_10":["006051101X"],"publish_date":"July 6, 2004","works":[{"key":"/works/OL274238W"}],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"What Haskel Besser does best-and he does a lot of things very well-is demolish any preconceptions people may have of religious Jews."},"lccn":["2003056976"],"lc_classifications":["BM755.B553 K69 2004","BM755.B553K69 2004"],"local_id":["urn:bwbsku:O8-CNX-235"],"oclc_numbers":["53285046"],"description":{"type":"/type/text","value":"\"A Hasidic rabbi on Manhattan's Upper West Side, Rabbi Haskel Besser is a powerful and unique presence: a deeply religious man who is at home in the secular world. With an easy smile, Rabbi Besser spreads joy wherever he goes, enriching the lives of his many friends and congregants with his profound understanding of both Orthodox Judaism and human nature. Journalist Warren Kozak befriended Rabbi Besser in 1988 and writes with warmth and admiration about the rabbi's extraordinary life.\" \"Growing up in a Poland rich with Hasidic culture and the music, art, and literature of a vibrant Europe, Haskel Besser and his family lived a charmed life. With the first hints of the growing wave of anti-Semitism that would destroy their world, the rabbi and his family miraculously escaped to Palestine. This narrative takes the reader through some of the most significant historical moments of the past eighty years as they were experienced by the rabbi and by his friends and family.\" \"The Rabbi of 84th Street is also the story of Judaism in the twentieth century; of the importance of centuries-old traditions to the twenty-first century; and of the triumph of faith, kindness, and spirit. Readers will be inspired and uplifted by the rabbi's life and wisdom, which have made him such an important spiritual leader. This biography opens a window into the normally closed world of Hasidic Jews and introduces readers to an exceptional individual whose teachings and guidance have touched so many the world over.\"--BOOK JACKET."},"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2024-10-05T16:17:11.538557"}}},"ISBN:9780061541308":{"bib_key":"ISBN:9780061541308","info_url":"http://openlibrary.org/books/OL37373345M/Rabbi_of_84th_Street","preview":"noview","preview_url":"http://openlibrary.org/books/OL37373345M/Rabbi_of_84th_Street","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2629619A","name":"Warren Kozak"}],"isbn_13":["9780061541308"],"languages":[{"key":"/languages/eng"}],"pagination":"224","publish_date":"2007","publishers":["HarperCollins Publishers"],"source_records":["bwb:9780061541308"],"title":"Rabbi of 84th Street","full_title":"Rabbi of 84th Street","works":[{"key":"/works/OL274238W"}],"key":"/books/OL37373345M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-03-01T02:00:16.479131"},"last_modified":{"type":"/type/datetime","value":"2022-03-01T02:00:16.479131"}}}}