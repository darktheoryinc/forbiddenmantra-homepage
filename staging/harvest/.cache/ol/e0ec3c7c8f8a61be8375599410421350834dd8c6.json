ocal_id":["urn:bwbsku:W7-BVA-479"],"ocaid":"gravitygrace0000weil_m9b9","isbn_10":["0803298005"],"lccn":["97027794"],"oclc_numbers":["37331593"],"dewey_decimal_class":["194"],"lc_classifications":["B2430.W473 P43 1997","B2430.W473P43 1997"],"description":{"type":"/type/text","value":"Simone Weil, the French philosopher, political activist, and religious mystic, was little known when she died young in 1943. Four years later the philosopher-farmer Gustave Thibon compiled La pesanteur et la grâce from the notebooks she left in his keeping. In 1952 this English translation accelerated the fame and influence of Simone Weil.\r\n\r\nThe striking aphorisms in *Gravity and Grace* reflect the religious philosophy of Weil’s last years. Written at the onset of World War II, when her health was deteriorating and her left-wing social activism was giving way to spiritual introspection, this masterwork makes clear why critics have called Simone Weil “a great soul who might have become a saint” and “the Outsider as saint, in an age of alienation.”"},"latest_revision":20,"revision":20,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-06-29T23:44:09.675970"}}},"ISBN:9788481640274":{"bib_key":"ISBN:9788481640274","info_url":"http://openlibrary.org/books/OL13318380M/La_Gravedad_y_La_Gracia","preview":"noview","preview_url":"http://openlibrary.org/books/OL13318380M/La_Gravedad_y_La_Gracia","details":{"title":"La Gravedad y La Gracia","authors":[{"key":"/authors/OL43117A","name":"Simone Weil"}],"publish_date":"November 1996","publishers":["Trotta"],"languages":[{"key":"/languages/spa"}],"isbn_13":["9788481640274"],"physical_format":"Paperback","isbn_10":["8481640271"],"type":{"key":"/type/edition"},"subjects":["History","Religion - Commentaries / Reference"],"source_records":["amazon:8481640271"],"key":"/books/OL13318380M","works":[{"key":"/works/OL587614W"}],"latest_revision":4,"revision":4,"created":{"type":"/t