ary.org/books/OL28556072M/Madhyamaka_and_Yogacara","preview":"noview","preview_url":"http://openlibrary.org/books/OL28556072M/Madhyamaka_and_Yogacara","details":{"publishers":["Oxford University Press, Incorporated"],"subtitle":"Allies or Rivals?","last_modified":{"type":"/type/datetime","value":"2020-08-04T12:27:25.385951"},"source_records":["bwb:9780190231293"],"title":"Madhyamaka and Yogacara","number_of_pages":316,"isbn_13":["9780190231293"],"created":{"type":"/type/datetime","value":"2020-08-04T12:27:25.385951"},"languages":[{"key":"/languages/eng"}],"full_title":"Madhyamaka and Yogacara Allies or Rivals?","lc_classifications":["B162.M33 2015"],"publish_date":"2015","key":"/books/OL28556072M","authors":[{"key":"/authors/OL7460589A","name":"Jay L. Garfield"},{"key":"/authors/OL1428506A","name":"Jan Westerhoff"}],"latest_revision":1,"works":[{"key":"/works/OL21095974W"}],"type":{"key":"/type/edition"},"subjects":["Buddhist philosophy","Buddhism"],"revision":1}},"ISBN:9780190231286":{"bib_key":"ISBN:9780190231286","info_url":"http://openlibrary.org/books/OL28556081M/Madhyamaka_and_Yogacara","preview":"noview","preview_url":"http://openlibrary.org/books/OL28556081M/Madhyamaka_and_Yogacara","thumbnail_url":"https://covers.openlibrary.org/b/id/15254812-S.jpg","details":{"publishers":["Oxford University Press, Incorporated"],"subtitle":"Allies or Rivals?","full_title":"Madhyamaka and Yogacara Allies or Rivals?","lc_classifications":["B162.M33 2015","B162 .M33 2015","BQ7141 .M33 2015","BQ7141 .M33 2015"],"key":"/books/OL28556081M","authors":[{"key":"/authors/OL7460589A","name":"Jay L. Garfield"},{"key":"/authors/OL1428506A","name":"Jan Westerhoff"}],"languages":[{"key":"/languages/eng"}],"source_records":["bwb:9780190231286","marc:marc_loc_2016/BooksAll.2016.part41.utf8:182526186:3384","marc:harvard_bibliographic_metadata/20220215_012.bib.mrc:288284392:5513"],"title":"Madhyamaka and Yogacara","lccn":["2014028326"],"number_of_pages":316,"isbn_13":["9780190231286"],"subjects":["Buddhist philosophy","Buddhism"],"publish_date":"2015","works":[{"key":"/works/OL21095974W"}],"type":{"key":"/type/edition"},"oclc_numbers":["891121591"],"description":{"type":"/type/text","value":"\"Madhyamaka and Yogacara are the two principal schools of Mahayana Buddhist philosophy. While Madhyamaka asserts the ultimate emptiness and conventional reality of all phenomena, Yogacara is usually considered to be idealistic. This collection of essays addresses the degree to which these philosophical approaches are consistent or complementary. Indian and Tibetan doxographies often take these two schools to be philosophical rivals. They are grounded in distinct bodies of sutra literature and adopt what appear to be very different positions regarding the analysis of emptiness and the status of mind. Madhyamaka-Yogacara polemics abound in Indian Buddhist literature, and Tibetan doxographies regard them as distinct systems. Nonetheless, scholars have tried to synthesize the two positions for centuries. This volume offers new essays by prominent experts on both these traditions, who address the question of the degree to which these philosophical approaches should be seen as rivals or as allies. In answering the question of whether Madhyamaka and Yogacara can be considered compatible, contributors engage with a broad range of canonical literature, and relate the texts to contemporary philosophical problems\"--"},"covers":[15254812],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-08-04T12:27:34.117758"},"last_modified":{"type":"/type/datetime","value":"2026-09-15T10:04:22.260744"}}},"ISBN:9780819101891":{"bib_key":"ISBN:9780819101891","info_url":"http://openlibrary.org/books/OL11391283M/Early_Buddhist_Philosophy","preview":"noview","preview_url":"http://openlibrary.org/books/OL11391283M/Early_Buddhist_Philosophy","details":{"publishers":["Rowman & Littlefield (Non NBN)"],"physical_format":"Paperback","source_records":["marc:marc_orego