022"],"subjects":["Pilgrims and pilgrimages","Saivism","Indians, religion"],"title":"Hindu Pilgrimage","subtitle":"Shifting Patterns of Worldview of Srisailam in South India","full_title":"Hindu Pilgrimage Shifting Patterns of Worldview of Srisailam in South India","works":[{"key":"/works/OL20343643W"}],"key":"/books/OL39997891M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-10-18T19:02:27.626546"},"last_modified":{"type":"/type/datetime","value":"2022-10-18T19:02:27.626546"}}},"ISBN:9780415659970":{"bib_key":"ISBN:9780415659970","info_url":"http://openlibrary.org/books/OL27553162M/Hindu_Pilgrimage","preview":"noview","preview_url":"http://openlibrary.org/books/OL27553162M/Hindu_Pilgrimage","thumbnail_url":"https://covers.openlibrary.org/b/id/9008603-S.jpg","details":{"publishers":["Routledge"],"identifiers":{"amazon":["0415659973"]},"subtitle":"Shifting Patterns of Worldview of Srisailam in South India","covers":[9008603],"physical_format":"hardcover","full_title":"Hindu Pilgrimage : Shifting Patterns of Worldview of Srisailam in South India","lc_classifications":["BL1239.36","BL1239.36.S72 R43 2014","BL1239.36.S72 .R433 2014eb"],"key":"/books/OL27553162M","authors":[{"key":"/authors/OL7711804A","name":"Prabhavati C. Reddy"}],"source_records":["amazon:0415659973","bwb:9780415659970","marc:marc_loc_2016/BooksAll.2016.part40.utf8:244192041:2262","marc:harvard_bibliographic_metadata/ab.bib.14.20150123.full.mrc:22235889:2534","marc:marc_columbia/Columbia-extract-20221130-031.mrc:146511097:2128","marc:marc_columbia/Columbia-extract-20221130-022.mrc:151667337:2553","marc:harvard_bibliographic_metadata/20220215_021.bib.mrc:167901234:3656"],"title":"Hindu Pilgrimage","lccn":["2013033981"],"notes":{"type":"/type/text","value":"Source title: Hindu Pilgrimage: Shifting Patterns of Worldview of Srisailam in South India (Routledge Hindu Studies Series)"},"number_of_pages":238,"isbn_13":["9780415659970"],"isbn_10":["0415659973"],"publish_date":"Mar 27, 2014","works":[{"key":"/works/OL20343643W"}],"type":{"key":"/type/edition"},"oclc_numbers":["853494290","878144924"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"\"In recent years, changes in religious studies in general and the study of Hinduism in particular have drawn more scholarly attention to other forms of the Hindu faith that are concretely embodied in temples, icons, artworks, rituals, and pilgrimage practices. This book analyses phenomenon of pilgrimage as a religious practice and experience. It focuses on Srisailam, a renowned south Indian pilgrimage site of Shiva and Goddess Durga and investigates two dimensions: the worldview of a place that is of utmost sanctity for Hindu pilgrims and its historical evolution from medieval to modern times. In doing so, it explores the shifting patterns of the worldviews of Srisailam and its modes of management, representing the ideologically-centered religious values and civic-oriented utilitarian practices. Bringing together the phenomenological and historical study of Srisailam for a comprehensive understanding of both the religious dimension and the historical development of the social organization of the pilgrimage place, this book will be of interest to students of Hinduism, Pilgrimage and South Asian Studies\"--"},"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2019-10-25T14:36:39.380325"},"last_modified":{"type":"/type/datetime","value":"2025-11-09T17:37:13.046556"}}},"ISBN:9781317806301":{"bib_key":"ISBN:9781317806301","info_url":"http://openlibrary.org/books/OL33627330M/Hindu_Pilgrimage","preview":"noview","preview_url":"http://openlibrary.org/books/OL33627330M/Hindu_Pilgrimage","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7711804A","name":"Prabhavati C. Reddy"}],"isbn_13":["9781317806301"],"languages":[{"key":"/languages/eng"}],"number_of_pages":222,"publish_date":"2014","publishers":["Taylor & Francis Grou