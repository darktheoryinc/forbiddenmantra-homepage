w_url":"http://openlibrary.org/books/OL29204027M/Gaon_of_Vilna","details":{"publishers":["University of California Press"],"subtitle":"The Man and His Image","last_modified":{"type":"/type/datetime","value":"2020-08-23T05:38:24.920221"},"source_records":["bwb:9781282356535"],"title":"Gaon of Vilna","number_of_pages":299,"isbn_13":["9781282356535"],"created":{"type":"/type/datetime","value":"2020-08-23T05:38:24.920221"},"languages":[{"key":"/languages/eng"}],"full_title":"Gaon of Vilna The Man and His Image","lc_classifications":[""],"publish_date":"2002","key":"/books/OL29204027M","authors":[{"key":"/authors/OL2753889A","name":"Immanuel Etkes"}],"latest_revision":1,"works":[{"key":"/works/OL8275634W"}],"type":{"key":"/type/edition"},"subjects":["Rabbis","Hasidism","Lithuania, biography"],"revision":1}},"ISBN:9780520223943":{"bib_key":"ISBN:9780520223943","info_url":"http://openlibrary.org/books/OL7710910M/The_Gaon_of_Vilna","preview":"noview","preview_url":"http://openlibrary.org/books/OL7710910M/The_Gaon_of_Vilna","thumbnail_url":"https://covers.openlibrary.org/b/id/326791-S.jpg","details":{"publishers":["University of California Press"],"number_of_pages":304,"subtitle":"The Man and His Image","weight":"1.2 pounds","isbn_10":["0520223942"],"covers":[326791],"physical_format":"Hardcover","lc_classifications":["2001008254","BM755.E6 E8513 2002"],"key":"/books/OL7710910M","authors":[{"key":"/authors/OL2753889A","name":"Immanuel Etkes"}],"languages":[{"key":"/languages/eng"}],"source_records":["amazon:0520223942:bs:2898044518:207557","marc:marc_ithaca_college/ic_marc.mrc:189831684:1606","bwb:9780520223943","marc:marc_loc_2016/BooksAll.2016.part28.utf8:194397579:1949","marc:marc_columbia/Columbia-extract-20221130-007.mrc:310979137:3247","idb:9780520223943","promise:bwb_daily_pallets_2024-06-21:P9-EAY-632","marc:harvard_bibliographic_metadata/20220215_008.bib.mrc:145523085:3109"],"title":"The Gaon of Vilna","identifiers":{"goodreads":["798014"],"librarything":["2196254"]},"isbn_13":["9780520223943"],"first_sentence":{"type":"/type/text","value":"Rabbi Eliyahu, the son of Shlomo Zalman, known as the Gaon of Vilna or by the acronym Ha-GRA, for \"ha-Gaon Rabbi Eliyahu\"-enjoyed exceptional authority during his lifetime."},"subjects":["Biography: general","European history: c 1500 to c 1750","European history: c 1750 to c 1900","Jewish studies","Judaism","Rabbis","Elijah ben Solomon,","Biography & Autobiography","Vilnius","Religion - Judaism","Lithuania","Biography/Autobiography","Europe","Hasidism","Judaism - General","Social Science / Jewish Studies","Biography","Educators","1720-1797","18th century","History"],"publish_date":"May 20, 2002","works":[{"key":"/works/OL8275634W"}],"type":{"key":"/type/edition"},"physical_dimensions":"9.1 x 6.3 x 0.8 inches","lccn":["2001008254"],"oclc_numbers":["48675610"],"description":{"type":"/type/text","value":"\"A legendary figure in his own lifetime, Rabbi Eliyahu ben Shlomo Zalman (1720-1797) was known as the \"Gaon of Vilna.\" He was the acknowledged master of Talmudic studies in the vibrant intellectual center of Vilna, revered throughout Eastern Europe for his learning and for his ability to traverse with ease seemingly opposed domains of thought and activity. After his death, the myth that had been woven around him became even more powerful and was expressed in various public images.\n\nThe formation of these images was influenced as much by the needs and wishes of those who clung to and depended on them as by the actual figure of the Gaon. In this study, Immanuel Etkes sheds light on aspects of the Vilna Gaon's \"real\" character and traces several public images of him as they have developed and spread from the early nineteenth century until the present.\".\n\n\"As a full-length study in English of a tremendously influential teacher, his times, and his legacy, The Gaon of Vilna will be welcomed by all students of Eastern European Jewish history; of Orthodoxy, Hasidism, and rabbinic scholarship; and of comparative religion.\"--BOOK JACKET."},"local_id":["urn:bwbsku:P9-EAY-632"],"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2008-04-29T15:03:11.581851"},"last_modified":{"type":"/type/datetime","value":"2025-07-06T18:48:32.777156"}}},"ISBN:9780520925076":{"bib_key":"ISBN:9780520925076","info_url":"http://openlibrary.org/books/OL29602466M/Gaon_of_Vilna","preview":"noview","preview_url":"http://openlibrary.org/books/OL29602466M/Gaon_of_Vilna","details":{"publishers":["University of California Press"],"subtitle":"The Man and His Image","last_modified":{"type":"/type/datetime","value":"2020-08-28T21:50:27.687050"},"source_records":["bwb:9780520925076"],"title":"Gaon of Vilna","number_of_pages":304,"isbn_13":["9780520925076"],"created":{"type":"/type/datetime","value":"2020-08-28T21:50:27.687050"},"languages":[{"key":"/languages/eng"}],"full_title":"Gaon of Vilna The Man and His Image","lc_classifications":[""],"publish_date":"2002","key":"/books/OL29602466M","authors":[{"key":"/authors/OL2753889A","name":"Immanuel Etkes"}],"latest_revision":1,"works":[{"key":"/works/OL8275634W"}],"type":{"key":"/type/edition"},"subjects":["Hasidism","Lithuania, biography","Rabbis"],"revision":1}},"ISBN:9780826606211":{"bib_key":"ISBN:9780826606211","info_url":"http://openlibrary.org/books/OL8170042M/Lubavitcher_Rabbi's_Memoirs","preview":"noview","preview_url":"http://openlibrary.org/books/OL8170042M/Lubavitcher_Rabbi's_Memoirs","thumbnail_url":"https://covers.openlibrary.org/b/id/631136-S.jpg","details":{"identifiers":{"goodreads":["1870180"],"librarything":["2374924"]},"title":"Lubavitcher Rabbi's Memoirs","subtitle":"Tracing the Origins of the Chasidic Movement, Vol. 1","authors":[{"key":"/authors/OL2883039A","name":"Yosef Y. Schneersohn"}],"publish_date":"March 8, 2004","publishers":["Kehot Publication Society"],"weight":"1.5 pounds","covers":[631136],"physical_format":"Hardcover","contributions":["Mindel Nissan (Translator)"],"subjects":[