3712","ia:fortressintroduc0000pinn","bwb:9780800634421","marc:marc_columbia/Columbia-extract-20221130-007.mrc:199620290:2245"],"title":"Fortress introduction to Black church history","dewey_decimal_class":["277.3/0089/96073"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 162-170) and index."},"number_of_pages":184,"languages":[{"key":"/languages/eng"}],"isbn_10":["080063442X"],"publish_date":"2002","publish_country":"xxu","by_statement":"Anne H. Pinn, Anthony B. Pinn.","works":[{"key":"/works/OL13520247W"}],"type":{"key":"/type/edition"},"lccn":["2001051067"],"oclc_numbers":["47990020"],"description":{"type":"/type/text","value":"\"This history, co-authored by a black minister and a black theologian, provides an overview of the shape and history of major black religious bodies: Methodist, Baptist, and Pentecostal. With photos, timelines, profiles, and additional readings, Pinn and Pinn ably explain the evolution of black Christianity into the groups we know today. A final chapter sketches the state of black Christian church bodies and their ongoing contributions to a more just American society.\n\nThe Pinns's book will help a new generation of black Americans assess the religious legacy of the black churches and the larger society to gauge their social import.\"--BOOK JACKET."},"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-11-06T07:12:46.187059"},"last_modified":{"type":"/type/datetime","value":"2023-11-14T17:41:03.421821"}}},"ISBN:9780567088857":{"bib_key":"ISBN:9780567088857","info_url":"http://openlibrary.org/books/OL19230437M/Primitive_Christianity","preview":"noview","preview_url":"http://openlibrary.org/books/OL19230437M/Primitive_Christianity","thumbnail_url":"https://covers.openlibrary.org/b/id/5456595-S.jpg","details":{"publishers":["T & T Clark"],"identifiers":{"goodreads":["2602922"],"librarything":["4700807"]},"subtitle":"a survey of recent studies and some new proposals","isbn_10":["0