","name":"Michael Booth"}],"ocaid":"eatprayeatoneman0000boot","publish_places":["London"],"isbn_13":["9780224089630"],"pagination":"296 pages","source_records":["ia:eatprayeatoneman0000boot","amazon:0224089633","bwb:9780224089630","marc:marc_columbia/Columbia-extract-20221130-019.mrc:32069432:960","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:837030204:869","marc:harvard_bibliographic_metadata/20220215_025.bib.mrc:267484952:1966"],"title":"Eat, pray, eat","dewey_decimal_class":["915.404532"],"number_of_pages":296,"languages":[{"key":"/languages/eng"}],"subject_places":["India"],"subjects":["Food habits","Travel","Indic Cooking","Description and travel"],"subject_people":["Michael Booth"],"publish_country":"enk","publish_date":"2011","by_statement":"Michael Booth","oclc_numbers":["747915757"],"works":[{"key":"/works/OL20886395W"}],"type":{"key":"/type/edition"},"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2020-06-26T04:45:45.537651"},"last_modified":{"type":"/type/datetime","value":"2025-12-27T15:40:33.401190"}}},"ISBN:9781446499412":{"bib_key":"ISBN:9781446499412","info_url":"http://openlibrary.org/books/OL33408104M/Eat_Pray_Eat","preview":"noview","preview_url":"http://openlibrary.org/books/OL33408104M/Eat_Pray_Eat","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7598387A","name":"Michael Booth"}],"isbn_13":["9781446499412"],"languages":[{"key":"/languages/eng"}],"number_of_pages":304,"publish_date":"2011","publishers":["Penguin Random House"],"source_records":["bwb:9781446499412"],"title":"Eat Pray Eat","full_title":"Eat Pray Eat","works":[{"key":"/works/OL20886395W"}],"key":"/books/OL33408104M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-09-17T04:31:06.462161"},"last_modified":{"type":"/type/datetime","value":"2021-09-17T04:31:06.462161"}}},"ISBN:9781444812978":{"bib_key":"ISBN:9781444812978","info_url":"http://openlibrary.org/books/OL39217203M/Eat_pray_eat","preview":"borrow","preview_url":"https://archive.org/details/eatprayeatoneman0000boot_p5u7","thumbnail_url":"https://covers.openlibrary.org/b/id/12854543-S.jpg","details":{"type":{"key":"/type/edition"},"publish_date":"2012","publish_country":"enk","languages":[{"key":"/languages/eng"}],"authors":[{"key":"/authors/OL7598387A","name":"Michael Booth"}],"oclc_numbers":["795854384"],"lc_classifications":["PT8119 .B636 2005"],"dewey_decimal_class":["915.404532"],"notes":{"type":"/type/text","value":"Originally published: London: Jonathan Cape, 2011."},"description":{"type":"/type/text","value":"\"Terminally disappointed, and regularly the worse for wine, Michael Booth needed to change his lifestyle. Instead, he travels with his wife and two young children to the Indian subcontinent to write the definitive book on Indian food. From Delhi to Amritsar and the Taj Mahal, they meet the locals, sampling their different cuisines along the way. In Rajasthan they dine like maharajas before heading for Mumbai and the slums of Dharavi. But Booth's plan is derailed when his metaphysical, middle-aged malaise spirals deeper. Fortunately, [his] wife enrols him in a yoga boot camp, and he is helped by a meditation guru to find equanimity and equilibrium. But can he ever regain his balance, overcome his addictions and face up to life as a husband and father?\"--Back cover."},"subjects":["Travel","Spiritual biography","Prānāyāma","Food habits","Indic Cooking","Large type books","Description and travel","Biographies spirituelles","Pranayama","Habitudes alimentaires","Cuisine de l'Inde","Livres en gros caractères","Descriptions et voyages","Large print books"],"subject_places":["India","Inde"],"subject_people":["Michael Booth"],"title":"Eat, pray, eat","subtitle":"one man's accidental search for equanimity, equilibrium and enlightenment","by_statement":"Michael Booth","publishers":["Charnwood"],"publish_places":["Leicester"],"isbn_13":["9781444812978"],"isbn_10":["1444812971"],"pagi