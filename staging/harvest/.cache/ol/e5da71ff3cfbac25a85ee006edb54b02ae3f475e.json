tates"],"pagination":"vi, 315 p. ;","covers":[839645],"lc_classifications":["BM755.L485 A3 2001","BM755.L485A3 2001"],"latest_revision":10,"key":"/books/OL6791269M","authors":[{"key":"/authors/OL2463319A","name":"Alan Lew"}],"ocaid":"onegodclapping00alan","publish_places":["Woodstock, Vt"],"contributions":["Jaffe, Sherril, 1945-"],"genres":["Biography."],"source_records":["ia:onegodclapping00alan","marc:marc_loc_2016/BooksAll.2016.part01.utf8:36969125:868","bwb:9781580231152"],"title":"One God clapping","dewey_decimal_class":["296/.092","B"],"notes":{"type":"/type/text","value":"Originally published: New York : Kodansha International, 1999."},"number_of_pages":315,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"languages":[{"key":"/languages/eng"}],"lccn":["00054451"],"subjects":["Lew, Alan, 1943-","Rabbis -- United States -- Biography.","Judaism -- Relations -- Buddhism.","Buddhism -- Relations -- Judaism.","Zen Buddhism."],"publish_date":"2001","publish_country":"vtu","last_modified":{"type":"/type/datetime","value":"2020-10-12T02:15:37.881250"},"by_statement":"Alan Lew with Sherril Jaffe.","oclc_numbers":["45707633"],"works":[{"key":"/works/OL18174735W"}],"type":{"key":"/type/edition"},"revision":10}},"ISBN:9781568362878":{"bib_key":"ISBN:9781568362878","info_url":"http://openlibrary.org/books/OL8689215M/One_God_Clapping","preview":"borrow","preview_url":"https://archive.org/details/onegodclappingsp0000lewa","thumbnail_url":"https://covers.openlibrary.org/b/id/811315-S.jpg","details":{"publishers":["Kodansha America"],"number_of_pages":315,"subtitle":"The Spiritual Path of a Zen Rabbi","weight":"1.1 pounds","isbn_10":["1568362870"],"covers":[811315],"local_id":["urn:sfpl:31223052667970","urn:sfpl:31223052667988","urn:bwbsku:P7-EEL-280","urn:bwbsku:W6-ASN-999"],"physical_format":"Hardcover","lc_classifications":["BM755.L474 A3 1999","BM755.L485 A3 1999"],"key":"/books/OL8689215M","authors":[{"key":"/authors/OL2463319A","name":"Alan Lew"},{"key":"/authors/OL542561A","name":"Sherril Jaffe"}],"isbn_13":["9781568362878"],"source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:190128729:1826","marc:marc_loc_2016/BooksAll.2016.part27.utf8:237172983:841","ia:onegodclappingsp0000lewa","promise:bwb_daily_pallets_2022-03-17","promise:bwb_daily_pallets_2021-05-21","marc:marc_columbia/Columbia-extract-20221130-005.mrc:413645222:3216"],"title":"One God Clapping","lccn":["99029401"],"identifiers":{"goodreads":["6514501"],"librarything":["534524"]},"languages":[{"key":"/languages/eng"}],"subjects":["Relations","United States","Judaism - General","Buddhism","Judaism","Religion","Religion - World Religions","Rabbis","General","Buddhism - General","Biography"],"publish_date":"August 1999","oclc_numbers":["41185167"],"works":[{"key":"/works/OL18174735W"}],"type":{"key":"/type/edition"},"physical_dimensions":"8.5 x 5.7 x 1.2 inches","ocaid":"onegodclappingsp0000lewa","description":{"type":"/type/text","value":"\"Rabbi Alan Lew is known as the Zen Rabbi, a man who has been a leader in the Jewish meditation movement and who has worked to bring two ancient religious traditions into everyday life. One God Clapping is the story of his roundabout yet continuously provoking spiritual odyssey. It is also the story of the meeting between East and West in America and the ways in which that encounter has transformed how we understand our God and ourselves.\"--BOOK JACKET.\n\n\"Born in Brooklyn, where his grandfathers introduce him to the rituals of Jewish life, Lew is uprooted when his family moves to the suburbs. From there, his quest for spiritual solace begins, seeing him through the flowering of the sixties in California where, in the company of poets, hipsters, and beats, he settles on Zen Buddhism as a spiritual path. The enhanced self-awareness he chronicles leads to a completely unexpected revelation - the depth of his attachment to being a Jew.\n\nHis interest in Buddhism begins to wane, culminating in his decision to become a rabbi. Yet even upon settling in as rabbi of the largest conservative synagogue in San Francisco, he is not at the end of his search for a spiritual home. Forced to answer questions about his Buddhist past, he is obliged to examine more closely the nature of spiritual practice and determine exactly what Buddhism and Judaism have to offer each other.\"--BOOK JACKET.\n\n\"Like a Zen parable or a Jewish folk tale, One God Clapping unfolds as a series of stories, each containing a moment of revelation or instruction that, while often unexpected, is never simple of contrived. Like the life of Alan Lew himself, this book is a bold experiment in the integration of Eastern and Western ways of looking at and living in the world.\"--BOOK JACKET."},"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-30T08:14:56.482104"},"last_modified":{"type":"/type/datetime","value":"2026-07-22T16:58:09.419765"}}},"ISBN:9780671242305":{"bib_key":"ISBN:9780671242305","info_url":"http://openlibrary.org/books/OL23771546M/Three_ways_of_Asian_wisdom","preview":"noview","preview_url":"http://openlibrary.org/books/OL23771546M/Three_ways_of_Asian_wisdom","details":{"notes":{"type":"/type/text","value":"Bibliography: p. 199-207."},"title":"Three ways of Asian wisdom","subtitle":"Hinduism, Buddhism, Zen, and their significance for the West","authors":[{"key":"/authors/OL993285A","name":"Nancy Wilson Ross"}],"publish_date":"1966","publishers":["Simon and Schuster"],"isbn_10":["067124230X"],"publish_places":["New York"],"pagination":"222 p. :","source_records":["bwb:9780671242305"],"dewey_decimal_class":["181.04"],"languages":[{"key":"/languages/eng"}],"subjects":["Hinduism","Buddhism","Zen Buddhism"],"publish_country":"nyu","by_statement":"Nancy Wilson Ross.","type":{"key":"/type/edition"},"key":"/books/OL23771546M","number_of_pages":222,"works":[{"key":"/works/OL4753770W"}],"latest_revision":5,"revision":5,"created":{