2340502:6978"],"title":"Cults and New Religions","lccn":["2015005984","2015005385"],"number_of_pages":240,"isbn_13":["9781118722107"],"subjects":["Religions","Cults"],"publish_date":"2015","works":[{"key":"/works/OL4452543W"}],"type":{"key":"/type/edition"},"covers":[12466634],"ocaid":"cultsnewreligion0000cowa_n5k3","local_id":["urn:bwbsku:T1-BAK-982"],"oclc_numbers":["898922872"],"description":{"type":"/type/text","value":"\"This unparalleled introduction to cults and new religious movements has been completely up-dated and expanded to reflect the latest developments; each chapter reviews the origins, leaders, beliefs, rituals and practices of a NRM, highlighting the specific controversies surrounding each group. A fully updated, revised and expanded edition of an unparalleled introduction to cults and new religious movements. Profiles a number of the most visible, significant, and controversial new religious movements, presenting each group's history, doctrines, rituals, leadership, and organization. Offers a discussion of the major controversies in which new religious movements have been involved, using each profiled group to illustrate the nature of one of those controversies. Covers debates including what constitutes an authentic religion, the validity of claims of brainwashing techniques, the implications of experimentation with unconventional sexual practices, and the deeply rooted cultural fears that cults engender. New sections include methods of studying new religions in each chapter as well as presentations on 'groups to watch'\"--\n\n\"An overview of the development of new religions and the controversies surrounding them in late modern society\"--"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2020-08-03T21:57:40.175568"},"last_modified":{"type":"/type/datetime","value":"2025-06-22T17:56:58.905493"}}},"ISBN:9781118850435":{"bib_key":"ISBN:9781118850435","info_url":"http://openlibrary.org/books/OL39933911M/Cults_and_New_Religions","preview":"noview","preview_url":"http://openlibrary.org/books/OL39933911M/Cults_and_New_Religions","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL886918A","name":"Douglas E. Cowan"},{"key":"/authors/OL1550300A","name":"David G. Bromley"}],"isbn_13":["9781118850435"],"languages":[{"key":"/languages/eng"}],"pagination":"248","publish_date":"2015","publishers":["Wiley & Sons, Incorporated, John"],"source_records":["bwb:9781118850435"],"title":"Cults and New Religions","weight":"0.682","subtitle":"A Brief History","full_title":"Cults and New Religions A Brief History","works":[{"key":"/works/OL4452543W"}],"key":"/books/OL39933911M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-10-18T01:14:25.275170"},"last_modified":{"type":"/type/datetime","value":"2022-10-18T01:14:25.275170"}}},"ISBN:9781118723494":{"bib_key":"ISBN:9781118723494","info_url":"http://openlibrary.org/books/OL29281664M/Cults_and_New_Religions","preview":"noview","preview_url":"http://openlibrary.org/books/OL29281664M/Cults_and_New_Religions","details":{"publishers":["Wiley & Sons, Incorporated, John"],"subtitle":"A Brief History","last_modified":{"type":"/type/datetime","value":"2020-08-24T05:00:48.180631"},"source_records":["bwb:9781118723494"],"title":"Cults and New Religions","number_of_pages":248,"isbn_13":["9781118723494"],"created":{"type":"/type/datetime","value":"2020-08-24T05:00:48.180631"},"languages":[{"key":"/languages/eng"}],"full_title":"Cults and New Religions A Brief History","lc_classifications":[""],"publish_date":"2015","key":"/books/OL29281664M","authors":[{"key":"/authors/OL886918A","name":"Douglas E. Cowan"},{"key":"/authors/OL1550300A","name":"David G. Bromley"}],"latest_revision":1,"works":[{"key":"/works/OL4452543W"}],"type":{"key":"/type/edition"},"subjects":["Religions","Cults"],"revision":1}}}