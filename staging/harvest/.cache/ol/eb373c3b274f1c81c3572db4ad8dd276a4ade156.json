4719791","0814799388","0814740081","0814762069","0814782884","0814727417","0814788149","0814767168","0814757065","081471661","0814752071","0814719783","0814757073","0814727425"],"publish_places":["New York University Press, 2005"],"type":{"key":"/type/edition"},"lccn":["2004014626","2004018035","2004020166","2004024059","2004025441","2004026265","2004026812","2004028985","2004029511","2004029512","2004029513","2004030739","2005010435","2005017220","2009004559"],"oclc_numbers":["301948674","60664384","55738143","56086171","57243258","56404878","57392680","56956062","57185671","57243260","56834523","57236233","56967205","69662498","59098790","56733257"],"key":"/books/OL17151602M","works":[{"key":"/works/OL18323108W"}],"publishers":["NYU Press","New York University Press","JJC Foundation","Clay Sanskrit"],"publish_date":"2005-01-01","number_of_pages":374,"languages":[{"key":"/languages/eng"},{"key":"/languages/san"}],"description":{"type":"/type/text","value":"\"This court epic describes events leading up to but not including the birth of Kumara (also known as Skanda or Karttikeya), the war god destined to defeat the demon Taraka.\" \"The gods attempt to deploy Kama, the Indian Cupid, to set the ascetic supreme deity Shiva on fire with love for Uma (also known as Parvati), the daughter of the god of the Himalayan mountain range. Kama's mission fails, and Shiva, roused from his meditative trance, turns his flaming third eye on the love god, burning him to ashes. Next, Parvati herself turns to intense asceticism in order to win spiritual power and thereby the husband for whom she longs. She succeeds, and the climax of the poem is Shiva and Parvati's marriage and cosmic lovemaking, and Kumara's divine conception.\"--Jacket."},"latest_revision":139,"revision":139,"created":{"type":"/type/datetime","value":"2008-09-27T18:03:32.178627"},"last_modified":{"type":"/type/datetime","value":"2026-08-06T04:37:05.632709"}}},"ISBN:9781283999816":{"bib_key":"ISBN:9781283999816","info_url":"http://openlibrary.org/books/OL26654663M/Midnight's_Children","preview":"noview","preview_url":"http://openlibrary.org/books/OL26654663M/Midnight's_Children","thumbnail_url":"https://covers.openlibrary.org/b/id/8346715-S.jpg","details":{"publishers":["Random House Trade Paperbacks"],"description":"Saleem Sinai is born at the stroke of midnight on August 15, 1947, the very moment of India’s independence. Greeted by fireworks displays, cheering crowds, and Prime Minister Nehru himself, Saleem grows up to learn the ominous consequences of this coincidence. His every act is mirrored and magnified in events that sway the course of national affairs; his health and well-being are inextricably bound to those of his nation; his life is inseparable, at times indistinguishable, from the history of his country. Perhaps most remarkable are the telepathic powers linking him with India’s 1,000 other “midnight’s children,” all born in that initial hour and endowed with magical gifts. \r\n\r\nThis novel is at once a fascinating family saga and an astonishing evocation of a vast land and its people–a brilliant incarnation of the universal human comedy. Twenty-five years after its publication, Midnight’ s Children stands apart as both an epochal work of fiction and a brilliant performance by one of the great literary voices of our time.\r\n\r\nSource: https://www.penguinrandomhouse.com/books/158932/midnights-children-by-salman-rushdie/","covers":[8346715],"physical_format":"Epub","lc_classifications":["PR.9499.3.R8M5 1991"],"key":"/books/OL26654663M","publish_places":["New York, USA"],"isbn_13":["9781283999816"],"classifications":{},"title":"Midnight's Children","dewey_decimal_class":["823/.914"],"identifiers":{"amazon":["B003WUYQCS"],"goodreads":["43590983"]},"languages":[{"key":"/languages/eng"}],"isbn_10":["1283999811"],"publish_date":"1991","copyright_date":"1981","works":[{"key":"/works/OL457179W"}],"type":{"key":"/type/edition"},"source_records":["bwb:9781283999816"],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2019-01-16T14:59:19.293643"},"last_modified":{"type":"/type/datetime","value":"2022-12-17T07:36:26.897604"}}},"ISBN:9788439721796":{"bib_key":"ISBN:9788439721796","info_url":"http://openlibrary.org/books/OL26248669M/Hijos_de_la_medianoche","preview":"restricted","preview_url":"https://archive.org/details/isbn_9788439721796","thumbnail_url":"https://covers.openlibrary.org/b/id/8346722-S.jpg","details":{"translated_from":[{"key":"/languages/eng"}],"identifiers":{"google":["x3VVPgAACAAJ"],"depósito_legal":["B 189-2009"],"goodreads":["6075769"]},"contributors":[{"role":"Translator","name":"Miguel Sáenz"}],"series":["Literatura Mondadori No. 389"],"covers":[8346722],"edition_name":"1a ed.","source_records":["ia:isbn_9788439721796"],"title":"Hijos de la medianoche","work_titles":["Midnight's children"],"translation_of":"Midnight's Children","languages":[{"key":"/languages/spa"}],"subjects":["Nin os de los ricos","Paranormal fiction","Sobrenatural","Poor children","Relations","Fiction","Infants switched at birth","Novela","Islam","Relaciones","Nin os lactantes","Hinduism","Nin os pobres","Children of the rich","Hinduismo"],"publish_country":"sp ","by_statement":"Salman Rushdie ; traducción de Miguel Sáenz","type":{"key":"/type/edition"},"publishers":["Mondadori"],"description":{"type":"/type/text","value":"\"Esta es la historia de Saleem Sinai, nacido en Bombay al filo de la medianoche del 15 de agosto de 1947, en el momento mismo en que la India, entre fuegos artificiales y multitudes, alcanza su independencia. El destino de Saleem queda inexorablemente unido al de su país, y sus peripecias personales reflejarán siempre la evolución política de la India o serán reflejadas por ella. Es la historia de un hombre dotado de facultades insólitas pero también la de una generación y la de una familia, lo que la convierte en un retrato completo de toda una época y una cultura. Ganadora del prestigioso premio Booker of Bookers, Hijos de la medianoche constituye una asombrosa novela que combina magistralmente magia y humor, compromiso politico fantasía y humanidad.\" (De la editorial)"},"physical_format":"Hardcover","full_title":"Hijos de la medianoche","key":"/books/OL26248669M","authors":[{"key":"/authors/OL26769A","name":"Salman Rushdie"}],"publish_places":["Barcelona, España"],"pagination":"641 p. ; 24 cm","notes":{"type":"/type/text","value":"Primera edición en este formato."},"number_of_pages":641,"subject_places":["India"],"publish_date":"2009","works":[{"key":"/works/OL457179W"}],"ocaid":"isbn_9788439721796","isbn_10":["843972179X"],"isbn_13":["9788439721796"],"oclc_numbers":["294885690"],"classifications":{"udc":["821.111(540)-31\"19\""]},"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2017-04-27T21:47:56.183469"},"last_modified":{"type":"/type/datetime","value":"2026-07-13T05:08:13.654992"}}},"ISBN:9780676970654":{"bib_key":"ISBN:9780676970654","info_url":"http://openlibrary.org/books/OL20351955M/Midnight's_children","preview":"noview","preview_url":"http://openlibrary.org/books/OL20351955M/Midnight's_children","details":{"publishers":["Vintage Canada"],"number_of_pages":462,"last_modified":{"type":"/type/datetime","value":"2020-08-25T15:56:46.415351"},"latest_revision":5,"key":"/books/OL20351955M","authors":[{"key":"/authors/OL26769A","name":"Salman Rushdie"}],"publish_places":["Toronto"],"pagination":"462 p. ;","source_records":["bwb:9780676970654"],"title":"Midnight's children","dewey_decimal_class":["823/.914"],"identifiers":{"librarything":["2118"],"goodreads":["879891"]},"created":{"type":"/type/datetime","value":"2008-10-26T14:59:52.122200"},"languages":[{"key":"/languages/eng"}],"isbn_10":["0676970656"],"publish_date":"1997","publish_country":"onc","by_statement":"Salman Rushdie.","works":[{"key":"/works/OL457179W"}],"type":{"key":"/type/edition"},"revision":5}},"ISBN:9780099535096":{"bib_key":"ISBN:9780099535096","info_url":