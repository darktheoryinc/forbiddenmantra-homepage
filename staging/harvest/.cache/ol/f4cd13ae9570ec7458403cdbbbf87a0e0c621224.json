":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Enchantment","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Permission","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Persistence","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Trust","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Divinity.","pagenum":"","type":{"key":"/type/toc_item"}}],"description":"Elizabeth Gilbert digs deep into her own generative process to share her wisdom and unique perspective about creativity, offering insights into the mysterious nature of inspiration. She asks us to embrace our curiosity and let go of needless suffering. She shows us how to tackle what we most love, and how to face down what we most fear. She discusses the attitudes, approaches, and habits we need in order to live our most creative lives. Balancing between soulful spirituality and cheerful pragmatism, Gilbert encourages us to uncover the \"strange jewels\" that are hidden within each of us. Whether we are looking to write a book, make art, find new ways to address challenges in our work, embark on a dream long deferred, or simply infuse our everyday lives with more mindfulness and passion, Big Magic cracks open a world of wonder and joy.","series":["Thorndike Press large print core"],"local_id":["urn:sfpl:31223116439903","urn:sfpl:31223116439887","urn:sfpl:31223116439630","urn:bwbsku:P7-EIT-074"],"key":"/books/OL27190146M","authors":[{"key":"/authors/OL30835A","name":"Elizabeth Gilbert"}],"subtitle":"creative living beyond fear","subjects":["Creative ability","Confidence","Courage","Conduct of life","Magical thinking","Inspiration"],"languages":[{"key":"/languages/eng"}],"pagination":"299 pages (large print)","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:219175186:3416","bwb:9781410483157","marc:marc_loc_2016/BooksAll.2016.part42.utf8:79989473:959","ia:bigmagiccreative0000gilb_q6n6","promise:bwb_daily_pallets_2021-08-24"],"title":"Big magic","number_of_pages":299,"edition_name":"Large print edition.","publish_date":"2015","publish_country":"miu","copyright_date":"2015","by_statement":"Elizabeth Gilbert","works":[{"key":"/works/OL17356845W"}],"type":{"key":"/type/edition"},"covers":[15028416,14933575,12574848],"identifiers":{},"ocaid":"bigmagiccreative0000gilb_q6n6","isbn_10":["1410483150"],"isbn_13":["9781410483157"],"lccn":["2015031240"],"oclc_numbers":["912381904"],"dewey_decimal_class":["153.3/5"],"lc_classifications":["BF408 .G464 2015b","BF408.G464 2015b"],"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2019-07-19T05:11:27.833922"},"last_modified":{"type":"/type/datetime","value":"2025-05-09T00:56:39.622176"}}},"ISBN:9781594634970":{"bib_key":"ISBN:9781594634970","info_url":"http://openlibrary.org/books/OL43275909M/Big_Magic","preview":"noview","preview_url":"http://openlibrary.org/books/OL43275909M/Big_Magic","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL30835A","name":"Elizabeth Gilbert"}],"isbn_10":["1594634971"],"isbn_13":["9781594634970"],"local_id":["urn:bwbsku:O7-CJB-091"],"publish_date":"2015-09-22","publishers":["Riverhead Books"],"source_records":["promise:bwb_daily_pallets_2021-08-13","bwb:9781594634970"],"title":"Big Magic","subtitle":"Creative Living Beyond Fear","full_title":"Big Magic Creative Living Beyond Fear","works":[{"key":"/works/OL17356845W"}],"key":"/books/OL43275909M","latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2022-12-08T02:43:19.227223"},"last_modified":{"type":"/type/datetime","value":"2025-03-09T15:49:09.645042"}}},"ISBN:9788466367141":{"bib_key":"ISBN:9788466367141","info_url":"http://openlibrary.org/books/OL47456290M/Libera_tu_magia","preview":"noview","preview_url":"http://openlibrary.org/books/OL47456290M/Libera_tu_magia","thumbnail_url":"https://covers.openlibrary.org/b/id/14060613-S.jpg","details":{"type":{"key":"/type/edition"},"title":"Libera tu magia","authors":[{"key":"/authors/OL30835A","name":"Elizabeth Gilbert"},{"key":"/authors/OL9116766A","name":"Laura Vidal Sanz"}],"publish_date":"Jan 26, 2023","source_records":["amazon:8466367144","bwb:9788466367141"],"number_of_pages":312,"publishers":["DEBOLSILLO"],"physical_format":"mass market paperback","full_title":"Libera tu magia Una vida creativa más allá del miedo","subtitle":"Una vida creativa más allá del miedo","notes":"Source title: Libera tu magia: Una vida creativa más allá del miedo","covers":[14060613],"works":[{"key":"/works/OL17356845W"}],"key":"/books/OL47456290M","identifiers":{},"isbn_10":["8466367144"],"isbn_13":["9788466367141"],"languages":[{"key":"/languages/spa"},{"key":"/languages/spa"}],"translated_from":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"La mayoría de los humanos tenemos una faceta creativa en nuestras mentes que casi nunca conseguimos o queremos desarrollar por motivos prácticos o personales. Gilbert defiende la necesidad de explorar la faceta creativa para alcanzar una existencia plena, superando el miedo (a la vergüenza, a hacer el ridículo, a perder el tiempo, a no ser tomado en serio) y abrazando la parte mística e intangible de la inspiración. La autora explica cómo tener una relación positiva con la creatividad propia, cómo ser disciplinado, pero no tomárselo demasiado en serio, cómo no albergar grandes expectativas pero no dejarse desanimar y cómo cada pequeño acto cotidiano, sea un dibujo, decorar la casa o hacer patinaje artístico, alimenta esa parte creativa de los humanos y no solo puede, sino que debe formar parte orgánica de nuestras vidas.\r\n \r\nAl mismo tiempo desmitifica totalmente la figura del artista atormentado, defendiendo una actitud abierta, receptiva y positiva en busca de la inspiración como resultado de una curiosidad sana, una disciplina y una determinación que mantengan el ego a raya y permitan sobrellevar decepciones y fracasos.\r\n \r\n«La creatividad es sagrada y al mismo tiempo no lo es.\r\nLoque hacemos importa muchísimo y al mismo tiempo no importa nada.\r\nTrabajamos en soledad, y nos acompañan espíritus.\r\nEstamos aterrorizados y somos valientes.\r\nEl arte es una tareaabrumadora y un privilegio maravilloso.\r\nEl trabajo quiere ser hecho, y quiere ser hecho por ti»."},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2023-04-16T16:42:26.679191"},"last_modified":{"type":"/type/datetime","value":"2026-02-25T03:25:00.670675"}}},"ISBN:9780486835969":{"bib_key":"ISBN:9780486835969","info_url":"http://openlibrary.org/books/OL28908537M/What_Is_Man","preview":"noview","preview_url":"http://openlibrary.org/books/OL28908537M/What_Is_Man","details":{"publishers":["Dover Publications, Incorporated"],"languages":[{"key":"/languages/eng"}],"subtitle":"And Other Essays","source_records":["bwb:9780486835969"],"title":"What Is Man?","number_of_pages":272,"full_title":"What Is Man? And Other Essays","publish_date":"2019","key":"/books/OL28908537M","authors":[{"key":"/authors/OL18319A","name":"Mark Twain"}],"works":[{"key":"/works/OL54132W"}],"type":{"key":"/type/edition"},"subjects":["American literature"],"identifiers":{},"isbn_13":["9780486835969"],"classifications":{},"lc_classifications":["PS13032019"],"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2020-08-17T19:19:21.862656"},"last_modified":{"type":"/type/datetime","value":"2021-11-19T06:34:41.688949"}}},"ISBN:9781406502534":{"bib_key":"ISBN:9781406502534","info_url":"http://openlibrary.org/books/OL8407958M/What_Is_Man_And_Other_Essays","preview":"noview","preview_url":"http://openlibrary.org/books/OL8407958M/What_Is_Man_And_Other_Essays","thumbnail_url":"https://covers.openlibrary.org/b/id/756021-S.jpg","details":{"publishers":["Dodo Press"],"identifiers":{"goodreads":["298648"],"librarything":["1704485"]},"weight":"14.9 ounces","covers":[756021],"ph