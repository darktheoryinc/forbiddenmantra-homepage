mad bin Aḥmad bin Muḥāmmad bin Aḥmad ibn Rushd al-Qurṭubī al-Andalusī; taḥqīq wa-taʻlīq wa-dirāsat ʻAlī Muḥammad Muʻawwaḍ, ʻĀdil Aḥmad ʻAbd al-Mawjūd","works":[{"key":"/works/OL50108W"}],"type":{"key":"/type/edition"},"revision":1}},"ISBN:9781873938935":{"bib_key":"ISBN:9781873938935","info_url":"http://openlibrary.org/books/OL904153M/The_distinguished_jurist's_primer","preview":"noview","preview_url":"http://openlibrary.org/books/OL904153M/The_distinguished_jurist's_primer","thumbnail_url":"https://covers.openlibrary.org/b/id/14816676-S.jpg","details":{"publishers":["Centre for Muslim Contribution to Civilization","Garnet Pub."],"subtitle":"a translation of Bidāyat al-mujtahid","isbn_10":["1873938136","1873938934"],"series":["The great books of Islamic civilisation"],"pagination":"v. <l-2   > ;","covers":[14816676,3836812,4831728,3836845],"lc_classifications":["KBP320.A84 A3313 1994","LAW"],"key":"/books/OL904153M","authors":[{"key":"/authors/OL31013A","name":"Averroës"}],"publish_places":["Reading, UK"],"contributions":["Centre for Muslim Contribution to Civilization."],"work_title":["Bidāyat al-mujtahid wa-nihāyat al-muqtaṣid."],"languages":[{"key":"/languages/eng"}],"genres":["Early works to 1800."],"source_records":["marc:marc_records_scriblio_net/part25.dat:111016796:1284","bwb:9781873938935"],"title":"The distinguished jurist's primer","lccn":["95197453"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"identifiers":{"goodreads":["775828","1326888"],"librarything":["7481918"]},"edition_name":"1st ed.","subjects":["Islamic law -- Early works to 1800","Malikites -- Early works to 1800","Islamic law -- Interpretation and construction","Islam -- Doctrines -- Early works to 1800"],"publish_date":"1994","publish_country":"enk","by_statement":"Ibn Rushd ; translated by Imran Ahsan Khan Nyazee ; reviewed by Muhammad Abdul Rauf.","oclc_numbers":["33044052"],"works":[{"key":"/works/OL50108W"}],"type":{"key":"/type/edition"},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-09-15T03:55:15.643871"}}},"ISBN:9781873938133":{"bib_key":"ISBN:9781873938133","info_url":"http://openlibrary.org/books/OL8654514M/The_Distinguished_Jurist's_Primer","preview":"noview","preview_url":"http://openlibrary.org/books/OL8654514M/The_Distinguished_Jurist's_Primer","thumbnail_url":"https://covers.openlibrary.org/b/id/4831729-S.jpg","details":{"publishers":["Garnet Education"],"number_of_pages":660,"subtitle":"A Translation of Bidayat Al-Mujtahid (The Great Books of Islamic Civilization)","weight":"3.3 pounds","isbn_10":["1873938136"],"covers":[4831729,3836813],"physical_format":"Hardcover","lc_classifications":["LAW","KBP320.A84 A3313 1994"],"key":"/books/OL8654514M","authors":[{"key":"/authors/OL31013A","name":"Averroës"},{"key":"/authors/OL3044190A","name":"Ibn Rushd"}],"contributions":["Imran Ahsan Khan Nyazee (Translator)"],"languages":[{"key":"/languages/eng"}],"source_records":["bwb:9781873938133","marc:marc_loc_2016/BooksAll.2016.part24.utf8:211275277:1289","marc:marc_columbia/Columbia-extract-20221130-004.mrc:241882153:1435","marc:harvard_bibliographic_metadata/20220215_039.bib.mrc:206144443:5466"],"title":"The Distinguished Jurist's Primer","lccn":["95197453"],"identifiers":{"librarything":["7481918"],"goodreads":["1326888"]},"isbn_13":["9781873938133"],"edition_name":"1st ed edition","subjects":["Islam","Other prose: classical, early & medieval","Reference","Interpretation and construction","Early works to 1800","Religion - World Religions","Malikites","Islamic Law","Comparative Religion","Islam - Law","General","Interpretation and constructio"],"publish_date":"January 1995","works":[{"key":"/works/OL50108W"}],"type":{"key":"/type/edition"},"physical_dimensions":"9.5 x 6.8 x 2.2 inches","oclc_numbers":["31812369"],"description":{"type":"/type/text","value":"\"Ibn Rushd's \"Bidayat al-Mujtahid\" (\"The Distinguished Jurist's Primer\") occupies a unique place among the authoritative manuals of Islamic law. It is designed to prepare the jurist for the task of the mujtahid, the independent jurist, who derives the law and lays down precedents to be followed by the judge in the administration of justice. In this manual Ibn Rushd traces most of the issues of Islamic law, describing not only what the law is, but also elaborating the methodology of some of the greatest legal minds in Islam to show how such laws were derived. This text provides a still-relevant basis for the interpretation and formulation of Islamic law. Combining his legal and philosophical knowledge, Ibn Rushd transcends the boundaries of different schools and presents a critical analysis of the opinions of the famous Muslim jurists and their methodologies. The legal subject areas covered include marriage and divorce; sale and exchange of goods; wages, crop-sharing and speculative partnership; security for debts and insolvency; gifts, bequests and inheritance; and offences and judgements.\"--Publisher's description."},"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-04-30T08:14:56.482104"},"last_modified":{"type":"/type/datetime","value":"2026-05-21T19:52:37.109965"}}},"ISBN:9781136721687":{"bib_key":"ISBN:9781136721687","info_url":"http://openlibrary.org/books/OL33638320M/Complete_Multifaith_Resource_for_Primary_Religious_Education","preview":"noview","preview_url":"http://openlibrary.org/books/OL33638320M/Complete_Multifaith_Resource_for_Primary_Religious_Education","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL3256232A","name":"Judith Lowndes"}],"isbn_13":["9781136721687"],"languages":[{"key":"/languages/eng"}],"number_of_pages":138,"publish_date":"2012","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781136721687"],"subjects":["Religious education of children","Education, primary","Christianity and other religio