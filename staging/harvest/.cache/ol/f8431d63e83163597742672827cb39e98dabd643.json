:9780140029819"],"dewey_decimal_class":["868"],"languages":[{"key":"/languages/eng"}],"lccn":["74160161"],"subjects":["Borges, Jorge Luis, 1899-  -- Translations into English","Argentina -- Social life and customs -- Fiction"],"publish_country":"enk","series":["Penguin modern classics"],"by_statement":"edited by Donald A. Yates and James E. Irby; preface by André Maurois.","work_title":["Selected works."],"type":{"key":"/type/edition"},"local_id":["urn:bwbsku:KR-408-235"],"key":"/books/OL5088768M","number_of_pages":297,"works":[{"key":"/works/OL110959W"}],"latest_revision":37,"revision":37,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2023-02-28T02:08:29.524542"}}},"ISBN:9780140093131":{"bib_key":"ISBN:9780140093131","info_url":"http://openlibrary.org/books/OL46856373M/Labyrinths","preview":"borrow","preview_url":"https://archive.org/details/borgesjorgeluisl0000jorg","thumbnail_url":"https://covers.openlibrary.org/b/id/14410049-S.jpg","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL18928A","name":"Jorge Luis Borges"}],"local_id":["urn:bwbsku:P8-CIL-608"],"publish_date":"1987","publishers":["Penguin Books"],"source_records":["promise:bwb_daily_pallets_2023-02-22:P8-CIL-608"],"title":"Labyrinths","works":[{"key":"/works/OL110959W"}],"key":"/books/OL46856373M","identifiers":{"goodreads":["2762921"]},"isbn_10":["0140093133"],"isbn_13":["9780140093131"],"ocaid":"borgesjorgeluisl0000jorg","classifications":{},"number_of_pages":287,"pagination":"287p.","description":{"type":"/type/text","value":"'The stories, essays and poems written by Jorge Luis Borges of Argentina suffice for us to call him great', as André Maurois writes in his preface, because of their wonderful intelligence, their wealth of invention and their tight, almost mathematical style.\r\n\r\nThe twenty-three stories in Labyrinths include Borges's classic 'Tlön, Uqbar, Orbis Tertius', a new world where external objects are whatever each person wants; and 'Pierre Menard', the story of the man who rewrote parts of Don Quixote for the twentieth century in Cervantes's words.\r\n\r\nThe ten essays reflect the extraordinary scope of Borges's reading – the ancient literatures of Greece and China, the medieval philosophers, Pascal, Shakespeare, Valéry, Shaw and Wells – while the seven parables are unforgettable exercises in the art of astonishment."},"publish_places":["Harmondsworth"],"physical_format":"paperback","copyright_date":"1964","edition_name":"reprint","languages":[{"key":"/languages/eng"}],"covers":[14410049],"table_of_contents":[{"level":0,"title":"Preface","pagenum":"9","type":{"key":"/type/toc_item"}},{"level":0,"title":"Introduction","pagenum":"15","type":{"key":"/type/toc_item"}},{"level":0,"title":"Fictions","type":{"key":"/type/toc_item"}},{"level":1,"title":"Tlön, Uqbar, Orbis Tertius","pagenum":"27","type":{"key":"/type/toc_item"}},{"level":1,"title":"The Garden of Forking Paths","pagenum":"44","type":{"key":"/type/toc_item"}},{"level":1,"title":"The Lottery in Babylon","pagenum":"55","type":{"key":"/type/toc_item"}},{"level":1,"title":"Pierre Menard, Author of the Quixote","pagenum":"62","type":{"key":"/type/toc_item"}},{"level":1,"title":"The Circular Ruins","pagenum":"72","type":{"key":"/type/toc_item"}},{"level":1,"title":"The Library of Babel","pagenum":"78","type":{"key":"/type/toc_item"}},{"level":1,"title":"Funes the Memorious","pagenum":"87","type":{"key":"/type/toc_item"}},{"level":1,"title":"The Shape of the Sword","pagenum":"96","type":{"key":"/type/toc_item"}},{"level":1,"title":"Theme of the Traitor and the Hero","pagenum":"102","type":{"key":"/type/toc_item"}},{"level":1,"title":"Death and the Compass","pagenum":"106","type":{"key":"/type/toc_item"}},{"level":1,"title":"The Secret Miracle","pagenum":"118","type":{"key":"/type/toc_item"}},{"level":1,"title":"Three Versions of Judas","pagenum":"125","type":{"key":"/type/toc_item"}},{"level":1,"t