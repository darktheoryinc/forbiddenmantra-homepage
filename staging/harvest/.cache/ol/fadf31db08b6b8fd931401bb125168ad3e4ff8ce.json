type/datetime","value":"2024-08-23T01:50:16.148673"}}},"ISBN:9780415585767":{"bib_key":"ISBN:9780415585767","info_url":"http://openlibrary.org/books/OL28438670M/Being_Brahmin_Being_Modern","preview":"noview","preview_url":"http://openlibrary.org/books/OL28438670M/Being_Brahmin_Being_Modern","details":{"publishers":["Taylor & Francis Group"],"languages":[{"key":"/languages/eng"}],"subtitle":"Exploring the Lives of Caste Today","source_records":["bwb:9780415585767","marc:marc_loc_2016/BooksAll.2016.part37.utf8:207625258:836","marc:marc_columbia/Columbia-extract-20221130-031.mrc:109919473:4342","marc:marc_columbia/Columbia-extract-20221130-017.mrc:37445273:939","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:573085376:2255","marc:harvard_bibliographic_metadata/20220215_029.bib.mrc:102356303:2662"],"title":"Being Brahmin Being Modern","lccn":["2010317101"],"number_of_pages":370,"isbn_13":["9780415585767"],"lc_classifications":["","DS432.B73 R36 2010","DS432.B73 R36 2010eb","HT720 .B35 2010","DS432.B73 B35 2010"],"publish_date":"2010","key":"/books/OL28438670M","authors":[{"key":"/authors/OL8031975A","name":"Ramesh Bairy"}],"works":[{"key":"/works/OL21010196W"}],"type":{"key":"/type/edition"},"subjects":["Caste, india"],"oclc_numbers":["826657858","526111392"],"description":{"type":"/type/text","value":"\"There is clearly an academic and political obsession with the 'idea' of the Brahmin. There is also, simultaneously, a near-complete absence of engagement with the Brahmin as an embodied person or community. This book addresses this intriguing paradox by making available a sociological description of the Brahmins in today's Karnataka. It pursues three distinct, yet enmeshed, registers of inquiry -- the persona of the 'Brahmin' embodied in the agency of the individual Brahmin; the organised complexes of action such as the caste association and the public culture of print; and finally, taking off from a longer (yet, modern and contemporary) history of non-Brahminical othering of the Brahmin. It argues that we tend to understand the contemporaneity of caste almost exclusively within the twin registers of legitimation-contestation and dominance-resistance. While these facets continue to be salient, there is also a need to push out into hitherto neglected dimensions of caste. The book focuses attention on the many lives of modern caste -- its secularisation, the subject positions that it offers, the equivocations by which persons and communities become 'subjects' of caste, their differential investments in the caste-self.\" - - Routledge.com web site."},"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2020-08-01T19:39:14.613180"},"last_modified":{"type":"/type/datetime","value":"2026-01-31T02:38:07.067735"}}},"ISBN:9781136198151":{"bib_key":"ISBN:9781136198151","info_url":"http://openlibrary.org/books/OL33762948M/Being_Brahmin_Being_Modern","preview":"noview","preview_url":"http://openlibrary.org/books/OL33762948M/Being_Brahmin_Being_Modern","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8031975A","name":"Ramesh Bairy"}],"isbn_13":["9781136198151"],"languages":[{"key":"/languages/eng"}],"number_of_pages":370,"publish_date":"2013","publishers":["Taylor & Francis Group"],"source_records":["bwb:9781136198151"],"title":"Being Brahmin, Being Modern","subtitle":"Exploring the Lives of Caste Today","full_title":"Being Brahmin, Being Modern Exploring the Lives of Caste Today","works":[{"key":"/works/OL21010196W"}],"key":"/books/OL33762948M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-09-21T10:39:48.705019"},"last_modified":{"type":"/type/datetime","value":"2021-09-21T10:39:48.705019"}}},"ISBN:9780415860857":{"bib_key":"ISBN:9780415860857","info_url":"http://openlibrary.org/books/OL28504840M/History_and_the_Making_of_a_Modern_Hindu_Self","preview":"noview","preview_url":"http://openlibrary.org/books/OL28504840M/History_and_the_Making_of_a_