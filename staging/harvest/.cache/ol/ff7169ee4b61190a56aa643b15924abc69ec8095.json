:"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2022-06-17T13:45:44.303932"}}},"ISBN:9780226025605":{"bib_key":"ISBN:9780226025605","info_url":"http://openlibrary.org/books/OL10191549M/The_Sense_of_Unity","preview":"borrow","preview_url":"https://archive.org/details/senseofunitysufi0000arda","thumbnail_url":"https://covers.openlibrary.org/b/id/12999897-S.jpg","details":{"publishers":["Univ of Chicago Pr (T)"],"number_of_pages":172,"subtitle":"The Sufi Tradition in Persian Architecture (Publications of the Center for Middle Eastern Studies)","weight":"1.6 pounds","physical_format":"Paperback","key":"/books/OL10191549M","authors":[{"key":"/authors/OL2035849A","name":"Nader Ardalan"}],"subjects":["Architecture","History of art: BCE to c 500 CE, ancient & classical world","Middle East","General","History","Photography","Architecture, Islamic","Iran","Sufism","Symbolism in architecture"],"isbn_13":["9780226025605"],"source_records":["amazon:0226025608","bwb:9780226025605","ia:senseofunitysufi0000arda","promise:bwb_daily_pallets_2021-06-03"],"title":"The Sense of Unity","identifiers":{"goodreads":["1332106"],"librarything":["603138"]},"languages":[{"key":"/languages/eng"}],"isbn_10":["0226025608"],"publish_date":"November 1979","works":[{"key":"/works/OL149887W"}],"type":{"key":"/type/edition"},"physical_dimensions":"12.2 x 12.2 x 0.5 inches","covers":[12999897],"ocaid":"senseofunitysufi0000arda","lccn":["72092278"],"lc_classifications":["NA1483 .A67 1973"],"oclc_numbers":["2709387"],"local_id":["urn:bwbsku:P7-AQI-601"],"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":{"type":"/type/datetime","value":"2022-12-08T09:20:19.751159"}}},"ISBN:9781871031782":{"bib_key":"ISBN:9781871031782","info_url":"http://openlibrary.org/books/OL9383906M/The_Sense_of_Unity","preview":"noview","preview_url":"http://openlibrary.org/books/OL9383906M/The_Sense_of_Unity","thumbnail_url":"https://covers.openlibrary.org/b/id/2072457-S.jpg","details":{"identifiers":{"librarything":["6738917"],"goodreads":["271418"]},"title":"The Sense of Unity ","subtitle":"The Sufi Tradition in Persian Architecture","authors":[{"key":"/authors/OL2035849A","name":"Nader Ardalan"},{"key":"/authors/OL61169A","name":"Laleh Bakhtiar"}],"publish_date":"April 1, 2000","publishers":["Abjad Book Designers & Builders"],"weight":"1.8 pounds","covers":[2072457],"physical_format":"Paperback","subjects":["Architecture","Decoration & Ornament","Design & Drafting","Public, Commercial, or Industrial Buildings"],"edition_name":"2nd edition","languages":[{"key":"/languages/eng"}],"isbn_13":["9781871031782"],"isbn_10":["1871031788"],"oclc_numbers":["43484347"],"type":{"key":"/type/edition"},"physical_dimensions":"10.3 x 10.1 x 0.5 inches","key":"/books/OL9383906M","number_of_pages":150,"works":[{"key":"/works/OL149887W"}],"lc_classifications":["NA1483 .A67 1999"],"source_records":["marc:harvard_bibliographic_metadata/20220215_003.bib.mrc:219805533:4576"],"description":{"type":"/type/text","value":"Despite its extraordinary richness, Islamic architecture has rarely been studied for its conceptual and symbolic significance. In the Sense of Unity, a handsomely illustrated volume and the first extended work of its kind, Nader Ardalan and Laleh Bakhtiar examine the architecture of Persia as a manifestation of Islamic tradition and demonstrate the synthesis of traditional Persian thought and form. The most fundamental principle of Sufism, the inner, esoteric dimension of Islam, is that of unity in multiplicity. This view sees in every aspect of reality a reflection of a transcendent source which is given symbolic expression through all of man's activities, most directly and importantly through his works of art. The authors of The Sense of Unity show how all the elements of the Islamic architecture of Persia from the simplest architectural unit to a complex urban environment are woven around this central doctrine and thus are best understood as multiple manifestations of unity. The Sense of Unity is illustrated with photographs, drawing, charts, and tables which are an integral part of its argument and which exemplify, in abundant and striking detail, the principles discussed in the text. Presenting to the Western reader for the first time the insights of the Iranian cultural tradition, the book also offers a stimulating new way of thinking about man and his relationship to his milieu."},"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":{"type":"/type/datetime","value":"2025-05-17T22:53:55.002379"}}},"ISBN:9781322232775":{"bib_key":"ISBN:9781322232775","info_url":"http://openlibrary.org/books/OL46043817M/Women_in_Sufism","preview":"noview","preview_url":"http://openlibrary.org/books/OL46043817M/Women_in_Sufism","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8145690A","name":"Marta Dominguez Diaz"}],"isbn_13":["9781322232775"],"languages":[{"key":"/languages/eng"}],"pagination":"205","publish_date":"2014","publishers":["Routledge"],"source_records":["bwb:9781322232775"],"title":"Women in Sufism","subtitle":"Female Religiosities in a Transnational Order","full_title":"Women in Sufism Female Religiosities in a Transnational Order","works":[{"key":"/works/OL21267882W"}],"key":"/books/OL46043817M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2023-01-17T04:06:26.391657"},"last_modified":{"type":"/type/datetime","value":"2023-01-17T04:06:26.391657"}}},"ISBN:9781317806561":{"bib_key":"ISBN:9781317806561","info_url":"http://openlibrary.org/books/OL54038187M/Women_in_Sufism","preview":"noview","preview_url":"http://openlibrary.org/books/OL54038187M/Women_in_Sufism","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8145690A","name":"Marta Dominguez Diaz"}],"dewey_decimal_class":["297.48"],"isbn_13