{"ISBN:9781526119841":{"bib_key":"ISBN:9781526119841","info_url":"http://openlibrary.org/books/OL35527800M/Charlotte_Brontë","preview":"noview","preview_url":"http://openlibrary.org/books/OL35527800M/Charlotte_Brontë","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8118952A","name":"Deborah Wynne"},{"key":"/authors/OL9926361A","name":"Amber Regis"}],"isbn_13":["9781526119841"],"languages":[{"key":"/languages/eng"}],"pagination":"304","publish_date":"2017","publishers":["Manchester University Press"],"source_records":["bwb:9781526119841"],"subjects":["Bronte, charlotte, 1816-1855","English literature, history and criticism, 19th century"],"title":"Charlotte Brontë","subtitle":"Legacies and Afterlives","full_title":"Charlotte Brontë Legacies and Afterlives","works":[{"key":"/works/OL25050702W"}],"key":"/books/OL35527800M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-11-02T22:49:45.403781"},"last_modified":{"type":"/type/datetime","value":"2021-11-02T22:49:45.403781"}}},"ISBN:9781784992460":{"bib_key":"ISBN:9781784992460","info_url":"http://openlibrary.org/books/OL33310158M/Charlotte_Brontë","preview":"noview","preview_url":"http://openlibrary.org/books/OL33310158M/Charlotte_Brontë","thumbnail_url":"https://covers.openlibrary.org/b/id/14732325-S.jpg","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL8118952A","name":"Deborah Wynne"},{"key":"/authors/OL8118953A","name":"Amber K. Regis"}],"isbn_13":["9781784992460"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["PR4169","PR4169 .C44 2017"],"number_of_pages":304,"publish_date":"2017","publishers":["Manchester University Press"],"source_records":["bwb:9781784992460","marc:marc_columbia/Columbia-extract-20221130-026.mrc:106908042:1315","marc:harvard_bibliographic_metadata/20220215_039.bib.mrc:210679405:6273"],"subjects":["English literature, history and criticism, 19th century"],"title":"Charlotte Brontë","weight":"0.503","full_title":"Charlotte Brontë","works":[{"key":"/works/OL25050702W"}],"key":"/books/OL33310158M","oclc_numbers":["964538894"],"covers":[14732325],"description":{"type":"/type/text","value":"\"Charlotte Brontë: Legacies and Afterlives is a timely reflection on the persistent fascination and creative engagement with Charlotte Brontë's life and work. The new essays in this volume, which cover the period from Brontë's first publication to the twenty-first century, explain why her work has endured in so many different forms and contexts. This book brings the story of Charlotte Brontë's legacy up to date, analysing the intriguing afterlives of characters such as Jane Eyre and Rochester in neo-Victorian fiction, cinema, television, the stage and, more recently, on the web. Taking a fresh look at 150 years of engagement with one of the best-loved novelists of the Victorian period, from obituaries to vlogs, from stage to screen, from novels to erotic makeovers, this book reveals the author's diverse and intriguing legacy. Engagingly written and illustrated, the book will appeal to both scholars and general readers.\" -- ‡c From publisher's description."},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2021-09-13T18:04:28.105503"},"last_modified":{"type":"/type/datetime","value":"2026-05-22T00:24:35.721966"}}},"ISBN:9781526119858":{"bib_key":"ISBN:9781526119858","info_url":"http://openlibrary.org/books/OL38302427M/Charlotte_Brontë","preview":"noview","preview_url":"http://openlibrary.org/books/OL38302427M/Charlotte_Brontë","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL9926361A","name":"Amber Regis"},{"key":"/authors/OL8118952A","name":"Deborah Wynne"}],"isbn_13":["9781526119858"],"languages":[{"key":"/languages/eng"}],"publish_date":"2017","publishers":["Manchester University Press"],"source_records":["bwb:9781526119858"],"subjects":["Bronte, charlotte, 1816-1855","English literature, history and criticism, 19th century"],"ti