rk, NY"],"contributions":["Cohn, Marian."],"languages":[{"key":"/languages/eng"}],"pagination":"xxv, 421 p. :","source_records":["ia:absolutebeautyra00raic","marc:marc_loc_2016/BooksAll.2016.part26.utf8:35835919:938","bwb:9780062701725","marc:marc_columbia/Columbia-extract-20221130-006.mrc:122730512:2621"],"title":"Absolute beauty","dewey_decimal_class":["646.7/26"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 408-409) and index."},"number_of_pages":421,"edition_name":"1st ed.","lccn":["97001908"],"subjects":["Skin -- Care and hygiene.","Medicine, Ayurvedic.","Beauty, Personal."],"publish_date":"1997","publish_country":"nyu","by_statement":"Pratima Raichur with Marian Cohn.","oclc_numbers":["36423383"],"works":[{"key":"/works/OL2622964W"}],"type":{"key":"/type/edition"},"description":{"type":"/type/text","value":"\"A chemist and internationally recognized expert on Ayurvedic skin care, Pratima Raichur explains how the external skin tissue is the physical reflection of everything that happens within the body: the way we eat and breathe, as well as the thoughts and emotions that fill our mind and color our spirit. Combining ancient and modern science, Absolute Beauty describes the three constitutional skin types, or \"doshas,\" and walks readers through the three essential steps of good skin care.\n\nRaichur also outlines the five sense-based therapies that work from the inside out to create a glowing complexion and an attractiveness that transcends age, fashion, and superficial flaws.\" \"This exceptional beauty manual includes a detailed self-test to help readers determine their exact skin type, customized skin care regimens for each skin type, proven-effective advice for addressing the most troubling skin problems, essential nutritional information, and instructions for detoxifying the body.\".\n\n\"Perhaps most important, Pratima Raichur provides an accessible introduction to Ayurveda's spiritual principles and practices to help all women achieve the joy and peace of mind that are the ultimate source of absolute beauty.\"--BOOK JACKET."},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-07-10T23:51:23.662807"}}},"ISBN:9780062390257":{"bib_key":"ISBN:9780062390257","info_url":"http://openlibrary.org/books/OL35942609M/Absolute_Beauty","preview":"noview","preview_url":"http://openlibrary.org/books/OL35942609M/Absolute_Beauty","thumbnail_url":"https://covers.openlibrary.org/b/id/14673130-S.jpg","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL10002939A","name":"Pratima Raichur"},{"key":"/authors/OL2631199A","name":"Mariam Cohn"}],"isbn_13":["9780062390257"],"languages":[{"key":"/languages/eng"}],"pagination":"448","publish_date":"2014","publishers":["HarperCollins Publishers"],"source_records":["bwb:9780062390257"],"subjects":["Beauty, personal"],"title":"Absolute Beauty","subtitle":"Radiant Skin and Inner Harmony Through the Ancient Secrets of Ayurveda","full_title":"Absolute Beauty Radiant Skin and Inner Harmony Through the Ancient Secrets of Ayurveda","works":[{"key":"/works/OL26558914W"}],"key":"/books/OL35942609M","covers":[14673130],"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2021-12-27T04:16:33.138113"},"last_modified":{"type":"/type/datetime","value":"2024-08-22T16:33:41.382878"}}},"ISBN:9780060929107":{"bib_key":"ISBN:9780060929107","info_url":"http://openlibrary.org/books/OL7284907M/Absolute_Beauty","preview":"noview","preview_url":"http://openlibrary.org/books/OL7284907M/Absolute_Beauty","thumbnail_url":"https://covers.openlibrary.org/b/id/40473-S.jpg","details":{"publishers":["Harper Paperbacks"],"number_of_pages":448,"subtitle":"Radiant Skin and Inner Harmony Through the Ancient Secrets of Ayurveda","title":"Absolute Beauty","identifiers":{"goodreads":["53548"],"librarything":["705936"]},"isbn_13":["9780060929107"],"c