{"ISBN:9781614296256":{"bib_key":"ISBN:9781614296256","info_url":"http://openlibrary.org/books/OL28926462M/Following_in_the_Buddha's_Footsteps","preview":"noview","preview_url":"http://openlibrary.org/books/OL28926462M/Following_in_the_Buddha's_Footsteps","details":{"publishers":["Wisdom Publications"],"source_records":["bwb:9781614296256","promise:bwb_daily_pallets_2024-07-22:W9-AKP-911","marc:harvard_bibliographic_metadata/20220215_001.bib.mrc:69243369:4700"],"title":"Following in the Buddha's Footsteps","number_of_pages":496,"isbn_13":["9781614296256"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BQ4350.B78 2019","BQ4350 .B78 2019"],"publish_date":"2019","key":"/books/OL28926462M","authors":[{"key":"/authors/OL2886A","name":"His Holiness Tenzin Gyatso the XIV Dalai Lama"},{"key":"/authors/OL8044801A","name":"Thubten Chodron"}],"works":[{"key":"/works/OL21355666W"}],"type":{"key":"/type/edition"},"subjects":["Buddhism"],"local_id":["urn:bwbsku:W9-AKP-911"],"lccn":["2019008271"],"oclc_numbers":["1085202496"],"description":{"type":"/type/text","value":"\"The fourth volume of the Dalai Lama's definitive series on the path to awakening, The Three Jewels of Refuge and the Three Higher Trainings, delves into the substance of spiritual practice. You'll first hear His Holiness's explanation of the Buddha, Dharma, and Sangha, why they are reliable guides on the path, and how to relate to them. His Holiness then describes the three essential trainings common to all Buddhist traditions: the higher trainings in ethical conduct, concentration, and wisdom. The chapters on ethical conduct show us how to live a life free of harm to self or others. Those on concentration give us detailed instructions on how to develop single-pointed concentration as well as the higher states of concentration available to an earnest practitioner. The chapters on wisdom contain in-depth teachings on the noble eightfold path and the four establishments of mindfulness for developing greater awareness and understanding of our body, feelings, mind, and other phenomena. Together these topics form the core of Buddhist practice\"--"},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-08-18T01:44:21.209903"},"last_modified":{"type":"/type/datetime","value":"2025-04-14T13:21:29.090718"}}},"ISBN:9781614296263":{"bib_key":"ISBN:9781614296263","info_url":"http://openlibrary.org/books/OL34929692M/Following_in_the_Buddha's_Footsteps","preview":"noview","preview_url":"http://openlibrary.org/books/OL34929692M/Following_in_the_Buddha's_Footsteps","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2886A","name":"His Holiness Tenzin Gyatso the XIV Dalai Lama"},{"key":"/authors/OL8044801A","name":"Thubten Chodron"}],"isbn_13":["9781614296263"],"languages":[{"key":"/languages/eng"}],"publish_date":"2019","publishers":["Wisdom Publications"],"source_records":["bwb:9781614296263"],"title":"Following in the Buddha's Footsteps","pagination":"552","full_title":"Following in the Buddha's Footsteps","works":[{"key":"/works/OL21355666W"}],"key":"/books/OL34929692M","latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2021-10-09T08:37:33.122608"},"last_modified":{"type":"/type/datetime","value":"2023-07-07T19:29:49.620428"}}},"ISBN:9781614299110":{"bib_key":"ISBN:9781614299110","info_url":"http://openlibrary.org/books/OL48783691M/Following_in_the_Buddha's_Footsteps","preview":"noview","preview_url":"http://openlibrary.org/books/OL48783691M/Following_in_the_Buddha's_Footsteps","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL13016669A","name":"Dalai Dalai Lama"},{"key":"/authors/OL8044801A","name":"Thubten Chodron"}],"isbn_13":["9781614299110"],"languages":[{"key":"/languages/eng"}],"pagination":"552","publish_date":"2023","publishers":["Wisdom Publications"],"source_records":["bwb:9781614299110"],"subjects":["Buddhism, doctrines","Buddhism, china, tibet autonomous region"],"t