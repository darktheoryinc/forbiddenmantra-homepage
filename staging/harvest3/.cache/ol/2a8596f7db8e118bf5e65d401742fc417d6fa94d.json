["200.92/2"],"notes":{"type":"/type/text","value":"Proceedings of a conference held Nov. 3-4, 2006 at the University of Chicago Divinity School.\n\nIncludes bibliographical references and index."},"languages":[{"key":"/languages/eng"}],"lccn":["2009018925"],"subjects":["Wach, Joachim, -- 1898-1955 -- Congresses","Eliade, Mircea, -- 1907-1986 -- Congresses","Hermeneutics -- Congresses","Political science -- Congresses","Religion -- Congresses"],"publish_date":"2009","publish_country":"nyu","by_statement":"edited by Christian Wedemeyer and Wendy Doniger.","works":[{"key":"/works/OL16982049W"}],"type":{"key":"/type/edition"},"oclc_numbers":["323161040"],"local_id":["urn:bwbsku:KT-354-785"],"latest_revision":18,"revision":18,"created":{"type":"/type/datetime","value":"2009-05-27T17:31:27.716979"},"last_modified":{"type":"/type/datetime","value":"2026-06-18T09:25:14.111931"}}},"ISBN:9781512603521":{"bib_key":"ISBN:9781512603521","info_url":"http://openlibrary.org/books/OL36238961M/Donigers_of_Great_Neck","preview":"noview","preview_url":"http://openlibrary.org/books/OL36238961M/Donigers_of_Great_Neck","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"isbn_13":["9781512603521"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["F128.9.J5D66 2018","F128.9.J5 D66 2019"],"pagination":"184","publish_date":"2019","publishers":["Brandeis University Press"],"source_records":["bwb:9781512603521","marc:marc_columbia/Columbia-extract-20221130-029.mrc:6152588:2529","marc:harvard_bibliographic_metadata/20220215_005.bib.mrc:287820149:3649"],"subjects":["Jewish women","Authors, biography","New york (state), biography","Jews, united states, biography","Women, united states, biography"],"title":"Donigers of Great Neck","weight":"0.232","subtitle":"A Mythologized Memoir","works":[{"key":"/works/OL26752819W"}],"key":"/books/OL36238961M","oclc_numbers":["1048041103","1098039323"],"description":{"type":"/type/text","value":"\"This is the story of the contrasting Judaisms that Wendy Doniger's two parents brought from their very different homes in Europe during World War I; of their paths to a shared but sharply bifurcated life in America during World War II, her father a publisher, her mother a political activist; and of the ways in which their attitudes to religion in general, and Judaism in particular, influenced the author's development as a Jewish woman and a scholar of religion\"--"},"number_of_pages":172,"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2021-12-29T15:27:59.601451"},"last_modified":{"type":"/type/datetime","value":"2025-06-23T16:37:59.561240"}}},"ISBN:9781512603514":{"bib_key":"ISBN:9781512603514","info_url":"http://openlibrary.org/books/OL38309367M/The_Donigers_of_Great_Neck","preview":"restricted","preview_url":"https://archive.org/details/donigersofgreatn0000wend","thumbnail_url":"https://covers.openlibrary.org/b/id/15230964-S.jpg","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"languages":[{"key":"/languages/eng"}],"pagination":"184","publish_date":"2019","publishers":["Brandeis University Press"],"source_records":["bwb:9781512603514","promise:bwb_daily_pallets_2024-12-05:Y0-BEE-737"],"subjects":["Jewish women","New york (state), biography","Authors, biography","Jews, united states, biography","Women, united states, biography"],"title":"The Donigers of Great Neck","weight":"0.336 ","subtitle":"A Mythologized Memoir","full_title":"Donigers of Great Neck A Mythologized Memoir","works":[{"key":"/works/OL26752819W"}],"key":"/books/OL38309367M","local_id":["urn:bwbsku:Y0-BEE-737"],"identifiers":{},"covers":[15230964],"ocaid":"donigersofgreatn0000wend","isbn_13":["9781512603514"],"lc_classifications":["F128.9.J5D66 2018"],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2022-06-17T21:08:23.568815"},"last_modified":{"type":"/type/datetime","value":"2026-06-18T11:33:12.146303"}}},"ISBN:9780190499280":{"bib_key":"ISBN:9780190499280","info_url":"http://openlibrary.org/books/OL27203385M/Redeeming_the_Kamasutra","preview":"restricted","preview_url":"https://archive.org/details/redeemingkamasut0000doni","thumbnail_url":"https://covers.openlibrary.org/b/id/15230736-S.jpg","details":{"description":{"type":"/type/text","value":"\"The Kamasutra, composed in the third century CE, is the world's most famous textbook of erotic love. There is nothing remotely like it even today, and for its time it was astonishingly sophisticated. Yet it is all but ignored as a serious work in its country of origin-sometimes taken as a matter of national shame rather than pride - and in the rest of the world it is a source of amused amazement and inspires magazine articles that offer \"mattress-quaking sex styles\" such as \"the backstairs boogie\" and \"the spider web\". In this scholarly and superbly readable book, one of the world's foremost authorities on ancient Indian texts seeks to restore the Kamasutra to its proper place in the Sanskrit canon, as a landmark of India's secular literature. She reveals fascinating aspects of the Kamasutra as a guide to the art of living for the cosmopolitan beau monde of ancient India: its emphasis on grooming and etiquette (including post-coital conversation), the study and practice of the arts (ranging from cooking and composing poetry to coloring one's teeth and mixing perfumes), and discretion and patience in conducting affairs (especially adulterous affairs). In its encyclopedic social and psychological narratives, it also displays surprisingly modern ideas about gender and role-playing, female sexuality, and homosexual desire. Even as she draws our attention to the many ways in which the Kamasutra challenges the conventions of its time (and often ours) - in dismissing procreation as the aim of sex, for instance - Doniger also shows us how it perpetuates attitudes that have continued to darken human sexuality: passages that twin passion with violence, for example, and those that explain away women's protests and exclamations of pain as ploys to excite their male partners. In these attitudes, as in its more enlightened observations on sexual love, we see the nearly two-thousand-year-old Kamasutra mirror twenty-first-century realities. In investigating and helping us understand a much celebrated but under-appreciated text, Wendy Doniger has produced a rich and compelling text of her own that will interest, delight, and surprise scholars and lay readers alike\"--\n\n\"In this scholarly and superbly readable book, one of the world's foremost authorities on ancient Indian texts seeks to restore the Kamasutra to its proper place in the Sanskrit canon, as a landmark of India's secular literature. In investigating, and helping us understand, a much celebrated but under-appreciated text, Wendy Doniger has produced a rich and compelling text of her own that will interest, delight, and surprise scholars and lay readers alike\"--"},"notes":{"type":"/type/text","value":"Includes bibliographical references."},"title":"Redeeming the Kamasutra","authors":[{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"publish_date":"2016","table_of_contents":[{"level":0,"title":"The strange and the familiar in the Kamasutra. Class in the Kamasutra ; The life of a man-about-town ; The Kamasutra as a play ; The Kamasutra and the contemporary reader ; The positions","type":{"key":"/type/toc_item"}},{"level":0,"title":"The Kautilyan Kamasutra. The triple set of human aims ; The history of the three texts, and their intertextuality ; The indebtedness of the Kamasutra to the Arthashastra ; Basic similarities of form and argument ; Attitudes to low-life and kings ; Attitudes to other scholars ; Striking points of agreement ; Spying ; Testing ; The need to control the senses ; The Arthashastra and Kamasutra on sex ; Sex and politics","type":{"key":"/type/toc_item"}},{"level":0,"title":"The mythology of the Kamasutra. Mythological background ; Tales told to encourage women ; Tales told to warn men","type":{"key":"/type/toc_item"}},{"level":0,"title":"Women in the Kamasutra. The Kamasutra for women ; Women's rights ; Women's sexuality ; Sexual freedom ; Women's voices","type":{"key":"/type/toc_item"}},{"level":0,"title":"The third nature : gender inversions in the Kamasutra. Traditional and inverted Indian concepts of gender ; Same-sex men ; Sir Richard Burton on the \"third nature\" ; Same-sex women ; Bisexuality","type":{"key":"/type/toc_item"}},{"level":0,"title":"The mare's trap : the nature and culture of sex. Size matters ; The problem of desire ; Positional solutions ; Mechanical and pharmaceutical solutions ; The mare's trap ; Animals and humans : nature and culture ; The culture of the Kamasutra","type":{"key":"/type/toc_item"}},{"level":0,"title":"The rise and fall of Kama and the Kamasutra. Kama in the early history of India ; Detumescence under the British ; Sir Richard Burton's version of the Kamasutra ; The demise of Kama ; The rebirth of Kama.","type":{"key":"/type/toc_item"}}],"isbn_10":["0190499281"],"local_id":["urn:sfpl:31223116592032","urn:sfpl:31223116592040","urn:bwbsku:P8-APM-364"],"lc_classifications":["PK2907.E7 D66 2016","PK2907.E7D66 2016"],"isbn_13":["9780190499280"],"pagination":"182 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:286578878:6264","bwb:9780190499280","marc:marc_columbia/Columbia-extract-20221130-024.mrc:183626913:5589","promise:bwb_daily_pallets_2023-02-10:p8-apm-364","marc:harvard_bibliographic_metadata/20220215_005.bib.mrc:237817447:5324"],"dewey_decimal_class":["891/.2093538"],"languages":[{"key":"/languages/eng"}],"lccn":["2015036282"],"subjects":["Sanskrit Erotic literature","History and criticism"],"subject_people":["Vātsyāyana"],"publish_country":"nyu","by_statement":"Wendy Doniger","oclc_numbers":["922155311"],"type":{"key":"/type/edition"},"publishers":