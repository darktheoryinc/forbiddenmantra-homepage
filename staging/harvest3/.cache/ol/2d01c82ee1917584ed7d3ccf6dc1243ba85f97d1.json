ds":["bwb:9780231502290"],"title":"Selected Poems of du Fu","number_of_pages":128,"isbn_13":["9780231502290"],"created":{"type":"/type/datetime","value":"2020-08-29T12:48:40.082288"},"languages":[{"key":"/languages/eng"}],"full_title":"Selected Poems of du Fu","lc_classifications":[""],"publish_date":"2003","key":"/books/OL29658899M","authors":[{"key":"/authors/OL5472422A","name":"Burton Watson"}],"latest_revision":1,"works":[{"key":"/works/OL21780169W"}],"type":{"key":"/type/edition"},"revision":1}},"ISBN:9780231521215":{"bib_key":"ISBN:9780231521215","info_url":"http://openlibrary.org/books/OL29660368M/Chuang_Tzu","preview":"noview","preview_url":"http://openlibrary.org/books/OL29660368M/Chuang_Tzu","details":{"publishers":["Columbia University Press"],"subtitle":"Basic Writings","last_modified":{"type":"/type/datetime","value":"2020-08-29T13:22:45.720353"},"source_records":["bwb:9780231521215"],"title":"Chuang Tzu","number_of_pages":160,"isbn_13":["9780231521215"],"created":{"type":"/type/datetime","value":"2020-08-29T13:22:45.720353"},"languages":[{"key":"/languages/eng"}],"full_title":"Chuang Tzu Basic Writings","lc_classifications":[""],"publish_date":"1996","key":"/books/OL29660368M","authors":[{"key":"/authors/OL5472422A","name":"Burton Watson"}],"latest_revision":1,"works":[{"key":"/works/OL21780917W"}],"type":{"key":"/type/edition"},"revision":1}},"ISBN:9780231081603":{"bib_key":"ISBN:9780231081603","info_url":"http://openlibrary.org/books/OL1733627M/The_Lotus_Sutra","preview":"noview","preview_url":"http://openlibrary.org/books/OL1733627M/The_Lotus_Sutra","thumbnail_url":"https://covers.openlibrary.org/b/id/144068-S.jpg","details":{"publishers":["Columbia University Press"],"identifiers":{"goodreads":["187304"],"librarything":["160038"]},"series":["Translations from the Asian classics"],"covers":[144068],"lc_classifications":["BQ2052.E5 W38 1993","BQ2052.E5W38 1993"],"key":"/books/OL1733627M","publish_places":["New York"],"contributions":["Watson, Burton, 1925-","Kumārajīva, d. 412?"],"pagination":"xxix, 359 p. ;","source_records":["marc:marc_records_scriblio_net/part22.dat:175256220:901","ia:lotussutra00wats","bwb:9780231081603","marc:marc_loc_2016/BooksAll.2016.part21.utf8:211463334:908","ia:lotussutra0000unse","marc:marc_columbia/Columbia-extract-20221130-009.mrc:503362624:1284","amazon:023108160X","marc:marc_columbia/Columbia-extract-20221130-003.mrc:278379558:4342","marc:harvard_bibliographic_metadata/20220215_001.bib.mrc:128281578:5260","marc:harvard_bibliographic_metadata/ab.bib.02.20150123.full.mrc:763829523:3576"],"title":"The Lotus Sutra","dewey_decimal_class":["294.3/82"],"notes":{"type":"/type/text","value":"Translated from: Miao fa lian hua jing, which was translated from Sanskrit into Chinese by Kumarajiva.\nIncludes index."},"number_of_pages":359,"languages":[{"key":"/languages/eng"}],"lccn":["92038410"],"isbn_10":["023108160X"],"publish_date":"1993","publish_country":"nyu","by_statement":"translated by Burton Watson.","work_title":["Tripiṭaka. Sūtrapiṭaka. Saddharmapuṇḍarīkasūtra. English"],"works":[{"key":"/works/OL18946599W"}],"type":{"key":"/type/edition"},"oclc_numbers":["26930830"],"description":{"type":"/type/text","value":"\"Since its appearance in China in the third century, the Lotus Sutra has been regarded as one of the most illustrious scriptures in the Mahayana Buddhist canon. The object of intense veneration among generations of Buddhists in China, Korea, Japan, and other parts of East Asia, it has attracted more commentary than any other Buddhist scripture and has had a profound impact on the great works of Japanese and Chinese literature.\" \"Conceived as a drama of colossal proportions, the text takes on new meaning in Burton Watson's translation. Depicting events in a cosmic world that transcends ordinary concepts of time and space, the Lotus Sutra presents abstract religious concepts in concrete terms and affirms that there is a single path to enlightenment - that of the bodhisattva - and that the Buddha is not to be delimited in time and space. Filled with striking imagery. memorable parables, and countless revelations concerning the universal accessibility of Buddhahood, the Lotus Sutra has brought comfort and wisdom to devotees over the centuries and stands as a pivotal text in world literature.\" \"As Watson notes, \"The Lotus Sutra is not so much an integral work as a collection of religious texts, an anthology of sermons, stories and devotional manuals, some speaking with particular force to persons of one type or in one set of circumstances, some to those of another type or in other circumstances. This is no doubt one reason why it has had such broad and lasting appeal over the ages and has permeated so deeply into the cultures that have been exposed to it.\"\"--BOOK JACKET."},"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-04-28T03:27:39.314804"}}}}