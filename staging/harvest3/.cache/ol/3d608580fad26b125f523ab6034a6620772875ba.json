"/languages/eng"}],"publish_date":"2007","publish_country":"nyu","works":[{"key":"/works/OL5960247W"}],"type":{"key":"/type/edition"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2010-06-17T01:31:29.134749"},"last_modified":{"type":"/type/datetime","value":"2025-03-28T14:37:39.021928"}}},"ISBN:9780062122841":{"bib_key":"ISBN:9780062122841","info_url":"http://openlibrary.org/books/OL27164164M/Refuge_recovery","preview":"restricted","preview_url":"https://archive.org/details/refugerecoverybu0000levi","thumbnail_url":"https://covers.openlibrary.org/b/id/12579071-S.jpg","details":{"other_titles":["Buddhist path to recovering from addiction"],"table_of_contents":[{"level":0,"title":"The four truths of recovery: Addiction creates suffering ; The cause of addiction is repetitive craving ; Recovery is possible ; The path to recovery ; Understanding ; Intention ;  Communication/community ; Action/engagement ; Livelihood/service ; Effort/energy ; Mindfulness/ meditations ; Concentration/meditations ; The path to heartfulness ; Breaking the addiction","type":{"key":"/type/toc_item"}},{"level":0,"title":"Reflections on recovery: Lynne ; Jordan ; Dave ; Mary ; Pablo ; Enrique ; RuthAnn ; Andrea","type":{"key":"/type/toc_item"}},{"level":0,"title":"Appendixes: Mindfullness meditation instructions ; Heart practices ; Format for Refuge Recovery meetings..","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"Bestselling author and renowned Buddhist teacher Noah Levine adapts the Buddha's Four Noble Truths and Eight Fold Path into a proven and systematic approach to recovery from alcohol and drug addiction--an indispensable alternative to the 12-step program. While many desperately need the help of the 12-step recovery program, the traditional AA model's focus on an external higher power can alienate people who don't connect with its religious tenets. Refuge Recovery is a systematic method based on Buddhist principles, which integrates scientific, non-theistic, and psychological insight. Viewing addiction as cravings in the mind and body, Levine shows how a path of meditative awareness can alleviate those desires and ease suffering. Refuge Recovery includes daily meditation practices, written investigations that explore the causes and conditions of our addictions, and advice and inspiration for finding or creating a community to help you heal and awaken. Practical yet compassionate, Levine's successful Refuge Recovery system is designed for anyone interested in a non-theistic approach to recovery and requires no previous experience or knowledge of Buddhism or meditation."},"isbn_10":["0062122843"],"lc_classifications":["RC533 .L489 2014","HV4998 .L48 2014",""],"key":"/books/OL27164164M","authors":[{"key":"/authors/OL1478961A","name":"Noah Levine"}],"subtitle":"a Buddhist path to recovering from addiction","subjects":["Alternative treatment","Compulsive behavior","Recovering addicts","Life skills guides","Buddhism","Habit breaking","Meditation","Religious life","Therapeutic use"],"edition_name":"First edition.","pagination":"xiv, 273 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:75886752:4126","marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:101639569:4040","bwb:9780062122841","marc:marc_loc_2016/BooksAll.2016.part40.utf8:254073885:1359","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:101697432:4040","ia:refugerecoverybu0000levi","promise:bwb_daily_pallets_2021-08-24"],"title":"Refuge recovery","dewey_decimal_class":["294.3/4442"],"number_of_pages":273,"isbn_13":["9780062122841"],"languages":[{"key":"/languages/eng"}],"lccn":["2013040251"],"local_id":["urn:sfpl:31223107457500","urn:sfpl:31223107457492","urn:cst:10017038349","urn:bwbsku:T2-AWR-854"],"publish_date":"2014","publish_country":"nyu","by_statement":"Noah Levine","oclc_numbers":["859586429"],"works":[{"key":"/works/OL19984036W"}],"type":{"key":"/t