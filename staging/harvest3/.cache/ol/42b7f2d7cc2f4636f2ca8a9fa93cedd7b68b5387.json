0","marc:marc_gtu/KLF IA Export 5-5-22.mrc:77207444:1008","marc:marc_columbia/Columbia-extract-20221130-010.mrc:450155750:2511","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:518290605:797","marc:harvard_bibliographic_metadata/20220215_039.bib.mrc:65212932:3266"],"title":"The woman who pretended to be who she was","url":["http://www.loc.gov/catdir/toc/ecip0415/2004004039.html"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 253-262) and index."},"identifiers":{"librarything":["118186"],"goodreads":["1537946"]},"languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["809/.93353"],"subjects":["Impersonation in literature","Self in literature"],"publish_date":"2005","publish_country":"nyu","by_statement":"Wendy Doniger.","works":[{"key":"/works/OL94344W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/toc/ecip0415/2004004039.html"],"local_id":["urn:gtu:32400007318599"],"oclc_numbers":["54499952"],"description":{"type":"/type/text","value":"\"In this book, noted scholar of Hinduism and mythology Wendy Doniger offers a cross-cultural exploration of the theme of self-impersonation, whose widespread occurrence argues for both its literary power and its human value. The stories she considers range from ancient Indian literature and Shakespeare to Hollywood and Bollywood. They illuminate a basic human way of negotiating reality, illusion, identity, and authenticity, not to mention memory, amnesia, and the process of aging. Many of them involve marriage and adultery, for tales of sexual betrayal cut to the heart of the crisis of identity.\"--BOOK JACKET."},"latest_revision":17,"revision":17,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-06-17T11:46:40.643648"}}},"ISBN:9780195347777":{"bib_key":"ISBN:9780195347777","info_url":"http://openlibrary.org/books/OL28741821M/The_Woman_Who_Pretended_to_Be_Who_She_Was","preview":"noview","preview_url":"http://openlibrary.org/books/OL28741821M/The_Woman_Who_Pretended_to_Be_Who_She_Was","details":{"publishers":["Oxford University Press"],"subtitle":"Myths of Self-Imitation","source_records":["bwb:9780195347777"],"title":"The Woman Who Pretended to Be Who She Was","number_of_pages":304,"languages":[{"key":"/languages/eng"}],"full_title":"Woman Who Pretended to Be Who She Was Myths of Self-Imitation","publish_date":"2004","key":"/books/OL28741821M","authors":[{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"works":[{"key":"/works/OL94344W"}],"type":{"key":"/type/edition"},"identifiers":{},"classifications":{},"isbn_13":["9780195347777"],"lc_classifications":[""],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-08-14T13:43:05.707832"},"last_modified":{"type":"/type/datetime","value":"2021-09-14T12:53:52.633486"}}},"ISBN:9780520031630":{"bib_key":"ISBN:9780520031630","info_url":"http://openlibrary.org/books/OL21123501M/The_origins_of_evil_in_Hindu_mythology","preview":"restricted","preview_url":"https://archive.org/details/originsofevilinh0000ofla","thumbnail_url":"https://covers.openlibrary.org/b/id/15230701-S.jpg","details":{"notes":{"type":"/type/text","value":"Bibliogr.\n\n4"},"identifiers":{"librarything":["1366821"],"goodreads":["3684999"]},"title":"The origins of evil in Hindu mythology","authors":[{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"publish_date":"1976","publishers":["University of California Press"],"isbn_10":["0520031636"],"series":["Hermeneutics studies in the history of religion -- 6"],"covers":[15230701],"lc_classifications":["BJ1401'O35","BJ1401 .O35","BL1100.E9 O34x"],"ocaid":"originsofevilinh0000ofla","publish_places":["Berkeley, CA"],"pagination":"xi, 411 p.","source_records":["marc:marc_laurentian/openlibrary.mrc:355304515:877","amazon:0520031636","ia:originsofevilinh0000ofla","bwb:9780520031630","marc:marc_loc_2016/BooksAll.2016.part09.utf8:42566748:714","marc:marc_columbia/Colu