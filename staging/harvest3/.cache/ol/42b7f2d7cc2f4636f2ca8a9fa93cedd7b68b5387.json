me","value":"2026-06-17T14:27:28.968609"}}},"ISBN:9780028972954":{"bib_key":"ISBN:9780028972954","info_url":"http://openlibrary.org/books/OL7269778M/Other_People's_Myths","preview":"noview","preview_url":"http://openlibrary.org/books/OL7269778M/Other_People's_Myths","details":{"publishers":["Macmillan Pub Co"],"subtitle":"The Cave of Echoes","source_records":["amazon:0028972953:o-1:2035210211:227899","amazon:0028972953:2:1637897911:231734","promise:bwb_daily_pallets_2020-11-24"],"title":"Other People's Myths","identifiers":{"librarything":["47031"],"goodreads":["6839692"]},"isbn_13":["9780028972954"],"languages":[{"key":"/languages/eng"}],"isbn_10":["0028972953"],"publish_date":"September 1990","key":"/books/OL7269778M","authors":[{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"oclc_numbers":["233023259"],"works":[{"key":"/works/OL94342W"}],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"A myth may be, among many other things, the incarnation of a metaphor."},"local_id":["urn:bwbsku:O5-NGH-569"],"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2026-06-18T12:12:30.120475"}}},"ISBN:9780190455101":{"bib_key":"ISBN:9780190455101","info_url":"http://openlibrary.org/books/OL28579842M/On_Hinduism","preview":"noview","preview_url":"http://openlibrary.org/books/OL28579842M/On_Hinduism","details":{"publishers":["Oxford University Press, Incorporated"],"last_modified":{"type":"/type/datetime","value":"2020-08-04T20:47:27.929948"},"source_records":["bwb:9780190455101"],"title":"On Hinduism","number_of_pages":682,"isbn_13":["9780190455101"],"created":{"type":"/type/datetime","value":"2020-08-04T20:47:27.929948"},"languages":[{"key":"/languages/eng"}],"full_title":"On Hinduism","lc_classifications":["BL1210.D66 2016"],"publish_date":"2016","key":"/books/OL28579842M","authors":[{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"latest_revision":1,"works":[{"key":"/works/OL19984035W"}],"type":{"key":"/type/edition"},"subjects":["Hinduism"],"revision":1}},"ISBN:9780199360079":{"bib_key":"ISBN:9780199360079","info_url":"http://openlibrary.org/books/OL27164163M/On_Hinduism","preview":"restricted","preview_url":"https://archive.org/details/onhinduism0000doni","thumbnail_url":"https://covers.openlibrary.org/b/id/15230733-S.jpg","details":{"description":"\"In this magisterial volume of essays, Wendy Doniger enhances our understanding of the ancient and complex religion to which she has devoted herself for half a century. This series of interconnected essays and lectures surveys the most critically important and hotly contested issues in Hinduism over 3,500 years, from the ancient time of the Vedas to the present day. The essays contemplate the nature of Hinduism; Hindu concepts of divinity; attitudes concerning gender, control, and desire; the question of reality and illusion; and the impermanent and the eternal in the two great Sanskrit epics, the Ramayana and the Mahabharata. Among the questions Doniger considers are: Are Hindus monotheists or polytheists? How can atheists be Hindu, and how can unrepentant Hindu sinners find salvation? Why have Hindus devoted so much attention to the psychology of addiction? What does the significance of dogs and cows tell us about Hinduism? How have Hindu concepts of death, rebirth, and karma changed over the course of history? How and why does a pluralistic faith, remarkable for its intellectual tolerance, foster religious intolerance? Doniger concludes with four concise autobiographical essays in which she reflects on her lifetime of scholarship, Hindu criticism of her work, and the influence of Hinduism on her own philosophy of life. On Hinduism is the culmination of over forty years of scholarship from a renowned expert on one of the world's great faiths\"--","local_id":["urn:sfpl:31223107463615"],"full_title":"On Hinduism","key":"/books/OL27164163M","authors":[{"key