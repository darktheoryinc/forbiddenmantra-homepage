ributions":["Cleary, Thomas F., 1949-"],"pagination":"x, 121 p. ;","source_records":["ia:bookofleadership0000huai","bwb:9780877736677","marc:marc_loc_2016/BooksAll.2016.part21.utf8:33108287:996","marc:harvard_bibliographic_metadata/ab.bib.02.20150123.full.mrc:645423501:1855","marc:harvard_bibliographic_metadata/20220215_033.bib.mrc:90274374:2279"],"title":"The Book of leadership and strategy","dewey_decimal_class":["181/.114"],"notes":{"type":"/type/text","value":"Translation of: Huai-nan tzu.\nOriginally published under title: The Tao of politics."},"number_of_pages":121,"languages":[{"key":"/languages/eng"}],"lccn":["91053226"],"isbn_10":["0877736677"],"publish_date":"1992","publish_country":"mau","by_statement":"translations from the Taoist classic Huainanzi by Thomas Cleary.","work_title":["Huai-nan tzu."],"works":[{"key":"/works/OL4127482W"}],"type":{"key":"/type/edition"},"oclc_numbers":["25634444"],"description":{"type":"/type/text","value":"The subtle arts of management and leadership have been developed over thousands of years by the Chinese. The Book of Leadership and Strategy represents the Taoist culmination of this long tradition and is one of the most prestigious works of ancient Chinese thought. Collected here are insightful teachings on the challenges of leadership on all levels, from organizational management to political statecraft. The translator, Thomas Cleary, has chosen and arranged these teachings to emphasize the most valuable lessons of Taoist wisdom for modern Western readers. Like Cleary's best-selling translation of The Art of War by Sun Tzu, this work will serve as an enlightening guide for people in business, politics, and government. -- from back cover."},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-03-21T03:07:58.138698"}}},"ISBN:9780877733638":{"bib_key":"ISBN:9780877733638","info_url":"http://openlibrary.org/books/OL