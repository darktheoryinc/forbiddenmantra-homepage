48.088569"}}},"ISBN:9780712635219":{"bib_key":"ISBN:9780712635219","info_url":"http://openlibrary.org/books/OL21664817M/The_book_of_balance_and_harmony","preview":"noview","preview_url":"http://openlibrary.org/books/OL21664817M/The_book_of_balance_and_harmony","details":{"publishers":["Rider"],"number_of_pages":153,"isbn_10":["0712635211"],"lc_classifications":["BL1920"],"key":"/books/OL21664817M","authors":[{"key":"/authors/OL6322488A","name":"Daoqun Li"}],"contributions":["Cleary, Thomas, 1949-"],"pagination":"xxxii,153p.","title":"The book of balance and harmony","dewey_decimal_class":["299.514"],"identifiers":{"librarything":["928328"]},"languages":[{"key":"/languages/eng"}],"subjects":["Taoism."],"publish_date":"1990","publish_country":"xxk","by_statement":"translation and introduction by Thomas Cleary.","works":[{"key":"/works/OL13437522W"}],"type":{"key":"/type/edition"},"source_records":["bwb:9780712635219"],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2008-11-03T13:07:58.219851"},"last_modified":{"type":"/type/datetime","value":"2022-11-17T22:00:54.633853"}}},"ISBN:9781556431937":{"bib_key":"ISBN:9781556431937","info_url":"http://openlibrary.org/books/OL1100224M/Instant_Zen","preview":"noview","preview_url":"http://openlibrary.org/books/OL1100224M/Instant_Zen","thumbnail_url":"https://covers.openlibrary.org/b/id/777351-S.jpg","details":{"publishers":["North Atlantic Books"],"identifiers":{"goodreads":["238883"],"librarything":["446540"]},"subtitle":"waking up in the present","isbn_10":["1556431937"],"covers":[777351],"lc_classifications":["BQ9265 .C45725813 1994","BQ9265.C4572513 1994"],"key":"/books/OL1100224M","authors":[{"key":"/authors/OL583326A","name":"Chʻing-yüan"}],"publish_places":["Berkeley, CA"],"contributions":["Cleary, Thomas F., 1949-"],"pagination":"xix, 137 p. ;","source_records":["bwb:9781556431937","marc:marc_loc_2016/BooksAll.2016.part23.utf8:135029345:1112","marc:marc_columbia/Columbia-extract-20221130-004.mrc:45516218:2550"],"title":"Instant Zen","dewey_decimal_class":["294.3/927"],"notes":{"type":"/type/text","value":"Includes bibliographical references (115-131).\n\"This book contains translations of general lectures on Zen by Foyan (1067-1120)\"--P. xviii."},"number_of_pages":137,"languages":[{"key":"/languages/eng"}],"lccn":["94025026"],"subjects":["Zen Buddhism -- Early works to 1800."],"publish_date":"1994","publish_country":"cau","by_statement":"translated by Thomas Cleary.","work_title":["Selections."],"works":[{"key":"/works/OL3493044W"}],"type":{"key":"/type/edition"},"oclc_numbers":["30624351"],"description":{"type":"/type/text","value":"Instant Zen presents the teachings of Foyan, a twelfth-century Chinese Zen master recognized as one of the greatest masters of the Song dynasty Zen renaissance in China. Returning to the uncomplicated genuineness of the original and classical Zen masters, Foyan offers many simple exercises in attention and thought designed to lead to the awakening of Zen insight into the real nature of the self.\n\nThese succinct teachings emphasize independence and autonomy, and show us how to open our own eyes and stand on our own two feet, to see directly without delusion and act on truth without confusion.\n\nTranslator Thomas Cleary provides an incisive introduction and extensive references from traditional Zen sources, placing the work in both historical and contemporary contexts. Newcomers to Zen will find this book a useful and sophisticated introduction to authentic inner Zen practices from an impeccable source, without cultural exoticism or religious cultism.\n\nInstant Zen sheds new light on this vital tradition, making available the immediacy of Zen practice and unveiling our innate potential for conscious awakening."},"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-07-14T22:12:54.822912"}}},"ISBN:9781556432002":{"