rks/OL27051889W"}],"key":"/books/OL37187872M","latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2022-02-26T22:28:51.979886"},"last_modified":{"type":"/type/datetime","value":"2024-04-10T04:34:38.233106"}}},"ISBN:9780857739636":{"bib_key":"ISBN:9780857739636","info_url":"http://openlibrary.org/books/OL60820014M/Wisdom_of_Tolerance","preview":"noview","preview_url":"http://openlibrary.org/books/OL60820014M/Wisdom_of_Tolerance","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL15058132A","name":"Daisaku Ikeda"},{"key":"/authors/OL84560A","name":"Abdurrahman Wahid"}],"dewey_decimal_class":["297.2843"],"isbn_13":["9780857739636"],"languages":[{"key":"/languages/eng"}],"number_of_pages":160,"publish_date":"2015","publishers":["I. B. Tauris & Company, Limited"],"source_records":["bwb:9780857739636"],"title":"Wisdom of Tolerance","subtitle":"A Philosophy of Generosity and Peace","full_title":"Wisdom of Tolerance A Philosophy of Generosity and Peace","works":[{"key":"/works/OL27051889W"}],"key":"/books/OL60820014M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2025-12-12T19:22:25.283332"},"last_modified":{"type":"/type/datetime","value":"2025-12-12T19:22:25.283332"}}},"ISBN:9781784530921":{"bib_key":"ISBN:9781784530921","info_url":"http://openlibrary.org/books/OL36677200M/The_Wisdom_of_Tolerance","preview":"noview","preview_url":"http://openlibrary.org/books/OL36677200M/The_Wisdom_of_Tolerance","thumbnail_url":"https://covers.openlibrary.org/b/id/12563941-S.jpg","details":{"type":{"key":"/type/edition"},"title":"The Wisdom of Tolerance","authors":[{"key":"/authors/OL84560A","name":"Abdurrahman Wahid"},{"key":"/authors/OL3930531A","name":"Daisaku Ikéda"}],"publish_date":"Jun 30, 2015","source_records":["amazon:1784530921","bwb:9781784530921","marc:marc_columbia/Columbia-extract-20221130-023.mrc:150082510:3966","marc:marc_bloomsbury/2025MAR_bloomsbury.mrc:29984631:3911","marc:harvard_bibliographic_metadata/20220215_010.bib.mrc:28385982:4091"],"number_of_pages":192,"publishers":["I.B.Tauris"],"isbn_10":["1784530921"],"isbn_13":["9781784530921"],"physical_format":"paperback","full_title":"The Wisdom of Tolerance : A Philosophy of Generosity and Peace","subtitle":"A Philosophy of Generosity and Peace","notes":{"type":"/type/text","value":"Source title: The Wisdom of Tolerance: A Philosophy of Generosity and Peace"},"covers":[12563941],"works":[{"key":"/works/OL27051889W"}],"key":"/books/OL36677200M","lc_classifications":["BP173.B9","BP173.B9 W34 2015","BP173.B9 I34 2015"],"oclc_numbers":["909313570","1158579576"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"\"What do Buddhism and Islam have in common? And what positive characteristics might Buddhist Japan and Muslim Indonesia be able to offer one another? In this thoughtful and wide-ranging discussion which draws on creative artists and thinkers as diverse as Beethoven, Goethe, Tolstoy, Thomas Jefferson and Akira Kurosawa distinguished representatives from each country demonstrate that meaningful dialogue between religions and cultures begins with a one-to-one conversation between individuals. Addressing the similarities of their nations as island peoples, with a shared history of trade and cultural exchange, Abdurrahman Wahid and Daisaku Ikeda agree that the aim of dialogue, like that of Buddhism and Islam alike, is fundamentally the goal of peace.  A pivotal moment in the conversation comes when reference is made to the Indonesian story of the Bamboo Princess, from the Chronicle of the Kings of Pasai; this is seen to bear close resemblance to the Japanese Taketori Monogatari, or 'Tale of the Bamboo Cutter'. Such narrative interrelationship which can be discerned even in the midst of religious and cultural distinctiveness emerges as a powerful symbol of the common humanity not just of Indonesia and Japan but of all cultures. Both thinkers continue to draw on their respective traditions, on their personal experiences of war and adversity, and especially on the lives of the Buddha and the Prophet Mohammed, to show that harmony springs from an attitude of tolerance and nonviolence which is where true courage resides. Whether masterfully expounding the teachings of Nichiren, or indicating that a proper understanding of jihad is not about religious conflict but about communicating the truth of Allah, the discussants mutually transform our understandings of value, pluralism, and amity.\"--Bloomsbury Publishing."},"identifiers":{"doi":["10.5040/9780755624348"]},"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2022-01-19T02:54:07.397953"},"last_modified":{"type":"/type/datetime","value":"2025-07-14T23:29:47.031628"}}},"ISBN:9781938252211":{"bib_key":"ISBN:9781938252211","info_url":"http://openlibrary.org/books/OL39287742M/Soka_Education","preview":"noview","preview_url":"http://openlibrary.org/books/OL39287742M/Soka_Education","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL3930531A","name":"Daisaku Ikéda"},{"key":"/authors/OL10437602A","name":"Kazanjian, Victor, Jr."}],"isbn_13":["9781938252211"],"languages":[{"key":"/languages/eng"}],"pagination":"256","publish_date":"2012","publishers":["Middleway Press"],"source_records":["bwb:9781938252211"],"subjects":["Education, philosophy","Buddhism","Religious education"],"title":"Soka Education","subtitle":"For the Happiness of the Individual","full_title":"Soka Education For the Happiness of the Individual","works":[{"key":"/works/OL27979670W"}],"key":"/books/OL39287742M","latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2022-08-17T19:11:04.007003"},"last_modified":{"type":"/type/datetime","value":"2024-04-10T04:34:38.233106"}}},"ISBN:9781938252228":{"bib_key":"ISBN:9781938252228","info_url":"http://openlibrary.org/books/OL38843194M/Soka_Education","preview":"noview","preview_url":"http://openlibrary.org/books/OL3884319