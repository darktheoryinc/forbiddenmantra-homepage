key":"/works/OL464661W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/bios/ucal052/99033553.html","http://www.loc.gov/catdir/description/ucal042/99033553.html"],"oclc_numbers":["41712596"],"description":{"type":"/type/text","value":"\"The Sandokai - a poem by the eighth-century Zen master Sekito Kisen (Ch. Shitou Xiqian) - is the subject of these talks given by Shunryu Suzuki Roshi, author of the influential Zen Mind, Beginner's Mind. Delivered in 1970 at Tassajara Zen Mountain Center, the teachings reveal a Zen teacher in his prime elucidating for his Western students a venerated, ancient, and difficult work, one of the core texts of Zen.\n\nThe poem addresses the question of how the oneness of things and the multiplicity of things coexist (or, as Suzuki Roshi expresses this complex thought, \"things-as-it-is\"). Included with the talks are questions from students and his direct answers to them, along with a meditation instruction.\"--BOOK JACKET."},"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-03-28T15:26:37.378618"}}},"ISBN:9781574532753":{"bib_key":"ISBN:9781574532753","info_url":"http://openlibrary.org/books/OL8741729M/Contemporary_Zen_Classics","preview":"noview","preview_url":"http://openlibrary.org/books/OL8741729M/Contemporary_Zen_Classics","thumbnail_url":"https://covers.openlibrary.org/b/id/826896-S.jpg","details":{"identifiers":{"goodreads":["221868"],"librarything":["458375"]},"title":"Contemporary Zen Classics","subtitle":"The 3 Pillars of Zen, Zen Mind, Beginners Mind, Zen Fresh, Zen Bones (Classic Zen)","authors":[{"key":"/authors/OL2643448A","name":"Roshi Philip Kapleau"},{"key":"/authors/OL27128A","name":"Shunryū Suzuki"}],"publish_date":"April 1998","publishers":["Audio Literature"],"weight":"1 pounds","covers":[826896],"physical_format":"Audio cassette","contributions":["Paul Reps (Compiler)","Peter Coyote (Na