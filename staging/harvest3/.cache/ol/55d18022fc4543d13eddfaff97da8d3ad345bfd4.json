orms. Some 200 poems, illustrating the most important formal, stylistic, and thematic developments in the growth of shih poetry, are presented here in new translations by Burton Watson. The accompanying background material - critical, historical, or biograhoical - is given in notes to particular poems or in brief essays reating to a group of poems.\" --Back cover."},"latest_revision":17,"revision":17,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-08-31T12:10:11.561442"}}},"ISBN:9780231034654":{"bib_key":"ISBN:9780231034654","info_url":"http://openlibrary.org/books/OL9378972M/Chinese_Lyricism","preview":"restricted","preview_url":"https://archive.org/details/chineselyricism00burt","thumbnail_url":"https://covers.openlibrary.org/b/id/4969591-S.jpg","details":{"publishers":["Columbia University Press"],"identifiers":{"librarything":["374311"],"goodreads":["6024"]},"weight":"10.6 ounces","covers":[4969591],"physical_format":"Paperback","lc_classifications":["PL2307"],"latest_revision":9,"key":"/books/OL9378972M","authors":[{"key":"/authors/OL1013996A","name":"Burton Watson"}],"ocaid":"chineselyricism00burt","subjects":["Literary studies: general","Anthologies (multiple authors)","Literary Criticism & Collections / Asian","Chinese","Poetry"],"isbn_13":["9780231034654"],"source_records":["bwb:9780231034654"],"title":"Chinese Lyricism","number_of_pages":232,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"languages":[{"key":"/languages/eng"}],"isbn_10":["0231034652"],"publish_date":"April 15, 1971","last_modified":{"type":"/type/datetime","value":"2020-10-07T18:33:53.877838"},"works":[{"key":"/works/OL4812574W"}],"type":{"key":"/type/edition"},"physical_dimensions":"8.9 x 5.8 x 0.5 inches","revision":9}},"ISBN:9781938252136":{"bib_key":"ISBN:9781938252136","info_url":"http://openlibrary.org/books/OL38841216M/Living_Buddha","preview":"noview","preview_url":"http://openl