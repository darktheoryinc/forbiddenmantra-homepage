es/eng"}],"lccn":["97061460"],"subjects":["Dōgen, 1200-1253","Sōtōshū -- Doctrines"],"publish_date":"1997","publish_country":"mau","by_statement":"by Kōshō Uchiyama Roshi ; translations by Shohaku Okumura and Taigen Dan Leighton ; introduction by Shohaku Okumura.","works":[{"key":"/works/OL2758680W"}],"type":{"key":"/type/edition"},"ocaid":"wholeheartedwayt0000uchi","local_id":["urn:bwbsku:W7-ANN-696"],"oclc_numbers":["38190728"],"description":{"type":"/type/text","value":"Zen Master Dogen's Bendowa is one of the primary texts on Zen practice. Transcending any particular school of Buddhism or religious belief, Dogen's profound and poetic writings are respected as a pinnacle of world spiritual literature.\n\nBendowa, or \"A Talk on the Wholehearted Practice of the Way,\" was written in 1231 and expresses Dogen's teaching of the essential meaning of zazen (seated meditation) and its actual practice. Included in this edition is an introduction by Reverend Shohaku Okumura, Director of the North American Soto School in Los Angeles."},"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-01-09T06:02:08.441390"}}},"ISBN:9780964378810":{"bib_key":"ISBN:9780964378810","info_url":"http://openlibrary.org/books/OL11708223M/Zen_Master_Eihei_Dogen's_Monastic_Regulations_(The_Institute's_Series_Number_1)","preview":"noview","preview_url":"http://openlibrary.org/books/OL11708223M/Zen_Master_Eihei_Dogen's_Monastic_Regulations_(The_Institute's_Series_Number_1)","details":{"identifiers":{"goodreads":["3066828"]},"title":"Zen Master Eihei Dogen's Monastic Regulations (The Institute's Series Number 1)","authors":[{"key":"/authors/OL2782083A","name":"Dōgen Zenji"}],"publish_date":"December 1993","publishers":["North Amer Inst of Zen & Buddhist"],"physical_format":"Hardcover","contributions":["Sakurai Shuyu (Foreword)","Donin Minamizawa (Corporate Author)","Shohei Ichimura (Editor, Translator)"],"isbn_13":["9780964378810"],"languages":[{"key":"/languages/eng"}],"isbn_10":["0964378817"],"type":{"key":"/type/edition"},"subjects":["Religion"],"source_records":["amazon:0964378817"],"key":"/books/OL11708223M","works":[{"key":"/works/OL8358231W"}],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2008-04-30T20:50:18.033121"},"last_modified":{"type":"/type/datetime","value":"2026-01-20T07:12:00.895709"}}},"ISBN:9780804831079":{"bib_key":"ISBN:9780804831079","info_url":"http://openlibrary.org/books/OL704862M/The_Zen_poetry_of_Dōgen","preview":"borrow","preview_url":"https://archive.org/details/zenpoetryofdogen0000doge","thumbnail_url":"https://covers.openlibrary.org/b/id/578659-S.jpg","details":{"publishers":["Tuttle"],"number_of_pages":183,"subtitle":"verses from the Mountain of Eternal Peace","isbn_10":["0804831076"],"covers":[578659],"lc_classifications":["PL792.D65 A25 1997","PL792.D65A25 1997"],"key":"/books/OL704862M","authors":[{"key":"/authors/OL2782083A","name":"Dōgen Zenji"}],"publish_places":["Boston, Mass"],"contributions":["Heine, Steven, 1950-"],"languages":[{"key":"/languages/eng"}],"pagination":"viii, 183 p. :","source_records":["marc:marc_loc_2016/BooksAll.2016.part26.utf8:79366001:1011","bwb:9780804831079","ia:zenpoetryofdogen0000doge","promise:bwb_daily_pallets_2021-05-14","marc:marc_columbia/Columbia-extract-20221130-005.mrc:122275278:2146","marc:harvard_bibliographic_metadata/20220215_020.bib.mrc:230596533:1820"],"title":"The Zen poetry of Dōgen","dewey_decimal_class":["895.6/122"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [161]-183).\n\"... contains a complete translation of Dōgen's collection of ... Japanese poetry [and] ... selection of his Chinese verse ...\"--p. [vii]."},"identifiers":{"librarything":["1025074"],"goodreads":["1473422"]},"edition_name":"1st ed.","lccn":["97061734"],"subjects":["Dōgen, 1200-1253 -- Translations into English.","Zen poetry."],"publish_date":"1997","publish_country":"mau","by_statement":"Steven Heine.","oclc_numbers":["38077354"],"works":[{"key":"/works/OL1963428W"}],"type":{"key":"/type/edition"},"ocaid":"zenpoetryofdogen0000doge","local_id":["urn:bwbsku:O7-BRT-208"],"description":{"type":"/type/text","value":"Although best known for zazen meditation, Dogen felt that poetry could act as a complement to the enlightenment experience, and this collection beautifully confirms this belief. Dogen scholar Steven Heine provides clear and revealing translations that capture Dogen's unique voice, echoing the master's Zen naturalist and aesthetic philosophy. More than a collection of enlightened poetry, this collection will appeal to both students and non-students of Buddhism alike."},"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-11-01T05:00:57.846276"}}}}