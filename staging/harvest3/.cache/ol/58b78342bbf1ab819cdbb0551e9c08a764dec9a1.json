reads":["1144208"],"librarything":["6135"]},"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"languages":[{"key":"/languages/eng"}],"isbn_10":["0195173104"],"publish_date":"January 16, 2004","last_modified":{"type":"/type/datetime","value":"2020-10-08T11:18:04.393307"},"works":[{"key":"/works/OL29054W"}],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"Since the Scientific Revolution, claims have been made about science and on behalf of science that include not only scientific but philosophical and theological assertions."},"revision":8}},"ISBN:9780195132076":{"bib_key":"ISBN:9780195132076","info_url":"http://openlibrary.org/books/OL15555109M/The_taboo_of_subjectivity","preview":"borrow","preview_url":"https://archive.org/details/tabooofsubjectiv00wall","thumbnail_url":"https://covers.openlibrary.org/b/id/7940587-S.jpg","details":{"publishers":["Oxford University Press"],"number_of_pages":218,"subtitle":"toward a new science of consciousness","isbn_10":["0195132076"],"covers":[7940587],"lc_classifications":["BL240.2 .W27 2000","BL240.2.W27 2000"],"key":"/books/OL15555109M","authors":[{"key":"/authors/OL26553A","name":"B. Alan Wallace"}],"ocaid":"tabooofsubjectiv00wall","publish_places":["New York"],"pagination":"x, 218 p. ;","source_records":["marc:marc_western_washington_univ/wwu_bibs.mrc_revrev.mrc:827892223:861","marc:marc_loc_updates/v35.i21.records.utf8:5798360:956","ia:tabooofsubjectiv00wall","ia:taboosubjectivit00wall","ia:taboosubjectivit00wall_318","bwb:9780195132076","marc:marc_loc_2016/BooksAll.2016.part28.utf8:12008196:956","marc:marc_columbia/Columbia-extract-20221130-006.mrc:279446873:1259","marc:harvard_bibliographic_metadata/20220215_014.bib.mrc:134884188:3041"],"title":"The taboo of subjectivity","lccn":["99044840"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 197-208) and index."},"identifiers":{"goodreads":["1890707"],"librarything":["6135"]},"languages":[{"key":"/languages/eng"}],"subjects":["Religion and science","Materialism","Consciousness"],"publish_date":"2000","publish_country":"nyu","by_statement":"B. Alan Wallace.","oclc_numbers":["42080364","50662527"],"works":[{"key":"/works/OL29054W"}],"type":{"key":"/type/edition"},"description":{"type":"/type/text","value":"\"This book takes a new look at ways of exploring the nature, origins, and potentials of consciousness within the context of science and religion. Alan Wallace draws careful distinctions between four elements of the scientific tradition: science itself, scientific realism, scientific materialism, and scientism. Arguing that the metaphysical doctrine of scientific materialism has taken on the role of ersatz-religion for its adherents, he traces its development from its Greek and Judeo-Christian origins, focusing on the interrelation between the Protestant Reformation and the Scientific Revolution.\"\n\n\"Wallace argues that the metaphysical principles of scientific materialism have long impeded scientific research into subjective states of awareness, including the nature of consciousness itself. Drawing on the writings of William James, Hilary Putnam, Augustine, and Indian Buddhist contemplatives such as Buddhaghosa, Asanga, and Padmasambhava, he presents a theoretical framework and mode of inquiry into human consciousness that combines both extraspective and introspective methods of research.\"\n\n\"In exploring the nature of consciousness, this study will help to bridge the chasm between religious belief and scientific knowledge. It is essential reading for philosophers and historians of science, scholars of religion, and anyone interested in the relationship between science and religion.\"--Jacket."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-09-20T12:57:21.278982"},"last_modified":{"type":"/type/datetime","value":"2025-08-17T01:05:48.964812"}}},"ISBN:9781280472893":{"bib_key":"ISBN:9781280472893","info_url":"http: