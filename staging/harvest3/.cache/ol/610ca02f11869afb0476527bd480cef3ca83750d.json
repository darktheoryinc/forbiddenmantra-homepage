my","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL234641A","name":"Livia Kohn"}],"isbn_13":["9781931483445"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["BL1923.K6858 2020","BL1923 .K6858 2020"],"publish_date":"2020","publishers":["Three Pines Press"],"source_records":["bwb:9781931483445","marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:115986276:4064"],"subjects":["Religion"],"title":"Zhong-Lü System of Internal Alchemy","pagination":"270","works":[{"key":"/works/OL25901928W"}],"key":"/books/OL34956331M","lccn":["2019057946"],"oclc_numbers":["1147929457"],"description":{"type":"/type/text","value":"\"This book contains a translation and in-depth study of two major texts of internal alchemy, attributed to two well-known immortals, Zhongli Quan and Lu  Dongbin, founders of the so-called Zhong Lu  tradition, which presents the first major formal structuring of internal alchemy and goes back to the 12th century. The first text entitled \"Transmission of the Dao from Zhongli to Lu ,\" provides keys to understanding energetic transmutation with particular steps and methods corresponding to the mechanism of the universe. It provides the basis of all of internal alchemy. The second text is the \"Conclusive Methods of Numinous Treasure,\" written in a more symbolic language and focusing more on specific practices. In addition to the translations, the book describes with simple clarity the major conceptions of cosmology, transmutations systems and key practices. These practices are accessible to all and these two texts which specialists had nod previously paid attention enough, are likely to become essential writings for anyone interested in the history of internal alchemy and for any practitioner of Daoism\"--"},"number_of_pages":262,"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2021-10-09T13:14:35.441541"},"last_modified":{"type":"/type/datetime","value":"2025-05-17T09:13:21.222125"}}},"ISBN