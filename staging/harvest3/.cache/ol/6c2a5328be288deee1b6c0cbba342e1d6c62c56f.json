n, CT"],"isbn_13":["9780300144857"],"pagination":"p. cm.","source_records":["marc:marc_loc_updates/v36.i44.records.utf8:9674899:1056","marc:marc_loc_updates/v38.i01.records.utf8:3124308:1297","marc:marc_loc_updates/v38.i02.records.utf8:8819213:1303","marc:marc_loc_updates/v38.i03.records.utf8:5255895:1303","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:44104230:2389","bwb:9780300144857","marc:marc_loc_2016/BooksAll.2016.part35.utf8:148345045:1303","marc:marc_columbia/Columbia-extract-20221130-015.mrc:71796792:1596","amazon:0300144857","marc:harvard_bibliographic_metadata/ab.bib.11.20150123.full.mrc:871870505:1290","marc:harvard_bibliographic_metadata/20220215_002.bib.mrc:211200551:3727"],"title":"Blood and mistletoe","dewey_decimal_class":["299/.160941"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"identifiers":{"goodreads":["6343114"],"librarything":["8205799"]},"languages":[{"key":"/languages/eng"}],"lccn":["2008044642"],"subjects":["Druids and druidism -- History","Great Britain -- Religion"],"publish_date":"2009","publish_country":"ctu","by_statement":"Ronald Hutton.","works":[{"key":"/works/OL15335148W"}],"type":{"key":"/type/edition"},"oclc_numbers":["262432289"],"covers":[13586857],"number_of_pages":492,"description":{"type":"/type/text","value":"Crushed by the Romans in the first century A.D., the ancient Druids of Britain left almost no reliable evidence behind. Because of this, historian Ronald Hutton shows, succeeding British generations have been free to reimagine, reinterpret, and reinvent the Druids. Huttonʹs captivating book is the first to encompass two thousand years of Druid history and to explore the evolution of English, Scottish, and Welsh attitudes toward the forever ambiguous figures of the ancient Celtic world. Druids have been remembered at different times as patriots, scientists, philosophers, or priests; sometimes portrayed as corrupt, bloodthirsty, or ignorant, they were also seen as fomenters of rebellion. Hutton charts how the Druids have been written in and out of history, archaeology, and the public consciousness for some 500 years, with particular focus on the romantic period, when Druids completely dominated notions of British prehistory. Sparkling with legends and images, filled with new perspectives on ancient and modern times, this book is a fascinating cultural study of Druids as catalysts in British history. -- Publisher description."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-12-11T17:01:39.600253"},"last_modified":{"type":"/type/datetime","value":"2025-04-30T15:41:40.240013"}}},"ISBN:9780300170856":{"bib_key":"ISBN:9780300170856","info_url":"http://openlibrary.org/books/OL27667018M/Blood_and_Mistletoe","preview":"noview","preview_url":"http://openlibrary.org/books/OL27667018M/Blood_and_Mistletoe","thumbnail_url":"https://covers.openlibrary.org/b/id/9109076-S.jpg","details":{"publishers":["Yale University Press"],"number_of_pages":492,"subtitle":"The History of the Druids in Britain","covers":[9109076],"physical_format":"paperback","full_title":"Blood and Mistletoe The History of the Druids in Britain","lc_classifications":["BL910.H88 2011"],"key":"/books/OL27667018M","authors":[{"key":"/authors/OL27813A","name":"Ronald Hutton"}],"source_records":["amazon:0300170858","bwb:9780300170856","promise:bwb_daily_pallets_2023-05-16:KS-026-314"],"title":"Blood and Mistletoe","notes":{"type":"/type/text","value":"Source title: Blood and Mistletoe: The History of the Druids in Britain"},"identifiers":{"amazon":["0300170858"]},"isbn_13":["9780300170856"],"isbn_10":["0300170858"],"publish_date":"May 24, 2011","works":[{"key":"/works/OL15335148W"}],"type":{"key":"/type/edition"},"local_id":["urn:bwbsku:KS-026-314"],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2019-11-10T13:22:31.475218"},"last_modified":{"type":"/type/datetime","value":"2023-05-18T01:37