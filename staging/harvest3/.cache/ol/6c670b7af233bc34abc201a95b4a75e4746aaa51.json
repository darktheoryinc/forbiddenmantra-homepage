03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-09-03T16:36:26.320539"}}},"ISBN:9780192854476":{"bib_key":"ISBN:9780192854476","info_url":"http://openlibrary.org/books/OL7384570M/The_Rise_and_Fall_of_Merry_England","preview":"noview","preview_url":"http://openlibrary.org/books/OL7384570M/The_Rise_and_Fall_of_Merry_England","thumbnail_url":"https://covers.openlibrary.org/b/id/119956-S.jpg","details":{"publishers":["Oxford University Press, USA"],"identifiers":{"goodreads":["3190835"],"librarything":["105667"]},"subtitle":"The Ritual Year 1400-1700","covers":[119956],"lc_classifications":[""],"key":"/books/OL7384570M","authors":[{"key":"/authors/OL27813A","name":"Ronald Hutton"}],"isbn_13":["9780192854476"],"source_records":["bwb:9780192854476"],"title":"The Rise and Fall of Merry England","number_of_pages":378,"languages":[{"key":"/languages/eng"}],"isbn_10":["019285447X"],"publish_date":"January 27, 2005","works":[{"key":"/works/OL31768W"}],"type":{"key":"/type/edition"},"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2022-11-01T14:46:40.076525"}}},"ISBN:9780198203636":{"bib_key":"ISBN:9780198203636","info_url":"http://openlibrary.org/books/OL1431614M/The_rise_and_fall_of_merry_England","preview":"borrow","preview_url":"https://archive.org/details/risefallofmerrye0000hutt","thumbnail_url":"https://covers.openlibrary.org/b/id/129254-S.jpg","details":{"publishers":["Oxford University Press"],"identifiers":{"librarything":["105667"],"goodreads":["2260643"]},"subtitle":"the ritual year, 1400-1700","isbn_10":["0198203632"],"subject_place":["England","England."],"covers":[129254],"lc_classifications":["DA320 .H87 1994","DA320.H87 1994"],"key":"/books/OL1431614M","authors":[{"key":"/authors/OL27813A","name":"Ronald Hutton"}],"ocaid":"risefallofmerrye0000hutt","publish_places":["Oxford","New York"],"subjects":["Rites and ceremonies, Medieval -- England","Social history -- Medieval, 500-1500","Popular culture -- England -- History","Calendar -- England -- History","Folklore -- England -- History","Ritual","England -- Social life and customs -- 16th century","England -- Social life and customs -- 17th century","England -- Social life and customs -- 1066-1485"],"subject_time":["Medieval, 500-1500.","16th century.","17th century.","1066-1485."],"pagination":"xi, 366 p. :","source_records":["marc:marc_records_scriblio_net/part23.dat:128538436:1127","marc:marc_loc_updates/v35.i21.records.utf8:3296166:1293","marc:OpenLibraries-Trent-MARCs/lbrn.mrc:2042832:850","ia:risefallofmerrye0000hutt","bwb:9780198203636","marc:marc_loc_2016/BooksAll.2016.part22.utf8:183145407:1293","marc:marc_columbia/Columbia-extract-20221130-004.mrc:28629109:2926","marc:harvard_bibliographic_metadata/20220215_030.bib.mrc:178894803:3619"],"title":"The rise and fall of merry England","dewey_decimal_class":["942"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 294-352) and index."},"number_of_pages":366,"languages":[{"key":"/languages/eng"}],"lccn":["93043092"],"local_id":["urn:trent:0116404747242"],"publish_date":"1994","publish_country":"enk","by_statement":"Ronald Hutton.","works":[{"key":"/works/OL31768W"}],"type":{"key":"/type/edition"},"oclc_numbers":["29356653"],"description":{"type":"/type/text","value":"The Rise and Fall of Merry England explores the religious and secular rituals which marked the passage of the year in late medieval and early modern England, and tells the story of how they altered over time in response to political, religious, and social changes.\n\nRonald Hutton examines a number of important and controversial issues, such as the character and pace of the English Reformation, the nature of the early Stuart 'Reformation of Manners', the context of writers like Ben Jonson and Robert Herrick, the origins of the science of folklore, the relevance of cultural divisions to the English Civil War, the impact of the English Revolution, and the viability of economic explanations for social change.\n\nNever before has such a comprehensive study of the subject been undertaken, and it has been made possible by using categories of source material, notably local financial records, in a quantity never attempted hitherto. This is a highly readable and entertaining book which, in both research and interpretation, breaks several frontiers."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-02-03T02:23:57.310131"}}},"ISBN:9780192853271":{"bib_key":"ISBN:9780192853271","info_url":"http://openlibrary.org/books/OL7384509M/The_Rise_and_Fall_of_Merry_England","preview":"noview","preview_url":"http://openlibrary.org/books/OL7384509M/The_Rise_and_Fall_of_Merry_England","thumbnail_url":"https://covers.openlibrary.org/b/id/119838-S.jpg","details":{"publishers":["Oxford University Press, USA"],"identifiers":{"goodreads":["2066306"],"librarything":["105667"]},"subtitle":"The Ritual Year 1400-1700","covers":[119838],"lc_classifications":[""],"key":"/books/OL7384509M","authors":[{"key":"/authors/OL27813A","name":"Ronald Hutton"}],"isbn_13":["9780192853271"],"source_records":["bwb:9780192853271"],"title":"The Rise and Fall of Merry England","number_of_pages":377,"languages":[{"key":"/languages/eng"}],"isbn_10":["0192853279"],"publish_date":"September 26, 1996","works":[{"key":"/works/OL31768W"}],"type":{"key":"/type/edition"},"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2022-11-01T14:46:40.076525"}}},"ISBN:9780300205466":{"bib_key":"ISBN:9780300205466","info_url":"http://openlibrary.org/books/OL28391108M/Pagan_Britain","preview":"restricted","preview_url":"https://archive.org/details/paganbritain0000hutt","thumbnail_url":"https://covers.openlibrary.org/b/id/11023456-S.jpg","details":{"publishers":["Yale University Press"],"table_of_contents":[{"level":0,"label":"","title":"The Palaeolithic and Mesolithic: how ritual came to Britain --","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The earlier Neolithic: a craze for monuments --","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The late Neolithic and early Bronze Age: the time of the sacred circle --","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Late prehistory: earthworks, pits and bones --","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The Roman impact: temples, statues and inscriptions --","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The conversion to Christianity: a clash of religions, a blend of religions --","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The legacy of British paganism.","pagenum":"","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"Britain's pagan past, with its astonishing number and variety of mysterious monuments, atmospheric sites, enigmatic artefacts, bloodthirsty legends and cryptic inscriptions, has always enthralled and perplexed us. 'Pagan Britain' is a history of religious beliefs from the Old Stone Age to the coming of Christianity. This ambitious book integrates the latest evidence to survey our transformed - and transforming - understanding of early religious behaviour; and, also, the way in which that behaviour has been interpreted in recent times, as a mirror for modern dreams and fears. From the Palaeolithic era to the coming of Christianity and beyond, Hutton reveals the long development, rapid suppression and enduring cultural significance of paganism. Woven into the chronological narrative are numerous case studies of sacred sites both well-known - Stonehenge, Avebury, Seahenge and Maiden Castle - and more unusual far-flung locations across the mainland and coastal islands."},"isbn_10":["0300197713","0300205465"],"subject_times":["To 449"],"lc_classifications":["BL980.G7 H865 2013","BL980.G7H865 2013","BL980.G7H865 2015"],"key":"/books/OL28391108M","authors":[{"key":"/authors/OL27813A","name":"Ronald Hutton"}],"publish_places":["New Haven"],"subjects":["Historia","Heidentum","Hedendom","Religion","Paganism","History"],"isbn_13":["9780300197716","9780300205466"],"pagination":"xvi, 480 pages","source_records":["marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:98999705:3999","bwb:9780300197716","bwb:9780300205466","marc:marc_loc_2016/BooksAll.2016.part40.utf8:225249538:855","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:99056056:3999","ia:paganbritain0000hutt","marc:harvard_bibliographic_metadata/ab.bib.13.20150123.full.mrc:975317066:2910","marc:harvard_bibliographic_metadata/20220215_041.bib.mrc:248428338:4148"],"title":"Pagan Britain","dewey_decimal_class":["200.9361"],"notes":{"type":"/type/text","value":"Includes bibliographical references (pages 401-459) and index."},"number_of_pages":480,"languages":[{"key":"/languages/eng"}],"lccn":["2013021870"],"subject_places":["Storbritannien","Großbritannien","Great Britain"],"local_id":["urn:cst:10017031475"],"publish_date":"2013","publish_country":"ctu","by_statement":"Ronald Hutton","oclc_numbers":["844731544"],"works":[{"key":"/works/OL20956800W"}],"type":{"key":"/type/edition"},"covers":[11023456],"ocaid":"paganbritain0000hutt","latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2020-07-27T09:37:08.120886"},"last_modified":{"type":"/type/datetime","value":"2026-06-25T22:56:13.524509"}}},"ISBN:9781306095280":{"bib_key":"ISBN:9781306095280","info_url":"http://openlibrary.org/books/OL29225978M/Pagan_Britain","preview":"noview","preview_url":"http://openlibrary.org/books/OL29225978M/Pagan_Britain","details":{"publishers":["Yale University Press"],"last_modified":{"type":"/type/datetime",