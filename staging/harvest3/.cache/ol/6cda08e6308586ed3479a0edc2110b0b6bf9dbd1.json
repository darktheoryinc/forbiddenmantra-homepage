si","promise:bwb_daily_pallets_2022-08-13","marc:marc_columbia/Columbia-extract-20221130-010.mrc:35490003:1282","marc:harvard_bibliographic_metadata/20220215_044.bib.mrc:71974273:2868"],"title":"Health, healing and beyond","lccn":["97070517"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 211)."},"number_of_pages":211,"languages":[{"key":"/languages/eng"}],"url":["http://www.loc.gov/catdir/bios/hol054/97070517.html","http://www.loc.gov/catdir/description/hol042/97070517.html"],"subjects":["Krishnamacharya, T., b. 1888.","Yoga."],"publish_date":"1998","publish_country":"nyu","by_statement":"T.K.V. Desikachar ; written with R.H. Cravens ; foreword by Michael Lerner, afterword by C. Subramaniam.","oclc_numbers":["39750188"],"works":[{"key":"/works/OL894545W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/bios/hol054/97070517.html","http://www.loc.gov/catdir/description/hol042/97070517.html"],"ocaid":"healthhealingbey0000desi","local_id":["urn:bwbsku:O8-BKC-491"],"description":{"type":"/type/text","value":"\"Yoga is India's greatest gift to the world, believed the sage Tirumalai Krishnamacharya. His contribution was to preserve and modernize the five-thousand-year-old wisdom that today benefits millions of individuals far beyond the confines of this Yogic master's homeland. To Krishnamacharya, Yoga was a means to improved health to restored well-being in the face of illness and to emotional balance and enhanced mental clarity. It was also the accessible path of progression toward union with the Absolute-- whether conceived as a named God or a nameless truth. Health, Healing & Beyond is the long-awaited biographical profile and exploration of the work of this teacher of many of Yoga's greatest exponents-- including B.K.S. Iyengar, Indra Devi, and K. Pattabhi Jois. It is the story of dedication to a single purpose-- to place the benefits of Yoga at the service of humanity\"--Publisher's description."},"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-07-22T13:06:51.894201"}}},"ISBN:9780819109668":{"bib_key":"ISBN:9780819109668","info_url":"http://openlibrary.org/books/OL4406519M/Religiousness_in_yoga","preview":"restricted","preview_url":"https://archive.org/details/isbn_9780819109675","thumbnail_url":"https://covers.openlibrary.org/b/id/1553960-S.jpg","details":{"publishers":["University Press of America"],"identifiers":{"goodreads":["2422600","2788938"],"librarything":["3171979"]},"subtitle":"lectures on theory and practice","isbn_10":["0819109665","0819109673"],"covers":[1553960,1553958],"lc_classifications":["B132.Y6 D468",""],"latest_revision":11,"key":"/books/OL4406519M","authors":[{"key":"/authors/OL79078A","name":"T. K. V. Desikachar"}],"ocaid":"isbn_9780819109675","publish_places":["Washington, D.C"],"contributions":["Skelton, Mary Louise.","Carter, John Ross."],"pagination":"xiv, 298 p. :","source_records":["marc:marc_records_scriblio_net/part11.dat:103119358:815","marc:marc_loc_updates/v37.i29.records.utf8:1698627:816","ia:isbn_9780819109675","bwb:9780819109668","bwb:9780819109675","marc:marc_loc_2016/BooksAll.2016.part12.utf8:728734:816"],"title":"Religiousness in yoga","dewey_decimal_class":["181/.45"],"notes":{"type":"/type/text","value":"Bibliography: p. 285.\nIncludes indexes."},"number_of_pages":298,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"languages":[{"key":"/languages/eng"}],"lccn":["79009643"],"subjects":["Yoga -- Addresses, essays, lectures"],"publish_date":"1980","publish_country":"dcu","last_modified":{"type":"/type/datetime","value":"2020-10-17T02:32:32.421565"},"by_statement":"T. K. V. Desikachar ; edited by Mary Louise Skelton and John Ross Carter.","works":[{"key":"/works/OL894546W"}],"type":{"key":"/type/edition"},"revision":11}},"ISBN:9780819109675":{"bib_key":"ISBN:9780819109675","info_url":"http://openlibrar