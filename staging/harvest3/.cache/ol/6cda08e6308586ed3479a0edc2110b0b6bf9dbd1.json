uthors":[{"key":"/authors/OL79078A","name":"T. K. V. Desikachar"}],"publish_date":"September 1992","publishers":["CS Ediciones"],"physical_format":"Paperback","isbn_13":["9789507640650"],"languages":[{"key":"/languages/spa"}],"isbn_10":["9507640657"],"type":{"key":"/type/edition"},"subjects":["General","Family / Parenting / Childbirth"],"source_records":["amazon:9507640657"],"key":"/books/OL12998478M","works":[{"key":"/works/OL894549W"}],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-04-30T20:50:18.033121"},"last_modified":{"type":"/type/datetime","value":"2025-12-23T05:30:34.528201"}}},"ISBN:9780865477599":{"bib_key":"ISBN:9780865477599","info_url":"http://openlibrary.org/books/OL27170071M/Freud_and_yoga","preview":"restricted","preview_url":"https://archive.org/details/freudyogatwophil0000desi","thumbnail_url":"https://covers.openlibrary.org/b/id/12857491-S.jpg","details":{"subtitle":"two philosophies of mind compared","description":{"type":"/type/text","value":"\"Lessons from a great yoga master and an eminent psychoanalyst that explore what psychotherapy and yoga philosophy have in common Yoga philosophy and Freud's revolutionary approach to psychology could not have been developed in more different times, places, or cultural conditions. And yet these two profound and dynamic systems of understanding human behavior, emotions, perception, and what's essential in our existence have an astonishing amount to share. What we learn by comparing their similarities as well as their differences can enhance how we comprehend our lives and our potential for change. In Freud and Yoga, the great yoga master T.K.V. Desikachar and the eminent psychoanalyst Hellfried Krusche examine forty classic sayings, or sūtras, from the vantage point of their respective disciplines. Through clear, candid conversations that draw on long experience and are illustrated by case studies from the clinic and the shala, these two experts explain the concepts, terms, forces, and processes in their traditions. Therapists and patients, yoga adepts and professionals, and readers interested in psychology and spirituality will find this unique investigation fascinating, enriching, and useful. In a time when Western and Eastern modalities have ever more to offer each other, Freud and Yoga is a watershed work--one that draws us closer to understanding our own nature and the deep workings of the human psyche\"--\n\n\"A dialogue between a master of yoga and a psychoanalyst about philosophies of mind\"--"},"links":[{"url":"http://www.netread.com/jcusers2/bk1388/599/9780865477599/image/lgcover.9780865477599.jpg","title":"Cover image"}],"local_id":["urn:sfpl:31223111633104","urn:sfpl:31223111633112","urn:bwbsku:W7-BQK-624"],"lc_classifications":["BF161 .D45513 2014","BF161.D45513 2014"],"key":"/books/OL27170071M","authors":[{"key":"/authors/OL79078A","name":"T. K. V. Desikachar"}],"contributions":["Krusche, Hellfried, author","Hodges, Anne-Marie, translator"],"subjects":["Mind and body","Yoga","Psychology"],"lccn":["2014016951"],"languages":[{"key":"/languages/eng"}],"pagination":"ix, 212 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:111209966:4021","bwb:9780865477599","marc:marc_loc_2016/BooksAll.2016.part41.utf8:163382321:3060","ia:freudyogatwophil0000desi","promise:bwb_daily_pallets_2022-05-25"],"title":"Freud and yoga","work_titles":["Verborgene Wissen bei Freud und Patañjali"],"notes":{"type":"/type/text","value":"Includes bibliographical references (pages 209-212)."},"number_of_pages":212,"isbn_13":["9780865477599"],"edition_name":"First American edition.","dewey_decimal_class":["150.19/52"],"isbn_10":["0865477590"],"subject_people":["Patañjali","Sigmund Freud (1856-1939)"],"publish_country":"nyu","publish_date":"2014","by_statement":"T.K.V. Desikachar and Hellfried Krusche ; translated from the German by Anne-Marie Hodges","oclc_numbers":["884882131"],"works":[{"key":"/wo