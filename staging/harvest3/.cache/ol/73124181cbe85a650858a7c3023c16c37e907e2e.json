sifications":["BQ7935.B777 A3 2010","BQ7935.B777A3 2010"],"key":"/books/OL24375251M","ocaid":"myspiritualjourn0000bsta","isbn_13":["9780061960222"],"classifications":{},"source_records":["ia:myspiritualjourn0000bsta","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:92641784:6161","marc:marc_loc_2016/BooksAll.2016.part37.utf8:125458347:2630","bwb:9780061960222","marc:marc_columbia/Columbia-extract-20221130-017.mrc:22364021:8852","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:459828237:8107","marc:harvard_bibliographic_metadata/20220215_034.bib.mrc:66749921:9167"],"title":"My Spiritual Journey","lccn":["2010012435"],"translation_of":"Mon autobiographie spirituelle","identifiers":{},"languages":[{"key":"/languages/eng"}],"local_id":["urn:sfpl:31223093071356","urn:sfpl:31223093071430","urn:sfpl:31223093071232","urn:sfpl:31223107846405","urn:sfpl:31223107846389","urn:sfpl:31223093071422","urn:sfpl:31223093071299","urn:sfpl:31223093071224","urn:sfpl:31223093071125","urn:sfpl:31223093071257","urn:sfpl:31223093071414","urn:sfpl:31223093071281","urn:sfpl:31223093071190","urn:sfpl:31223093071240"],"publish_date":"2010","oclc_numbers":["535495482"],"works":[{"key":"/works/OL15399682W"}],"type":{"key":"/type/edition"},"description":{"type":"/type/text","value":"\"Tenzin Gyatso, the fourteenth Dalai Lama, was born in 1935 to a peasant family in a remote part of Tibet. Although living in exile, he is the beloved traditional and religious leader of millions of Tibetans and has become a global icon of peace, compassion, spiritual living, and nonviolent struggle for justice. The Dalai Lama's My Spiritual Journey brings the world a message: one of suffering, success, and hope. This vivid and moving portrait of the Dalai Lama's life journey is personal in tone but universal in scope. Using previously unpublished materials, augmented by interviews, the Dalai Lama, with his trusted collaborator's help, presents a spiritual narrative of his life. Memories, stories, anecdotes, and ideas are gathered together to make an accessible and comprehensive whole. The book is organized into three parts. In the first part, he uses his childhood memories to show his human dimension and stresses the importance of relating to each other on the basis of common humanity rather than on differences in belief. In the second part, he considers himself as a Buddhist monk. He explains the source of his bodhisattva ideal and invites us to transform the world by transforming our own mind. His third aspect, that of a Dalai Lama, provides an opportunity to explain his wish to establish Tibet as a sanctuary of peace for the world, where humanity and nature can live in harmonious balance\"--"},"number_of_pages":284,"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2010-10-11T16:59:35.999660"},"last_modified":{"type":"/type/datetime","value":"2026-03-28T18:54:06.598849"}}},"ISBN:9780062018090":{"bib_key":"ISBN:9780062018090","info_url":"http://openlibrary.org/books/OL28179425M/My_Spiritual_Journey","preview":"noview","preview_url":"http://openlibrary.org/books/OL28179425M/My_Spiritual_Journey","thumbnail_url":"https://covers.openlibrary.org/b/id/10116351-S.jpg","details":{"publishers":["HarperOne"],"source_records":["amazon:0062018094","bwb:9780062018090"],"title":"My Spiritual Journey","number_of_pages":304,"isbn_13":["9780062018090"],"covers":[10116351],"physical_format":"paperback","full_title":"My Spiritual Journey","isbn_10":["0062018094"],"publish_date":"Oct 04, 2011","key":"/books/OL28179425M","authors":[{"key":"/authors/OL2886A","name":"His Holiness Tenzin Gyatso the XIV Dalai Lama"},{"key":"/authors/OL794975A","name":"Sofia Stril-Rever"}],"works":[{"key":"/works/OL15399682W"}],"type":{"key":"/type/edition"},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-06-03T02:25:29.608648"},"last_modified":{"type":"/type/datetime","value":"2024-11-14T11:32:58.761891"}}},