53-b.html","http://www.loc.gov/catdir/enhancements/fy0834/2001087453-d.html"],"local_id":["urn:sfpl:31223058232860","urn:sfpl:31223116687410"],"publish_date":"2001","publish_country":"kyu","by_statement":"Ananda K. Coomaraswamy and I.B. Horner.","works":[{"key":"/works/OL1043757W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/enhancements/fy0834/2001087453-b.html","http://www.loc.gov/catdir/enhancements/fy0834/2001087453-d.html"],"covers":[13214787],"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2008-09-26T13:37:05.651041"},"last_modified":{"type":"/type/datetime","value":"2023-12-20T03:49:10.089570"}}},"ISBN:9780195633856":{"bib_key":"ISBN:9780195633856","info_url":"http://openlibrary.org/books/OL1252691M/Yakṣas","preview":"borrow","preview_url":"https://archive.org/details/yaksasessaysinwa0000coom","details":{"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [207]-231) and index."},"identifiers":{"librarything":["4300436"],"goodreads":["1088505"]},"title":"Yakṣas","subtitle":"essays in the water cosmology","authors":[{"key":"/authors/OL102871A","name":"Ananda Coomaraswamy"}],"publish_date":"1993","publishers":["Indira Gandhi National Centre for the Arts","Oxford University Press","Oxford Univ Pr"],"isbn_10":["0195633857"],"subject_place":["India."],"lc_classifications":["BL1225.Y27 C66 1993","BL1225.Y27C66 1993"],"publish_places":["New Delhi","Delhi","New York"],"languages":[{"key":"/languages/eng"}],"pagination":"xvii, 257 p., [73] p. of plates :","source_records":["marc:marc_records_scriblio_net/part24.dat:194135377:960","marc:marc_cca/b10621386.out:14832550:1070","marc:marc_loc_2016/BooksAll.2016.part24.utf8:70960531:1080","bwb:9780195633856","promise:bwb_daily_pallets_2023-05-11:P8-DEL-591","marc:marc_columbia/Columbia-extract-20221130-004.mrc:119509451:3439","marc:marc_columbia/Columbia-extract-20221130-004.mrc:235401271:4866","marc:harvard_bibliographic_metadata/20220215_039.bib.mrc:93771100:6749"],"dewey_decimal_class":["294.5/211"],"edition_name":"New ed. rev. and enl.","lccn":["94902440"],"subjects":["Yakshas","Mythology, Indic","Sculpture -- India"],"publish_country":"ii ","by_statement":"Ananda K. Coomaraswamy ; edited by Paul Schroeder ; foreword by Kapila Vatsyayan.","type":{"key":"/type/edition"},"local_id":["urn:bwbsku:P8-DEL-591"],"ocaid":"yaksasessaysinwa0000coom","key":"/books/OL1252691M","number_of_pages":257,"works":[{"key":"/works/OL1043758W"}],"oclc_numbers":["31011223","30893576"],"description":{"type":"/type/text","value":"Yaksas is the sixth in the series of the Collected Works of A. K. Coomaraswamy in the IGNCA's publication programme. Yaksas was originally published by the Freer Gallery of the Smithsonian Institution in two parts (1928 and 1931). Subsequently, Ananda Coomaraswamy rethought his topic and collected a great deal of iconographic and literary material that permitted him to reconstitute a pre-Vedic cosmology with which the Yaksas, a whole series of pre-and non-Vedic divinities, were intimately associated.\n\nIn part 1, Coomaraswamy examined the origin of Yaksas in the context of Vedic, Brahmanical and Upanisadic literature, as also theories held by writers such as Fergusson and Dr. Vogel. He attempted to bring together, from literary and archaeological sources, material sufficient to present a clear picture of an even more important phase of non- and pre-Aryan preoccupation with the concept of the Yaksas and Yaksis.\n\nCoomaraswamy's thorough revisions of the early chapters of part 1 are incorporated in this edition."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-05-17T09:29:57.758874"}}},"ISBN:9780900588198":{"bib_key":"ISBN:9780900588198","info_url":"http://openlibrary.org/books/OL3881323M/The_bugbear_of_literacy","preview":"borrow","preview_url":"https://archive.org/details/bugbearoflit