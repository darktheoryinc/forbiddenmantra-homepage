ey":"ISBN:9781578635979","info_url":"http://openlibrary.org/books/OL27215836M/The_big_book_of_practical_spells","preview":"noview","preview_url":"http://openlibrary.org/books/OL27215836M/The_big_book_of_practical_spells","details":{"other_titles":["Everyday magic that works"],"subtitle":"everyday magic that works","description":{"type":"/type/text","value":"\"Practical, inspirational, and comprehensive, The Big Book of Practical Spells is a useful tool and resource for beginners and experienced devotees of the magical arts. Here in one majestic volume is a basic introduction to magic; a psychic glossary; a primer on the four elements, colors, and magical supplies (including minerals and botanicals); and a compendium of spells for any situation you may face. With Judika Illes as your guide, you will learn how to enhance your psychic power, cleanse your aura, protect yourself from malevolent powers, and create and use a wide variety of spells. There are spells for marriage, fertility, pregnancy prevention, babies and children, money, healing, and transitioning to the next life. These are spells that will help make life easier, more productive, and stress free.\" -- Back cover."},"isbn_10":["1578635977"],"local_id":["urn:sfpl:31223117703869","urn:sfpl:31223117703844","urn:bwbsku:P9-DNX-057"],"lc_classifications":["BF1611 .I453 2016","BF1566"],"key":"/books/OL27215836M","authors":[{"key":"/authors/OL2623795A","name":"Judika Illes"}],"isbn_13":["9781578635979"],"pagination":"xviii, 282 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:351344928:2836","bwb:9781578635979","promise:bwb_daily_pallets_2024-05-20:P9-DNX-057"],"title":"The big book of practical spells","dewey_decimal_class":["133.43"],"notes":{"type":"/type/text","value":"Includes bibliographical references (pages 271-273) and index."},"number_of_pages":282,"languages":[{"key":"/languages/eng"}],"lccn":["2016933096"],"subjects":["Incantations","Magic","Charms"],"publish_date":"2016","publish_country":"mau","copyright_date":"2016","by_statement":"Judika Illes","oclc_numbers":["922911268"],"works":[{"key":"/works/OL20035795W"}],"type":{"key":"/type/edition"},"publishers":["Red Wheel/Weiser"],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2019-07-19T16:02:01.677861"},"last_modified":{"type":"/type/datetime","value":"2024-05-22T01:24:14.632767"}}},"ISBN:9781633410282":{"bib_key":"ISBN:9781633410282","info_url":"http://openlibrary.org/books/OL29318198M/Big_Book_of_Practical_Spells","preview":"noview","preview_url":"http://openlibrary.org/books/OL29318198M/Big_Book_of_Practical_Spells","details":{"publishers":["Red Wheel/Weiser"],"subtitle":"Everyday Magic That Works","last_modified":{"type":"/type/datetime","value":"2020-08-24T14:27:30.582103"},"source_records":["bwb:9781633410282"],"title":"Big Book of Practical Spells","number_of_pages":304,"isbn_13":["9781633410282"],"created":{"type":"/type/datetime","value":"2020-08-24T14:27:30.582103"},"languages":[{"key":"/languages/eng"}],"full_title":"Big Book of Practical Spells Everyday Magic That Works","lc_classifications":[""],"publish_date":"2016","key":"/books/OL29318198M","authors":[{"key":"/authors/OL2623795A","name":"Judika Illes"}],"latest_revision":1,"works":[{"key":"/works/OL20035795W"}],"type":{"key":"/type/edition"},"subjects":["Magic","Charms","Incantations"],"revision":1}},"ISBN:9781578636242":{"bib_key":"ISBN:9781578636242","info_url":"http://openlibrary.org/books/OL26946608M/The_Weiser_book_of_occult_detectives","preview":"noview","preview_url":"http://openlibrary.org/books/OL26946608M/The_Weiser_book_of_occult_detectives","details":{"other_titles":["Occult detectives"],"table_of_contents":[{"level":0,"label":"","title":"The pot of tulips  -- by Fitz-James O'Brien","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Green tea  -- by J. Sheridan Le Fanu","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The cave of the Echoes  -- by Helena Petrovna Blavatsky","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The story of Yand Manor House  -- by Kate and Hesketh Prichard (H. Heron and E. Heron)","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The leather funnel  -- by Sir Arthur Conan Doyle","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The dead hand  -- by L.T. Meade and Robert Eustace","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The horse of in invisible  -- by William Hope Hodgson","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Case of the Veil of Isis  -- by Sax Rohmer -- The vampire / -- by Alice and Claude Askew","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"A victim of higher space  -- by Algernon Blackwood","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The witness in the wood  -- by Rose Champion","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The eyes of doom  -- by Ella M. Scrymsour","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The return of the ritual -- by Dion Fortune.","pagenum":"","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"\"This is is a compilation of vintage occult detective stories\"--\n\n\"The Weiser Book of Occult Detectives: 13 Stories of Supernatural Sleuthing is a compilation of vintage occult detective stories, written by masters of the genre including Arthur Conan Doyle, Algernon Blackwood, Dion Fortune, J. Sheridan Le Fanu, and Helena Blavatsky. Occult detectives explore paranormal mysteries or use their own supernatural gifts to solve crimes. The book features the original authors and stories that inspired what is now a bestsellilng genre in movies, TV, books, and video games. The stories in The Weiser Book of Occult Detectives star both female and male sleuths. The mysteries they tackle include murder, missing funds, demons, ghosts, vampires, and more. Among the ranks of occult detectives featured in this book are beloved favorites such as Dr. Hesselius, Dr. Taverner, Thomas Carnacki, and John Silence but also the unjustly forgotten and obscure sleuths Shiela Crerar and Diana Marburg. Techniques utilized by the various detectives include palmistry, clairvoyance, psychometry, mesmerism, dreams, and good old deductive reasoning. The book is edited and introduced by leading occult author and scholar Judika Illes.\"--"},"local_id":["urn:sfpl:31223124889016"],"lc_classifications":["PN6071.D45 W37 2017","PN6071.D45W37 2017"],"key":"/books/OL26946608M","authors":[{"key":"/authors/OL2623795A","name":"Judika Illes"}],"subtitle":"13 stories of supernatural sleuthing","subjects":["Paranormal fiction","Detective and mystery stories"],"isbn_13":["9781578636242"],"pagination":"xxiii, 288 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run06.mrc:96651246:3681","bwb:9781578636242"],"title":"The Weiser book of occult detectives","dewey_decimal_class":["808.83/872"],"number_of_pages":288,"languages":[{"key":"/languages/eng"}],"lccn":["2017023663"],"isbn_10":["1578636248"],"publish_date":"2017","publish_country":"mau","by_statement":"edited and introduced by Judika Illes","oclc_numbers":["982591869"],"works":[{"key":"/works/OL19733514W"}],"type":{"key":"/type/edition"},"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2019-05-24T04:05:00.592057"},"last_modified":{"type":"/type/datetime","value":"2021-10-03T08:33:05.002050"}}}}