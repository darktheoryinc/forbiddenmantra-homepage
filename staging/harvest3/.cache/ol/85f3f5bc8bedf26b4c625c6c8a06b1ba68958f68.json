records":["bwb:9781608686018","promise:bwb_daily_pallets_2021-07-13"],"title":"Letters to a Dead Friend about Zen","number_of_pages":272,"isbn_13":["9781608686018"],"languages":[{"key":"/languages/eng"}],"lc_classifications":[""],"publish_date":"2019","key":"/books/OL28939076M","authors":[{"key":"/authors/OL2924744A","name":"Brad Warner"}],"works":[{"key":"/works/OL21363879W"}],"type":{"key":"/type/edition"},"local_id":["urn:bwbsku:O7-BSB-585"],"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2020-08-18T05:54:34.849561"},"last_modified":{"type":"/type/datetime","value":"2022-12-08T04:58:09.720087"}}},"ISBN:9781608686025":{"bib_key":"ISBN:9781608686025","info_url":"http://openlibrary.org/books/OL51082203M/Letters_to_a_Dead_Friend_about_Zen","preview":"noview","preview_url":"http://openlibrary.org/books/OL51082203M/Letters_to_a_Dead_Friend_about_Zen","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2924744A","name":"Brad Warner"}],"isbn_13":["9781608686025"],"languages":[{"key":"/languages/eng"}],"pagination":"256","publish_date":"2019","publishers":["New World Library"],"source_records":["bwb:9781608686025"],"title":"Letters to a Dead Friend about Zen","full_title":"Letters to a Dead Friend about Zen","works":[{"key":"/works/OL21363879W"}],"key":"/books/OL51082203M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-02-17T10:47:04.130017"},"last_modified":{"type":"/type/datetime","value":"2024-02-17T10:47:04.130017"}}},"ISBN:9781608681846":{"bib_key":"ISBN:9781608681846","info_url":"http://openlibrary.org/books/OL51072405M/There_Is_No_God_and_He_Is_Always_with_You","preview":"noview","preview_url":"http://openlibrary.org/books/OL51072405M/There_Is_No_God_and_He_Is_Always_with_You","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2924744A","name":"Brad Warner"}],"isbn_13":["9781608681846"],"languages":[{"key":"/languages/eng"}],"pagination":"208","publish_date":"2013","publishers":["New World Library"],"source_records":["bwb:9781608681846"],"title":"There Is No God and He Is Always with You","subtitle":"A Search for God in Odd Places","full_title":"There Is No God and He Is Always with You A Search for God in Odd Places","works":[{"key":"/works/OL19968951W"}],"key":"/books/OL51072405M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-02-17T09:58:12.817349"},"last_modified":{"type":"/type/datetime","value":"2024-02-17T09:58:12.817349"}}},"ISBN:9781608681839":{"bib_key":"ISBN:9781608681839","info_url":"http://openlibrary.org/books/OL27149153M/There_is_no_god_and_he_is_always_with_you","preview":"restricted","preview_url":"https://archive.org/details/thereisnogodheis0000warn","thumbnail_url":"https://covers.openlibrary.org/b/id/12188284-S.jpg","details":{"subtitle":"a search for God in odd places","description":{"type":"/type/text","value":"\"In his \"intimate, funny, conversational style\" (Library Journal), Brad Warner stage dives into the Sam Harris, Karen Armstrong, Christopher Hitchens mosh pit of the God or no God debate - and body surfs up with a typically provocative perspective. Warner was initially interested in Zen because he wanted to find God, but Zen Buddhism is usually thought of as godless. Warner travels around the world looking for insight and what he finds, in chapters like \"Sam Harris Believes in God,\" \"God Doesn't Have to Be Real to Exist,\" and \"What God Wants,\" and through visits to places including Israel, Mexico, and Northern Ireland, is the belief that Buddhism \"is a way to approach and understand God without dealing with religion.\" The fact that the book's title is Warner's mis-remembrance of a Zen monk's quote is emblematic of his profoundly engaging and idiosyncratic take on the ineffable power of the \"ground of all being.\" \"--\n\n\"\"Perspectives on the 'God-or-no-God' debate from an idiosyncratic Soto Zen priest. With stories from his years of Zen practice and his travels to countries such as Israel, Mexico, and Northern Ireland, Warner suggests that Buddhist practice 'is a way to approach and understand God without dealing with religion'\"--Provided by publisher\"--"},"local_id":["urn:sfpl:31223110323616","urn:sfpl:31223110323640","urn:sfpl:31223110323624","urn:cst:10017031649","urn:bwbsku:P7-CGP-054","urn:bwbsku:P7-ATS-856"],"lc_classifications":["BQ9265.4 .W36 2013","BQ918.G6"],"key":"/books/OL27149153M","authors":[{"key":"/authors/OL2924744A","name":"Brad Warner"}],"subjects":["God","Travel","Buddhist interpretations","Zen Buddhism"],"isbn_13":["9781608681839"],"pagination":"xv, 189 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:356445570:3248","marc:marc_claremont_school_theology/CSTMARC2_barcode.mrc:98769639:4304","bwb:9781608681839","marc:marc_loc_2016/BooksAll.2016.part40.utf8:207429841:2470","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:98825934:4304","ia:thereisnogodheis0000warn","promise:bwb_daily_pallets_2021-07-13","promise:bwb_daily_pallets_2021-06-09"],"title":"There is no god and he is always with you","dewey_decimal_class":["212"],"number_of_pages":189,"languages":[{"key":"/languages/eng"}],"lccn":["2013009842"],"isbn_10":["1608681831"],"subject_people":["Brad Warner"],"publish_country":"cau","publish_date":"2013","by_statement":"Brad Warner","oclc_numbers":["843454513"],"works":[{"key":"/works/OL19968951W"}],"type":{"key":"/type/edition"},"covers":[12188284],"ocaid":"thereisnogodheis0000warn","latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2019-07-18T03:56:10.776400"},"last_modified":{"type":"/type/datetime","value":"2023-01-14T18:42:29.937341"}}},"ISBN:9781608685110":{"bib_key":"ISBN:9781608685110","info_url":"http://openlibrary.org/books/OL26933231M/It_came_from_beyond_Zen!","preview":"noview","preview_url":"http://openlibrary.org/books/OL26933231M/It_came_from_beyond_Zen!","details":{"subtitle":"more practical advice from Dōgen, Japan's greatest Zen master","description":{"type":"/type/text","value":"In Japan in 1253, one of the great thinkers of his time died -- and the world barely noticed. That man was the Zen monk Eihei Dogen. For centuries his main work, Shobogenzo, languished in obscurity, locked away in remote monasteries until scholars rediscovered it in the twentieth century. What took so long? In Brad Warner's view, Dogen was too ahead of his time to find an appreciative audience. To bring Dogen's work to a bigger readership, Warner began paraphrasing Shobogenzo, recasting it in simple, everyday language. The first part of this project resulted in Don't Be a Jerk, and now Warner presents this second volume, It Came from Beyond Zen! Once again, Warner uses wry humor and incisive commentary to bridge the gap between past and present, making Dogen's words clearer and more relevant than ever before."},"isbn_10":["160868511X"],"local_id":["urn:sfpl:31223122738538","urn:sfpl:31223122738355","urn:sfpl:31223122738512","urn:bwbsku:P6-ALA-452"],"key":"/books/OL26933231M","authors":[{"key":"/authors/OL2924744A","name":"Brad Warner"}],"contributions":["Dōgen, 1200-1253"],"isbn_13":["9781608685110"],"pagination":"xxii, 344 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run06.mrc:41478936:2827","bwb:9781608685110","promise:bwb_daily_pallets_2022-06-13"],"title":"It came from beyond Zen!","dewey_decimal_class":["294.385"],"notes":{"type":"/type/text","value":"Includes bibliographical references (pages 337-342)."},"number_of_pages":344,"languages":[{"key":"/languages/eng"}],"subjects":["Doctrines","Sōtōshū"],"publish_date":"2017","publish_country":"cau","by_statement":"Brad Warner","oclc_numbers":["1007340708"],"works":[{"key":"/works/OL19720106W"}],"type":{"key":"/type/edition"},"lc_classifications":["BT75.2.W37 2017"],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2019-05-23T23:48:42.030505"},"last_modified":{"type":"/type/datetime","value":"2022-12-05T02:15:48.170640"}}},"ISBN:9781608685127":{"bib_key":"ISBN:9781608685127","info_url":"http://openlibrary.org/books/OL51075007M/It_Came_from_Beyond_Zen!","preview":"noview","preview_url":"http://openlibrary.org/books/OL51075007M/It_Came_from_Beyond_Zen!","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2924744A","name":"Brad Warner"}],"isbn_13":["9781608685127"],"languages":[{"key":"/languages/eng"}],"pagination":"368","publish_date":"2017","publishers":["New World Library"],"source_records":["bwb:9781608685127"],"subjects":["Dharma (buddhism)","Spirituality"],"title":"It Came from Beyond Zen!","subtitle":"More Practical Advice from Dogen, Japan's Greatest Zen Master","full_title":"It Came from Beyond Zen! More Practical Advice from Dogen, Japan's Greatest Zen Master","works":[{"key":"/works/OL19720106W"}],"key":"/books/OL51075007M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-02-17T10:10:25.314318"},"last_modified":{"type":"/type/datetime","value":"2024-02-17T10:10:25.314318"}}},"ISBN:9781577319115":{"bib_key":"ISBN:9781577319115","info_url":"http://openlibrary.org/books/OL51064049M/Sex_Sin_and_Zen","preview":"noview","preview_url":"http://openlibrary.org/books/OL51064049M/Sex_Sin_and_Zen","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2924744A","name":"Brad Warner"}],"isbn_13":["9781577319115"],"languages":[{"key":"/languages/eng"}],"pagination":"304","publish_date":"2010","publishers":["New World Library"],"source_records":["bwb:9781577319115"],"subjects":["Sex, religious aspects"],"title":"Sex, Sin, and Zen","subtitle":"A Buddhist Exploration of Sex from Celibacy to Polyamory and Everything in Between","full_title":"Sex, Sin, and Zen A Buddhist Exploration of Sex from Celibacy to Polyamory and Everything in Between","works":[{"key":"/works/OL15488252W"}],"key":"/books/OL51064049M","latest_revision":1,"revisi