ina","thumbnail_url":"https://covers.openlibrary.org/b/id/13731485-S.jpg","details":{"publishers":["UFO Photo Archives","Ufo Photo Archives"],"physical_format":"Hardcover","title":"UFO's Over Modern China","identifiers":{"librarything":["7899691"],"goodreads":["1870357"]},"isbn_13":["9780960855834"],"languages":[{"key":"/languages/eng"}],"isbn_10":["0960855831"],"publish_date":"February 1986","key":"/books/OL11627347M","authors":[{"key":"/authors/OL2935988A","name":"Wendelle C. Stevens"},{"key":"/authors/OL407844A","name":"Paul Dong"}],"oclc_numbers":["18796130"],"type":{"key":"/type/edition"},"subjects":["UFOs","China"],"works":[{"key":"/works/OL34917703W"}],"covers":[13731485],"source_records":["amazon:0960855831"],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2008-04-30T20:50:18.033121"},"last_modified":{"type":"/type/datetime","value":"2023-03-21T01:58:18.690283"}}},"ISBN:9781962986151":{"bib_key":"ISBN:9781962986151","info_url":"http://openlibrary.org/books/OL51150070M/Real_Estate_of_America","preview":"noview","preview_url":"http://openlibrary.org/books/OL51150070M/Real_Estate_of_America","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL407844A","name":"Paul Dong"}],"isbn_13":["9781962986151"],"languages":[{"key":"/languages/eng"}],"publish_date":"2024","publishers":["Hua Xia"],"source_records":["bwb:9781962986151"],"subjects":["Business","Agriculture"],"title":"Real Estate of America","subtitle":"This Is a Fascinating and Challenging World, Let Us Grow Together in This World of Real Estate, Create the Future Together","works":[{"key":"/works/OL37890519W"}],"key":"/books/OL51150070M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-02-18T07:34:21.810861"},"last_modified":{"type":"/type/datetime","value":"2024-02-18T07:34:21.810861"}}},"ISBN:9780612953222":{"bib_key":"ISBN:9780612953222","info_url":"http://openlibrary.org/books/OL19512492M/Effect_of_muscle_length_on_reflex_responses_evoked_by_noxious_stimulation_of_neck_muscles_of_the_rat","preview":"noview","preview_url":"http://openlibrary.org/books/OL19512492M/Effect_of_muscle_length_on_reflex_responses_evoked_by_noxious_stimulation_of_neck_muscles_of_the_rat","details":{"description":{"type":"/type/text","value":"To examine the effect of muscle length on reflex responses evoked by noxious stimulation, mustard oil (MO), a small-fibre excitant and inflammatory irritant, was injected into (1) non-stretched left deep neck muscles with the rat in a straight body position (Straight group); (2) into stretched left deep neck muscles with the rat's neck rotated 45° to the right (Stretched group); and (3) non-stretched right deep neck muscles with the rat's neck rotated 45° to the right (Relaxed group). The deep neck and trapezius muscles showed a larger MO-evoked electromyographic response when they were stretched than when they were not stretched. This finding suggests that noxious stimulation of rat deep neck muscles may result in larger reflex responses in deep neck and trapezius muscles when they are stretched. This enhanced muscle activity could be associated with changes in the susceptibility of the neck muscles to damage or pain."},"notes":{"type":"/type/text","value":"Adviser: James W. Hu.\n\nThesis (M.Sc.)--University of Toronto, 2004.\n\nElectronic version licensed for access by U. of T. users.\n\nSource: Masters Abstracts International, Volume: 43-03, page: 0792.\n\nMICR copy on microfiche (2 microfiches)."},"title":"Effect of muscle length on reflex responses evoked by noxious stimulation of neck muscles of the rat.","authors":[{"key":"/authors/OL5750230A","name":"Paul Dong Su Shin"}],"publish_date":"2004","pagination":"94 leaves.","url":["http://link.library.utoronto.ca/eir/EIRdetail.cfm?Resources__ID=95000&T=F"],"languages":[{"key":"/languages/eng"}],"isbn_10":["061295322X"],"publish_country":"onc","type":{"key":"/type/edition"},"source_records":["marc:marc_university_of_toronto/uoft.marc:4870767823:2247"],"key":"/books/OL19512492M","number_of_pages":94,"works":[{"key":"/works/OL12790701W"}],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2008-10-22T17:29:37.267052"},"last_modified":{"type":"/type/datetime","value":"2026-06-02T23:32:50.560972"}}}}