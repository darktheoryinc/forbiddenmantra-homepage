rt34.utf8:153771661:2002","marc:marc_claremont_school_theology/CSTMARC2_multibarcode.mrc:69301924:3690","ia:beingwithdyingcu0000hali","marc:harvard_bibliographic_metadata/20220215_009.bib.mrc:302533611:4328"],"title":"Being with Dying","identifiers":{"goodreads":["2309183"],"librarything":["4622971"]},"languages":[{"key":"/languages/eng"}],"local_id":["urn:sfpl:31223078225530","urn:sfpl:31223078225514","urn:sfpl:31223078225472","urn:sfpl:31223078225522","urn:cst:10017021317"],"publish_date":"June 10, 2008","works":[{"key":"/works/OL2724132W"}],"type":{"key":"/type/edition"},"lccn":["2007042003"],"lc_classifications":["R726.8 .H35 2008","R726.8 .H35 2009"],"ocaid":"beingwithdyingcu0000hali","oclc_numbers":["264043405"],"description":{"type":"/type/text","value":"Zen teacher Joan Halifax has been helping both the dying and their caregivers to face death with courage and compassion for three decades. Here, Joan offers the fruits of her work, providing comfort, inspiration, and practical skills for all those who are in the process of dying or who are charged with a dying person's care. Her teaching, based on Buddhist principles, emphasizes that we have the ability to open up to and rely on our inner strength, and we can help others who are suffering to do the same. Joan offers stories from her personal experience as well as guided exercises and contemplations to help readers meditate on death without fear, develop a commitment to helping others, and transform suffering and resistance into courage.--From publisher description."},"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2008-04-30T20:50:18.033121"},"last_modified":{"type":"/type/datetime","value":"2025-07-24T14:19:17.558235"}}},"ISBN:9781645472872":{"bib_key":"ISBN:9781645472872","info_url":"http://openlibrary.org/books/OL51103801M/Being_with_Dying","preview":"noview","preview_url":"http://openlibrary.org/books/OL51103801M/Being_with_Dying","details":{"type":{"key":"/type/edition"},"a