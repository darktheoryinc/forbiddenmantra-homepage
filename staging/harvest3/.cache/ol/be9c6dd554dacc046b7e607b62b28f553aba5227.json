shers":["Oxford University Press"],"subtitle":"Nagarjuna's Vigrahavyavartani","dewey_decimal_class":["294.3/85"],"pagination":"p. cm.","covers":[8640127],"lc_classifications":["BQ2902 .E5 2010","BQ2902.E5 2010","BQ2902 .E513 2010"],"key":"/books/OL23535079M","authors":[{"key":"/authors/OL16558A","name":"Nāgārjuna"}],"publish_places":["New York"],"contributions":["Westerhoff, Jan."],"isbn_13":["9780199732692","9780199732708"],"genres":["Early works to 1800"],"source_records":["marc:marc_loc_updates/v37.i24.records.utf8:10660661:891","ia:dispellerdispute00west","bwb:9780199732708","bwb:9780199732692","marc:marc_loc_2016/BooksAll.2016.part36.utf8:122278660:1238","marc:marc_columbia/Columbia-extract-20221130-016.mrc:94500171:1621","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:331067549:3006","marc:harvard_bibliographic_metadata/20220215_015.bib.mrc:134233300:4105"],"title":"The dispeller of disputes","work_titles":["Vigrahavyāvartanī."],"notes":{"type":"/type/text","value":"Translation and commentry by Jan Westerhoff.\n\nIncludes bibliographical references."},"identifiers":{"librarything":["9724801"]},"languages":[{"key":"/languages/eng"}],"lccn":["2009023180"],"subjects":["Mādhyamika (Buddhism) -- Early works to 1800"],"publish_date":"2010","publish_country":"nyu","by_statement":"Jan Westerhoff.","works":[{"key":"/works/OL12097451W"}],"type":{"key":"/type/edition"},"oclc_numbers":["398505721"],"description":{"type":"/type/text","value":"\"Nagarjuna's Vigrahavyavartani is an essential work of Madhyamaka Buddhist philosophical literature. Written in an accessible question-and-answer style, it contains Nagarjuna's replies to criticisms of his philosophy of the \"Middle Way.\" The Vigrahavyavartani has been widely cited both in canonical literature and in recent scholarship; it has remained a central text in India, Tibet, China, and Japan, and has attracted the interest of greater and greater numbers of Western readers. In The Dispeller of Disputes, Jan Westerhoff offers a clear new translation of the Vigrahavyavartani, taking current philological research and all available editions into account, and adding his own insightful philosophical commentary on the text. Crucial manuscript material has been discovered since the earlier translations were written, and Westerhoff draws on this material to produce a study reflecting the most up-to-date research on this text. In his nuanced and incisive commentary, he explains Nagarjuna's arguments, grounds them in historical and textual scholarship, and explicitly connects them to contemporary philosophical concerns.\"--Publisher's website."},"number_of_pages":142,"latest_revision":17,"revision":17,"created":{"type":"/type/datetime","value":"2009-07-21T17:48:41.975572"},"last_modified":{"type":"/type/datetime","value":"2026-02-20T01:50:21.594609"}}},"ISBN:9780199732692":{"bib_key":"ISBN:9780199732692","info_url":"http://openlibrary.org/books/OL23535079M/The_dispeller_of_disputes","preview":"noview","preview_url":"http://openlibrary.org/books/OL23535079M/The_dispeller_of_disputes","thumbnail_url":"https://covers.openlibrary.org/b/id/8640127-S.jpg","details":{"publishers":["Oxford University Press"],"subtitle":"Nagarjuna's Vigrahavyavartani","dewey_decimal_class":["294.3/85"],"pagination":"p. cm.","covers":[8640127],"lc_classifications":["BQ2902 .E5 2010","BQ2902.E5 2010","BQ2902 .E513 2010"],"key":"/books/OL23535079M","authors":[{"key":"/authors/OL16558A","name":"Nāgārjuna"}],"publish_places":["New York"],"contributions":["Westerhoff, Jan."],"isbn_13":["9780199732692","9780199732708"],"genres":["Early works to 1800"],"source_records":["marc:marc_loc_updates/v37.i24.records.utf8:10660661:891","ia:dispellerdispute00west","bwb:9780199732708","bwb:9780199732692","marc:marc_loc_2016/BooksAll.2016.part36.utf8:122278660:1238","marc:marc_columbia/Columbia-extract-20221130-016.mrc:94500171:1621","marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:331067549:3006","marc:harvard_bibliographic_metadata/20220215_015.bib.mrc:134233300:4105"],"title":"The dispeller of disputes","work_titles":["Vigrahavyāvartanī."],"notes":{"type":"/type/text","value":"Translation and commentry by Jan Westerhoff.\n\nIncludes bibliographical references."},"identifiers":{"librarything":["9724801"]},"languages":[{"key":"/languages/eng"}],"lccn":["2009023180"],"subjects":["Mādhyamika (Buddhism) -- Early works to 1800"],"publish_date":"2010","publish_country":"nyu","by_statement":"Jan Westerhoff.","works":[{"key":"/works/OL12097451W"}],"type":{"key":"/type/edition"},"oclc_numbers":["398505721"],"description":{"type":"/type/text","value":"\"Nagarjuna's Vigrahavyavartani is an essential work of Madhyamaka Buddhist philosophical literature. Written in an accessible question-and-answer style, it contains Nagarjuna's replies to criticisms of his philosophy of the \"Middle Way.\" The Vigrahavyavartani has been widely cited both in canonical literature and in recent scholarship; it has remained a central text in India, Tibet, China, and Japan, and has attracted the interest of greater and greater numbers of Western readers. In The Dispeller of Disputes, Jan Westerhoff offers a clear new translation of the Vigrahavyavartani, taking current philological research and all available editions into account, and adding his own insightful philosophical commentary on the text. Crucial manuscript material has been discovered since the earlier translations were written, and Westerhoff draws on this material to produce a study reflecting the most up-to-date research on this text. In his nuanced and incisive commentary, he explains Nagarjuna's arguments, grounds them in historical and textual scholarship, and explicitly connects them to contemporary philosophical concerns.\"--Publisher's website."},"number_of_pages":142,"latest_revision":17,"revision":17,"created":{"type":"/type/datetime","value":"2009-07-21T17:48:41.975572"},"last_modified":{"type":"/type/datetime","value":"2026-02-2