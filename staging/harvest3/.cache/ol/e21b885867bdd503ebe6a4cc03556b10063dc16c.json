9","info_url":"http://openlibrary.org/books/OL9368045M/The_Bedtrick_Tales_of_Sex_and_Masquerade_(Worlds_of_Desire_The_Chicago_Series_on_Sexuality_Gender_an","preview":"noview","preview_url":"http://openlibrary.org/books/OL9368045M/The_Bedtrick_Tales_of_Sex_and_Masquerade_(Worlds_of_Desire_The_Chicago_Series_on_Sexuality_Gender_an","thumbnail_url":"https://covers.openlibrary.org/b/id/140484-S.jpg","details":{"publishers":["University Of Chicago Press"],"number_of_pages":576,"weight":"1.6 pounds","covers":[140484],"physical_format":"Paperback","key":"/books/OL9368045M","authors":[{"key":"/authors/OL32073A","name":"Wendy Doniger"}],"subjects":["Literary studies: general","Religious social & pastoral thought & activity","Sociology, Social Studies","Social Science","Love / Sex / Marriage","Sociology","Folklore & Mythology","Sexuality","Social Science / Folklore & Mythology","Comparative studies","Deception","Mythology","Sex"],"edition_name":"New Ed edition","languages":[{"key":"/languages/eng"}],"first_sentence":{"type":"/type/text","value":"You go to bed with someone you think you know, and when you wake up you discover that it was someone else\u001aanother man or another woman, or a man instead of a woman, or a woman instead of a man, or a god, or a snake, or a foreigner or alien, or a complete stranger, or your own wife or husband, or your mother or father."},"source_records":["amazon:0226156435:2-ad:1483148579:210729","bwb:9780226156439","promise:bwb_daily_pallets_2021-08-24"],"title":"The Bedtrick: Tales of Sex and Masquerade (Worlds of Desire: The Chicago Series on Sexuality, Gender, and Culture)","identifiers":{"goodreads":["275155"],"librarything":["301199"]},"isbn_13":["9780226156439"],"isbn_10":["0226156435"],"publish_date":"December 1, 2005","works":[{"key":"/works/OL94338W"}],"type":{"key":"/type/edition"},"physical_dimensions":"8.5 x 5.5 x 1.4 inches","lc_classifications":["BL325.S42D64 2005"],"local_id":["urn:bwbsku:P7-EIE-841"],"latest_revision":9,"revisio