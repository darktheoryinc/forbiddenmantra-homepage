0195202502","marc:marc_loc_2016/BooksAll.2016.part13.utf8:82106825:1052","marc:marc_claremont_school_theology/CSTMARC1_multibarcode.mrc:116103749:3150","marc:marc_columbia/Columbia-extract-20221130-001.mrc:232954416:1584","ia:sivaeroticasceti0000doni","marc:harvard_bibliographic_metadata/ab.bib.00.20150123.full.mrc:145274758:936","idb:9780195202502","promise:bwb_daily_pallets_2023-12-29:T2-DSN-266","marc:harvard_bibliographic_metadata/20220215_026.bib.mrc:243998723:3354"],"title":"Śiva, the erotic ascetic","work_titles":["Asceticism and eroticism in the mythology of Śiva"],"notes":{"type":"/type/text","value":"Reprint of the ed. published by Oxford University Press, London and New York, under title, Asceticism and eroticism in the mythology of Śiva.\n\nIncludes indexes.\n\nBibliography, p."},"identifiers":{"goodreads":["1132360"],"librarything":["1181838"]},"languages":[{"key":"/languages/eng"}],"lccn":["81000127"],"isbn_10":["0195202503"],"publish_date":"1981","publish_country":"xxu","by_statement":"Wendy Doniger O'Flaherty.","works":[{"key":"/works/OL18320603W"}],"type":{"key":"/type/edition"},"oclc_numbers":["7248489"],"covers":[15230730],"ocaid":"sivaeroticasceti0000doni","number_of_pages":386,"description":{"type":"/type/text","value":"\"Highly acclaimed upon its original publication in 1973 under the title Asceticism and Eroticism in the Mythology of Siva, this book applies a structuralist method to a corpus of mythology never before analyzed, or for the most part, translated from the Sanskrit. The author traces the development of an Indian approach to an enduring human dilemma: the conflict between spiritual aspirations and human desires. The work treats hundreds of related myths and examines a wide range of Indian texts (Vedic, Puranic, classical, modern, and tribal), centering upon the stories of the great ascetic, Siva, and his erotic alter ego, Kama\"--Back cover."},"latest_revision":20,"revision":20,"created":{"type":"/type/datetime","value":"2008-11-01T04:09:32.354441"},"last_modified":{"type":"/type/datetime","value":"2026-06-18T10:35:22.948145"}}}}