":{"type":"/type/datetime","value":"2022-01-27T07:11:09.917704"},"last_modified":{"type":"/type/datetime","value":"2022-01-27T07:11:09.917704"}}},"ISBN:9780593436141":{"bib_key":"ISBN:9780593436141","info_url":"http://openlibrary.org/books/OL36143766M/Ayurveda_for_Women","preview":"noview","preview_url":"http://openlibrary.org/books/OL36143766M/Ayurveda_for_Women","thumbnail_url":"https://covers.openlibrary.org/b/id/13290915-S.jpg","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL10042205A","name":"Emily L. Glaser"},{"key":"/authors/OL7612611A","name":"Claudia Welch"}],"isbn_13":["9780593436141"],"languages":[{"key":"/languages/eng"}],"pagination":"208","publish_date":"2022","publishers":["Penguin Random House LLC","Zeitgeist","Readerlink"],"source_records":["bwb:9780593436141","amazon:0593436148"],"title":"Ayurveda for Women","weight":"0.513","subtitle":"The Power of Food As Medicine with Recipes for Health and Wellness","full_title":"Ayurveda for Women The Power of Food As Medicine with Recipes for Health and Wellness","works":[{"key":"/works/OL26695164W"}],"key":"/books/OL36143766M","covers":[13290915],"number_of_pages":208,"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2021-12-28T16:36:13.961259"},"last_modified":{"type":"/type/datetime","value":"2023-02-11T02:33:36.098262"}}},"ISBN:9780425247433":{"bib_key":"ISBN:9780425247433","info_url":"http://openlibrary.org/books/OL25197992M/Sorority_sisters","preview":"restricted","preview_url":"https://archive.org/details/isbn_9780425247433","thumbnail_url":"https://covers.openlibrary.org/b/id/8063309-S.jpg","details":{"publishers":["Berkley Books"],"description":{"type":"/type/text","value":"\"When life doesn't give you sisters, make your own. In 1975, trying to find a place to belong, they join a college sorority. Laurie was looking for a place to call home, even if it was only for the four years of college. She knew whatever bonds she made wouldn't last. Life had taught her that. Karen, as usual, was doing what her mother told her to do, even though she was afraid she wasn't pretty enough to be a sorority girl. Ellen was looking for friends--and the free beers that came with mandatory fraternity exchanges. And if her dad had to dig deep into his bank account to foot the sorority bill, so much the better. Diane, sexy and confident, with guys trailing after her like wolves on the scent, is the kind of woman other women hate. Until her mask slips... In the same pledge class, they found each other. Through parties and pranks, finals week and skipped classes, boyfriends and bad breakups, they forged a bond built on laughter and trust that takes them by surprise. No one expected it to last beyond college graduation. But some bonds are too strong to break. Now they're sisters. And with sisters, it's not about what happens. It's about no matter what happens. \"--"},"covers":[8063309],"full_title":"Sorority sisters","lc_classifications":["PS3623.E46215 S67 2012","PS3623.E46215S67"],"key":"/books/OL25197992M","authors":[{"key":"/authors/OL7077583A","name":"Claudia Welch"}],"ocaid":"isbn_9780425247433","publish_places":["New York"],"isbn_13":["9780425247433"],"pagination":"p. cm.","source_records":["marc:marc_loc_updates/v40.i06.records.utf8:14409951:1872","ia:isbn_9780425247433","ia:sororitysisters0000welc","marc:marc_loc_2016/BooksAll.2016.part39.utf8:173361096:1867","amazon:0425247430","bwb:9780425247433"],"title":"Sorority sisters","lccn":["2012002081"],"languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["813/.6"],"subjects":["FICTION / Contemporary Women","Female friendship","Fiction"],"publish_date":"2012","publish_country":"nyu","by_statement":"Claudia Welch","works":[{"key":"/works/OL16499184W"}],"type":{"key":"/type/edition"},"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2012-02-08T10:58:31.091235"},"last_modified":{"type":"/type/datetime","value":"2022-12-17T17:52:35.399553"}}},"ISBN:978