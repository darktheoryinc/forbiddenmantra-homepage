"/type/datetime","value":"2008-04-30T08:14:56.482104"},"last_modified":{"type":"/type/datetime","value":"2021-09-09T07:46:32.244595"}}},"ISBN:9781570621369":{"bib_key":"ISBN:9781570621369","info_url":"http://openlibrary.org/books/OL977760M/Dharma_art","preview":"borrow","preview_url":"https://archive.org/details/dharmaart00trun","thumbnail_url":"https://covers.openlibrary.org/b/id/817097-S.jpg","details":{"publishers":["Shambhala"],"identifiers":{"goodreads":["1044901"],"librarything":["249057"]},"ia_box_id":["IA185001"],"isbn_10":["1570621365"],"series":["Dharma ocean series"],"covers":[817097],"ia_loaded_id":["dharmaart00trun"],"lc_classifications":["BQ4570.A72 T78 1996"],"key":"/books/OL977760M","authors":[{"key":"/authors/OL363720A","name":"Chögyam Trungpa"}],"ocaid":"dharmaart00trun","publish_places":["Boston"],"contributions":["Lief, Judith L."],"edition_name":"1st ed.","pagination":"xiv, 144 p. :","source_records":["marc:marc_records_scriblio_net/part25.dat:177764436:747","marc:marc_loc_updates/v36.i21.records.utf8:1332883:975","marc:marc_cca/b10621386.out:34808426:856","ia:dharmaart00trun","marc:marc_loc_2016/BooksAll.2016.part25.utf8:83715996:979","marc:marc_columbia/Columbia-extract-20221130-007.mrc:322982267:2111","marc:harvard_bibliographic_metadata/20220215_021.bib.mrc:107264700:1728"],"title":"Dharma art","dewey_decimal_class":["294.3/375"],"notes":{"type":"/type/text","value":"Includes index."},"number_of_pages":144,"languages":[{"key":"/languages/eng"}],"lccn":["96014961"],"subjects":["Buddhism and the arts"],"publish_date":"1996","publish_country":"mau","by_statement":"Chögyam Trungpa ; edited by Judith L. Lief.","oclc_numbers":["34553425"],"works":[{"key":"/works/OL2558025W"}],"type":{"key":"/type/edition"},"description":{"type":"/type/text","value":"\"\"Dharma art\" refers to creative works that spring from the awakened meditative state, characterized by directness, unselfconsciousness, and nonagression. Chogyam Trungpa Rinpoche shows that dharma art provides a vehicle to appreciate the nature of things as they are and express it without any struggle or desire to achieve.\n\nA work of dharma art brings out the goodness and dignity of the situation it reflects - dignity that comes from the artist's interest in the details of life and sense of appreciation for experience. At the same time, the author stresses the need for artists to study their craft, develop skill, and absorb knowledge and insight passed down by tradition.\n\nAnd, finally, he extends the principles of dharma art to everyday life, showing how any activity can provide an opportunity to relax and open ourselves to the phenomenal world.\"--BOOK JACKET."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-11-07T04:32:41.968253"}}},"ISBN:9781570624667":{"bib_key":"ISBN:9781570624667","info_url":"http://openlibrary.org/books/OL18280539M/The_essential_Chögyam_Trungpa","preview":"restricted","preview_url":"https://archive.org/details/essentialchogyam0000trun","thumbnail_url":"https://covers.openlibrary.org/b/id/11037244-S.jpg","details":{"publishers":["Shambhala"],"number_of_pages":251,"isbn_10":["1570624666"],"lc_classifications":["BQ4302 .T782 1999","BQ4302.T782 1999"],"key":"/books/OL18280539M","authors":[{"key":"/authors/OL363720A","name":"Chögyam Trungpa"}],"publish_places":["Boston"],"contributions":["Gimian, Carolyn Rose."],"languages":[{"key":"/languages/eng"}],"pagination":"xii, 251 p. ;","source_records":["marc:bcl_marc/bcl_open.03.mrc:507665796:929","marc:marc_cca/b10621386.out:30999040:885","bwb:9781570624667","marc:marc_loc_2016/BooksAll.2016.part27.utf8:223859244:994","ia:essentialchogyam0000trun","promise:bwb_daily_pallets_2020-12-22","marc:marc_columbia/Columbia-extract-20221130-010.mrc:30532585:1235","marc:marc_columbia/Columbia-extract-20221130-005.mrc:447904625:1203"],"title":"The essential Chögyam Trungpa","dewey_decimal